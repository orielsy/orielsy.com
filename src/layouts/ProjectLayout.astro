---
import BaseLayout from './BaseLayout.astro';
import ContentStatus from '../components/ContentStatus.astro';
import ConceptDraftNotice from '../components/ConceptDraftNotice.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'projects'>;
  published?: boolean;
}

const { entry, published = false } = Astro.props;
const { data, id } = entry;
const isConceptDraft = published && data.draft;
const statusTitle = 'Project in Progress';
const statusDescription = 'This project is still being developed and its public case study is not available yet.';

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
}).format(data.date);

const statusStyles: Record<string, string> = {
  'Active': 'text-emerald-600 dark:text-emerald-400 border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/50 dark:bg-emerald-950/30',
  'Prototype': 'text-amber-600 dark:text-amber-400 border-amber-200 dark:border-amber-900/60 bg-amber-50/50 dark:bg-amber-950/30',
  'Completed': 'text-blue-600 dark:text-blue-400 border-blue-200 dark:border-blue-900/60 bg-blue-50/50 dark:bg-blue-950/30',
  'In Progress': 'text-purple-600 dark:text-purple-400 border-purple-200 dark:border-purple-900/60 bg-purple-50/50 dark:bg-purple-950/30',
  'Archived': 'text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30',
};

const statusBadge = statusStyles[data.status] || 'text-[var(--text-secondary)] border-[var(--border-subtle)] bg-[var(--bg-secondary)]';
---

<BaseLayout
  title={published ? data.title : statusTitle}
  description={published ? data.summary : statusDescription}
  image={published ? data.heroImage : undefined}
  imageAlt={published ? data.title : undefined}
  type={published ? 'article' : 'website'}
  schemaType="webpage"
  noindex={!published}
>
  <article class="w-full">
    <!-- Back to projects -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to Projects</span>
      </a>
    </div>

    <!-- Project Header -->
    <header class="pb-8 border-b border-[var(--border-subtle)]">
      {published ? (
        <>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2">
          {isConceptDraft && (
            <span class="px-2.5 py-0.5 rounded text-xs font-mono font-medium border border-amber-200 dark:border-amber-900/60 bg-amber-50/60 dark:bg-amber-950/20 text-amber-700 dark:text-amber-300">
              Concept Draft
            </span>
          )}
          <span class:list={['px-2.5 py-0.5 rounded text-xs font-mono font-medium border', statusBadge]}>
            {data.status}
          </span>
          <span class="text-xs font-mono text-[var(--text-muted)]">{data.role}</span>
        </div>
        <time datetime={data.date.toISOString()} class="text-xs font-mono text-[var(--text-muted)]">
          {formattedDate}
        </time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] mb-4 leading-tight">
        {data.title}
      </h1>

      <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed mb-6">
        {data.summary}
      </p>

      <!-- Technical Spec Box -->
      <div class="p-4 rounded-lg bg-[var(--bg-secondary)]/50 border border-[var(--border-subtle)] grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
        {data.architecture && (
          <div>
            <div class="text-[10px] uppercase tracking-wider text-[var(--text-muted)] mb-1">Architecture Paradigm</div>
            <div class="text-[var(--text-primary)] font-medium">{data.architecture}</div>
          </div>
        )}

        <div>
          <div class="text-[10px] uppercase tracking-wider text-[var(--text-muted)] mb-1.5">Technologies</div>
          <div class="flex flex-wrap gap-1">
            {data.technologies.map((t) => (
              <span class="px-1.5 py-0.5 rounded bg-[var(--bg-card)] border border-[var(--border-subtle)] text-[var(--text-secondary)]">
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap items-center gap-4 mt-6 text-xs font-mono">
        {data.github && (
          <a
            href={data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:border-[var(--border-strong)] flex items-center gap-2 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub Repository</span>
          </a>
        )}

        {data.demo && (
          <a
            href={data.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] flex items-center gap-2 transition-colors font-semibold"
          >
            <span>Live Demonstration</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}

        {data.associatedResearch && (
          <a
            href={data.associatedResearch}
            class="px-3 py-1.5 rounded border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center gap-2 transition-colors"
          >
            <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Read Architecture Exploration</span>
          </a>
        )}
      </div>
        </>
      ) : (
        <div class="pt-4">
          <div class="text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold mb-3">
            {statusTitle}
          </div>
          <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] leading-tight">
            {data.title}
          </h1>
        </div>
      )}
    </header>
    {published && isConceptDraft && <ConceptDraftNotice kind="project" />}

    {published ? (
      <div class="prose max-w-none pt-8">
        <slot />
      </div>
    ) : (
      <ContentStatus kind="project" />
    )}
  </article>
</BaseLayout>
