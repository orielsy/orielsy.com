---
import BaseLayout from './BaseLayout.astro';
import ContentStatus from '../components/ContentStatus.astro';
import ConceptDraftNotice from '../components/ConceptDraftNotice.astro';
import '../styles/project-article.css';
import { getCollection, type CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'projects'>;
  published?: boolean;
}

const { entry, published = false } = Astro.props;
const { data, id } = entry;
const isConceptDraft = published && data.draft;
const statusTitle = 'Project in Progress';
const statusDescription = 'This project is still being developed and its public case study is not available yet.';
const demoIsVideo = published && typeof data.demo === 'string' && /\.(mp4|webm|ogg)(?:$|\?)/i.test(data.demo);

const formattedDate = data.dateLabel ?? new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
}).format(data.date);

const researchEntries = await getCollection('research');
const researchByPath = new Map(
  researchEntries.map((researchEntry) => [`/research/${researchEntry.id}`, researchEntry]),
);
const unresolvedResearch = data.associatedResearch.filter((path) => !researchByPath.has(path));

if (unresolvedResearch.length > 0) {
  throw new Error(
    `Project "${id}" references unknown Research route(s): ${unresolvedResearch.join(', ')}`,
  );
}

const previewUnpublishedResearch = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';
const associatedResearchEntries = data.associatedResearch
  .map((path) => researchByPath.get(path))
  .filter((researchEntry): researchEntry is CollectionEntry<'research'> => Boolean(researchEntry))
  .filter((researchEntry) => researchEntry.data.published || previewUnpublishedResearch);
---

<BaseLayout
  title={published ? data.title : statusTitle}
  description={published ? data.summary : statusDescription}
  image={published ? data.heroImage : undefined}
  imageAlt={published ? data.title : undefined}
  type={published ? 'article' : 'website'}
  schemaType="webpage"
  noindex={!published}
  wide
>
  <article class="w-full" data-project-entry={id}>
    <header class="border-b border-[var(--border-subtle)] py-12 sm:py-16 lg:py-20">
      <div class="site-shell grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <a
            href="/projects"
            class="font-editorial-mono inline-flex items-center gap-2 text-[9px] uppercase tracking-[0.1em] text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)] sm:text-[10px]"
          >
            <span aria-hidden="true">←</span>
            Projects archive
          </a>
        </div>

        <div class="lg:col-span-8 lg:col-start-5">
          {published ? (
            <>
              {data.projectName && (
                <p class="font-editorial-mono mb-4 text-[9px] uppercase tracking-[0.14em] text-[var(--accent)] sm:text-[10px]">
                  {data.projectName}
                </p>
              )}

              <div class="font-editorial-mono flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] uppercase tracking-[0.09em] text-[var(--text-muted)] sm:text-[10px]">
                <span class="text-[var(--accent)]">{data.status}</span>
                <span>{data.role}</span>
                <time datetime={data.date.toISOString()}>{formattedDate}</time>
              </div>

              <h1 class="font-display mt-6 max-w-5xl text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-[var(--text-primary)] sm:text-5xl lg:text-6xl">
                {data.title}
              </h1>

              <p class="mt-7 max-w-3xl text-base leading-8 text-[var(--text-secondary)] sm:text-lg">
                {data.summary}
              </p>

              {(data.problem || data.solution) && (
                <section class="project-hero-brief mt-9 border-t border-[var(--border-subtle)] pt-5" aria-label="Project brief">
                  <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--accent)] sm:text-[10px]">
                    Project brief
                  </p>
                  <dl class="mt-5 grid gap-5 sm:grid-cols-2">
                    {data.problem && (
                      <div>
                        <dt>Problem</dt>
                        <dd>{data.problem}</dd>
                      </div>
                    )}
                    {data.solution && (
                      <div>
                        <dt>Built response</dt>
                        <dd>{data.solution}</dd>
                      </div>
                    )}
                  </dl>
                </section>
              )}

              {demoIsVideo && data.demo && (
                <figure class="project-hero-media mt-10 overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-card)]">
                  <video
                    controls
                    poster={data.heroImage}
                    data-speechbubbles-video={id === 'local-ai-real-time-captioning' ? '' : undefined}
                    class="block aspect-video w-full bg-black object-contain"
                    preload="metadata"
                    playsinline
                  >
                    <source src={data.demo} />
                    Your browser does not support the video tag.
                  </video>
                  <figcaption class="font-editorial-mono border-t border-[var(--border-subtle)] px-4 py-3 text-[10px] leading-5 text-[var(--text-muted)]">
                    {data.demoCaption ?? `Demonstration artifact for ${data.title}.`}
                  </figcaption>
                </figure>
              )}
            </>
          ) : (
            <>
              <p class="font-editorial-mono text-[9px] uppercase tracking-[0.1em] text-[var(--accent)] sm:text-[10px]">
                {statusTitle}
              </p>
              <h1 class="font-display mt-5 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-[-0.04em] text-[var(--text-primary)] sm:text-5xl">
                {data.title}
              </h1>
            </>
          )}
        </div>
      </div>
    </header>
    {published ? (
      <div class="site-shell py-10 sm:py-14 lg:py-16">
        <div class="project-publication-grid grid gap-10 lg:grid-cols-12 lg:gap-0">
          <div class="project-reading min-w-0 lg:col-span-8 lg:col-start-5">
            {isConceptDraft && <ConceptDraftNotice kind="project" />}

            <div class="prose project-prose max-w-none">
              <slot />
            </div>

            {(data.architecture || data.technologies.length > 0 || data.github || data.demo || associatedResearchEntries.length > 0) && (
              <section class="mt-14 border-t border-[var(--border-subtle)] pt-6" aria-label="Project reference">
                <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--accent)] sm:text-[10px]">
                  Project reference
                </p>

                {(data.architecture || data.technologies.length > 0) && (
                  <dl class="project-hero-facts mt-5 grid gap-px border border-[var(--border-subtle)] bg-[var(--border-subtle)] sm:grid-cols-2">
                    {data.architecture && (
                      <div class="bg-[var(--bg-card)] p-5">
                        <dt>Architecture paradigm</dt>
                        <dd>{data.architecture}</dd>
                      </div>
                    )}
                    {data.technologies.length > 0 && (
                      <div class="bg-[var(--bg-card)] p-5">
                        <dt>Technologies</dt>
                        <dd>
                          <ul class="project-hero-technology-list" aria-label="Project technologies">
                            {data.technologies.map((technology) => <li>{technology}</li>)}
                          </ul>
                        </dd>
                      </div>
                    )}
                  </dl>
                )}

                {(data.github || data.demo) && (
                  <div class="font-editorial-mono mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-[9px] uppercase tracking-[0.08em] sm:text-[10px]">
                    {data.demo && (
                      <a
                        href={data.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-analytics-event="project_demo"
                        data-analytics-project={id}
                        class="text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
                      >
                        Live demonstration ↗
                      </a>
                    )}
                    {data.github && (
                      <a
                        href={data.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-analytics-event="project_repo"
                        data-analytics-project={id}
                        class="text-[var(--text-primary)] transition-colors hover:text-[var(--accent)]"
                      >
                        Repository ↗
                      </a>
                    )}
                  </div>
                )}

                {associatedResearchEntries.length > 0 && (
                  <div class="mt-6">
                    <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)] sm:text-[10px]">
                      Associated Research
                    </p>
                    <ul class="mt-3 grid gap-2">
                      {associatedResearchEntries.map((researchEntry) => (
                        <li>
                          <a
                            href={`/research/${researchEntry.id}`}
                            data-analytics-event="project_to_research"
                            data-analytics-project={id}
                            data-analytics-research={researchEntry.id}
                            class="group inline-flex items-start gap-2 text-sm leading-6 text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
                          >
                            <span>{researchEntry.data.title}</span>
                            <span class="font-editorial-mono shrink-0 text-[var(--accent)] transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </section>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="site-shell py-10 sm:py-14">
        <div class="max-w-3xl lg:ml-[33.333333%]">
          <ContentStatus kind="project" />
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<script>
  import { trackPortfolioEvent } from '../lib/analytics';

  document.querySelectorAll<HTMLVideoElement>('[data-speechbubbles-video]').forEach((video) => {
    if (video.dataset.analyticsBound === 'true') return;
    video.dataset.analyticsBound = 'true';

    video.addEventListener('play', () => {
      trackPortfolioEvent('speechbubbles_video_play', {
        project: 'local-ai-real-time-captioning',
      });
    }, { once: true });
  });
</script>
