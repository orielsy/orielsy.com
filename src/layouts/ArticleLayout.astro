---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ContentStatus from '../components/ContentStatus.astro';
import ConceptDraftNotice from '../components/ConceptDraftNotice.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'research'>;
  headings: { depth: number; slug: string; text: string }[];
  prevEntry?: CollectionEntry<'research'>;
  nextEntry?: CollectionEntry<'research'>;
  published?: boolean;
}

const { entry, headings, prevEntry, nextEntry, published = false } = Astro.props;
const { data, id } = entry;
const isConceptDraft = published && data.draft;
const statusTitle = 'Research in Progress';
const statusDescription = 'This research entry is still being developed and is not publicly available yet.';

const formattedPubDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.pubDate);

const formattedUpdateDate = data.updatedDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(data.updatedDate)
  : null;
---

<BaseLayout
  title={published ? data.title : statusTitle}
  description={published ? data.description : statusDescription}
  image={published ? data.heroImage : undefined}
  imageAlt={published ? data.title : undefined}
  articleDate={published ? data.pubDate.toISOString() : undefined}
  modifiedDate={published && data.updatedDate ? data.updatedDate.toISOString() : undefined}
  type={published ? 'article' : 'website'}
  schemaType={published ? 'article' : 'webpage'}
  noindex={!published}
>
  <article class="w-full">
    <!-- Back to research -->
    <div class="mb-8">
      <a
        href="/research"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to Research</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="pb-8 border-b border-[var(--border-subtle)]">
      {published ? (
        <>
      <div class="flex flex-wrap items-center gap-2.5 mb-4 text-xs font-mono">
        {isConceptDraft && (
          <span class="px-2.5 py-0.5 rounded font-medium border border-amber-200 dark:border-amber-900/60 bg-amber-50/60 dark:bg-amber-950/20 text-amber-700 dark:text-amber-300">
            Concept Draft
          </span>
        )}
        <span class="px-2.5 py-0.5 rounded font-medium border border-[var(--border-subtle)] bg-[var(--bg-secondary)] text-[var(--accent)]">
          {data.type}
        </span>
        <span class="text-[var(--text-muted)]">&bull;</span>
        <time datetime={data.pubDate.toISOString()} class="text-[var(--text-muted)]">
          {formattedPubDate}
        </time>
        {data.readingTime && (
          <>
            <span class="text-[var(--text-muted)]">&bull;</span>
            <span class="text-[var(--text-muted)]">{data.readingTime}</span>
          </>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] mb-4 leading-tight">
        {data.title}
      </h1>

      <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed font-normal mb-6">
        {data.description}
      </p>

      <!-- Meta Bar: Tags & Artifact Links -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[var(--border-subtle)] text-xs font-mono">
        {data.tags && data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded bg-[var(--bg-secondary)] text-[var(--text-muted)] border border-[var(--border-subtle)]">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <div class="flex items-center gap-4">
          {data.github && (
            <a
              href={data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center gap-1.5 transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>Repository</span>
            </a>
          )}
          {data.demo && (
            <a
              href={data.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--accent)] hover:underline flex items-center gap-1 transition-colors"
            >
              <span>Live Implementation</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      </div>

      {formattedUpdateDate && (
        <div class="mt-3 text-[11px] font-mono text-[var(--text-muted)]">
          Last revised: {formattedUpdateDate}
        </div>
      )}
        </>
      ) : (
        <div class="pt-4">
          <div class="text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold mb-3">
            {statusTitle}
          </div>
          <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] leading-tight">
            {data.title}
          </h1>
        </div>
      )}
    </header>
    {published && isConceptDraft && <ConceptDraftNotice kind="research" />}
    {published ? (
      <>
        <!-- Table of contents if headings present -->
        <TableOfContents headings={headings} />

        <!-- Article Content -->
        <div class="prose max-w-none pt-6">
          <slot />
        </div>

        <!-- Article Footer / Navigation -->
        <footer class="mt-16 pt-8 border-t border-[var(--border-subtle)]">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              {prevEntry ? (
                <a
                  href={`/research/${prevEntry.id}`}
                  class="group flex flex-col text-left"
                >
                  <span class="text-[11px] font-mono text-[var(--text-muted)] group-hover:text-[var(--accent)]">
                    &larr; Previous Work
                  </span>
                  <span class="text-xs sm:text-sm font-medium text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-1">
                    {prevEntry.data.title}
                  </span>
                </a>
              ) : <div />}
            </div>

            <div>
              {nextEntry ? (
                <a
                  href={`/research/${nextEntry.id}`}
                  class="group flex flex-col text-right sm:items-end"
                >
                  <span class="text-[11px] font-mono text-[var(--text-muted)] group-hover:text-[var(--accent)]">
                    Next Work &rarr;
                  </span>
                  <span class="text-xs sm:text-sm font-medium text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-1">
                    {nextEntry.data.title}
                  </span>
                </a>
              ) : <div />}
            </div>
          </div>
        </footer>
      </>
    ) : (
      <ContentStatus kind="research" />
    )}
  </article>
</BaseLayout>
