---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ContentStatus from '../components/ContentStatus.astro';
import ConceptDraftNotice from '../components/ConceptDraftNotice.astro';
import Callout from '../components/Callout.astro';
import '../styles/research-article.css';
import '../styles/research-publication.css';
import '../styles/research-graphics.css';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'research'>;
  headings: { depth: number; slug: string; text: string }[];
  prevEntry?: CollectionEntry<'research'>;
  nextEntry?: CollectionEntry<'research'>;
  published?: boolean;
}

const { entry, headings, prevEntry, nextEntry, published = false } = Astro.props;
const { data } = entry;
const isConceptDraft = published && data.draft;
const statusTitle = 'Research in Progress';
const statusDescription = 'This research entry is still being developed and is not publicly available yet.';

const formattedPubDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(data.pubDate);

const formattedUpdateDate = data.updatedDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(data.updatedDate)
  : null;
---

<BaseLayout
  title={published ? data.title : statusTitle}
  description={published ? data.description : statusDescription}
  image={published ? data.heroImage : undefined}
  imageAlt={published ? data.title : undefined}
  articleDate={published ? data.pubDate.toISOString() : undefined}
  modifiedDate={published && data.updatedDate ? data.updatedDate.toISOString() : undefined}
  type={published ? 'article' : 'website'}
  schemaType={published ? 'article' : 'webpage'}
  noindex={!published}
  wide
>
  <article class="w-full" data-research-entry={entry.id}>
    <header class="border-b border-[var(--border-subtle)] py-12 sm:py-16 lg:py-20">
      <div class="site-shell grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <a
            href="/research"
            class="font-editorial-mono inline-flex items-center gap-2 text-[9px] uppercase tracking-[0.1em] text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)] sm:text-[10px]"
          >
            <span aria-hidden="true">←</span>
            Research archive
          </a>
        </div>

        <div class="lg:col-span-8 lg:col-start-5">
          {published ? (
            <>
              <div class="font-editorial-mono flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] uppercase tracking-[0.09em] text-[var(--text-muted)] sm:text-[10px]">
                <span class="text-[var(--accent)]">{data.type}</span>
                <time datetime={data.pubDate.toISOString()}>{formattedPubDate}</time>
                {data.readingTime && <span>{data.readingTime}</span>}
                {isConceptDraft && <span>Concept Draft</span>}
              </div>

              <h1 class="font-display mt-6 max-w-5xl text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-[var(--text-primary)] sm:text-5xl lg:text-6xl">
                {data.title}
              </h1>

              <p class="mt-7 max-w-3xl text-base leading-8 text-[var(--text-secondary)] sm:text-lg">
                {data.description}
              </p>

              <div class="mt-8 grid gap-6 border-t border-[var(--border-subtle)] pt-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
                {data.tags && data.tags.length > 0 && (
                  <ul class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Research tags">
                    {data.tags.map((tag) => (
                      <li class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">
                        #{tag}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="font-editorial-mono flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] uppercase tracking-[0.08em] sm:justify-end">
                  {data.github && (
                    <a href={data.github} target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
                      Repository ↗
                    </a>
                  )}
                  {data.demo && (
                    <a href={data.demo} target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] hover:text-[var(--accent-hover)]">
                      Live implementation ↗
                    </a>
                  )}
                </div>
              </div>

              {formattedUpdateDate && (
                <p class="font-editorial-mono mt-4 text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">
                  Last revised {formattedUpdateDate}
                </p>
              )}
            </>
          ) : (
            <>
              <p class="font-editorial-mono text-[9px] uppercase tracking-[0.1em] text-[var(--accent)] sm:text-[10px]">
                {statusTitle}
              </p>
              <h1 class="font-display mt-5 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-[-0.04em] text-[var(--text-primary)] sm:text-5xl">
                {data.title}
              </h1>
            </>
          )}
        </div>
      </div>
    </header>
    {published ? (
      <>
        <div class="site-shell py-10 sm:py-14 lg:py-16">
          {(isConceptDraft || data.tldr) && (
            <div class="research-reading mx-auto w-full min-w-0 lg:hidden">
              {isConceptDraft && <ConceptDraftNotice kind="research" />}
              {data.tldr && (
                <Callout type="note" title={data.tldrLabel ?? 'TL;DR'}>
                  {data.tldr}
                </Callout>
              )}
            </div>
          )}

          <div class="research-publication-grid grid gap-10 lg:grid-cols-12 lg:gap-0">
            <aside class="lg:col-span-3" aria-label="Research navigation">
              <div class="research-toc-sticky lg:pr-8" data-research-toc-shell>
                <TableOfContents headings={headings} />
              </div>
            </aside>

            <div class="research-reading mx-auto w-full min-w-0 lg:col-span-8 lg:col-start-5 lg:mx-0">
              {isConceptDraft && (
                <div class="hidden lg:block">
                  <ConceptDraftNotice kind="research" />
                </div>
              )}

              {data.tldr && (
                <div class="hidden lg:block">
                  <Callout type="note" title={data.tldrLabel ?? 'TL;DR'}>
                    {data.tldr}
                  </Callout>
                </div>
              )}

              <div class="prose research-prose max-w-none">
                <slot />
              </div>
            </div>
          </div>
        </div>

        <footer class="border-t border-[var(--border-subtle)] py-10 sm:py-12">
          <div class="site-shell grid gap-8 sm:grid-cols-2">
            <div>
              {prevEntry ? (
                <a href={`/research/${prevEntry.id}`} class="group block max-w-lg">
                  <span class="font-editorial-mono text-[9px] uppercase tracking-[0.09em] text-[var(--text-muted)] group-hover:text-[var(--accent)]">
                    ← Previous Research
                  </span>
                  <span class="font-display mt-2 block text-base font-semibold leading-snug text-[var(--text-primary)] group-hover:text-[var(--accent)]">
                    {prevEntry.data.title}
                  </span>
                </a>
              ) : null}
            </div>

            <div class="sm:text-right">
              {nextEntry ? (
                <a href={`/research/${nextEntry.id}`} class="group ml-auto block max-w-lg">
                  <span class="font-editorial-mono text-[9px] uppercase tracking-[0.09em] text-[var(--text-muted)] group-hover:text-[var(--accent)]">
                    Next Research →
                  </span>
                  <span class="font-display mt-2 block text-base font-semibold leading-snug text-[var(--text-primary)] group-hover:text-[var(--accent)]">
                    {nextEntry.data.title}
                  </span>
                </a>
              ) : null}
            </div>
          </div>
        </footer>
      </>
    ) : (
      <div class="reading-shell py-12">
        <ContentStatus kind="research" />
      </div>
    )}
  </article>
</BaseLayout>

<script>
  import { trackPortfolioEvent } from '../lib/analytics';

  document.querySelectorAll<HTMLElement>('[data-research-entry]').forEach((article) => {
    if (article.dataset.analyticsBound === 'true') return;
    article.dataset.analyticsBound = 'true';

    article.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest<HTMLAnchorElement>('a[href^="/projects/"]');
      const href = link?.getAttribute('href');
      const project = href?.split('/').filter(Boolean)[1];
      const research = article.dataset.researchEntry;

      if (!project || !research) return;
      trackPortfolioEvent('research_to_project', { research, project });
    });
  });
</script>

<style is:global>
  .research-toc-sticky {
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  @media (min-width: 1024px) {
    .research-toc-sticky {
      position: sticky;
      top: 6rem;
    }

    .research-toc-sticky[data-yielding] {
      opacity: 0;
      transform: translateY(-0.5rem);
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-toc-sticky {
      transition: none;
    }
  }
</style>

<script>
  const desktopResearchLayout = window.matchMedia('(min-width: 1024px)');
  const tocShell = document.querySelector<HTMLElement>('[data-research-toc-shell]');
  const publicationPlates = Array.from(
    document.querySelectorAll<HTMLElement>('[data-breakout-mode="publication"]'),
  );

  if (tocShell && publicationPlates.length > 0) {
    let observer: IntersectionObserver | null = null;
    let resizeTimer: number | undefined;

    const setYielding = (yielding: boolean) => {
      tocShell.toggleAttribute('data-yielding', yielding);

      if (yielding) {
        tocShell.setAttribute('aria-hidden', 'true');
        tocShell.setAttribute('inert', '');
      } else {
        tocShell.removeAttribute('aria-hidden');
        tocShell.removeAttribute('inert');
      }
    };

    const disconnectObserver = () => {
      observer?.disconnect();
      observer = null;
      setYielding(false);
    };

    const setupObserver = () => {
      disconnectObserver();

      if (!desktopResearchLayout.matches) return;

      const stickyTop = 96;
      const tocHeight = Math.max(1, Math.ceil(tocShell.getBoundingClientRect().height));
      const bottomInset = Math.max(0, window.innerHeight - stickyTop - tocHeight);
      const intersectingPlates = new Set<Element>();

      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              intersectingPlates.add(entry.target);
            } else {
              intersectingPlates.delete(entry.target);
            }
          });

          setYielding(intersectingPlates.size > 0);
        },
        {
          root: null,
          rootMargin: `-${stickyTop}px 0px -${bottomInset}px 0px`,
          threshold: 0,
        },
      );

      publicationPlates.forEach((plate) => observer?.observe(plate));
    };

    const scheduleObserverRefresh = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setupObserver, 120);
    };

    desktopResearchLayout.addEventListener('change', setupObserver);
    window.addEventListener('resize', scheduleObserverRefresh, { passive: true });
    setupObserver();
  }
</script>
