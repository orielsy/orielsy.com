---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';
import '../styles/adaptive-enterprise-ui-lab.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  articleDate?: string;
  modifiedDate?: string;
  type?: 'website' | 'article';
  schemaType?: 'website' | 'person' | 'article' | 'webpage';
  noindex?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  articleDate,
  modifiedDate,
  type = 'website',
  schemaType = 'webpage',
  noindex = false,
  wide = false,
} = Astro.props;

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim()
  || '3d13a097-feea-41a8-86e9-9464d0a2fe75';
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL?.trim()
  || 'https://cloud.umami.is/script.js';
const umamiEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      articleDate={articleDate}
      modifiedDate={modifiedDate}
      type={type}
      schemaType={schemaType}
      noindex={noindex}
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeStorageKey = 'orielsy-theme';
        const legacyThemeStorageKey = 'theme';
        const motionStorageKey = 'orielsy-motion';
        const darkMedia = window.matchMedia('(prefers-color-scheme: dark)');
        const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');

        const readPreference = (key) => {
          try {
            return window.localStorage.getItem(key);
          } catch {
            return null;
          }
        };

        const writePreference = (key, value) => {
          try {
            window.localStorage.setItem(key, value);
          } catch {
            // The selected preference still applies for the current page.
          }
        };

        const applyTheme = (theme) => {
          root.classList.toggle('dark', theme === 'dark');
          root.classList.toggle('light', theme === 'light');
        };

        const applyMotion = (motion) => {
          root.dataset.motion = motion;
        };

        const resolveTheme = () => {
          const saved = readPreference(themeStorageKey);
          if (saved === 'light' || saved === 'dark') return saved;

          const legacy = readPreference(legacyThemeStorageKey);
          if (legacy === 'light' || legacy === 'dark') {
            writePreference(themeStorageKey, legacy);
            try {
              window.localStorage.removeItem(legacyThemeStorageKey);
            } catch {
              // Legacy cleanup is optional.
            }
            return legacy;
          }

          return darkMedia.matches ? 'dark' : 'light';
        };

        const resolveMotion = () => {
          const saved = readPreference(motionStorageKey);
          if (saved === 'full' || saved === 'reduced') return saved;
          return reducedMotionMedia.matches ? 'reduced' : 'full';
        };

        const syncPreferenceControls = () => {
          const theme = root.classList.contains('dark') ? 'dark' : 'light';
          document.querySelectorAll('[data-theme-option]').forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            button.setAttribute('aria-pressed', String(button.dataset.themeOption === theme));
          });

          const reduced = root.dataset.motion === 'reduced';
          document.querySelectorAll('[data-motion-toggle]').forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            button.setAttribute('aria-pressed', String(reduced));
            button.setAttribute('aria-label', reduced ? 'Resume site animation' : 'Pause site animation');

            const label = button.querySelector('[data-motion-toggle-label]');
            if (label) label.textContent = reduced ? 'Resume' : 'Pause';
          });
        };

        const setTheme = (theme) => {
          applyTheme(theme);
          writePreference(themeStorageKey, theme);
          try {
            window.localStorage.removeItem(legacyThemeStorageKey);
          } catch {
            // Legacy cleanup is optional.
          }
          syncPreferenceControls();
        };

        const setMotion = (motion) => {
          applyMotion(motion);
          writePreference(motionStorageKey, motion);
          syncPreferenceControls();
        };

        applyTheme(resolveTheme());
        applyMotion(resolveMotion());

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;

          const themeButton = event.target.closest('[data-theme-option]');
          if (themeButton instanceof HTMLButtonElement) {
            const nextTheme = themeButton.dataset.themeOption;
            if (nextTheme === 'light' || nextTheme === 'dark') setTheme(nextTheme);
            return;
          }

          const motionButton = event.target.closest('[data-motion-toggle]');
          if (motionButton instanceof HTMLButtonElement) {
            setMotion(root.dataset.motion === 'reduced' ? 'full' : 'reduced');
          }
        });

        const syncWhenReady = () => syncPreferenceControls();
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncWhenReady, { once: true });
        } else {
          syncWhenReady();
        }

        document.addEventListener('astro:after-swap', syncPreferenceControls);

        darkMedia.addEventListener?.('change', (event) => {
          const saved = readPreference(themeStorageKey);
          if (saved !== 'light' && saved !== 'dark') {
            applyTheme(event.matches ? 'dark' : 'light');
            syncPreferenceControls();
          }
        });

        reducedMotionMedia.addEventListener?.('change', (event) => {
          const saved = readPreference(motionStorageKey);
          if (saved !== 'full' && saved !== 'reduced') {
            applyMotion(event.matches ? 'reduced' : 'full');
            syncPreferenceControls();
          }
        });
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600&family=Sora:wght@500;600&display=swap"
    />
    {umamiEnabled && (
      <script
        is:inline
        define:vars={{ umamiWebsiteId, umamiScriptUrl }}
      >
        (() => {
          const hostname = window.location.hostname;
          const isLocal = hostname === 'localhost'
            || hostname === '127.0.0.1'
            || hostname === '[::1]'
            || hostname.endsWith('.localhost');

          const analyticsOptOutKey = 'orielsy-analytics-opt-out';
          const url = new URL(window.location.href);
          const analyticsMode = url.searchParams.get('analytics')?.toLowerCase();
          const hasAnalyticsToggle = analyticsMode === 'off' || analyticsMode === 'on';
          let analyticsOptedOut = analyticsMode === 'off';

          try {
            if (analyticsMode === 'off') {
              window.localStorage.setItem(analyticsOptOutKey, 'true');
            } else if (analyticsMode === 'on') {
              window.localStorage.removeItem(analyticsOptOutKey);
            }

            analyticsOptedOut = window.localStorage.getItem(analyticsOptOutKey) === 'true';
          } catch {
            // If storage is unavailable, honor the current URL toggle for this page load.
          }

          if (hasAnalyticsToggle) {
            url.searchParams.delete('analytics');
            const cleanUrl = `${url.pathname}${url.search}${url.hash}`;
            window.history.replaceState(window.history.state, '', cleanUrl);
          }

          if (isLocal || analyticsOptedOut) return;

          const script = document.createElement('script');
          script.defer = true;
          script.src = umamiScriptUrl;
          script.dataset.websiteId = umamiWebsiteId;
          document.head.appendChild(script);
        })();
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[var(--accent)] selection:text-[var(--accent-contrast)]">
    <Header />
    <main
      class:list={[
        'flex-1 w-full',
        wide ? '' : 'max-w-4xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12',
      ]}
    >
      <slot />
    </main>
    <Footer />
    <script>
      import { trackPortfolioEvent } from '../lib/analytics';

      document.querySelectorAll<HTMLButtonElement>('[data-status-trigger]').forEach((trigger) => {
        const statusId = trigger.getAttribute('aria-controls');
        const status = statusId ? document.getElementById(statusId) : null;

        if (!status) return;

        trigger.addEventListener('click', () => {
          const willExpand = trigger.getAttribute('aria-expanded') !== 'true';
          status.hidden = !willExpand;
          trigger.setAttribute('aria-expanded', String(willExpand));
        });
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const control = event.target.closest<HTMLElement>('[data-analytics-event]');
        const eventName = control?.dataset.analyticsEvent;
        if (!control || !eventName) return;

        const data = {
          ...(control.dataset.analyticsSource && { source: control.dataset.analyticsSource }),
          ...(control.dataset.analyticsProject && { project: control.dataset.analyticsProject }),
          ...(control.dataset.analyticsResearch && { research: control.dataset.analyticsResearch }),
        };

        trackPortfolioEvent(eventName, Object.keys(data).length > 0 ? data : undefined);
      });
    </script>
  </body>
</html>
