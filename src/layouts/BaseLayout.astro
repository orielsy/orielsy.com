---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
  type?: 'website' | 'article';
}

const { title, description, image, articleDate, type = 'website' } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      articleDate={articleDate}
      type={type}
    />
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[var(--accent)] selection:text-white">
    <Header />
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 pt-8 sm:pt-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
