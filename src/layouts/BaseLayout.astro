---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';
import '../styles/adaptive-enterprise-ui-lab.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  articleDate?: string;
  modifiedDate?: string;
  type?: 'website' | 'article';
  schemaType?: 'website' | 'person' | 'article' | 'webpage';
  noindex?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  articleDate,
  modifiedDate,
  type = 'website',
  schemaType = 'webpage',
  noindex = false,
  wide = false,
} = Astro.props;

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim()
  || '3d13a097-feea-41a8-86e9-9464d0a2fe75';
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL?.trim()
  || 'https://cloud.umami.is/script.js';
const umamiEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      articleDate={articleDate}
      modifiedDate={modifiedDate}
      type={type}
      schemaType={schemaType}
      noindex={noindex}
    />
    <script is:inline>
      (() => {
        try {
          const storageKey = 'orielsy-theme';
          const legacyStorageKey = 'theme';
          const saved = localStorage.getItem(storageKey) || localStorage.getItem(legacyStorageKey);
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved === 'light' || saved === 'dark'
            ? saved
            : prefersDark ? 'dark' : 'light';

          const root = document.documentElement;
          root.classList.toggle('dark', theme === 'dark');
          root.classList.toggle('light', theme === 'light');

          localStorage.setItem(storageKey, theme);
          if (localStorage.getItem(legacyStorageKey)) {
            localStorage.removeItem(legacyStorageKey);
          }
        } catch {
          // Fall back to the light theme defined by the document when storage is unavailable.
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600&family=Sora:wght@500;600&display=swap"
    />
    {umamiEnabled && (
      <script
        is:inline
        define:vars={{ umamiWebsiteId, umamiScriptUrl }}
      >
        (() => {
          const hostname = window.location.hostname;
          const isLocal = hostname === 'localhost'
            || hostname === '127.0.0.1'
            || hostname === '[::1]'
            || hostname.endsWith('.localhost');

          const analyticsOptOutKey = 'orielsy-analytics-opt-out';
          const url = new URL(window.location.href);
          const analyticsMode = url.searchParams.get('analytics')?.toLowerCase();
          const hasAnalyticsToggle = analyticsMode === 'off' || analyticsMode === 'on';
          let analyticsOptedOut = analyticsMode === 'off';

          try {
            if (analyticsMode === 'off') {
              window.localStorage.setItem(analyticsOptOutKey, 'true');
            } else if (analyticsMode === 'on') {
              window.localStorage.removeItem(analyticsOptOutKey);
            }

            analyticsOptedOut = window.localStorage.getItem(analyticsOptOutKey) === 'true';
          } catch {
            // If storage is unavailable, honor the current URL toggle for this page load.
          }

          if (hasAnalyticsToggle) {
            url.searchParams.delete('analytics');
            const cleanUrl = `${url.pathname}${url.search}${url.hash}`;
            window.history.replaceState(window.history.state, '', cleanUrl);
          }

          if (isLocal || analyticsOptedOut) return;

          const script = document.createElement('script');
          script.defer = true;
          script.src = umamiScriptUrl;
          script.dataset.websiteId = umamiWebsiteId;
          document.head.appendChild(script);
        })();
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[var(--accent)] selection:text-white">
    <Header />
    <main
      class:list={[
        'flex-1 w-full',
        wide ? '' : 'max-w-4xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12',
      ]}
    >
      <slot />
    </main>
    <Footer />
    <script>
      import { trackPortfolioEvent } from '../lib/analytics';

      document.querySelectorAll<HTMLButtonElement>('[data-status-trigger]').forEach((trigger) => {
        const statusId = trigger.getAttribute('aria-controls');
        const status = statusId ? document.getElementById(statusId) : null;

        if (!status) return;

        trigger.addEventListener('click', () => {
          const willExpand = trigger.getAttribute('aria-expanded') !== 'true';
          status.hidden = !willExpand;
          trigger.setAttribute('aria-expanded', String(willExpand));
        });
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const control = event.target.closest<HTMLElement>('[data-analytics-event]');
        const eventName = control?.dataset.analyticsEvent;
        if (!control || !eventName) return;

        const data = {
          ...(control.dataset.analyticsSource && { source: control.dataset.analyticsSource }),
          ...(control.dataset.analyticsProject && { project: control.dataset.analyticsProject }),
          ...(control.dataset.analyticsResearch && { research: control.dataset.analyticsResearch }),
        };

        trackPortfolioEvent(eventName, Object.keys(data).length > 0 ? data : undefined);
      });
    </script>
  </body>
</html>
