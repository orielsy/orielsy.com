---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  articleDate?: string;
  modifiedDate?: string;
  type?: 'website' | 'article';
  schemaType?: 'website' | 'person' | 'article' | 'webpage';
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  articleDate,
  modifiedDate,
  type = 'website',
  schemaType = 'webpage',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      articleDate={articleDate}
      modifiedDate={modifiedDate}
      type={type}
      schemaType={schemaType}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[var(--accent)] selection:text-white">
    <Header />
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 pt-8 sm:pt-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
