---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';
import '../styles/adaptive-enterprise-ui-lab.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  articleDate?: string;
  modifiedDate?: string;
  type?: 'website' | 'article';
  schemaType?: 'website' | 'person' | 'article' | 'webpage';
  noindex?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  articleDate,
  modifiedDate,
  type = 'website',
  schemaType = 'webpage',
  noindex = false,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      articleDate={articleDate}
      modifiedDate={modifiedDate}
      type={type}
      schemaType={schemaType}
      noindex={noindex}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600&family=Sora:wght@500;600&display=swap"
    />
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[var(--accent)] selection:text-white">
    <Header />
    <main
      class:list={[
        'flex-1 w-full',
        wide ? '' : 'max-w-4xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12',
      ]}
    >
      <slot />
    </main>
    <Footer />
    <script>
      document.querySelectorAll<HTMLButtonElement>('[data-status-trigger]').forEach((trigger) => {
        const statusId = trigger.getAttribute('aria-controls');
        const status = statusId ? document.getElementById(statusId) : null;

        if (!status) return;

        trigger.addEventListener('click', () => {
          const willExpand = trigger.getAttribute('aria-expanded') !== 'true';
          status.hidden = !willExpand;
          trigger.setAttribute('aria-expanded', String(willExpand));
        });
      });
    </script>
  </body>
</html>
