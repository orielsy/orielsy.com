---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectArchiveVisual from '../../components/projects/ProjectArchiveVisual.astro';
import ProjectResearchBadge from '../../components/ProjectResearchBadge.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';
const publishedProjects = allProjects.filter((entry) => entry.data.published);
const sortedProjects = publishedProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const unpublishedProjects = allProjects.filter((entry) => !entry.data.published);
const sortedUnpublishedProjects = unpublishedProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const statuses = Array.from(new Set(publishedProjects.map((project) => project.data.status)));
const researchEntries = await getCollection('research');
const publishedResearchPaths = new Set(
  researchEntries
    .filter((entry) => entry.data.published)
    .map((entry) => `/research/${entry.id}`),
);
const projectResearchPaths = new Map(
  publishedProjects.map((project) => [
    project.id,
    project.data.associatedResearch.filter((path) => publishedResearchPaths.has(path)),
  ] as const),
);
// Keep the archive filters ready for when the published project collection grows.
const showProjectFilters = false;

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout
  title="Selected Projects & Implementations"
  description="Selected public projects, prototypes, experiments, and reference implementations by Orielsy Diaz."
  wide
>
  <header class="border-b border-[var(--border-subtle)] py-14 sm:py-20">
    <div class="site-shell grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--accent)]">Selected Projects</p>
        <h1 class="font-display mt-5 max-w-4xl text-4xl font-semibold leading-[1.06] tracking-[-0.04em] text-[var(--text-primary)] sm:text-6xl">
          Implementation as evidence.
        </h1>
      </div>
      <p class="max-w-md text-sm leading-7 text-[var(--text-secondary)] lg:col-span-4">
        Working systems and prototypes that make architecture, interface decisions, and technical constraints inspectable.
      </p>
    </div>
  </header>

  {showProjectFilters && (
    <section class="border-b border-[var(--border-subtle)] py-4">
      <div class="site-shell flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
          Browse by status
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2" id="project-filter-container">
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="project-filter-btn cursor-pointer border-b border-[var(--accent)] py-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-primary)] transition-colors"
          >
            All <span class="text-[var(--text-muted)]">({publishedProjects.length})</span>
          </button>
          {statuses.map((status) => {
            const count = publishedProjects.filter((project) => project.data.status === status).length;
            return (
              <button
                type="button"
                data-filter={status}
                aria-pressed="false"
                class="project-filter-btn cursor-pointer border-b border-transparent py-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
              >
                {status} <span class="text-[var(--text-muted)]">({count})</span>
              </button>
            );
          })}
        </div>
      </div>
    </section>

    <script is:inline>
      const filterButtons = document.querySelectorAll('.project-filter-btn');
      const projects = document.querySelectorAll('#projects-list .project-item');
      const emptyState = document.getElementById('no-filtered-projects');

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          filterButtons.forEach((button) => {
            button.setAttribute('aria-pressed', 'false');
            button.classList.remove('border-[var(--accent)]', 'text-[var(--text-primary)]');
            button.classList.add('border-transparent', 'text-[var(--text-muted)]');
          });

          btn.setAttribute('aria-pressed', 'true');
          btn.classList.add('border-[var(--accent)]', 'text-[var(--text-primary)]');
          btn.classList.remove('border-transparent', 'text-[var(--text-muted)]');

          let visibleCount = 0;
          projects.forEach((project) => {
            const status = project.getAttribute('data-project-status');
            const visible = filter === 'all' || status === filter;
            project.style.display = visible ? 'grid' : 'none';
            if (visible) visibleCount++;
          });

          emptyState?.classList.toggle('hidden', visibleCount > 0);
        });
      });
    </script>
  )}

  <section class="site-shell py-12 sm:py-16" aria-label="Selected project implementations">
    <div id="projects-list" class="space-y-14 sm:space-y-16">
      {sortedProjects.map((project, index) => (
        <article
          data-project-status={project.data.status}
          class="project-item grid gap-8 lg:grid-cols-12"
        >
          <div class="lg:col-span-2">
            <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
              Project · {String(project.data.projectNumber ?? index + 1).padStart(2, '0')}
            </p>
            <p class="font-editorial-mono mt-4 text-[9px] uppercase tracking-[0.07em] text-[var(--text-secondary)]">
              {project.data.status}
            </p>
            {project.data.dateLabel?.includes(':') ? (
              <div class="font-editorial-mono mt-2 text-[8px] uppercase leading-5 tracking-[0.07em] text-[var(--text-muted)]">
                <span class="block">{project.data.dateLabel.split(':', 2)[0]}</span>
                <span class="block">{project.data.dateLabel.slice(project.data.dateLabel.indexOf(':') + 1).trim()}</span>
              </div>
            ) : (
              <p class="font-editorial-mono mt-2 text-[8px] uppercase leading-5 tracking-[0.07em] text-[var(--text-muted)]">
                {project.data.dateLabel ?? formatDate(project.data.date)}
              </p>
            )}

            {(projectResearchPaths.get(project.id)?.length ?? 0) > 0 && (
              <div class="mt-3">
                <ProjectResearchBadge
                  href={projectResearchPaths.get(project.id)!.length === 1
                    ? projectResearchPaths.get(project.id)![0]
                    : `/projects/${project.id}#associated-research`}
                  count={projectResearchPaths.get(project.id)!.length}
                />
              </div>
            )}
          </div>

          <div class="grid gap-8 border-t border-[var(--accent)] pt-6 lg:col-span-10 lg:grid-cols-[minmax(0,1fr)_320px]">
            <div class="min-w-0">
              <div class="flex flex-wrap gap-x-4 gap-y-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                {project.data.role && <span>{project.data.role}</span>}
                {project.data.draft && <span class="text-[var(--accent)]">Concept Draft</span>}
              </div>

              <h2 class="font-display mt-4 max-w-3xl text-2xl font-semibold leading-tight tracking-[-0.03em] text-[var(--text-primary)] sm:text-3xl">
                <a href={`/projects/${project.id}`} class="transition-colors hover:text-[var(--accent)]">{project.data.title}</a>
              </h2>

              <p class="mt-5 max-w-2xl text-sm leading-7 text-[var(--text-secondary)]">{project.data.summary}</p>

              {(project.data.archive?.signals?.length ?? 0) > 0 ? (
                <ul
                  class="mt-7 grid max-w-2xl gap-px border border-[var(--border-subtle)] bg-[var(--border-subtle)] sm:grid-cols-2"
                  aria-label="Project architecture signals"
                >
                  {project.data.archive!.signals.map((signal) => (
                    <li class="bg-[var(--bg-card)] px-4 py-3 font-editorial-mono text-[9px] uppercase leading-5 tracking-[0.06em] text-[var(--text-secondary)]">
                      {signal}
                    </li>
                  ))}
                </ul>
              ) : project.data.architecture ? (
                <div class="mt-7 max-w-2xl border-l border-[var(--accent)] pl-4">
                  <p class="font-editorial-mono text-[8px] uppercase tracking-[0.1em] text-[var(--text-muted)]">Architecture</p>
                  <p class="font-editorial-mono mt-2 text-[9px] uppercase leading-5 tracking-[0.06em] text-[var(--text-secondary)]">
                    {project.data.architecture}
                  </p>
                </div>
              ) : null}

              <a href={`/projects/${project.id}`} class="font-editorial-mono mt-7 inline-flex items-center gap-2 text-[9px] uppercase tracking-[0.08em] text-[var(--text-primary)] hover:text-[var(--accent)]">
                Open project detail <span aria-hidden="true">→</span>
              </a>
            </div>

            <ProjectArchiveVisual
              visual={project.data.archive?.visual}
              technologies={project.data.technologies}
            />
          </div>
        </article>
      ))}
    </div>

    {showProjectFilters && (
      <div id="no-filtered-projects" class="mt-6 hidden border-y border-[var(--border-subtle)] py-10 text-center">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">No projects found matching this status filter.</p>
      </div>
    )}

    {sortedProjects.length === 0 && (
      <div class="border-y border-[var(--border-subtle)] py-10 text-center">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">No published projects yet.</p>
      </div>
    )}
  </section>

  {sortedUnpublishedProjects.length > 0 && (
    <section class="border-t border-[var(--border-subtle)] py-12 sm:py-16" aria-labelledby="projects-in-progress-heading">
      <div class="site-shell grid gap-8 lg:grid-cols-12">
        <header class="lg:col-span-3">
          <h2 id="projects-in-progress-heading" class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
            Projects in Progress
          </h2>
          <p class="mt-3 max-w-xs text-xs leading-6 text-[var(--text-muted)]">
            {previewUnpublished
              ? 'Local content-preview mode is active. Unpublished entries are linked for review but remain unpublished in source.'
              : 'Early ideas and unfinished implementations are shown here for context. These entries are not published as finished projects and do not link to detail pages.'}
          </p>
        </header>
        <div class="space-y-6 lg:col-span-9" id="unpublished-projects-list">
          {sortedUnpublishedProjects.map((project) => (
            <ProjectCard entry={project} previewUnpublished={previewUnpublished} />
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
