---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';
const publishedProjects = allProjects.filter((entry) => entry.data.published);
const sortedProjects = publishedProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const unpublishedProjects = allProjects.filter((entry) => !entry.data.published);
const sortedUnpublishedProjects = unpublishedProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const statuses = Array.from(new Set(publishedProjects.map((project) => project.data.status)));

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout
  title="Selected Projects & Implementations"
  description="Selected public projects, prototypes, experiments, and reference implementations by Orielsy Diaz."
  wide
>
  <header class="border-b border-[var(--border-subtle)] py-14 sm:py-20">
    <div class="site-shell grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--accent)]">Selected Projects</p>
        <h1 class="font-display mt-5 max-w-4xl text-4xl font-semibold leading-[1.06] tracking-[-0.04em] text-[var(--text-primary)] sm:text-6xl">
          Implementation as evidence.
        </h1>
      </div>
      <p class="max-w-md text-sm leading-7 text-[var(--text-secondary)] lg:col-span-4">
        Prototypes, developer tools, and architectural implementations exploring client-side AI runtimes, multi-process desktop systems, and modern UI platforms.
      </p>
    </div>
  </header>

  <section class="border-b border-[var(--border-subtle)] py-4">
    <div class="site-shell flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
        Browse by status
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2" id="project-filter-container">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="project-filter-btn cursor-pointer border-b border-[var(--accent)] py-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-primary)] transition-colors"
        >
          All <span class="text-[var(--text-muted)]">({publishedProjects.length})</span>
        </button>
        {statuses.map((status) => {
          const count = publishedProjects.filter((project) => project.data.status === status).length;
          return (
            <button
              type="button"
              data-filter={status}
              aria-pressed="false"
              class="project-filter-btn cursor-pointer border-b border-transparent py-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
            >
              {status} <span class="text-[var(--text-muted)]">({count})</span>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <section class="site-shell py-12 sm:py-16" aria-labelledby="published-projects-heading">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <p id="published-projects-heading" class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
          Published Projects
        </p>
        <p class="mt-3 max-w-xs text-xs leading-6 text-[var(--text-muted)]">
          Artifact-first implementations and prototypes with inspectable architecture and technical decisions.
        </p>
      </div>

      <div class="lg:col-span-9">
        <div id="projects-list" class="border-y border-[var(--border-subtle)]">
          {sortedProjects.map((project, index) => (
            <article
              data-project-status={project.data.status}
              class="project-item group grid gap-6 border-b border-[var(--border-subtle)] py-8 last:border-b-0 lg:grid-cols-[120px_minmax(0,1fr)_240px] lg:gap-8"
            >
              <div>
                <span class="font-editorial-mono text-[9px] text-[var(--accent)]">{String(index + 1).padStart(2, '0')}</span>
                <p class="font-editorial-mono mt-3 text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)]">{project.data.status}</p>
                <p class="font-editorial-mono mt-2 text-[8px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                  {project.data.dateLabel ?? formatDate(project.data.date)}
                </p>
              </div>

              <div>
                <div class="flex flex-wrap gap-x-4 gap-y-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                  {project.data.role && <span>{project.data.role}</span>}
                  {project.data.draft && <span class="text-[var(--accent)]">Concept Draft</span>}
                </div>
                <h2 class="font-display mt-3 max-w-3xl text-2xl font-semibold leading-tight tracking-[-0.03em] text-[var(--text-primary)] sm:text-3xl">
                  <a href={`/projects/${project.id}`} class="transition-colors group-hover:text-[var(--accent)]">{project.data.title}</a>
                </h2>
                <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--text-secondary)]">{project.data.summary}</p>
                {project.data.architecture && (
                  <p class="font-editorial-mono mt-5 max-w-2xl border-l border-[var(--accent)] pl-4 text-[9px] uppercase leading-5 tracking-[0.06em] text-[var(--text-muted)]">
                    {project.data.architecture}
                  </p>
                )}
              </div>

              <div class="lg:border-l lg:border-[var(--border-subtle)] lg:pl-6">
                <p class="font-editorial-mono text-[8px] uppercase tracking-[0.1em] text-[var(--text-muted)]">Technology</p>
                <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-2 lg:block lg:border-t lg:border-[var(--border-subtle)]">
                  {project.data.technologies.slice(0, 6).map((technology) => (
                    <li class="font-editorial-mono text-[9px] uppercase tracking-[0.06em] text-[var(--text-secondary)] lg:border-b lg:border-[var(--border-subtle)] lg:py-2.5">
                      {technology}
                    </li>
                  ))}
                </ul>
                <a href={`/projects/${project.id}`} class="font-editorial-mono mt-5 inline-flex items-center gap-2 text-[9px] uppercase tracking-[0.08em] text-[var(--text-primary)] hover:text-[var(--accent)]">
                  Project detail <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div id="no-filtered-projects" class="mt-6 hidden border-y border-[var(--border-subtle)] py-10 text-center">
          <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">No projects found matching this status filter.</p>
        </div>

        {sortedProjects.length === 0 && (
          <div class="border-y border-[var(--border-subtle)] py-10 text-center">
            <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">No published projects yet.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  {sortedUnpublishedProjects.length > 0 && (
    <section class="border-t border-[var(--border-subtle)] py-12 sm:py-16" aria-labelledby="projects-in-progress-heading">
      <div class="site-shell grid gap-8 lg:grid-cols-12">
        <header class="lg:col-span-3">
          <h2 id="projects-in-progress-heading" class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
            Projects in Progress
          </h2>
          <p class="mt-3 max-w-xs text-xs leading-6 text-[var(--text-muted)]">
            {previewUnpublished
              ? 'Local content-preview mode is active. Unpublished entries are linked for review but remain unpublished in source.'
              : 'Early ideas and unfinished implementations are shown here for context. These entries are not published as finished projects and do not link to detail pages.'}
          </p>
        </header>
        <div class="space-y-6 lg:col-span-9" id="unpublished-projects-list">
          {sortedUnpublishedProjects.map((project) => (
            <ProjectCard entry={project} previewUnpublished={previewUnpublished} />
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.project-filter-btn');
    const projects = document.querySelectorAll<HTMLElement>('#projects-list .project-item');
    const emptyState = document.getElementById('no-filtered-projects');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterButtons.forEach((button) => {
          button.setAttribute('aria-pressed', 'false');
          button.classList.remove('border-[var(--accent)]', 'text-[var(--text-primary)]');
          button.classList.add('border-transparent', 'text-[var(--text-muted)]');
        });

        btn.setAttribute('aria-pressed', 'true');
        btn.classList.add('border-[var(--accent)]', 'text-[var(--text-primary)]');
        btn.classList.remove('border-transparent', 'text-[var(--text-muted)]');

        let visibleCount = 0;
        projects.forEach((project) => {
          const status = project.getAttribute('data-project-status');
          const visible = filter === 'all' || status === filter;
          project.style.display = visible ? 'grid' : 'none';
          if (visible) visibleCount++;
        });

        emptyState?.classList.toggle('hidden', visibleCount > 0);
      });
    });
  </script>
</BaseLayout>
