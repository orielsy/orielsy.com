---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ContentPreviewNotice from '../../components/ContentPreviewNotice.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';
  const routableProjects = previewUnpublished
    ? projectEntries
    : projectEntries.filter((entry) => entry.data.published);

  return routableProjects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, published: entry.data.published },
  }));
}

const { entry, published } = Astro.props;
const { Content } = await render(entry);
const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview' && !published;
const renderFullContent = published || previewUnpublished;
---

<ProjectLayout entry={entry} published={renderFullContent}>
  {previewUnpublished && <ContentPreviewNotice kind="project" />}
  {renderFullContent && <Content />}
</ProjectLayout>
