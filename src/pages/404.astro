---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The requested page could not be found."
>
  <div class="py-20 text-center max-w-lg mx-auto">
    <div class="text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold mb-3">
      Error 404
    </div>
    <h1 class="text-3xl font-bold tracking-tight text-[var(--text-primary)] mb-4">
      Page Not Found
    </h1>
    <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-8">
      The requested route does not exist or may have moved.
    </p>
    <div class="flex items-center justify-center gap-4 text-xs font-mono">
      <a
        href="/"
        class="px-4 py-2 rounded bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] font-medium transition-colors"
      >
        Return Home
      </a>
      <a
        href="/research"
        class="px-4 py-2 rounded border border-[var(--border-subtle)] hover:border-[var(--border-strong)] bg-[var(--bg-card)] text-[var(--text-primary)] transition-colors"
      >
        Browse Research
      </a>
    </div>
  </div>
</BaseLayout>
