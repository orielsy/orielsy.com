---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedResearchVisual from '../components/home/FeaturedResearchVisual.astro';
import ProgressiveEnhancementVisual from '../components/home/ProgressiveEnhancementVisual.astro';
import FeaturedProjectVisual from '../components/home/FeaturedProjectVisual.astro';
import TldrToggleButton from '../components/TldrToggleButton.astro';
import ResearchFollowsBadge from '../components/ResearchFollowsBadge.astro';
import ResearchContinuationBadge from '../components/ResearchContinuationBadge.astro';
import ProjectResearchBadge from '../components/ProjectResearchBadge.astro';
import ResearchProjectBadge from '../components/ResearchProjectBadge.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research');
const researchOrigins = new Map(
  allResearch.map((entry) => {
    const origin = entry.data.originSlug
      ? allResearch.find((candidate) => candidate.id === entry.data.originSlug)
      : undefined;

    return [
      entry.id,
      origin ? { href: `/research/${origin.id}`, title: origin.data.title } : null,
    ] as const;
  }),
);
const researchContinuationCounts = new Map(
  allResearch.map((entry) => [
    entry.id,
    allResearch.filter((candidate) => candidate.data.originSlug === entry.id).length,
  ] as const),
);
const publishedResearch = allResearch.filter((entry) => entry.data.published);
const recentResearch = publishedResearch
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allProjects = await getCollection('projects');
const publishedProjects = allProjects.filter((entry) => entry.data.published);
const recentProjects = publishedProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const researchProjectEntries = new Map(
  allResearch.map((entry) => [
    entry.id,
    publishedProjects.filter((project) =>
      project.data.associatedResearch.includes(`/research/${entry.id}`),
    ),
  ] as const),
);

const featuredResearch = recentResearch.find((entry) => entry.data.featured) ?? recentResearch[0];
const recentResearchList = recentResearch
  .filter((entry) => entry.id !== featuredResearch?.id)
  .slice(0, 3);
const featuredProject = recentProjects.find((entry) => entry.data.featured) ?? recentProjects[0];
const publishedResearchPaths = new Set(publishedResearch.map((entry) => `/research/${entry.id}`));
const featuredProjectResearchPaths = featuredProject
  ? featuredProject.data.associatedResearch.filter((path) => publishedResearchPaths.has(path))
  : [];

const explorationAreas = [
  {
    title: 'Context Engineering for Coding Agents',
    description: 'Durable project knowledge and task-aware context for coding agents.',
    tag: 'Agent Systems',
  },
  {
    title: 'Product Knowledge & Adaptive UX',
    description: 'Using application state and product knowledge to guide the interface.',
    tag: 'UI Architecture',
  },
  {
    title: 'AI as an Interface Capability',
    description: 'Intelligence embedded directly into existing interface interactions.',
    tag: 'Applied AI',
  },
  {
    title: 'Adaptive AI Runtimes',
    description: 'Choosing where intelligent capabilities execute based on runtime constraints.',
    tag: 'Runtime Architecture',
  },
];

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout
  title="Orielsy Diaz — UI Architecture, Context Engineering & Applied AI"
  description="Senior Frontend Engineer & UI Architect. Research, systems architecture, and applied AI explorations."
  schemaType="website"
  wide
>
  <section class="border-b border-[var(--border-subtle)] py-16 sm:py-24 lg:py-28">
    <div class="site-shell grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <div class="flex items-center gap-3 font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)] sm:text-[10px]">
          <span class="h-px w-10 bg-[var(--accent)]" aria-hidden="true"></span>
          <span>Orielsy Diaz &bull; Senior Frontend Engineer &bull; UI Architect</span>
        </div>

        <h1 class="font-display mt-8 max-w-5xl text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-[var(--text-primary)] sm:text-6xl lg:text-7xl">
          Architecture, interaction systems, and applied AI <span class="text-[var(--accent)]">at the edge of the interface.</span>
        </h1>
      </div>

      <div class="lg:col-span-4 lg:pb-2">
        <p class="max-w-[46rem] text-sm leading-7 text-[var(--text-secondary)] sm:text-[15px]">
          I design frontend architecture for complex, long-lived applications and enterprise platforms. My current work explores context engineering and applied AI as capabilities for product interfaces and developer tools.
        </p>

        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 font-editorial-mono text-[10px] uppercase tracking-[0.08em]">
          <a href="/about#connect" class="inline-flex items-center gap-2 text-[var(--text-muted)] hover:text-[var(--text-primary)]">
            Get in touch <span aria-hidden="true">→</span>
          </a>
          <a href="https://www.linkedin.com/in/orielsy" target="_blank" rel="noopener noreferrer" data-analytics-event="outbound_linkedin" data-analytics-source="home" class="inline-flex items-center gap-2 text-[var(--text-muted)] hover:text-[var(--text-primary)]">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {featuredResearch && (
    <section class="py-16 sm:py-20">
      <div class="site-shell">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
              Featured Research · {String(featuredResearch.data.researchNumber ?? 1).padStart(2, '0')}
            </p>
            {featuredResearch.data.home?.blurb && (
              <p class="mt-3 max-w-md text-xs leading-6 text-[var(--text-muted)]">
                {featuredResearch.data.home.blurb}
              </p>
            )}
          </div>

          <div class="flex flex-col items-start gap-3 sm:items-end">
            {(researchOrigins.get(featuredResearch.id) ||
              (researchProjectEntries.get(featuredResearch.id)?.length ?? 0) > 0) && (
              <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                {researchOrigins.get(featuredResearch.id) && (
                  <ResearchFollowsBadge {...researchOrigins.get(featuredResearch.id)!} />
                )}
                {(researchProjectEntries.get(featuredResearch.id)?.length ?? 0) > 0 && (
                  <ResearchProjectBadge
                    href={researchProjectEntries.get(featuredResearch.id)!.length === 1
                      ? `/projects/${researchProjectEntries.get(featuredResearch.id)![0].id}`
                      : `/research/${featuredResearch.id}#research-lineage`}
                    count={researchProjectEntries.get(featuredResearch.id)!.length}
                  />
                )}
              </div>
            )}
            <a
              href="/research"
              class="font-editorial-mono text-[10px] uppercase tracking-[0.08em] text-[var(--text-muted)] hover:text-[var(--accent)]"
            >
              All research →
            </a>
          </div>
        </div>

        <article class="mt-6 border-t border-[var(--accent)] pt-7">
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-7">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-editorial-mono text-[9px] uppercase tracking-[0.09em] text-[var(--text-muted)]">
                <span class="text-[var(--accent)]">{featuredResearch.data.type}</span>
                <time datetime={featuredResearch.data.pubDate.toISOString()}>{formatDate(featuredResearch.data.pubDate)}</time>
                {featuredResearch.data.readingTime && <span>{featuredResearch.data.readingTime}</span>}
              </div>

              {(researchContinuationCounts.get(featuredResearch.id) ?? 0) > 0 && (
                <div class="mt-3">
                  <ResearchContinuationBadge
                    href={`/research/${featuredResearch.id}#research-lineage`}
                    count={researchContinuationCounts.get(featuredResearch.id)!}
                  />
                </div>
              )}

              <h2 class="font-display mt-4 max-w-3xl text-3xl font-semibold leading-[1.12] tracking-[-0.035em] text-[var(--text-primary)] sm:text-4xl">
                <a href={`/research/${featuredResearch.id}`} class="transition-colors hover:text-[var(--accent)]">
                  {featuredResearch.data.title}
                </a>
              </h2>

              <p class="mt-5 max-w-2xl text-sm leading-7 text-[var(--text-secondary)]">
                {featuredResearch.data.description}
              </p>

              {featuredResearch.data.tldr && (
                <div class="mt-6">
                  <TldrToggleButton controls={`tldr-home-featured-${featuredResearch.id}`} />
                </div>
              )}

              {featuredResearch.data.tldr && (
                <div
                  id={`tldr-home-featured-${featuredResearch.id}`}
                  class="mt-4 hidden max-w-2xl border-l border-[var(--accent-border)] pl-4"
                  data-tldr-panel
                >
                  <p class="text-sm leading-7 text-[var(--text-secondary)]">{featuredResearch.data.tldr}</p>
                </div>
              )}

              {featuredResearch.data.tags?.length > 0 && (
                <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 font-editorial-mono text-[8px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                  {featuredResearch.data.tags.map((tag) => <span>#{tag}</span>)}
                </div>
              )}

              <div class="mt-8">
                <a
                  href={`/research/${featuredResearch.id}`}
                  class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--text-primary)] hover:text-[var(--accent)]"
                >
                  Read publication <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <figure class="lg:col-span-5">
              {featuredResearch.data.home?.visual === 'progressive-enhancement' ? (
                <>
                  <div class="border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5">
                    <ProgressiveEnhancementVisual />
                  </div>
                  <figcaption class="mt-3 font-editorial-mono text-[9px] uppercase tracking-[0.14em] text-[var(--text-muted)]">
                    Capability scales with environment; authority stays bounded
                  </figcaption>
                </>
              ) : featuredResearch.data.home?.visual === 'adaptive-interface' ? (
                <FeaturedResearchVisual />
              ) : (
                <aside class="border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5" aria-label="Featured research metadata">
                  <p class="font-editorial-mono text-[9px] uppercase tracking-[0.1em] text-[var(--text-muted)]">Topics</p>
                  <div class="mt-7 border-t border-[var(--border-subtle)]">
                    {featuredResearch.data.tags.map((tag, index) => (
                      <div class="flex items-center justify-between gap-4 border-b border-[var(--border-subtle)] py-3">
                        <span class="font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-secondary)]">#{tag}</span>
                        <span class="font-editorial-mono text-[8px] text-[var(--text-muted)]">0{index + 1}</span>
                      </div>
                    ))}
                  </div>
                </aside>
              )}
            </figure>
          </div>
        </article>
      </div>
    </section>
  )}

  {recentResearchList.length > 0 && (
    <section class="border-y border-[var(--border-subtle)] py-16 sm:py-20">
      <div class="site-shell">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Latest Publications</p>
            <h2 class="font-display mt-3 text-2xl font-semibold tracking-[-0.03em] text-[var(--text-primary)] sm:text-3xl">Research & Explorations</h2>
          </div>
          <a href="/research" class="font-editorial-mono text-[10px] uppercase tracking-[0.08em] text-[var(--text-muted)] hover:text-[var(--accent)]">View all →</a>
        </div>

        <div class="mt-9 border-y border-[var(--border-subtle)]">
          {recentResearchList.map((entry, index) => (
            <article class="group grid gap-4 border-b border-[var(--border-subtle)] py-7 last:border-b-0 sm:grid-cols-[130px_minmax(0,1fr)_auto] sm:gap-8">
              <div class="flex items-start gap-3 sm:block">
                <span class="font-editorial-mono text-[9px] text-[var(--accent)]">{String(entry.data.researchNumber ?? index + 1).padStart(2, '0')}</span>
                <div class="min-w-0 sm:mt-3">
                  <time datetime={entry.data.pubDate.toISOString()} class="font-editorial-mono block text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                    {formatDate(entry.data.pubDate)}
                  </time>
                  {(researchOrigins.get(entry.id) ||
                    (researchContinuationCounts.get(entry.id) ?? 0) > 0 ||
                    (researchProjectEntries.get(entry.id)?.length ?? 0) > 0) && (
                    <div class="mt-2 flex min-w-0 flex-col items-start gap-2">
                      {researchOrigins.get(entry.id) && (
                        <ResearchFollowsBadge {...researchOrigins.get(entry.id)!} />
                      )}
                      {(researchContinuationCounts.get(entry.id) ?? 0) > 0 && (
                        <ResearchContinuationBadge
                          href={`/research/${entry.id}#research-lineage`}
                          count={researchContinuationCounts.get(entry.id)!}
                        />
                      )}
                      {(researchProjectEntries.get(entry.id)?.length ?? 0) > 0 && (
                        <ResearchProjectBadge
                          href={researchProjectEntries.get(entry.id)!.length === 1
                            ? `/projects/${researchProjectEntries.get(entry.id)![0].id}`
                            : `/research/${entry.id}#research-lineage`}
                          count={researchProjectEntries.get(entry.id)!.length}
                        />
                      )}
                    </div>
                  )}
                </div>
              </div>

              <div>
                <div class="flex flex-wrap gap-x-4 gap-y-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                  <span>{entry.data.type}</span>
                  {entry.data.readingTime && <span>{entry.data.readingTime}</span>}
                </div>
                <h3 class="font-display mt-3 max-w-3xl text-xl font-semibold leading-snug tracking-[-0.025em] text-[var(--text-primary)] sm:text-2xl">
                  <a href={`/research/${entry.id}`} class="transition-colors hover:text-[var(--accent)]">{entry.data.title}</a>
                </h3>
                <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--text-secondary)]">{entry.data.description}</p>

                {entry.data.tldr && (
                  <div class="mt-5">
                    <TldrToggleButton controls={`tldr-home-${entry.id}`} />
                  </div>
                )}

                {entry.data.tldr && (
                  <div
                    id={`tldr-home-${entry.id}`}
                    class="mt-4 hidden max-w-3xl border-l border-[var(--accent-border)] pl-4"
                    data-tldr-panel
                  >
                    <p class="text-sm leading-7 text-[var(--text-secondary)]">{entry.data.tldr}</p>
                  </div>
                )}

              </div>

              <span class="hidden text-[var(--text-muted)] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 sm:block" aria-hidden="true">→</span>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {featuredProject && (
    <section class="py-16 sm:py-20">
      <div class="site-shell">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">From Theory to Practice</p>
            <h2 class="font-display mt-3 text-2xl font-semibold tracking-[-0.03em] text-[var(--text-primary)] sm:text-3xl">Selected Implementation</h2>
          </div>
          <a href="/projects" class="font-editorial-mono text-[10px] uppercase tracking-[0.08em] text-[var(--text-muted)] hover:text-[var(--accent)]">View all →</a>
        </div>

        <article class="mt-10 grid gap-8 border-t border-[var(--accent)] pt-6 lg:grid-cols-[minmax(0,1fr)_320px]">
          <div>
            <div class="flex flex-wrap items-start gap-x-4 gap-y-2 font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">
              <span>{featuredProject.data.status}</span>
              <span>{featuredProject.data.role}</span>
              <div class="flex min-w-0 flex-col items-start">
                <span>{featuredProject.data.dateLabel ?? formatDate(featuredProject.data.date)}</span>
                {featuredProjectResearchPaths.length > 0 && (
                  <div class="mt-2">
                    <ProjectResearchBadge
                      href={featuredProjectResearchPaths.length === 1
                        ? featuredProjectResearchPaths[0]
                        : `/projects/${featuredProject.id}#associated-research`}
                      count={featuredProjectResearchPaths.length}
                    />
                  </div>
                )}
              </div>
            </div>
            <h3 class="font-display mt-4 max-w-3xl text-2xl font-semibold leading-tight tracking-[-0.03em] text-[var(--text-primary)] sm:text-3xl">
              <a href={`/projects/${featuredProject.id}`} class="hover:text-[var(--accent)]">{featuredProject.data.title}</a>
            </h3>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--text-secondary)]">
              {featuredProject.data.home?.blurb ?? featuredProject.data.summary}
            </p>
            <a href={`/projects/${featuredProject.id}`} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-primary)] hover:text-[var(--accent)]">
              View implementation <span aria-hidden="true" class="text-xs">→</span>
            </a>
          </div>

          {featuredProject.data.home?.visual === 'speech-broadcast' ? (
            <FeaturedProjectVisual />
          ) : (
            <aside class="border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5" aria-label="Selected project technologies">
              <p class="font-editorial-mono text-[9px] uppercase tracking-[0.1em] text-[var(--text-muted)]">Technology</p>
              <ul class="mt-7 border-t border-[var(--border-subtle)]">
                {featuredProject.data.technologies.slice(0, 6).map((technology, index) => (
                  <li class="flex items-center justify-between gap-4 border-b border-[var(--border-subtle)] py-3">
                    <span class="font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-secondary)]">{technology}</span>
                    <span class="font-editorial-mono text-[8px] text-[var(--text-muted)]">0{index + 1}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </article>
      </div>
    </section>
  )}

  <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-secondary)]/40 py-7">
    <div class="site-shell flex flex-col gap-5 lg:flex-row lg:items-center lg:gap-8">
      <div class="shrink-0 font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
        Areas of Inquiry
      </div>

      <ol class="grid flex-1 border-l border-t border-[var(--border-subtle)] sm:grid-cols-2 lg:grid-cols-4">
        {explorationAreas.map((area, index) => (
          <li class="border-b border-r border-[var(--border-subtle)] px-4 py-4">
            <div class="flex gap-3">
              <span class="font-editorial-mono text-[9px] text-[var(--accent)]">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="font-display text-xs font-semibold leading-5 text-[var(--text-primary)]">{area.title}</h2>
                <p class="font-editorial-mono mt-2 text-[8px] uppercase tracking-[0.08em] text-[var(--text-muted)]">{area.tag}</p>
                <p class="mt-3 text-[11px] leading-5 text-[var(--text-secondary)]">{area.description}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-tldr-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const panelId = button.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!panel) return;

        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        panel.classList.toggle('hidden', expanded);

        const symbol = button.querySelector<HTMLElement>('[data-tldr-symbol]');
        if (symbol) symbol.textContent = expanded ? '+' : '−';

        if (!expanded) {
          panel.setAttribute('tabindex', '-1');

          requestAnimationFrame(() => {
            panel.focus({ preventScroll: true });

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const rect = panel.getBoundingClientRect();
            const margin = 30;
            let scrollDelta = 0;

            if (rect.bottom > window.innerHeight - margin) {
              scrollDelta = rect.bottom - window.innerHeight + margin;
            } else if (rect.top < margin) {
              scrollDelta = rect.top - margin;
            }

            if (scrollDelta !== 0) {
              window.scrollBy({
                top: scrollDelta,
                behavior: reduceMotion ? 'auto' : 'smooth',
              });
            }
          });
        }
      });
    });
  </script>
</BaseLayout>
