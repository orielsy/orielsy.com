---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TldrToggleButton from '../../components/TldrToggleButton.astro';
import ResearchFollowsBadge from '../../components/ResearchFollowsBadge.astro';
import ResearchContinuationBadge from '../../components/ResearchContinuationBadge.astro';
import ResearchProjectBadge from '../../components/ResearchProjectBadge.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research');
const researchOrigins = new Map(
  allResearch.map((entry) => {
    const origin = entry.data.originSlug
      ? allResearch.find((candidate) => candidate.id === entry.data.originSlug)
      : undefined;

    return [
      entry.id,
      origin ? { href: `/research/${origin.id}`, title: origin.data.title } : null,
    ] as const;
  }),
);
const researchContinuationCounts = new Map(
  allResearch.map((entry) => [
    entry.id,
    allResearch.filter((candidate) => candidate.data.originSlug === entry.id).length,
  ] as const),
);
const allProjects = await getCollection('projects');
const publishedProjects = allProjects.filter((entry) => entry.data.published);
const researchProjectEntries = new Map(
  allResearch.map((entry) => [
    entry.id,
    publishedProjects.filter((project) =>
      project.data.associatedResearch.includes(`/research/${entry.id}`),
    ),
  ] as const),
);
const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';

const publishedResearch = allResearch.filter((entry) => entry.data.published);
const sortedResearch = publishedResearch.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const unpublishedResearch = allResearch.filter((entry) => !entry.data.published);
const sortedUnpublishedResearch = unpublishedResearch.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout
  title="Research & Architecture Explorations"
  description="Technical essays, architecture explorations, research notes, and systems design by Orielsy Diaz."
  wide
>
  <header class="border-b border-[var(--border-subtle)] py-14 sm:py-20">
    <div class="site-shell grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="font-editorial-mono text-[10px] uppercase tracking-[0.1em] text-[var(--accent)]">Research Archive</p>
        <h1 class="font-display mt-5 max-w-4xl text-4xl font-semibold leading-[1.06] tracking-[-0.04em] text-[var(--text-primary)] sm:text-6xl">
          Writing as a form of systems work.
        </h1>
      </div>
      <p class="max-w-md text-sm leading-7 text-[var(--text-secondary)] lg:col-span-4">
        Long-form architectural thinking, experiments, research notes, and system designs exploring frontend platforms, runtime inference, context engineering, and interactive tools.
      </p>
    </div>
  </header>

  <section class="site-shell py-12 sm:py-16" aria-label="Published research">
    <div id="articles-list" class="border-y border-[var(--border-subtle)]">
      {sortedResearch.map((entry, index) => (
        <article
          data-article-type={entry.data.type}
          class="article-item group grid gap-6 border-b border-[var(--border-subtle)] py-7 last:border-b-0 md:grid-cols-12 md:gap-8"
        >
          <div class="min-w-0 md:col-span-4 lg:col-span-3">
            <div class="flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-1">
              <span class="font-editorial-mono text-[10px] text-[var(--accent)]">{String(entry.data.researchNumber ?? publishedResearch.length - index).padStart(2, '0')}</span>
              <time datetime={entry.data.pubDate.toISOString()} class="font-editorial-mono text-[10px] uppercase tracking-[0.06em] text-[var(--text-muted)]">
                {formatDate(entry.data.pubDate)}
              </time>
              {researchOrigins.get(entry.id) && (
                <ResearchFollowsBadge {...researchOrigins.get(entry.id)!} />
              )}
              {(researchContinuationCounts.get(entry.id) ?? 0) > 0 && (
                <ResearchContinuationBadge
                  href={`/research/${entry.id}#research-lineage`}
                  count={researchContinuationCounts.get(entry.id)!}
                />
              )}
              {(researchProjectEntries.get(entry.id)?.length ?? 0) > 0 && (
                <ResearchProjectBadge
                  href={researchProjectEntries.get(entry.id)!.length === 1
                    ? `/projects/${researchProjectEntries.get(entry.id)![0].id}`
                    : `/research/${entry.id}#research-lineage`}
                  count={researchProjectEntries.get(entry.id)!.length}
                />
              )}
            </div>
          </div>

          <div class="grid min-w-0 gap-6 md:col-span-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-start lg:col-span-9">
            <div class="min-w-0">
              <div class="flex flex-wrap gap-x-4 gap-y-1 font-editorial-mono text-[10px] uppercase tracking-[0.06em] text-[var(--text-muted)]">
                <span>{entry.data.type}</span>
                {entry.data.readingTime && <span>{entry.data.readingTime}</span>}
                {entry.data.draft && <span class="text-[var(--accent)]">Concept Draft</span>}
              </div>
              <h2 class="font-display mt-3 max-w-4xl text-xl font-semibold leading-snug tracking-[-0.025em] text-[var(--text-primary)] sm:text-2xl">
                <a href={`/research/${entry.id}`} class="transition-colors hover:text-[var(--accent)]">{entry.data.title}</a>
              </h2>
              <p class="mt-3 max-w-4xl text-sm leading-7 text-[var(--text-secondary)]">{entry.data.description}</p>

              {entry.data.tldr && (
                <div class="mt-5">
                  <TldrToggleButton controls={`tldr-archive-${entry.id}`} />
                </div>
              )}

              {entry.data.tldr && (
                <div
                  id={`tldr-archive-${entry.id}`}
                  class="mt-4 hidden max-w-4xl border-l border-[var(--accent-border)] pl-4"
                  data-tldr-panel
                >
                  <p class="text-sm leading-7 text-[var(--text-secondary)]">{entry.data.tldr}</p>
                </div>
              )}
            </div>

            <span class="hidden text-[var(--text-muted)] transition-transform group-hover:translate-x-0.5 md:block" aria-hidden="true">→</span>
          </div>
        </article>
      ))}
    </div>

    {sortedResearch.length === 0 && (
      <div class="border-y border-[var(--border-subtle)] py-10 text-center">
        <p class="font-editorial-mono text-[10px] uppercase tracking-[0.08em] text-[var(--text-muted)]">No published research articles yet.</p>
      </div>
    )}
  </section>

  {sortedUnpublishedResearch.length > 0 && (
    <section class="border-t border-[var(--border-subtle)] py-12 sm:py-16" aria-labelledby="research-in-progress-heading">
      <div class="site-shell grid gap-8 lg:grid-cols-12">
        <header class="lg:col-span-3">
          <h2 id="research-in-progress-heading" class="font-editorial-mono text-[10px] uppercase tracking-[0.1em] text-[var(--text-muted)]">
            Research in Progress
          </h2>
          <p class="mt-3 max-w-xs text-xs leading-6 text-[var(--text-muted)]">
            {previewUnpublished
              ? 'Local content-preview mode is active. Unpublished entries are linked for review but remain unpublished in source.'
              : 'Early ideas and unfinished explorations are shown here for context. These entries are not published as finished research and do not link to detail pages.'}
          </p>
        </header>
        <div class="lg:col-span-9" id="unpublished-articles-list">
          {sortedUnpublishedResearch.map((entry) => (
            <ArticleCard entry={entry} showTags={false} previewUnpublished={previewUnpublished} />
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-tldr-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const panelId = button.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!panel) return;

        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        panel.classList.toggle('hidden', expanded);

        const symbol = button.querySelector<HTMLElement>('[data-tldr-symbol]');
        if (symbol) symbol.textContent = expanded ? '+' : '−';

        if (!expanded) {
          panel.setAttribute('tabindex', '-1');

          requestAnimationFrame(() => {
            panel.focus({ preventScroll: true });

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const rect = panel.getBoundingClientRect();
            const margin = 30;
            let scrollDelta = 0;

            if (rect.bottom > window.innerHeight - margin) {
              scrollDelta = rect.bottom - window.innerHeight + margin;
            } else if (rect.top < margin) {
              scrollDelta = rect.top - margin;
            }

            if (scrollDelta !== 0) {
              window.scrollBy({
                top: scrollDelta,
                behavior: reduceMotion ? 'auto' : 'smooth',
              });
            }
          });
        }
      });
    });
  </script>
</BaseLayout>