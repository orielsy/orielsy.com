---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research');
const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';

const publishedResearch = allResearch.filter((entry) => entry.data.published);
const sortedResearch = publishedResearch.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const unpublishedResearch = allResearch.filter((entry) => !entry.data.published);
const sortedUnpublishedResearch = unpublishedResearch.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTypes = Array.from(new Set(publishedResearch.map((item) => item.data.type)));

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout
  title="Research & Architecture Explorations"
  description="Technical essays, architecture explorations, research notes, and systems design by Orielsy Diaz."
  wide
>
  <header class="border-b border-[var(--border-subtle)] py-14 sm:py-20">
    <div class="site-shell grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--accent)]">Research Archive</p>
        <h1 class="font-display mt-5 max-w-4xl text-4xl font-semibold leading-[1.06] tracking-[-0.04em] text-[var(--text-primary)] sm:text-6xl">
          Writing as a form of systems work.
        </h1>
      </div>
      <p class="max-w-md text-sm leading-7 text-[var(--text-secondary)] lg:col-span-4">
        Long-form architectural thinking, experiments, research notes, and system designs exploring frontend platforms, runtime inference, context engineering, and interactive tools.
      </p>
    </div>
  </header>

  <section class="border-b border-[var(--border-subtle)] py-4">
    <div class="site-shell flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
        Browse by format
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2" id="filter-container">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-btn cursor-pointer border-b border-[var(--accent)] py-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-primary)] transition-colors"
        >
          All <span class="text-[var(--text-muted)]">({publishedResearch.length})</span>
        </button>
        {allTypes.map((type) => {
          const count = publishedResearch.filter((entry) => entry.data.type === type).length;
          return (
            <button
              type="button"
              data-filter={type}
              aria-pressed="false"
              class="filter-btn cursor-pointer border-b border-transparent py-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
            >
              {type} <span class="text-[var(--text-muted)]">({count})</span>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <section class="site-shell py-12 sm:py-16" aria-labelledby="published-research-heading">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <p id="published-research-heading" class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
          Published Research
        </p>
        <p class="mt-3 max-w-xs text-xs leading-6 text-[var(--text-muted)]">
          Reasoning-first writing, architecture explorations, and technical investigations.
        </p>
      </div>

      <div class="lg:col-span-9">
        <div id="articles-list" class="border-y border-[var(--border-subtle)]">
          {sortedResearch.map((entry, index) => (
            <article
              data-article-type={entry.data.type}
              class="article-item group grid gap-4 border-b border-[var(--border-subtle)] py-7 last:border-b-0 sm:grid-cols-[130px_minmax(0,1fr)_auto] sm:gap-8"
            >
              <div class="flex items-start gap-3 sm:block">
                <span class="font-editorial-mono text-[9px] text-[var(--accent)]">{String(index + 1).padStart(2, '0')}</span>
                <time datetime={entry.data.pubDate.toISOString()} class="font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)] sm:mt-3 sm:block">
                  {formatDate(entry.data.pubDate)}
                </time>
              </div>

              <div>
                <div class="flex flex-wrap gap-x-4 gap-y-1 font-editorial-mono text-[9px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                  <span>{entry.data.type}</span>
                  {entry.data.readingTime && <span>{entry.data.readingTime}</span>}
                  {entry.data.draft && <span class="text-[var(--accent)]">Concept Draft</span>}
                </div>
                <h2 class="font-display mt-3 max-w-3xl text-xl font-semibold leading-snug tracking-[-0.025em] text-[var(--text-primary)] sm:text-2xl">
                  <a href={`/research/${entry.id}`} class="transition-colors group-hover:text-[var(--accent)]">{entry.data.title}</a>
                </h2>
                <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--text-secondary)]">{entry.data.description}</p>
                {entry.data.tags?.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 font-editorial-mono text-[8px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
                    {entry.data.tags.map((tag) => <span>#{tag}</span>)}
                  </div>
                )}
              </div>

              <span class="hidden text-[var(--text-muted)] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 sm:block" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>

        <div id="no-filtered-results" class="mt-6 hidden border-y border-[var(--border-subtle)] py-10 text-center">
          <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">No articles found matching this format.</p>
        </div>

        {sortedResearch.length === 0 && (
          <div class="border-y border-[var(--border-subtle)] py-10 text-center">
            <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">No published research articles yet.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  {sortedUnpublishedResearch.length > 0 && (
    <section class="border-t border-[var(--border-subtle)] py-12 sm:py-16" aria-labelledby="research-in-progress-heading">
      <div class="site-shell grid gap-8 lg:grid-cols-12">
        <header class="lg:col-span-3">
          <h2 id="research-in-progress-heading" class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
            Research in Progress
          </h2>
          <p class="mt-3 max-w-xs text-xs leading-6 text-[var(--text-muted)]">
            {previewUnpublished
              ? 'Local content-preview mode is active. Unpublished entries are linked for review but remain unpublished in source.'
              : 'Early ideas and unfinished explorations are shown here for context. These entries are not published as finished research and do not link to detail pages.'}
          </p>
        </header>
        <div class="space-y-4 lg:col-span-9" id="unpublished-articles-list">
          {sortedUnpublishedResearch.map((entry) => (
            <ArticleCard entry={entry} showTags={true} previewUnpublished={previewUnpublished} />
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const articles = document.querySelectorAll<HTMLElement>('#articles-list .article-item');
    const emptyState = document.getElementById('no-filtered-results');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterButtons.forEach((button) => {
          button.setAttribute('aria-pressed', 'false');
          button.classList.remove('border-[var(--accent)]', 'text-[var(--text-primary)]');
          button.classList.add('border-transparent', 'text-[var(--text-muted)]');
        });

        btn.setAttribute('aria-pressed', 'true');
        btn.classList.add('border-[var(--accent)]', 'text-[var(--text-primary)]');
        btn.classList.remove('border-transparent', 'text-[var(--text-muted)]');

        let visibleCount = 0;
        articles.forEach((article) => {
          const type = article.getAttribute('data-article-type');
          const visible = filter === 'all' || type === filter;
          article.style.display = visible ? 'grid' : 'none';
          if (visible) visibleCount++;
        });

        emptyState?.classList.toggle('hidden', visibleCount > 0);
      });
    });
  </script>
</BaseLayout>
