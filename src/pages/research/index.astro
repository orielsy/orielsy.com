---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research');

const publishedResearch = allResearch.filter((entry) => entry.data.published);
const sortedResearch = publishedResearch.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const unpublishedResearch = allResearch.filter((entry) => !entry.data.published);
const sortedUnpublishedResearch = unpublishedResearch.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(new Set(publishedResearch.flatMap((item) => item.data.tags)));
const allTypes = Array.from(new Set(publishedResearch.map((item) => item.data.type)));
---

<BaseLayout
  title="Research & Architecture Explorations"
  description="Technical essays, architecture explorations, research notes, and systems design by Orielsy Diaz."
>
  <div class="max-w-4xl">
    <!-- Header -->
    <header class="pb-8 border-b border-[var(--border-subtle)] mb-8">
      <div class="text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold mb-2">
        Technical Publication
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] mb-3">
        Research & Explorations
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed max-w-2xl">
        Long-form architectural thinking, empirical experiments, and system designs exploring frontend platforms, runtime inference, context engineering, and interactive tools.
      </p>

      <!-- Types / Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 mt-6 pt-4 border-t border-[var(--border-subtle)] text-xs font-mono" id="filter-container">
        <span class="text-[var(--text-muted)] text-[11px]">FILTER:</span>
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-2.5 py-1 rounded border border-[var(--accent)] bg-[var(--accent)] text-white text-[11px] font-medium transition-colors cursor-pointer"
        >
          All ({publishedResearch.length})
        </button>
        {allTypes.map((t) => {
          const count = publishedResearch.filter((r) => r.data.type === t).length;
          return (
            <button
              type="button"
              data-filter={t}
              class="filter-btn px-2.5 py-1 rounded bg-[var(--bg-secondary)] border border-[var(--border-subtle)] hover:border-[var(--border-strong)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-[11px] transition-colors cursor-pointer"
            >
              {t} ({count})
            </button>
          );
        })}
      </div>
    </header>

    <!-- Articles Grid / List -->
    <div class="space-y-4" id="articles-list">
      {sortedResearch.map((entry) => (
        <ArticleCard entry={entry} showTags={true} />
      ))}
    </div>

    <!-- Empty filtered state -->
    <div id="no-filtered-results" class="hidden p-12 text-center border border-[var(--border-subtle)] rounded-lg bg-[var(--bg-card)] mt-4">
      <p class="text-xs font-mono text-[var(--text-muted)]">No articles found matching this format.</p>
    </div>

    {sortedResearch.length === 0 && (
      <div class="p-12 text-center border border-[var(--border-subtle)] rounded-lg bg-[var(--bg-card)]">
        <p class="text-xs font-mono text-[var(--text-muted)]">No published research articles yet.</p>
      </div>
    )}

    {sortedUnpublishedResearch.length > 0 && (
      <section class="mt-12 pt-8 border-t border-[var(--border-subtle)]" aria-labelledby="research-in-progress-heading">
        <header class="mb-5">
          <h2 id="research-in-progress-heading" class="text-xl sm:text-2xl font-semibold tracking-tight text-[var(--text-primary)] mb-2">
            Research in Progress
          </h2>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed max-w-2xl">
            Early ideas and unfinished explorations are shown here for context. These entries are not published as finished research and do not link to detail pages.
          </p>
        </header>
        <div class="space-y-4" id="unpublished-articles-list">
          {sortedUnpublishedResearch.map((entry) => (
            <ArticleCard entry={entry} showTags={true} />
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const articles = document.querySelectorAll<HTMLElement>('#articles-list .article-item');
    const emptyState = document.getElementById('no-filtered-results');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update button active styles
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[var(--accent)]', 'text-white', 'border-[var(--accent)]', 'font-medium');
          b.classList.add('bg-[var(--bg-secondary)]', 'border-[var(--border-subtle)]', 'text-[var(--text-secondary)]');
        });

        btn.classList.add('bg-[var(--accent)]', 'text-white', 'border-[var(--accent)]', 'font-medium');
        btn.classList.remove('bg-[var(--bg-secondary)]', 'border-[var(--border-subtle)]', 'text-[var(--text-secondary)]');

        let visibleCount = 0;
        articles.forEach((article) => {
          const type = article.getAttribute('data-article-type');
          if (filter === 'all' || type === filter) {
            article.style.display = 'flex';
            visibleCount++;
          } else {
            article.style.display = 'none';
          }
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  </script>
</BaseLayout>
