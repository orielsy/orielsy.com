---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ContentPreviewNotice from '../../components/ContentPreviewNotice.astro';

export async function getStaticPaths() {
  const researchEntries = await getCollection('research');

  const sorted = [...researchEntries].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const publishedEntries = sorted.filter((entry) => entry.data.published);
  const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';
  const routableEntries = previewUnpublished ? sorted : publishedEntries;

  return routableEntries.map((entry) => {
    const publishedIndex = publishedEntries.findIndex(
      (publishedEntry) => publishedEntry.id === entry.id
    );

    return {
      params: { slug: entry.id },
      props: {
        entry,
        published: entry.data.published,
        prevEntry: publishedIndex >= 0 && publishedIndex < publishedEntries.length - 1
          ? publishedEntries[publishedIndex + 1]
          : undefined,
        nextEntry: publishedIndex > 0 ? publishedEntries[publishedIndex - 1] : undefined,
      },
    };
  });
}

const { entry, prevEntry, nextEntry, published } = Astro.props;
const { Content, headings } = await render(entry);
const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview' && !published;
const renderFullContent = published || previewUnpublished;
---

<ArticleLayout
  entry={entry}
  headings={headings}
  prevEntry={prevEntry}
  nextEntry={nextEntry}
  published={renderFullContent}
>
  {previewUnpublished && <ContentPreviewNotice kind="research" />}
  {renderFullContent && <Content />}
</ArticleLayout>
