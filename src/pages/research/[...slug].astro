---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ContentPreviewNotice from '../../components/ContentPreviewNotice.astro';

export async function getStaticPaths() {
  const researchEntries = await getCollection('research');

  const sorted = [...researchEntries].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const publishedEntries = sorted.filter((entry) => entry.data.published);
  const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview';
  const routableEntries = previewUnpublished ? sorted : publishedEntries;

  return routableEntries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      published: entry.data.published,
    },
  }));
}

const { entry, published } = Astro.props;
const { Content, headings } = await render(entry);
const previewUnpublished = import.meta.env.DEV && import.meta.env.MODE === 'content-preview' && !published;
const renderFullContent = published || previewUnpublished;
---

<ArticleLayout
  entry={entry}
  headings={headings}
  published={renderFullContent}
>
  {previewUnpublished && <ContentPreviewNotice kind="research" />}
  {renderFullContent && <Content />}
</ArticleLayout>
