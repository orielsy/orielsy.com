---
export interface Props {
  type?: 'note' | 'architecture' | 'warning' | 'idea';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const labels: Record<string, string> = {
  note: 'NOTE',
  architecture: 'ARCHITECTURE PATTERN',
  warning: 'CONSTRAINT / TRADEOFF',
  idea: 'EXPLORATION',
};
---

<aside class="not-prose my-8 border-l border-[var(--accent)] bg-[var(--bg-secondary)]/35 px-5 py-5 sm:px-6">
  <div class="font-editorial-mono text-[9px] uppercase tracking-[0.1em] text-[var(--accent)]">
    {title || labels[type] || labels.note}
  </div>
  <div class="mt-3 text-sm leading-7 text-[var(--text-secondary)]">
    <slot />
  </div>
</aside>
