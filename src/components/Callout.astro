---
export interface Props {
  type?: 'note' | 'architecture' | 'warning' | 'idea';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const styles: Record<string, { border: string; bg: string; titleColor: string; label: string }> = {
  note: {
    border: 'border-blue-500/30',
    bg: 'bg-blue-500/5',
    titleColor: 'text-blue-600 dark:text-blue-400',
    label: 'NOTE',
  },
  architecture: {
    border: 'border-emerald-500/30',
    bg: 'bg-emerald-500/5',
    titleColor: 'text-emerald-600 dark:text-emerald-400',
    label: 'ARCHITECTURE PATTERN',
  },
  warning: {
    border: 'border-amber-500/30',
    bg: 'bg-amber-500/5',
    titleColor: 'text-amber-600 dark:text-amber-400',
    label: 'CONSTRAINT / TRADEOFF',
  },
  idea: {
    border: 'border-purple-500/30',
    bg: 'bg-purple-500/5',
    titleColor: 'text-purple-600 dark:text-purple-400',
    label: 'EXPLORATION',
  },
};

const current = styles[type] || styles.note;
---

<aside class:list={['my-6 p-4 rounded-lg border text-sm leading-relaxed', current.border, current.bg]}>
  <div class="flex items-center gap-2 mb-2">
    <span class:list={['text-[11px] font-mono font-semibold tracking-wider', current.titleColor]}>
      {title || current.label}
    </span>
  </div>
  <div class="text-[var(--text-secondary)] text-xs sm:text-sm">
    <slot />
  </div>
</aside>
