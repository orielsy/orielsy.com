---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { data, id } = entry;
const isPublished = data.published;

const statusStyles: Record<string, string> = {
  'Active': 'text-emerald-600 dark:text-emerald-400 border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/50 dark:bg-emerald-950/30',
  'Prototype': 'text-amber-600 dark:text-amber-400 border-amber-200 dark:border-amber-900/60 bg-amber-50/50 dark:bg-amber-950/30',
  'Completed': 'text-blue-600 dark:text-blue-400 border-blue-200 dark:border-blue-900/60 bg-blue-50/50 dark:bg-blue-950/30',
  'In Progress': 'text-purple-600 dark:text-purple-400 border-purple-200 dark:border-purple-900/60 bg-purple-50/50 dark:bg-purple-950/30',
  'Archived': 'text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30',
};

const statusBadge = statusStyles[data.status] || 'text-[var(--text-secondary)] border-[var(--border-subtle)] bg-[var(--bg-secondary)]';
---

<article
  data-project-status={data.status}
  data-project-published={isPublished ? 'true' : 'false'}
  aria-disabled={!isPublished ? 'true' : undefined}
  class:list={[
    'project-item group relative flex flex-col p-6 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] transition-all duration-150',
    isPublished && 'hover:bg-[var(--bg-card-hover)] hover:border-[var(--border-strong)]',
    !isPublished && 'opacity-75',
  ]}
>
  <div class="flex items-center justify-between gap-2 mb-3">
    {!isPublished && (
      <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium border text-[var(--accent)] border-[var(--accent-border)] bg-[var(--accent-subtle)]">
        Project in Progress
      </span>
    )}
    {isPublished && (
    <span class:list={['px-2 py-0.5 rounded text-[11px] font-mono font-medium border', statusBadge]}>
      {data.status}
    </span>
    )}
    {data.role && (
      <span class="text-xs font-mono text-[var(--text-muted)]">{data.role}</span>
    )}
  </div>

  <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors mb-2">
    {isPublished ? (
      <a href={`/projects/${id}`} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {data.title}
      </a>
    ) : (
      <span>{data.title}</span>
    )}
  </h3>

  <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-5">
    {data.summary}
  </p>

  {data.architecture && (
    <div class="mb-5 p-3 rounded bg-[var(--bg-secondary)]/50 border border-[var(--border-subtle)] text-xs font-mono text-[var(--text-secondary)]">
      <div class="text-[10px] uppercase tracking-wider text-[var(--text-muted)] mb-1">Architecture</div>
      <div>{data.architecture}</div>
    </div>
  )}

  <div class="mt-auto pt-4 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 z-10">
    <div class="flex flex-wrap gap-1.5">
      {data.technologies.map((tech) => (
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[var(--bg-secondary)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-3 text-xs font-mono">
      {isPublished && data.github && (
        <a
          href={data.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1"
          aria-label={`View ${data.title} GitHub repository`}
        >
          <span>GitHub</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
      {isPublished && data.demo && (
        <a
          href={data.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--accent)] hover:underline flex items-center gap-1"
          aria-label={`View ${data.title} live demo`}
        >
          <span>Demo</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
