---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'projects'>;
  previewUnpublished?: boolean;
}

const { entry, previewUnpublished = false } = Astro.props;
const { data, id } = entry;
const isPublished = data.published;
const isConceptDraft = isPublished && data.draft;
const canOpen = isPublished || previewUnpublished;
---

<article
  data-project-status={data.status}
  data-project-published={isPublished ? 'true' : 'false'}
  data-project-draft={isConceptDraft ? 'true' : 'false'}
  class:list={[
    'project-item group relative border-t border-[var(--border-subtle)] py-5 transition-colors first:border-t-0 sm:py-6',
    canOpen && 'hover:bg-[var(--bg-secondary)]/30',
    !canOpen && 'cursor-pointer opacity-80 hover:bg-[var(--bg-secondary)]/30',
  ]}
>
  {!canOpen && (
    <button
      type="button"
      data-status-trigger
      aria-controls={`project-status-${id}`}
      aria-expanded="false"
      aria-label={`Show publication status for ${data.title}`}
      class="absolute inset-0 z-10 cursor-pointer border-0 bg-transparent p-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--accent)]"
    ></button>
  )}

  <div class="grid gap-4 sm:grid-cols-[132px_minmax(0,1fr)] sm:gap-8">
    <div class="font-editorial-mono text-[10px] uppercase leading-5 tracking-[0.08em] text-[var(--text-muted)]">
      <p class="text-[var(--accent)]">
        {!isPublished ? (previewUnpublished ? 'Local preview' : 'In progress') : isConceptDraft ? 'Concept draft' : data.status}
      </p>
      {data.role && <p class="mt-1">{data.role}</p>}
    </div>

    <div class="min-w-0">
      <div class="font-editorial-mono flex flex-wrap gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
        <span>{data.status}</span>
        {data.dateLabel && <span>{data.dateLabel}</span>}
      </div>

      <h3 class="font-display mt-2 text-lg font-semibold leading-snug tracking-[-0.025em] text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)] sm:text-xl">
        {canOpen ? (
          <a href={`/projects/${id}`} class="focus:outline-none">
            <span class="absolute inset-0" aria-hidden="true"></span>
            {data.title}
          </a>
        ) : (
          <span>{data.title}</span>
        )}
      </h3>

      <p class="mt-2 max-w-3xl text-sm leading-7 text-[var(--text-secondary)]">
        {data.summary}
      </p>

      {!canOpen && (
        <div
          id={`project-status-${id}`}
          hidden
          role="status"
          aria-live="polite"
          class="relative z-20 mt-4 border-l border-[var(--accent)] pl-4 text-xs leading-6 text-[var(--text-secondary)]"
        >
          This project is still being developed and its public case study is not available yet.
        </div>
      )}

      {data.architecture && (
        <div class="mt-4 border-l border-[var(--border-strong)] pl-4">
          <p class="font-editorial-mono text-[10px] uppercase tracking-[0.08em] text-[var(--text-muted)]">Architecture</p>
          <p class="mt-1 text-xs leading-6 text-[var(--text-secondary)]">{data.architecture}</p>
        </div>
      )}

      <div class="relative z-20 mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-4">
        <div class="flex flex-wrap gap-x-4 gap-y-2 font-editorial-mono text-[10px] uppercase tracking-[0.06em] text-[var(--text-muted)]">
          {data.technologies.map((tech) => <span>{tech}</span>)}
        </div>

        <div class="font-editorial-mono flex items-center gap-4 text-[10px] uppercase tracking-[0.07em]">
          {isPublished && data.github && (
            <a
              href={data.github}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="project_repo"
              data-analytics-project={id}
              class="text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
            >
              Repository ↗
            </a>
          )}
          {isPublished && data.demo && (
            <a
              href={data.demo}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="project_demo"
              data-analytics-project={id}
              class="text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
            >
              Demo ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</article>