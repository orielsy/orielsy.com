---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const records = [
  {
    label: 'Requirement',
    path: 'specs/003-content-publication-gating/spec.md',
    detail: 'Defines status-interactive unpublished cards and their acceptance criteria.',
  },
  {
    label: 'Decision',
    path: 'docs/decisions/004-content-publication-gating.md',
    detail: 'Preserves why inline status can exist without exposing unfinished body content.',
  },
  {
    label: 'Policy',
    path: 'docs/decisions/005-github-pages-seo-and-url-policy.md',
    detail: 'Carries the non-navigating status interaction into URL and indexing policy.',
  },
  {
    label: 'Guidance',
    path: 'README.md',
    detail: 'Documents the resulting public catalog behavior for maintainers.',
  },
];
---

<ResearchFigureFrame
  className="is-open"
  figureNumber="06"
  eyebrow="Author account + repository evidence"
  title="A changed requirement has several homes"
  caption="The article reports the move from non-clickable summaries to inline status interaction. The current branch shows the resulting behavior across these records; that does not establish that every file changed atomically or that documentation alone verifies runtime behavior."
>
  <div class="change-map">
    <section class="reported-change">
      <span class="label accent">Reported requirement change</span>
      <strong>Unpublished cards → inline status interaction</strong>
      <p>The behavior is larger than the component that renders the card.</p>
    </section>

    <section class="record-group">
      <span class="label">Current durable records</span>
      <div class="record-grid">
        {records.map((record) => (
          <div class="record">
            <span class="record-label">{record.label}</span>
            <code>{record.path}</code>
            <p>{record.detail}</p>
          </div>
        ))}
      </div>
      <p class="verification-note">Code reveals current behavior. These records preserve intended behavior and rationale; review and tests still have to compare them.</p>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  code {
    border: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    white-space: normal !important;
    overflow-wrap: anywhere;
  }

  .change-map {
    display: grid;
    gap: 1.5rem;
  }

  section {
    min-width: 0;
  }

  .label,
  .record-label,
  code {
    font-family: var(--font-mono-ui);
  }

  .label {
    display: block;
    color: var(--text-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .label.accent,
  .record-label {
    color: var(--accent);
  }

  .reported-change {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }

  .reported-change strong {
    display: block;
    margin-top: 0.55rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .reported-change p,
  .record p,
  .verification-note {
    margin: 0.55rem 0 0 !important;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .record-grid {
    display: grid;
    gap: 1px;
    margin-top: 0.8rem;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--border-subtle);
  }

  .record {
    min-width: 0;
    background: var(--bg-secondary);
    padding: 0.9rem;
  }

  .record-label {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  code {
    display: block;
    margin-top: 0.45rem;
    color: var(--text-primary) !important;
    font-size: 0.6875rem !important;
    line-height: 1.5;
  }

  .verification-note {
    margin-top: 0.9rem !important;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.8rem;
    color: var(--text-muted);
  }

  @media (min-width: 820px) {
    .change-map {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
      gap: 2.5rem;
      align-items: start;
    }

    .record-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
