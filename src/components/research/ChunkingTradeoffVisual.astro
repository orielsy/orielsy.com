---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const strategies = [
  { label: 'Shorter chunks', delay: 'Lower perceived delay', context: 'Less linguistic context', tradeoff: 'Faster updates, with more risk of unstable or incomplete phrases.' },
  { label: 'Longer chunks', delay: 'Higher perceived delay', context: 'More linguistic context', tradeoff: 'More context for decoding, but the transcript arrives later.' },
];
---

<ResearchFigureFrame
  className="chunk-tradeoff-figure"
  figureNumber="03"
  title="Chunk duration trades responsiveness for decoding context"
  status="Current default · 3 seconds"
  caption="The 3-second threshold is an implementation default when no client override is supplied, not evidence of an optimal latency/accuracy point."
>
  <div class="strategies">
    {strategies.map((strategy, index) => (
      <section>
        <span class="index">{String(index + 1).padStart(2, '0')}</span>
        <strong>{strategy.label}</strong>
        <dl><div><dt>Delay</dt><dd>{strategy.delay}</dd></div><div><dt>Context</dt><dd>{strategy.context}</dd></div></dl>
        <p>{strategy.tradeoff}</p>
      </section>
    ))}
  </div>
  <div class="implementation-note">
    <span>Current public backend</span>
    <strong>Fixed-duration chunk accumulator</strong>
    <p>Processed samples are cleared after transcription; the current source should not be described as an overlapping sliding window.</p>
  </div>
</ResearchFigureFrame>

<style>
  :global(.research-reading .research-prose figure.chunk-tradeoff-figure) { border-radius: 0 !important; }
  .strategies { display: grid; border-block: 1px solid var(--border-subtle); }
  .strategies section { position: relative; padding: 1rem 0 1rem 2.5rem; }
  .strategies section + section { border-top: 1px solid var(--border-subtle); }
  .index { position: absolute; top: 1rem; left: 0; color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; }
  .strategies strong { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; }
  dl { display: grid; gap: 0.5rem; margin: 0.8rem 0 0; }
  dl > div { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 0.6rem; border-top: 1px solid var(--border-subtle); padding-top: 0.5rem; }
  dt { color: var(--text-muted); font-family: var(--font-mono-ui); font-size: 0.6875rem; text-transform: uppercase; }
  dd, .strategies p { margin: 0; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.55; }
  .strategies p { margin-top: 0.75rem !important; }
  .implementation-note { display: grid; gap: 0.35rem; border-top: 1px solid var(--border-strong); margin-top: 1rem; padding-top: 1rem; }
  .implementation-note > span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; text-transform: uppercase; }
  .implementation-note strong { color: var(--text-primary); font-size: 0.875rem; }
  .implementation-note p { margin: 0; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  @media (min-width: 720px) { .strategies { grid-template-columns: repeat(2,minmax(0,1fr)); } .strategies section { padding: 1rem; } .strategies section:first-child { padding-left: 2.5rem; } .strategies section + section { border-top: 0; border-left: 1px solid var(--border-subtle); } .strategies section + section .index { left: 1rem; } }
</style>
