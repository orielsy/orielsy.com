---
import { FlaskConical } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  className="chunk-tradeoff-figure"
  figureNumber="02"
  title="Chunk duration changes the trade-off"
  status="Current default + proposed experiment"
  caption="Three seconds is the public backend default when no client override is supplied. The comparison describes a qualitative trade-off; it does not identify an optimum."
>
  <div class="tradeoff-grid">
    <section>
      <p class="figure-label">Shorter chunks</p>
      <h4 class="figure-node">Earlier updates</h4>
      <p class="figure-copy">Less linguistic context; greater risk of unstable or incomplete phrases.</p>
    </section>
    <section class="longer">
      <p class="figure-label figure-accent">Longer chunks</p>
      <h4 class="figure-node">Later updates</h4>
      <p class="figure-copy">More decoding context; transcript arrives later.</p>
    </section>
  </div>

  <div class="current-implementation">
    <p class="figure-label">Current implementation</p>
    <p class="figure-copy">Fixed-duration accumulator · default 3 seconds · processed samples cleared after transcription · not an overlapping sliding window</p>
  </div>

  <div class="next-experiment">
    <FlaskConical size={16} strokeWidth={1.75} aria-hidden="true" />
    <p class="figure-copy"><strong>Next experiment:</strong> compare chunk-duration strategies rather than treating the default as validated.</p>
  </div>
</ResearchFigureFrame>

<style>
  .chunk-tradeoff-figure :global(p),
  .chunk-tradeoff-figure :global(h4) {
    margin: 0;
  }

  .tradeoff-grid {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .tradeoff-grid section {
    min-width: 0;
    background: var(--research-figure-surface-base, var(--bg-primary));
    padding: 1.25rem;
  }

  .tradeoff-grid section.longer {
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
  }

  .tradeoff-grid h4 {
    margin-top: 0.75rem !important;
  }

  .tradeoff-grid .figure-copy {
    margin-top: 0.75rem !important;
  }

  .current-implementation {
    display: grid;
    gap: 0.75rem;
    margin-top: 1px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .next-experiment {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1rem;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 1rem;
  }

  .next-experiment :global(svg) {
    margin-top: 0.2rem;
    flex: 0 0 auto;
    color: var(--accent);
  }

  .next-experiment strong {
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .tradeoff-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .current-implementation {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
