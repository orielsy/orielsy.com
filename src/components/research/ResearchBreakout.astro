---
export interface Props {
  maxWidth?: string;
  mode?: 'wide' | 'publication';
}

const { maxWidth, mode = 'wide' } = Astro.props;
---

<div
  class="research-breakout not-prose"
  data-breakout-mode={mode}
  style={maxWidth ? `--research-breakout-max: ${maxWidth};` : undefined}
>
  <slot />
</div>

<style>
  .research-breakout {
    --research-breakout-max: 58rem;
    position: relative;
    left: 50%;
    box-sizing: border-box;
    width: min(var(--research-breakout-max), calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    margin-block: 2.5rem;
    transform: translateX(-50%);
  }

  .research-breakout[data-breakout-mode='publication'] {
    --research-breakout-max: 80rem;
  }

  @media (min-width: 640px) {
    .research-breakout {
      width: min(var(--research-breakout-max), calc(100vw - 3rem));
      max-width: calc(100vw - 3rem);
    }
  }

  /*
   * The article switches to its 12-column desktop layout at 1024px. That
   * breakpoint is still too tight to safely expand figures beyond the reading
   * column, so keep breakouts contained until the viewport has more room.
   */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .research-breakout[data-breakout-mode='wide'],
    .research-breakout[data-breakout-mode='publication'] {
      left: auto;
      width: 100%;
      max-width: 100%;
      margin-left: 0;
      transform: none;
    }
  }

  /*
   * Once the viewport is comfortably wider, allow figures to borrow space
   * from the left-side article gutter while keeping their right edge aligned
   * with the prose column.
   */
  @media (min-width: 1280px) {
    .research-breakout[data-breakout-mode='wide'] {
      left: auto;
      width: min(var(--research-breakout-max), 125%);
      max-width: 125%;
      margin-left: calc(100% - min(var(--research-breakout-max), 125%));
      transform: none;
    }

    .research-breakout[data-breakout-mode='publication'] {
      left: auto;
      width: min(var(--research-breakout-max), 150%);
      max-width: 150%;
      margin-left: -50%;
      transform: none;
    }
  }
</style>
