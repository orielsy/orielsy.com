---
export interface Props {
  maxWidth?: string;
  mode?: 'wide' | 'publication';
}

const { maxWidth, mode = 'wide' } = Astro.props;
---

<div
  class="research-breakout not-prose"
  data-breakout-mode={mode}
  style={maxWidth ? `--research-breakout-max: ${maxWidth};` : undefined}
>
  <slot />
</div>

<style>
  .research-breakout {
    --research-breakout-max: 58rem;
    position: relative;
    left: 50%;
    box-sizing: border-box;
    width: min(var(--research-breakout-max), calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    transform: translateX(-50%);
  }

  .research-breakout[data-breakout-mode='publication'] {
    --research-breakout-max: 80rem;
  }

  @media (min-width: 640px) {
    .research-breakout {
      width: min(var(--research-breakout-max), calc(100vw - 3rem));
      max-width: calc(100vw - 3rem);
    }
  }

  /*
   * On the 12-column article layout the reading region occupies eight columns.
   * A publication plate therefore reaches the full twelve-column canvas at
   * 150% of that region, shifted left by half of the eight-column width.
   * This keeps the breakout tied to the editorial grid without introducing a
   * size-containment ancestor around the sticky contents rail.
   */
  @media (min-width: 1024px) {
    .research-breakout[data-breakout-mode='publication'] {
      left: auto;
      width: min(var(--research-breakout-max), 150%);
      max-width: 150%;
      margin-left: -50%;
      transform: none;
    }
  }
</style>