---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const concerns = [
  {
    label: 'Transport path',
    owner: 'Async service path',
    detail: 'WebSocket handling and buffering remain on the async service path while transcription work is moved elsewhere.',
  },
  {
    label: 'Blocking inference',
    owner: 'Worker thread',
    detail: 'asyncio.to_thread(model.transcribe) moves Whisper inference away from the async event loop.',
    accent: true,
  },
  {
    label: 'Render scheduling',
    owner: 'Electron / Vue renderer',
    detail: 'nextTick() and requestAnimationFrame() coordinate caption layout and visual transitions.',
  },
];
---

<ResearchFigureFrame
  eyebrow="Execution paths"
  title="Blocking inference is isolated from transport handling and UI rendering."
  caption="The source shows separate execution concerns for transport, inference, and rendering. That separation is architectural; it is not a measured latency, throughput, or visual-smoothness result."
>
  <div class="concerns" aria-label="runtime execution boundaries">
    {concerns.map((concern) => (
      <section class:list={['concern', concern.accent && 'is-accent']}>
        <span class="owner">{concern.owner}</span>
        <h4>{concern.label}</h4>
        <p>{concern.detail}</p>
      </section>
    ))}
  </div>
</ResearchFigureFrame>

<style>
  .concerns {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .concern {
    min-width: 0;
    margin: 0;
    background: var(--bg-card);
    padding: 1rem;
  }

  .concern.is-accent {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .owner {
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .is-accent .owner {
    color: var(--accent);
  }

  h4 {
    margin: 0.45rem 0 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--text-secondary);
    font-size: 0.6875rem;
    line-height: 1.55;
  }

  @media (min-width: 760px) {
    .concerns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
