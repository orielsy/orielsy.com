---
const stages = [
  { label: 'Client capture', detail: 'Microphone audio is captured, downsampled, and converted before transport.' },
  { label: 'WebSocket + buffering', detail: 'The backend accumulates fixed-duration audio chunks.' },
  { label: 'Thread-offloaded inference', detail: 'asyncio.to_thread() runs model.transcribe() away from the async event loop.' },
  { label: 'Client filtering', detail: 'Whisper metadata gates which segments enter the caption queue.' },
  { label: 'Electron / Vue rendering', detail: 'Caption positions and transitions remain in the desktop rendering layer.' },
];
---

<figure class="async-pipeline not-prose">
  <header>
    <p class="eyebrow">Separation of responsibilities</p>
    <h3>Blocking inference is isolated from transport responsiveness and UI rendering.</h3>
  </header>

  <ol class="stages" aria-label="speechBubbles runtime responsibility flow">
    {stages.map((stage, index) => (
      <li>
        <span class="index">{String(index + 1).padStart(2, '0')}</span>
        <strong>{stage.label}</strong>
        <p>{stage.detail}</p>
      </li>
    ))}
  </ol>

  <div class="responsibility-band">
    <span>Client</span>
    <span>Backend</span>
    <span>Renderer</span>
  </div>

  <figcaption>Capture/downsampling, model inference, transcript filtering, and caption animation remain distinct responsibilities in the current implementation.</figcaption>
</figure>

<style>
  .async-pipeline {
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.7rem;
    background: var(--bg-card);
  }

  .async-pipeline :global(p),
  .async-pipeline :global(h3),
  .async-pipeline :global(ol),
  .async-pipeline :global(li) { margin: 0; }

  .async-pipeline :global(ol) { padding: 0; list-style: none; }

  header {
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.15rem 1.25rem;
  }

  .eyebrow,
  .index,
  .responsibility-band {
    font-family: var(--font-mono-ui);
    text-transform: uppercase;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.13em;
  }

  h3 {
    margin-top: 0.45rem !important;
    max-width: 46rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.035em;
  }

  .stages {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .stages li {
    position: relative;
    min-width: 0;
    background: var(--bg-card);
    padding: 2.55rem 0.9rem 1rem;
  }

  .stages li:nth-child(3) {
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-card));
  }

  .index {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    color: var(--accent);
    font-size: 0.47rem;
    letter-spacing: 0.08em;
  }

  .stages strong {
    display: block;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .stages p {
    margin-top: 0.45rem !important;
    color: var(--text-secondary);
    font-size: 0.62rem;
    line-height: 1.5;
  }

  .responsibility-band {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    color: var(--text-muted);
    font-size: 0.46rem;
    letter-spacing: 0.1em;
  }

  .responsibility-band span {
    padding: 0.65rem 0.9rem;
    border-left: 1px solid var(--border-subtle);
  }

  .responsibility-band span:first-child { border-left: 0; }

  figcaption {
    border-top: 1px solid var(--border-subtle);
    padding: 0.8rem 1rem;
    color: var(--text-muted);
    font-size: 0.62rem;
    line-height: 1.55;
  }

  @media (min-width: 840px) {
    .stages { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  @media (max-width: 839px) {
    .responsibility-band { display: none; }
  }
</style>