---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const concerns = [
  { label: 'Transport responsiveness', owner: 'Async service path', detail: 'WebSocket handling and buffering should remain responsive while transcription work runs elsewhere.' },
  { label: 'Blocking inference', owner: 'Worker thread', detail: 'asyncio.to_thread(model.transcribe) moves Whisper inference away from the async event loop.', accent: true },
  { label: 'Render timing', owner: 'Electron / Vue renderer', detail: 'nextTick() and requestAnimationFrame() coordinate caption layout and visual transitions.' },
];
---

<ResearchFigureFrame
  className="async-speech-figure"
  figureNumber="05"
  title="Transport responsiveness, inference, and rendering are separate problems"
  caption="Moving blocking model work off the async event loop does not optimize rendering by itself. The current prototype still has geometry-read behavior that deserves a later batching pass."
>
  <div class="concerns" aria-label="runtime responsibility boundaries">
    {concerns.map((concern) => (
      <section class:list={['concern', concern.accent && 'is-accent']}>
        <span class="owner">{concern.owner}</span>
        <h4>{concern.label}</h4>
        <p>{concern.detail}</p>
      </section>
    ))}
  </div>
</ResearchFigureFrame>

<style>
  :global(.research-reading .research-prose figure.async-speech-figure) { border-radius: 0 !important; }
  .concerns { display: grid; border-block: 1px solid var(--border-subtle); }
  .concern { min-width: 0; margin: 0; padding: 1rem 0; }
  .concern + .concern { border-top: 1px solid var(--border-subtle); }
  .concern.is-accent { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .owner { color: var(--text-muted); font-family: var(--font-mono-ui); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; line-height: 1.45; text-transform: uppercase; }
  .is-accent .owner { color: var(--accent); }
  h4 { margin: 0.45rem 0 0; color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.4; }
  p { margin: 0.5rem 0 0; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  @media (min-width: 760px) { .concerns { grid-template-columns: repeat(3,minmax(0,1fr)); } .concern { padding: 1rem; } .concern:first-child { padding-left: 0; } .concern + .concern { border-top: 0; border-left: 1px solid var(--border-subtle); } .concern.is-accent { border-left: 2px solid var(--accent); } }
</style>
