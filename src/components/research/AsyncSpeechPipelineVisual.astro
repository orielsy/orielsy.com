---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const lanes = [
  { title: 'Transport', owner: 'Async service path', detail: 'WebSocket handling + buffering' },
  { title: 'Inference', owner: 'Worker thread', detail: 'asyncio.to_thread(model.transcribe)', accent: true },
  { title: 'Rendering', owner: 'Electron / Vue', detail: 'nextTick, geometry reads, requestAnimationFrame' },
];
---

<ResearchFigureFrame
  className="async-speech-figure"
  figureNumber="04"
  title="Three execution paths"
  status="Source behavior · bounded interpretation"
  caption="Moving inference off the async event loop separates blocking model work from transport handling. The renderer uses its own scheduling path; the source still shows forced-layout risk worth testing."
>
  <div class="execution-grid" aria-label="speechBubbles execution paths">
    {lanes.map((lane) => (
      <section class:list={[lane.accent && 'is-accent']}>
        <p class:list={['figure-label', lane.accent && 'figure-accent']}>{lane.owner}</p>
        <h4 class="figure-node">{lane.title}</h4>
        <p class="figure-copy">{lane.detail}</p>
      </section>
    ))}
  </div>
</ResearchFigureFrame>

<style>
  .async-speech-figure :global(p),
  .async-speech-figure :global(h4) {
    margin: 0;
  }

  .execution-grid {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .execution-grid section {
    min-width: 0;
    background: var(--research-figure-surface-base, var(--bg-primary));
    padding: 1.25rem;
  }

  .execution-grid section.is-accent {
    border-left: 2px solid var(--accent);
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
  }

  .execution-grid h4 {
    margin-top: 0.75rem !important;
  }

  .execution-grid .figure-copy {
    margin-top: 0.75rem !important;
  }

  @media (min-width: 760px) {
    .execution-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .execution-grid section.is-accent {
      border-left: 2px solid var(--accent);
    }
  }
</style>
