---
import { ArrowDown, ArrowRight } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  className="project-memory-incident"
  figureNumber="01"
  title="The claim and its two durable addresses"
  status="Observed account + repository evidence"
  caption="The correction now has two durable addresses at different scopes. That gives later work two places to catch a recurrence; it does not stop one from happening."
>
  <div class="incident-grid">
    <section class="observed">
      <p class="label figure-meta">01 · Author’s observed account</p>
      <blockquote class="figure-node-feature incident-claim">“15+ years of experience designing scalable web architectures, <mark>design systems</mark>, and enterprise platforms.”</blockquote>
      <p class="figure-copy">The article reports that this unsupported wording appeared and was corrected.</p>
    </section>

    <div class="correction">
      <ArrowDown class="arrow-mobile" size={16} strokeWidth={1.6} aria-hidden="true" />
      <span class="label figure-meta">02 · Reported corrective action</span>
      <strong class="figure-node">Output corrected</strong>
      <ArrowRight class="arrow-desktop" size={16} strokeWidth={1.6} aria-hidden="true" />
    </div>

    <section class="durable">
      <p class="label figure-meta">03 · What the branch directly shows</p>
      <p class="scope-note figure-copy">The constraint was recorded at project and product scope.</p>
      <div class="guardrails">
        <div><code class="figure-meta figure-accent">.specify/memory/constitution.md</code><p class="figure-copy">Do not describe the experience as “design systems” unless explicitly established.</p></div>
        <div><code class="figure-meta figure-accent">specs/001-site-foundation/spec.md</code><p class="figure-copy">Use grounded positioning; do not claim formal design-system ownership.</p></div>
      </div>
      <p class="boundary figure-meta">The branch corroborates the durable result—not necessarily every step or the complete chronology.</p>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .project-memory-incident :global(p), .project-memory-incident :global(blockquote) { margin: 0; }
  .incident-grid { display: grid; gap: 1.5rem; }
  section { min-width: 0; }
  .observed { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .label { text-transform: uppercase; }
  blockquote { margin-top: 0.8rem !important; border: 0 !important; padding: 0 !important; color: var(--text-primary); font-family: var(--font-display); font-style: normal; line-height: 1.6; }
  .incident-claim { font-size: 1.25rem !important; }
  mark { background: color-mix(in srgb, var(--accent) 18%, transparent); color: inherit; padding: 0.04em 0.12em; }
  .observed > p:last-child, .scope-note { margin-top: 0.8rem !important; }
  .correction { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.7rem; border-block: 1px dashed var(--border-subtle); padding: 1rem; text-align: center; }
  .correction strong { color: var(--text-primary); font-family: var(--font-display); font-weight: 600; line-height: 1.4; }
  .arrow-desktop { display: none; color: var(--accent); }
  .arrow-mobile { color: var(--accent); }
  .guardrails { display: grid; gap: 1px; margin-top: 0.9rem; border: 1px solid var(--border-subtle); background: var(--border-subtle); }
  .guardrails > div { min-width: 0; background: var(--research-figure-surface-base); padding: 0.8rem; }
  code { display: block; border: 0 !important; background: transparent !important; padding: 0 !important; white-space: normal !important; overflow-wrap: anywhere; }
  .guardrails p { margin-top: 0.55rem !important; }
  .boundary { margin-top: 0.9rem !important; border-top: 1px dashed var(--border-subtle); padding-top: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; }

  @media (min-width: 640px) {
    .incident-claim { font-size: 1.5rem !important; }
  }

  @media (min-width: 760px) {
    .incident-grid { grid-template-columns: minmax(0, 1fr) 9rem minmax(0, 1.25fr); align-items: stretch; gap: 0; }
    .correction { border-block: 0; border-inline: 1px dashed var(--border-subtle); padding-inline: 1rem; }
    .arrow-mobile { display: none; }
    .arrow-desktop { display: block; }
    .durable { padding-left: 1.5rem; }
    .observed { margin-right: 1.5rem; }
    .guardrails { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
