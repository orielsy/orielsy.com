---
import {
  ArrowRight,
  BookOpen,
  Check,
  CircleAlert,
  FileText,
  LayoutPanelTop,
  RotateCcw,
  Search,
} from '@lucide/astro';

const conventionalSteps = [
  { label: 'Work in product', detail: 'Active task', icon: LayoutPanelTop, outside: false },
  { label: 'Hit a blocker', detail: 'Meaning is unclear', icon: CircleAlert, outside: false },
  { label: 'Leave product', detail: 'Context breaks', icon: ArrowRight, outside: true },
  { label: 'Search documents', detail: 'Find and interpret', icon: Search, outside: true },
  { label: 'Return to product', detail: 'Resume the task', icon: RotateCcw, outside: false },
];
---

<figure class="adaptive-documentation-visual not-prose" aria-labelledby="adaptive-documentation-visual-title">
  <header>
    <p class="visual-kicker">Documentation-driven adaptive UX</p>
    <h2 id="adaptive-documentation-visual-title">Move the knowledge, not the user.</h2>
    <p class="visual-subtitle">The same authored product knowledge can create two very different paths through an enterprise task.</p>
  </header>

  <div class="tracks">
    <section class="track conventional" aria-labelledby="conventional-track-title">
      <div class="track-heading">
        <div class="track-title">
          <span>01</span>
          <h3 id="conventional-track-title">Conventional</h3>
        </div>
        <span class="track-badge">External detour</span>
      </div>
      <p class="track-description">The task crosses the product boundary before it can continue.</p>

      <div class="timeline">
        <div class="timeline-line" aria-hidden="true"></div>
        <ol>
          {conventionalSteps.map(({ label, detail, icon: Icon, outside }) => (
            <li>
              <span class:list={['step-icon', outside && 'is-outside']}>
                <Icon size={16} strokeWidth={1.6} aria-hidden="true" />
              </span>
              <div class:list={['step-card', outside && 'is-outside']}>
                <div class="step-heading">
                  <strong>{label}</strong>
                  {outside && <span>Outside app</span>}
                </div>
                <p>{detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="track adaptive" aria-labelledby="adaptive-track-title">
      <div class="track-heading">
        <div class="track-title accent-title">
          <span>02</span>
          <h3 id="adaptive-track-title">Adaptive</h3>
        </div>
        <span class="track-badge accent-badge">In-product path</span>
      </div>
      <p class="track-description">The task stays in place while applicable knowledge reaches the interface.</p>

      <div class="application-panel">
        <div class="application-heading">
          <div>
            <LayoutPanelTop size={16} strokeWidth={1.6} aria-hidden="true" />
            <span>Application</span>
          </div>
          <span class="stay-here"><i aria-hidden="true"></i>User stays here</span>
        </div>

        <div class="application-flow">
          <div class="source-stack">
            <div class="system-node">
              <LayoutPanelTop size={16} strokeWidth={1.6} aria-hidden="true" />
              <strong>Current state</strong>
              <p>Active task + product state</p>
            </div>
            <div class="plus-divider" aria-hidden="true"><span></span><b>+</b><span></span></div>
            <div class="system-node">
              <BookOpen size={16} strokeWidth={1.6} aria-hidden="true" />
              <strong>Authored knowledge</strong>
              <p>Docs · release notes · guidance</p>
            </div>
          </div>

          <ArrowRight class="flow-arrow" size={18} strokeWidth={1.6} aria-hidden="true" />

          <div class="system-node context-node">
            <FileText size={16} strokeWidth={1.6} aria-hidden="true" />
            <strong>Context layer</strong>
            <p>Applicability + response rules</p>
          </div>

          <ArrowRight class="flow-arrow" size={18} strokeWidth={1.6} aria-hidden="true" />

          <div class="system-node guidance-node">
            <Check size={16} strokeWidth={1.8} aria-hidden="true" />
            <strong>Timely guidance</strong>
            <p>Relevant explanation + action</p>
          </div>
        </div>
      </div>

      <div class="guidance-note">
        <Check size={16} strokeWidth={2} aria-hidden="true" />
        <p>Guidance appears only when the authored rules and current state support it. The system does not need to guess.</p>
      </div>
    </section>
  </div>

  <figcaption>
    <span>One task · the difference is where product knowledge meets the workflow.</span>
    <span>Deterministic by design</span>
  </figcaption>
</figure>

<style>
  .adaptive-documentation-visual {
    overflow: hidden;
    margin: 2.75rem 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.2rem;
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .adaptive-documentation-visual :global(p),
  .adaptive-documentation-visual :global(h2),
  .adaptive-documentation-visual :global(h3),
  .adaptive-documentation-visual :global(ol),
  .adaptive-documentation-visual :global(li),
  .adaptive-documentation-visual :global(strong) {
    margin: 0;
  }

  .adaptive-documentation-visual :global(ol) {
    padding: 0;
    list-style: none;
  }

  header {
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.5rem 1.25rem;
  }

  .visual-kicker,
  .track-title > span,
  .track-badge,
  .application-heading span,
  .step-heading > span,
  figcaption > span:last-child {
    font-family: var(--font-mono-ui);
    text-transform: uppercase;
  }

  .visual-kicker {
    color: var(--accent);
    font-size: 0.625rem !important;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  header h2 {
    margin-top: 0.55rem !important;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .visual-subtitle {
    max-width: 44rem;
    margin-top: 0.65rem !important;
    color: var(--text-secondary);
    font-size: 0.875rem !important;
    line-height: 1.6 !important;
  }

  .tracks {
    display: grid;
  }

  .track {
    min-width: 0;
    padding: 1.5rem 1.25rem;
  }

  .conventional {
    border-bottom: 1px solid var(--border-subtle);
  }

  .track-heading,
  .track-title,
  .step-heading,
  .application-heading,
  .application-heading > div,
  .stay-here,
  .guidance-note {
    display: flex;
    align-items: center;
  }

  .track-heading,
  .step-heading,
  .application-heading {
    justify-content: space-between;
  }

  .track-heading {
    gap: 1rem;
  }

  .track-title {
    gap: 0.75rem;
  }

  .track-title > span {
    color: var(--text-muted);
    font-size: 0.625rem;
  }

  .accent-title > span {
    color: var(--accent);
  }

  .track-title h3 {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .track-badge {
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: var(--text-muted);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
  }

  .accent-badge {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border-subtle));
    color: var(--accent);
  }

  .track-description {
    margin-top: 0.75rem !important;
    color: var(--text-secondary);
    font-size: 0.75rem !important;
    line-height: 1.55 !important;
  }

  .timeline {
    position: relative;
    margin-top: 1.75rem;
  }

  .timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1.05rem;
    border-left: 1px dashed var(--border-strong);
  }

  .timeline ol {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .step-icon {
    position: relative;
    z-index: 1;
    display: flex;
    width: 2.2rem;
    height: 2.2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text-muted);
  }

  .step-icon.is-outside {
    border-color: var(--border-strong);
    color: var(--text-secondary);
  }

  .step-card {
    border: 1px solid var(--border-subtle);
    border-radius: 0.2rem;
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
    padding: 0.85rem 1rem;
  }

  .step-card.is-outside {
    border-style: dashed;
    background: color-mix(in srgb, var(--research-figure-surface-emphasis, var(--bg-card-hover)) 55%, var(--bg-card));
  }

  .step-heading {
    gap: 0.75rem;
  }

  .step-heading strong {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .step-heading > span {
    color: var(--text-muted);
    font-size: 0.5625rem;
    letter-spacing: 0.09em;
  }

  .step-card > p {
    margin-top: 0.2rem !important;
    color: var(--text-muted);
    font-size: 0.6875rem !important;
  }

  .application-panel {
    margin-top: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--border-subtle));
    border-radius: 0.2rem;
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
    padding: 1rem;
  }

  .application-heading {
    gap: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .application-heading > div {
    gap: 0.5rem;
    color: var(--accent);
  }

  .application-heading > div span {
    color: var(--text-primary);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .stay-here {
    gap: 0.4rem;
    color: var(--accent);
    font-size: 0.625rem;
  }

  .stay-here i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--accent);
  }

  .application-flow {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  .source-stack {
    display: grid;
    gap: 0.5rem;
  }

  .system-node {
    min-width: 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.2rem;
    background: var(--research-figure-surface-base, var(--bg-primary));
    padding: 0.8rem;
  }

  .system-node :global(svg) {
    color: var(--text-muted);
  }

  .system-node strong {
    display: block;
    margin-top: 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .system-node p {
    margin-top: 0.2rem !important;
    color: var(--text-muted);
    font-size: 0.625rem !important;
    line-height: 1.5 !important;
  }

  .guidance-node {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border-subtle));
    background: color-mix(in srgb, var(--accent) 7%, var(--research-figure-surface-emphasis, var(--bg-card-hover)));
  }

  .guidance-node :global(svg) {
    color: var(--accent);
  }

  .plus-divider {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 0.25rem;
    color: var(--text-muted);
  }

  .plus-divider span {
    height: 1px;
    flex: 1;
    background: var(--border-subtle);
  }

  .plus-divider b {
    font-size: 0.6875rem;
    font-weight: 400;
  }

  .flow-arrow {
    justify-self: center;
    color: var(--text-muted);
    transform: rotate(90deg);
  }

  .guidance-note {
    gap: 0.75rem;
    margin-top: 0.9rem;
    border-left: 2px solid var(--accent);
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
    padding: 0.75rem 1rem;
  }

  .guidance-note :global(svg) {
    flex: none;
    color: var(--accent);
  }

  .guidance-note p {
    color: var(--text-secondary);
    font-size: 0.75rem !important;
    line-height: 1.55 !important;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--border-subtle);
    padding: 0.9rem 1.25rem;
    color: var(--text-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  figcaption > span:last-child {
    letter-spacing: 0.1em;
  }

  @media (min-width: 760px) {
    header,
    .track {
      padding-inline: 1.5rem;
    }

    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .conventional {
      border-right: 1px solid var(--border-subtle);
      border-bottom: 0;
    }

    .application-flow {
      grid-template-columns: 1.1fr auto 1fr auto 1.1fr;
      align-items: center;
    }

    .flow-arrow {
      transform: none;
    }

    figcaption {
      padding-inline: 1.5rem;
    }
  }
</style>
