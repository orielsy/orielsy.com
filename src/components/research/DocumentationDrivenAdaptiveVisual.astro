---
import {
  ArrowRight,
  CircleAlert,
  LayoutPanelTop,
  RotateCcw,
  Search,
} from '@lucide/astro';

const conventionalSteps = [
  { label: 'Work in product', detail: 'Active task', icon: LayoutPanelTop, outside: false },
  { label: 'Hit a blocker', detail: 'Meaning is unclear', icon: CircleAlert, outside: false },
  { label: 'Leave product', detail: 'Context breaks', icon: ArrowRight, outside: true },
  { label: 'Search documents', detail: 'Find and interpret', icon: Search, outside: true },
  { label: 'Return to product', detail: 'Resume the task', icon: RotateCcw, outside: false },
];
---

<figure class="adaptive-documentation-visual not-prose" aria-labelledby="adaptive-documentation-visual-title">
  <header class="visual-header">
    <p class="eyebrow figure-label figure-accent">Conceptual comparison · not a measured outcome</p>
    <h2 id="adaptive-documentation-visual-title">Two paths through the same task</h2>
  </header>

  <div class="tracks">
    <section class="track conventional" aria-labelledby="conventional-track-title">
      <div class="track-heading">
        <div class="track-title">
          <span class="figure-meta">01</span>
          <h3 id="conventional-track-title">Conventional</h3>
        </div>
        <span class="track-badge">External detour</span>
      </div>
      <p class="track-description figure-support">The task crosses the product boundary before it can continue.</p>

      <div class="timeline">
        <div class="timeline-line" aria-hidden="true"></div>
        <ol>
          {conventionalSteps.map(({ label, detail, icon: Icon, outside }) => (
            <li>
              <span class:list={['step-icon', outside && 'is-outside']}>
                <Icon size={14} strokeWidth={1.6} aria-hidden="true" />
              </span>
              <div class="step-copy">
                <div class="step-heading">
                  <strong>{label}</strong>
                  {outside && <span class="figure-label">Outside app</span>}
                </div>
                <p class="figure-local">{detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="track adaptive" aria-labelledby="adaptive-track-title">
      <div class="track-heading">
        <div class="track-title accent-title">
          <span class="figure-meta">02</span>
          <h3 id="adaptive-track-title">Adaptive</h3>
        </div>
        <span class="track-badge accent-badge">In-product path</span>
      </div>
      <p class="track-description figure-support">The task stays in place while applicable knowledge reaches the interface.</p>

      <div class="stay-panel">
        <LayoutPanelTop size={14} strokeWidth={1.6} aria-hidden="true" />
        <p class="figure-support"><strong>User stays in the product</strong> — authored guidance meets them at the field.</p>
      </div>

      <div class="decision-grid">
        <section>
          <p class="figure-label">Decision one</p>
          <h4>Applicability</h4>
          <p class="figure-local">Does this fragment apply to the current version, user, and field state?</p>
        </section>
        <section>
          <p class="figure-label">Decision two</p>
          <h4>Response policy</h4>
          <p class="figure-local">If it applies, what may the interface do — explain, guide, or offer?</p>
        </section>
      </div>

      <p class="figure-label separation-label">Two decisions · kept separate</p>

      <div class="authority-note">
        <p class="figure-local">Guidance may explain or guide. An offer appears only when exactly one valid option exists — and the user still accepts it. The note cannot choose a value.</p>
      </div>
    </section>
  </div>

  <figcaption>
    One task; the difference is where product knowledge meets the workflow. Conceptual motivation — evidence of outcomes lives with the Phase 1 experiment and scenario figures.
  </figcaption>
</figure>

<style>
  .adaptive-documentation-visual {
    overflow: hidden;
    margin: 2.5rem 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.2rem;
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .adaptive-documentation-visual :global(p),
  .adaptive-documentation-visual :global(h2),
  .adaptive-documentation-visual :global(h3),
  .adaptive-documentation-visual :global(h4),
  .adaptive-documentation-visual :global(ol),
  .adaptive-documentation-visual :global(li),
  .adaptive-documentation-visual :global(strong) {
    margin: 0;
  }

  .adaptive-documentation-visual :global(ol) {
    padding: 0;
    list-style: none;
  }

  .visual-header {
    border-bottom: 1px solid var(--border-subtle);
    padding: 1rem 1.25rem;
  }

  .visual-header .eyebrow {
    color: var(--accent);
    letter-spacing: 0.16em !important;
  }

  .accent-title .figure-meta {
    color: var(--accent) !important;
  }

  .visual-header h2 {
    position: static;
    margin: 0.375rem 0 0 !important;
    border: 0 !important;
    padding: 0 !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.02em;
    counter-increment: none !important;
  }

  .visual-header h2::before {
    content: none !important;
    display: none !important;
  }

  .tracks {
    display: grid;
  }

  .track {
    min-width: 0;
    padding: 1.25rem;
  }

  .conventional {
    border-bottom: 1px solid var(--border-subtle);
  }

  .track-heading,
  .track-title,
  .step-heading,
  .stay-panel {
    display: flex;
    align-items: center;
  }

  .track-heading {
    justify-content: space-between;
    gap: 1rem;
  }

  .track-title {
    gap: 0.75rem;
  }

  .track-title h3 {
    position: static;
    margin: 0 !important;
    padding: 0 !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--research-figure-copy, 0.875rem);
    font-weight: 600;
    line-height: 1.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .track-title h3::before {
    content: none !important;
    display: none !important;
  }

  .track-badge {
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.5625rem !important;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.5 !important;
    text-transform: uppercase;
  }

  .accent-badge {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border-subtle));
    color: var(--accent);
  }

  .track-description {
    margin-top: 0.75rem !important;
    color: var(--text-secondary) !important;
    font-size: 0.75rem !important;
    line-height: 1.25rem !important;
  }

  .timeline {
    position: relative;
    margin-top: 1.5rem;
  }

  .timeline-line {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.9375rem;
    border-left: 1px dashed var(--border-subtle);
  }

  .timeline ol {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .step-icon {
    position: relative;
    z-index: 1;
    display: flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text-muted);
  }

  .step-icon.is-outside {
    border-style: dashed;
    border-color: var(--border-strong);
    color: var(--text-secondary);
  }

  .step-copy {
    min-width: 0;
  }

  .step-heading {
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .step-heading strong {
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
  }

  .step-copy > p {
    margin-top: 0.125rem !important;
    color: var(--text-muted);
    font-size: 0.6875rem !important;
    line-height: 1rem !important;
  }

  .stay-panel {
    gap: 0.625rem;
    margin-top: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border-subtle));
    border-radius: 0.125rem;
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
    padding: 0.625rem 0.875rem;
  }

  .stay-panel :global(svg) {
    flex: none;
    color: var(--accent);
  }

  .stay-panel p {
    color: var(--text-primary) !important;
    font-size: 0.75rem !important;
    font-weight: 500;
    line-height: 1.25rem !important;
  }

  .stay-panel strong {
    font-weight: 600;
  }

  .decision-grid {
    display: grid;
    overflow: hidden;
    margin-top: 0.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.125rem;
  }

  .decision-grid > section {
    min-width: 0;
    background: var(--research-figure-surface-base, var(--bg-primary));
    padding: 0.875rem;
  }

  .decision-grid > section + section {
    border-top: 1px solid var(--border-subtle);
  }

  .decision-grid h4 {
    margin-top: 0.375rem !important;
    color: var(--text-primary);
    font-size: 0.75rem !important;
    font-weight: 600;
    line-height: 1rem !important;
  }

  .decision-grid section > p:last-child {
    margin-top: 0.25rem !important;
    color: var(--text-secondary);
    font-size: 0.6875rem !important;
    line-height: 1rem !important;
  }

  .separation-label {
    margin-top: 0.55rem !important;
    text-align: center;
  }

  .authority-note {
    margin-top: 0.75rem;
    border-left: 2px solid var(--accent);
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
    padding: 0.625rem 0.875rem;
  }

  .authority-note p {
    color: var(--text-secondary);
    font-size: 0.6875rem !important;
    line-height: 1.25rem !important;
  }

  figcaption {
    border-top: 1px solid var(--border-subtle);
    padding: 0.875rem 1.25rem;
    color: var(--text-muted);
    font-size: 0.75rem !important;
    line-height: 1.6 !important;
  }

  @media (min-width: 640px) {
    .visual-header h2 {
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
  }

  @media (min-width: 760px) {
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .conventional {
      border-right: 1px solid var(--border-subtle);
      border-bottom: 0;
    }

    .decision-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--border-subtle);
    }

    .decision-grid > section + section {
      border-top: 0;
    }
  }
</style>
