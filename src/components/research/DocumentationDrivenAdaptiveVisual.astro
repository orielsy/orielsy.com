---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

export interface Props {
  figureNumber?: string;
}

const { figureNumber } = Astro.props;

const conventionalSteps = [
  { title: 'Work in product', detail: 'Continue the active task.', external: false },
  { title: 'Hit a blocker', detail: 'Meaning or configuration becomes unclear.', external: false },
  { title: 'Leave product', detail: 'The task crosses the application boundary.', external: true },
  { title: 'Search documents', detail: 'Find and interpret the relevant guidance.', external: true },
  { title: 'Return to product', detail: 'Recover context and resume the task.', external: false },
];
---

<ResearchFigureFrame
  className="knowledge-path-figure"
  {figureNumber}
  title="Move the knowledge, not the user."
  subtitle="The same authored product knowledge can produce two very different paths through an enterprise task."
  caption="One task. The difference is where product knowledge meets the workflow."
>
  <div class="paths">
    <section class="path conventional" aria-labelledby="conventional-path-title">
      <div class="path-heading">
        <p class="path-meta">01 · Conventional</p>
        <h4 id="conventional-path-title">The user leaves the task to recover missing context.</h4>
      </div>

      <ol class="journey">
        {conventionalSteps.map((step, index) => (
          <li class:list={[step.external && 'is-external']}>
            <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <div class="step-title-row">
                <strong>{step.title}</strong>
                {step.external && <span class="step-state">Outside app</span>}
              </div>
              <p>{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="path adaptive" aria-labelledby="adaptive-path-title">
      <div class="path-heading">
        <p class="path-meta">02 · Adaptive</p>
        <h4 id="adaptive-path-title">The task stays in place while applicable knowledge reaches it.</h4>
      </div>

      <div class="application-boundary">
        <div class="application-label">
          <span>Application</span>
          <span>User stays here</span>
        </div>

        <div class="adaptive-flow">
          <div class="flow-cell inputs">
            <p class="flow-meta">Inputs</p>
            <div class="input-row">
              <strong>Current state</strong>
              <span>Active task + product context</span>
            </div>
            <div class="input-row">
              <strong>Authored knowledge</strong>
              <span>Docs, release notes, guidance</span>
            </div>
          </div>

          <div class="flow-cell context-layer">
            <p class="flow-meta">Context layer</p>
            <strong>Applicability + response rules</strong>
            <span>Deterministic selection and policy</span>
          </div>

          <div class="flow-cell output">
            <p class="flow-meta">Output</p>
            <strong>Timely guidance</strong>
            <span>Relevant explanation + action</span>
          </div>
        </div>
      </div>

      <p class="guidance-note">Guidance appears only when authored rules and current state support it. Phase 1 does not need to guess.</p>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .knowledge-path-figure :global(p),
  .knowledge-path-figure :global(h4),
  .knowledge-path-figure :global(ol),
  .knowledge-path-figure :global(li) {
    margin: 0;
  }

  .knowledge-path-figure :global(ol) {
    padding: 0;
    list-style: none;
  }

  .paths {
    display: grid;
    border-top: 1px solid var(--border-subtle);
  }

  .path {
    min-width: 0;
    padding: 1rem 0;
  }

  .path + .path {
    border-top: 1px solid var(--border-subtle);
  }

  .path-heading {
    padding: 0 0.25rem 0.9rem;
  }

  .path-meta,
  .flow-meta,
  .step-number,
  .step-state,
  .application-label {
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .path-meta,
  .adaptive .flow-meta {
    color: var(--accent);
  }

  .conventional .path-meta,
  .flow-meta,
  .step-number,
  .step-state {
    color: var(--text-muted);
  }

  .path h4 {
    margin-top: 0.35rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .journey {
    border-top: 1px solid var(--border-subtle);
  }

  .journey li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.72rem 0.25rem;
  }

  .journey li.is-external {
    background: color-mix(in srgb, var(--bg-secondary) 58%, transparent);
  }

  .step-number {
    padding-top: 0.1rem;
  }

  .step-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
  }

  .journey strong,
  .flow-cell > strong,
  .input-row strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .journey li p,
  .flow-cell > span,
  .input-row span,
  .guidance-note {
    color: var(--text-secondary);
    font-size: 0.71875rem;
    line-height: 1.55;
  }

  .journey li p {
    margin-top: 0.2rem !important;
  }

  .application-boundary {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .application-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.65rem 0.25rem;
    color: var(--text-muted);
  }

  .application-label span:first-child {
    color: var(--text-primary);
  }

  .application-label span:last-child {
    color: var(--accent);
  }

  .adaptive-flow {
    display: grid;
    border-top: 1px solid var(--border-subtle);
  }

  .flow-cell {
    min-width: 0;
    padding: 0.85rem 0.25rem;
  }

  .flow-cell + .flow-cell {
    border-top: 1px solid var(--border-subtle);
  }

  .flow-cell > strong,
  .flow-cell > span {
    display: block;
  }

  .flow-cell > strong {
    margin-top: 0.35rem;
  }

  .flow-cell > span {
    margin-top: 0.25rem;
  }

  .inputs {
    display: grid;
    gap: 0.65rem;
  }

  .input-row {
    display: grid;
    gap: 0.15rem;
  }

  .output {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    padding-left: 0.8rem;
  }

  .guidance-note {
    margin-top: 0.9rem !important;
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
  }

  @media (min-width: 860px) {
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .path {
      padding: 1rem;
    }

    .path + .path {
      border-top: 0;
      border-left: 1px solid var(--border-subtle);
    }

    .adaptive-flow {
      grid-template-columns: 1.08fr 0.95fr 0.95fr;
    }

    .flow-cell {
      padding: 0.85rem;
    }

    .flow-cell + .flow-cell {
      border-top: 0;
      border-left: 1px solid var(--border-subtle);
    }
  }
</style>
