---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  eyebrow="Initial framing"
  title="The binary I started with was too simple."
  status="A misleading destination"
  caption="The evidence points to redistribution of responsibility, not a straight-line transition from frameworks to no frameworks."
  bodyMode="padded"
>
  <div class="framing">
    <div class="node">
      <span>Current abstraction</span>
      <strong>Frameworks</strong>
    </div>

    <div class="transition" aria-hidden="true">
      <span>becomes</span>
      <strong>→</strong>
    </div>

    <div class="node rejected">
      <span>Assumed destination</span>
      <strong>No frameworks</strong>
      <i aria-hidden="true"></i>
      <b aria-hidden="true"></b>
    </div>
  </div>
</ResearchFigureFrame>

<style>
  .framing {
    display: grid;
    gap: 0.9rem;
    align-items: center;
  }

  .node {
    position: relative;
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding: 1rem;
  }

  .node span,
  .transition span {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.47rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .node strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .transition {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    color: var(--text-muted);
  }

  .transition strong {
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 1rem;
    font-weight: 500;
  }

  .rejected {
    overflow: hidden;
  }

  .rejected i,
  .rejected b {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 115%;
    height: 1px;
    background: color-mix(in srgb, var(--accent) 72%, transparent);
    transform-origin: center;
  }

  .rejected i {
    transform: translate(-50%, -50%) rotate(13deg);
  }

  .rejected b {
    transform: translate(-50%, -50%) rotate(-13deg);
  }

  @media (min-width: 640px) {
    .framing {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .transition {
      flex-direction: column;
      min-width: 4rem;
    }
  }
</style>
