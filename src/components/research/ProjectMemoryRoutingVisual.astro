---
import { ArrowDown, ArrowRight, Route } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  className="is-open"
  figureNumber="03"
  eyebrow="Current human-authored workflow"
  title="Route, then narrow"
  caption="A human-authored entry point and task scope guide selection; the repository does not detect relevance automatically. Other project memory remains available for other work."
>
  <div class="routing-flow">
    <section>
      <span class="label">Task</span>
      <strong>Change publication behavior</strong>
      <p>The task supplies scope, not every document in the repository.</p>
    </section>

    <span class="flow-arrow" aria-hidden="true"><ArrowDown class="arrow-down" size={16} stroke-width={1.75} /><ArrowRight class="arrow-right" size={16} stroke-width={1.75} /></span>

    <section class="router">
      <Route class="route-icon" size={20} stroke-width={1.75} aria-hidden="true" />
      <code>AGENTS.md</code>
      <p>Read the constitution, then the relevant spec, plan/tasks, and ADRs before structural changes.</p>
      <span class="label routing-label">Explicit routing</span>
    </section>

    <span class="flow-arrow" aria-hidden="true"><ArrowDown class="arrow-down" size={16} stroke-width={1.75} /><ArrowRight class="arrow-right" size={16} stroke-width={1.75} /></span>

    <section class="selected">
      <span class="label">Selected context</span>
      <ol>
        <li><span>01</span>Project-wide factual guardrails</li>
        <li><span>02</span>Publication-gating specification and decisions</li>
        <li><span>03</span>Relevant implementation surfaces</li>
      </ol>
    </section>
  </div>

</ResearchFigureFrame>

<style>
  .routing-flow {
    display: grid;
    gap: 0.8rem;
    padding: 0.25rem 0 0;
  }

  section {
    min-width: 0;
  }

  .label,
  code,
  li span,
  .routing-note strong {
    font-family: var(--font-mono-ui);
  }

  .label {
    display: block;
    color: var(--text-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  section > strong,
  code {
    display: block;
    margin-top: 0.35rem;
    color: var(--text-primary);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  code {
    border: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    color: var(--accent) !important;
    font-size: 0.9375rem;
  }

  section p,
  .routing-note {
    margin: 0.45rem 0 0 !important;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .router {
    position: relative;
    padding-block: 0.4rem;
  }

  .routing-flow :global(.route-icon),
  .routing-flow :global(.arrow-down),
  .routing-flow :global(.arrow-right) {
    color: var(--accent);
  }

  .flow-arrow {
    display: flex;
    align-self: center;
    justify-self: center;
  }

  .flow-arrow :global(.arrow-right) {
    display: none;
  }

  .routing-label {
    margin-top: 0.65rem;
  }

  .selected {
    border-left: 1px solid var(--accent); border-radius: 0 0.375rem 0.375rem 0; background: color-mix(in srgb, var(--accent) 5%, var(--bg-secondary));
    padding: 0.75rem 1rem;
  }

  ol {
    display: grid;
    gap: 0.55rem;
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: block;
    margin: 0 !important;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  li span {
    display: inline-block;
    min-width: 1.8rem;
    color: var(--accent);
    font-size: 0.6875rem;
  }

  .routing-note {
    margin-top: 0.75rem !important;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.65rem;
    color: var(--text-muted);
  }

  .routing-note strong {
    color: var(--accent);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (min-width: 820px) {
    .routing-flow {
      grid-template-columns: minmax(0, 1fr) 2rem minmax(0, 1.1fr) 2rem minmax(0, 1.15fr);
      align-items: center;
    }

    .flow-arrow :global(.arrow-down) {
      display: none;
    }

    .flow-arrow :global(.arrow-right) {
      display: block;
    }

    .routing-label {
      position: absolute;
      top: 0;
      right: -0.25rem;
      margin: 0;
    }
  }
</style>
