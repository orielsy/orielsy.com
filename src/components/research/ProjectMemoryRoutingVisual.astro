---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  eyebrow="Figure 03"
  status="Current human-authored workflow"
  title="Route, then narrow"
  caption="Selection narrows the working set for the present task; it does not remove other repository memory."
>
  <div class="routing-flow">
    <section>
      <span class="label">Task</span>
      <strong>Change publication behavior</strong>
      <p>The task supplies scope, not every document in the repository.</p>
    </section>

    <span class="arrow" aria-hidden="true">→</span>

    <section class="router">
      <span class="label">Explicit routing</span>
      <code>AGENTS.md</code>
      <p>Read the constitution, then the relevant spec, plan/tasks, and ADRs before structural changes.</p>
    </section>

    <span class="arrow" aria-hidden="true">→</span>

    <section class="selected">
      <span class="label">Selected context</span>
      <ol>
        <li><span>01</span><span>Project-wide factual guardrails</span></li>
        <li><span>02</span><span>Publication-gating specification and decisions</span></li>
        <li><span>03</span><span>Relevant implementation surfaces</span></li>
      </ol>
    </section>
  </div>

  <p class="routing-note">Current routing is explicit and human-authored. Automated relevance detection is not implemented.</p>
</ResearchFigureFrame>

<style>
  .routing-flow {
    display: grid;
    gap: 0.9rem;
  }

  section {
    min-width: 0;
    align-self: start;
  }

  .label,
  code,
  li > span:first-child,
  .routing-note {
    font-family: var(--font-mono-ui);
  }

  .label {
    display: block;
    color: var(--text-muted);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  section > strong,
  code {
    display: block;
    margin-top: 0.45rem;
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  code {
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    font-family: var(--font-mono-ui);
    font-size: 0.85rem;
    text-transform: none;
  }

  section p {
    margin: 0.5rem 0 0 !important;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .router {
    border-left: 2px solid var(--accent);
    padding-left: 0.9rem;
  }

  .arrow {
    align-self: center;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 1rem;
    text-align: center;
    transform: rotate(90deg);
  }

  ol {
    display: grid;
    gap: 0.65rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  li > span:first-child {
    color: var(--accent);
    font-size: 0.625rem;
  }

  .routing-note {
    margin: 1rem 0 0 !important;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.02em;
    line-height: 1.6;
    text-transform: none;
  }

  @media (min-width: 820px) {
    .routing-flow {
      grid-template-columns: minmax(0, 0.9fr) 2rem minmax(0, 1.15fr) 2rem minmax(0, 1.1fr);
      gap: 1rem;
      align-items: start;
      padding-top: 0.15rem;
    }

    .arrow {
      padding-top: 2.75rem;
      transform: none;
    }

    .selected {
      border-left: 1px solid var(--border-subtle);
      padding-left: 1rem;
    }
  }
</style>
