---
const paths = [
  {
    label: 'Conversation-only decision',
    badge: 'Failure path',
    accent: false,
    steps: [
      'Decision exists only in conversation',
      'New coding session',
      'Prior discussion is absent from working context',
      'Plausible wording reappears',
    ],
  },
  {
    label: 'Durable project rule',
    badge: 'Recovery path',
    accent: true,
    steps: [
      'Decision becomes a project rule',
      'Agent reads AGENTS.md',
      'AGENTS.md routes to constitution / specs',
      'Constraint enters working context',
      'Silent regression becomes less likely',
    ],
  },
];
---

<figure class="decision-persistence not-prose">
  <header>
    <div>
      <p class="eyebrow">Context persistence</p>
      <h3>The same decision behaves differently depending on where it lives.</h3>
    </div>
    <span class="header-note">Observed on this repository</span>
  </header>

  <div class="paths">
    {paths.map((path) => (
      <section class:list={['path', path.accent && 'is-recovery']}>
        <div class="path-heading">
          <span>{path.badge}</span>
          <strong>{path.label}</strong>
        </div>
        <ol>
          {path.steps.map((step, index) => (
            <li>
              <span class="step-index">{String(index + 1).padStart(2, '0')}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <figcaption>“Less likely” is intentional: durable context improves recoverability, but it does not guarantee agent behavior.</figcaption>
</figure>

<style>
  .decision-persistence {
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    background: var(--bg-card);
  }

  .decision-persistence :global(p),
  .decision-persistence :global(h3),
  .decision-persistence :global(ol),
  .decision-persistence :global(li) {
    margin: 0;
  }

  .decision-persistence :global(ol) {
    padding-left: 0;
    list-style: none;
  }

  header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.2rem 1.35rem;
  }

  .eyebrow,
  .header-note,
  .path-heading span,
  .step-index {
    font-family: var(--font-mono-ui);
    text-transform: uppercase;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  h3 {
    margin-top: 0.45rem !important;
    max-width: 42rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .header-note {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.47rem;
    letter-spacing: 0.1em;
  }

  .paths {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .path {
    background: var(--bg-card);
    padding: 1rem;
  }

  .path.is-recovery {
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .path-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .path-heading span {
    color: var(--text-muted);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
  }

  .is-recovery .path-heading span {
    color: var(--accent);
  }

  .path-heading strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.78rem;
  }

  ol {
    display: grid;
    gap: 0.45rem;
  }

  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: center;
    min-height: 2.8rem;
    border-left: 1px solid var(--border-strong);
    background: var(--bg-secondary);
    padding: 0.55rem 0.65rem;
    color: var(--text-secondary);
    font-size: 0.67rem;
    line-height: 1.45;
  }

  .is-recovery li {
    border-left-color: var(--accent);
  }

  .step-index {
    color: var(--text-muted);
    font-size: 0.47rem;
    letter-spacing: 0.08em;
  }

  .is-recovery .step-index {
    color: var(--accent);
  }

  figcaption {
    border-top: 1px solid var(--border-subtle);
    padding: 0.85rem 1rem;
    color: var(--text-muted);
    font-size: 0.62rem;
    line-height: 1.55;
  }

  @media (min-width: 760px) {
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    header,
    .path-heading {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
