---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const paths = [
  {
    label: 'Conversation-only decision',
    badge: 'Failure path',
    accent: false,
    steps: [
      'Decision exists only in conversation',
      'New coding session',
      'Prior discussion is absent from working context',
      'Plausible wording reappears',
    ],
  },
  {
    label: 'Durable project rule',
    badge: 'Recovery path',
    accent: true,
    steps: [
      'Decision becomes a project rule',
      'Agent reads AGENTS.md',
      'AGENTS.md routes to constitution / specs',
      'Constraint enters working context',
      'Silent regression becomes less likely',
    ],
  },
];
---

<ResearchFigureFrame
  title="The same decision behaves differently depending on where it lives."
  status="Observed on this repository"
  caption="The recovery path gives later sessions a durable route back to the constraint."
>
  <div class="paths">
    {paths.map((path) => (
      <section class:list={['path', path.accent && 'is-recovery']}>
        <div class="path-heading">
          <span>{path.badge}</span>
          <strong>{path.label}</strong>
        </div>
        <ol>
          {path.steps.map((step, index) => (
            <li>
              <span class="step-index">{String(index + 1).padStart(2, '0')}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</ResearchFigureFrame>

<style>
  .paths {
    display: grid;
    gap: 1px;
    border-block: 1px solid var(--border-subtle);
    background: var(--border-subtle);
  }

  .path {
    background: var(--bg-card);
    padding: 1rem;
  }

  .path.is-recovery {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .path-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-bottom: 0.75rem;
  }

  .path-heading span,
  .step-index {
    font-family: var(--font-mono-ui);
    text-transform: uppercase;
  }

  .path-heading span {
    color: var(--text-muted);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .is-recovery .path-heading span {
    color: var(--accent);
  }

  .path-heading strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  ol {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: center;
    min-height: 2.8rem;
    margin: 0;
    border-left: 1px solid var(--border-strong);
    background: var(--bg-secondary);
    padding: 0.6rem 0.7rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .is-recovery li {
    border-left-color: var(--accent);
  }

  .step-index {
    color: var(--text-muted);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }

  .is-recovery .step-index {
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
