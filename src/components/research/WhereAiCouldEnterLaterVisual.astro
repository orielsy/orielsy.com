---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const stages = [
  { title: 'Application truth', detail: 'Authoritative state' },
  { title: 'Deterministic validation', detail: 'Known requirements' },
  { title: 'Context filtering', detail: 'Reduce candidates' },
  { title: 'Inference', detail: 'Resolve remaining ambiguity', inference: true },
  { title: 'Evidence reconciliation', detail: 'Constrain inferred candidates' },
  { title: 'Response policy', detail: 'Decide UI authority' },
  { title: 'UI response', detail: 'Explanation or action', output: true },
] as const;
---

<ResearchFigureFrame
  className="ai-seams-figure"
  eyebrow="Future inference seam"
  title="Where AI could enter later."
  subtitle="Inference can enter at one explicit boundary without taking ownership of application truth or response policy."
  status="Future · not Phase 1"
  caption="Inference should resolve ambiguity, not replace truth. Deterministic application state still constrains what the interface may claim or do."
>
  <ol class="pipeline" aria-label="Future inference pipeline">
    {stages.map((stage, index) => (
      <li class:list={[stage.inference && 'is-inference', stage.output && 'is-output']}>
        <span class="node-number">{String(index + 1).padStart(2, '0')}{stage.inference ? ' · optional' : ''}</span>
        <strong>{stage.title}</strong>
        <small>{stage.detail}</small>
      </li>
    ))}
  </ol>

  <div class="boundary-note">
    <span>Deterministic facts and filtering</span>
    <span class="line" aria-hidden="true"></span>
    <strong>Optional inference stays bounded</strong>
    <span class="line" aria-hidden="true"></span>
    <span>Policy and rendering remain deterministic</span>
  </div>
</ResearchFigureFrame>

<style>
  .ai-seams-figure :global(ol),
  .ai-seams-figure :global(li) {
    margin: 0;
  }

  .ai-seams-figure :global(ol) {
    padding: 0;
    list-style: none;
  }

  .pipeline {
    display: grid;
    border-top: 1px solid var(--border-subtle);
    border-left: 1px solid var(--border-subtle);
  }

  .pipeline li {
    min-width: 0;
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
    padding: 0.8rem;
  }

  .node-number {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .pipeline strong,
  .pipeline small {
    display: block;
  }

  .pipeline strong {
    margin-top: 0.65rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.78125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .pipeline small {
    margin-top: 0.25rem;
    color: var(--text-secondary);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .pipeline .is-inference {
    border-color: var(--accent-border);
    border-style: dashed;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-card));
  }

  .is-inference .node-number,
  .is-inference strong {
    color: var(--accent);
  }

  .pipeline .is-output {
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .boundary-note {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .boundary-note strong {
    color: var(--accent);
    font-weight: 500;
  }

  .boundary-note .line {
    display: none;
  }

  @media (min-width: 760px) {
    .pipeline {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .pipeline li {
      min-height: 8.2rem;
    }

    .boundary-note {
      grid-template-columns: auto minmax(1rem, 1fr) auto minmax(1rem, 1fr) auto;
      align-items: center;
      gap: 0.6rem;
    }

    .boundary-note .line {
      display: block;
      border-top: 1px solid var(--border-subtle);
    }
  }
</style>
