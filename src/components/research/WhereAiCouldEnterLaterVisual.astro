---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
export interface Props { figureNumber?: string; }
const { figureNumber } = Astro.props;
---
<ResearchFigureFrame className="adaptive-future" {figureNumber} title="Inference has a place, not a mandate" status="Future only · not Phase 1" caption="No LLM, remote inference, semantic retrieval, or runtime placement was implemented in Phase 1. Any future inference must be reconciled with approved knowledge and authoritative state before response policy permits a UI action.">
  <div class="stage"><span>Implemented · deterministic client-side</span><p>State + validation → explicit context filtering → applicable authored fragments</p></div>
  <div class="stage future"><span>Optional future stage · not implemented</span><p>Intent mapping · candidate ranking · explanation adaptation</p></div>
  <div class="stage"><span>Authority boundary</span><p>Evidence reconciliation → response policy → structured UI response</p></div>
  <p class="runtime">Browser, machine-local, server, edge, or cloud placement is a later decision, not an active runtime router.</p>
</ResearchFigureFrame>
<style>
  .adaptive-future :global(p) { margin: 0; }
  .stage { border-top: 1px solid var(--border-subtle); padding: 1rem 0; }
  .stage span { color: var(--accent); font-family: var(--font-mono-ui); font-size: .6875rem; line-height: 1.5; text-transform: uppercase; }
  .stage p { margin-top: .3rem !important; color: var(--text-primary); font-size: .875rem; line-height: 1.6; }
  .future { border: 1px dashed var(--accent-border); border-inline-width: 0; padding-left: 1rem; }
  .runtime { border-top: 1px solid var(--border-strong); padding-top: 1rem; color: var(--text-secondary); font-size: .875rem; line-height: 1.6; }
  :global(.research-reading .research-prose figure.adaptive-future) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.adaptive-future) .stage p, :global(.research-reading .research-prose figure.adaptive-future) .runtime { font-size: .875rem !important; line-height: 1.6 !important; }
</style>
