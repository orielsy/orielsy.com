---
export interface Props {
  figureNumber?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  status?: string;
  caption?: string;
  bodyMode?: 'flush' | 'padded';
  className?: string;
}

const {
  figureNumber,
  eyebrow,
  title,
  subtitle,
  status,
  caption,
  bodyMode = 'flush',
  className,
} = Astro.props;
---

<figure class:list={['research-figure-frame', 'not-prose', figureNumber && 'has-figure-number', className]} data-research-diagram>
  <header>
    <div class="heading">
      {figureNumber && <p class="figure-number">Figure {figureNumber}</p>}
      {!figureNumber && eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h3>{title}</h3>
      {subtitle && <p class="subtitle">{subtitle}</p>}
    </div>
    {figureNumber && eyebrow && <p class="figure-basis">{eyebrow}</p>}
    {status && <p class="status">{status}</p>}
  </header>

  <div class:list={['body', bodyMode === 'padded' && 'is-padded']}>
    <slot />
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .research-figure-frame {
    overflow: hidden;
    margin: 2.75rem 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.2rem;
    background: var(--bg-card);
    padding: 1.25rem 1rem;
  }

  .research-figure-frame :global(p),
  .research-figure-frame :global(h3) {
    margin: 0;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    margin-bottom: 1.25rem;
    padding: 0 !important;
  }

  .heading {
    min-width: 0;
    max-width: 44rem;
  }

  .figure-number,
  .figure-basis,
  .eyebrow,
  .status {
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .figure-number {
    color: var(--accent);
  }

  .figure-basis,
  .eyebrow {
    color: var(--text-muted);
  }

  .status {
    color: var(--text-muted);
  }

  h3 {
    margin-top: 0.4rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin-top: 0.4rem !important;
    max-width: 42rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .body.is-padded {
    padding: 0.9rem;
  }

  figcaption {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    padding: 0.8rem 0 0 !important;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  @media (min-width: 640px) {
    .research-figure-frame {
      padding: 1.5rem;
    }

    header {
      margin-bottom: 1.5rem;
      padding: 0 !important;
    }

    h3 {
      font-size: 1.125rem;
    }

    .subtitle {
      font-size: 0.8125rem;
    }

    .body.is-padded {
      padding: 1rem;
    }

    figcaption {
      padding-inline: 0 !important;
      font-size: 0.75rem;
    }
  }
  /* Project-memory figures inherit the lab's publication header/body/caption composition. */
  .has-figure-number {
    padding: 0;
  }

  .has-figure-number header {
    align-items: center;
    margin: 0;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1rem !important;
  }

  .has-figure-number .heading {
    flex: 1 1 20rem;
  }

  .has-figure-number .figure-basis {
    flex-basis: 100%;
    text-align: left;
  }

  .has-figure-number .body {
    padding: 1.25rem 1rem;
  }

  .has-figure-number figcaption {
    margin: 0;
    padding: 0.9rem 1rem !important;
  }

  .is-open h3 {
    margin-top: 0.2rem !important;
    font-size: 1.125rem;
  }

  .is-open figcaption {
    font-size: 0.8125rem;
  }

  @media (min-width: 640px) {
    .has-figure-number header {
      padding: 1rem 1.5rem !important;
    }

    .has-figure-number .figure-basis {
      flex: 0 1 24rem;
      text-align: right;
    }

    .has-figure-number .body {
      padding: 1.25rem 1.5rem;
    }

    .has-figure-number figcaption {
      padding: 0.9rem 1.5rem !important;
    }

    .is-open h3 {
      font-size: 1.25rem;
    }
  }
</style>