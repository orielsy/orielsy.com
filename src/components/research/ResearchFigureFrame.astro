---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  status?: string;
  caption?: string;
  bodyMode?: 'flush' | 'padded';
  className?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  status,
  caption,
  bodyMode = 'flush',
  className,
} = Astro.props;
---

<figure class:list={['research-figure-frame', 'not-prose', className]} data-research-diagram>
  <header>
    <div class="heading">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h3>{title}</h3>
      {subtitle && <p class="subtitle">{subtitle}</p>}
    </div>
    {status && <p class="status">{status}</p>}
  </header>

  <div class:list={['body', bodyMode === 'padded' && 'is-padded']}>
    <slot />
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .research-figure-frame {
    overflow: hidden;
    margin: 2.5rem 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    background: var(--bg-card);
    padding: 1.25rem 1rem;
  }

  .research-figure-frame :global(p),
  .research-figure-frame :global(h3) {
    margin: 0;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    margin-bottom: 1.25rem;
    padding: 0 !important;
  }

  .heading {
    min-width: 0;
    max-width: 44rem;
  }

  .eyebrow,
  .status {
    font-family: var(--font-mono-ui);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .eyebrow {
    color: var(--accent);
  }

  .status {
    color: var(--text-muted);
  }

  h3 {
    margin-top: 0.35rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin-top: 0.35rem !important;
    max-width: 42rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .body.is-padded {
    padding: 0.9rem;
  }

  figcaption {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    padding: 0.8rem 0 0 !important;
    color: var(--text-muted);
    font-size: 0.6875rem;
    line-height: 1.55;
  }

  @media (min-width: 640px) {
    .research-figure-frame {
      padding: 1.5rem;
    }

    header {
      margin-bottom: 1.5rem;
      padding: 0 !important;
    }

    h3 {
      font-size: 1.125rem;
    }

    .subtitle {
      font-size: 0.8125rem;
    }

    .body.is-padded {
      padding: 1rem;
    }

    figcaption {
      padding-inline: 0 !important;
      font-size: 0.75rem;
    }
  }
</style>
