---
export interface Props {
  figureNumber?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  status?: string;
  caption?: string;
  bodyMode?: 'flush' | 'padded';
  className?: string;
}

const {
  figureNumber,
  eyebrow,
  title,
  subtitle,
  status,
  caption,
  bodyMode = 'flush',
  className,
} = Astro.props;
---

<figure class:list={['research-figure-frame', 'not-prose', className]} data-research-diagram>
  <header>
    <div class="heading">
      {figureNumber && <p class="figure-number">Figure {figureNumber}</p>}
      {!figureNumber && eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h3>{title}</h3>
      {subtitle && <p class="subtitle">{subtitle}</p>}
    </div>
    {status && <p class="status">{status}</p>}
  </header>

  <div class:list={['body', bodyMode === 'padded' && 'is-padded']}>
    <slot />
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .research-figure-frame {
    overflow: hidden;
    margin: 2.75rem 0;
    border: 1px solid var(--border-subtle);
    border-radius: 0.2rem;
    background: var(--bg-card);
    padding: 1.25rem 1rem;
  }

  .research-figure-frame :global(p),
  .research-figure-frame :global(h3) {
    margin: 0;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.45rem 1rem;
    margin-bottom: 1rem;
    padding: 0 !important;
  }

  .heading {
    min-width: 0;
    max-width: 44rem;
  }

  .figure-number,
  .eyebrow,
  .status {
    font-family: var(--font-mono-ui);
    font-size: var(--research-diagram-label, 0.625rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .figure-number,
  .eyebrow {
    color: var(--accent);
  }

  .status {
    color: var(--text-muted);
  }

  h3 {
    margin-top: 0.25rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--research-diagram-title, 1.0625rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin-top: 0.3rem !important;
    max-width: 42rem;
    color: var(--text-secondary);
    font-size: var(--research-diagram-subtitle, 0.875rem);
    line-height: 1.65;
  }

  .body.is-padded {
    padding: 0.9rem;
  }

  figcaption {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    padding: 0.85rem 0 0 !important;
    color: var(--text-muted);
    font-size: var(--research-diagram-caption, 0.75rem);
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .research-figure-frame {
      padding: 1.5rem;
    }

    header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) max-content;
      column-gap: 1.5rem;
      margin-bottom: 1rem;
      padding: 0 !important;
    }

    .heading {
      max-width: none;
    }

    .status {
      justify-self: end;
      white-space: nowrap;
    }

    h3 {
      font-size: var(--research-diagram-title-wide, 1.125rem);
    }

    .body.is-padded {
      padding: 1rem;
    }
  }
</style>