---
const principles = [
  { title: 'Use specialized models for specialized primitives', detail: 'Speech-to-text can serve transcription directly without routing the task through a general conversational interface.' },
  { title: 'Treat local inference as an execution option', detail: 'Browser or desktop runtimes can support downstream tasks when the local model and hardware are sufficient.' },
  { title: 'Keep capture, inference, and rendering decoupled', detail: 'Separating responsibilities makes latency, blocking work, and UI behavior easier to reason about independently.' },
];
---

<div class="speech-takeaways not-prose" aria-label="Architectural takeaways from the current implementation">
  <ol>
    {principles.map((principle, index) => (
      <li>
        <span class="index">{String(index + 1).padStart(2, '0')}</span>
        <div><strong>{principle.title}</strong><p>{principle.detail}</p></div>
      </li>
    ))}
  </ol>
</div>

<style>
  .speech-takeaways { margin: 1.5rem 0 2rem; border-block: 1px solid var(--border-subtle); }
  .speech-takeaways :global(p), .speech-takeaways :global(ol), .speech-takeaways :global(li) { margin: 0; }
  .speech-takeaways :global(ol) { padding: 0; list-style: none; }
  li { display: grid; grid-template-columns: 2.5rem minmax(0,1fr); gap: 0.8rem; padding: 0.95rem 0; }
  li + li { border-top: 1px solid var(--border-subtle); }
  .index { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; letter-spacing: 0.08em; }
  li strong { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; line-height: 1.4; }
  li p { margin-top: 0.3rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
</style>
