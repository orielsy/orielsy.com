---
import { LockKeyhole } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';
export interface Props { figureNumber?: string; }
const { figureNumber } = Astro.props;
const fragments = [
  ['Required-field help', 'Missing selection', 'Explains the existing requirement'],
  ['Beginner concept', 'New + missing selection', 'Does not appear for experienced users'],
  ['4.2 release note', '4.2 + missing selection', 'Changes explanation, not validity'],
  ['Selection guidance', 'Missing selection', 'Cannot determine which system the user intends'],
];
---

<ResearchFigureFrame
  className="adaptive-applicability"
  {figureNumber}
  title="A fragment may apply without earning an action"
  status="Research · applicability / policy"
  caption="These are authored fixture fragments with simple source labels, not discovered documents. Applicability filters by explicit context; validation and the permitted action are decided separately. The base field summary also exists in the fixture set."
>
  <div class="decisions">
    <section>
      <p class="figure-label">Decision A · matching knowledge</p>
      <div class="fragment-list">
        {fragments.map(([name, condition, consequence]) => (
          <div>
            <strong>{name}</strong>
            <span class="figure-support">{condition} · {consequence}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="policy">
      <p class="figure-label figure-accent">Decision B · permitted response</p>
      <div class="policy-rule">
        <p class="policy-primary">Validation asks whether the selected value meets the application requirement.</p>
        <p class="policy-secondary">Policy considers that result, the compatible options, applicable guidance, and certainty before deciding to explain, guide, or offer.</p>
      </div>
      <div class="policy-note">
        <LockKeyhole size={16} strokeWidth={1.75} aria-hidden="true" />
        <p class="figure-support">A matched release note can add context. It cannot select a Data Connection or change a validity rule.</p>
      </div>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .adaptive-applicability :global(.figure-number),
  .adaptive-applicability :global(.status),
  .adaptive-applicability :global(.figure-label) {
    font-size: 0.625rem !important;
    font-weight: 400;
    letter-spacing: 0 !important;
    line-height: 1.25rem !important;
  }

  .adaptive-applicability :global(.heading h3) {
    font-size: 1.125rem !important;
    line-height: 1.75rem !important;
    letter-spacing: 0 !important;
  }

  .adaptive-applicability :global(figcaption) {
    font-size: 0.75rem !important;
    line-height: 1.5rem !important;
  }

  .adaptive-applicability :global(.figure-support) {
    font-size: 0.75rem !important;
    line-height: 1.25rem !important;
  }

  .adaptive-applicability :global(p),
  .adaptive-applicability :global(span),
  .adaptive-applicability :global(strong) {
    margin: 0;
  }

  .decisions {
    display: grid;
    gap: 1.25rem;
  }

  section {
    min-width: 0;
  }

  section + section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
  }

  .fragment-list {
    margin-top: 0.75rem;
    border-block: 1px solid var(--border-subtle);
  }

  .fragment-list > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0;
  }

  .fragment-list > div + div {
    border-top: 1px solid var(--border-subtle);
  }

  .fragment-list strong {
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25rem;
  }

  .policy-rule {
    margin-top: 0.75rem;
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }

  .policy-primary,
  .policy-secondary {
    font-size: 0.875rem !important;
    line-height: 1.5rem !important;
  }

  .policy-primary {
    color: var(--text-primary);
  }

  .policy-secondary {
    margin-top: 0.75rem !important;
    color: var(--text-secondary);
  }

  .policy-note {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .policy-note :global(svg) {
    color: var(--accent);
  }

  .policy-note .figure-support {
    margin-top: 0.5rem !important;
  }

  @media (min-width: 720px) {
    .decisions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    section:first-child {
      padding-right: 1.25rem;
    }

    section + section {
      border-top: 0;
      border-left: 1px solid var(--border-subtle);
      padding: 0 0 0 1.25rem;
    }
  }
</style>
