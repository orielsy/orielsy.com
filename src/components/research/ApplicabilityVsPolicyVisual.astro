---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
export interface Props { figureNumber?: string; }
const { figureNumber } = Astro.props;
const fragments = [
  ['Required-field help', 'Missing selection', 'Explains the existing requirement'],
  ['Beginner concept', 'New user + missing selection', 'Omitted for experienced users'],
  ['4.2 release note', 'Version 4.2 + missing selection', 'Changes explanation, not validity'],
  ['Selection guidance', 'Missing selection', 'Cannot infer which system the user intends'],
];
---
<ResearchFigureFrame className="adaptive-applicability" {figureNumber} title="A fragment may apply without earning an action" caption="These are authored fixture fragments, not discovered documents. Matching a fragment cannot change validity or silently choose a Data Connection. A base field summary also exists.">
  <div class="decisions">
    <section aria-labelledby="adaptive-applicability-title"><h4 id="adaptive-applicability-title">Decision A · What knowledge matches?</h4><div class="fragment-list">{fragments.map(([name, condition, effect]) => <div><strong>{name}</strong><p>{condition} · {effect}</p></div>)}</div></section>
    <section aria-labelledby="adaptive-policy-title"><h4 id="adaptive-policy-title">Decision B · What response is permitted?</h4><p>Application state + validation + compatible options + applicable guidance + certainty.</p><div class="policy-outcome"><span>Several compatible</span><p>Explain, focus, or guide; do not guess a selection.</p></div><div class="policy-outcome"><span>Exactly one</span><p>Offer “Use connection”; acceptance is explicit.</p></div></section>
  </div>
</ResearchFigureFrame>
<style>
  .adaptive-applicability :global(p), .adaptive-applicability :global(h4) { margin: 0; }
  .decisions { display: grid; gap: 1.5rem; }
  section { min-width: 0; }
  section + section { border-top: 1px solid var(--border-subtle); padding-top: 1.25rem; }
  h4 { color: var(--text-primary); font-family: var(--font-display); font-size: .9375rem; font-weight: 600; line-height: 1.45; }
  .fragment-list { margin-top: .8rem; border-top: 1px solid var(--border-subtle); }
  .fragment-list > div { border-bottom: 1px solid var(--border-subtle); padding: .7rem 0; }
  .fragment-list strong { color: var(--text-primary); font-size: .875rem; font-weight: 600; }
  .fragment-list p, section > p, .policy-outcome p { margin-top: .3rem !important; color: var(--text-secondary); font-size: .875rem; line-height: 1.6; }
  section > p { margin-top: .8rem !important; }
  .policy-outcome { border-top: 1px solid var(--border-subtle); margin-top: 1rem; padding-top: .85rem; }
  .policy-outcome span { color: var(--accent); font-family: var(--font-mono-ui); font-size: .6875rem; text-transform: uppercase; }
  @media (min-width: 720px) { .decisions { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0; } section:first-child { padding-right: 1.5rem; } section + section { border-top: 0; border-left: 1px solid var(--border-subtle); padding: 0 0 0 1.5rem; } }
  :global(.research-reading .research-prose figure.adaptive-applicability) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.adaptive-applicability) .fragment-list p, :global(.research-reading .research-prose figure.adaptive-applicability) section > p, :global(.research-reading .research-prose figure.adaptive-applicability) .policy-outcome p { font-size: .875rem !important; line-height: 1.6 !important; }
</style>
