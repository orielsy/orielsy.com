---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const applicabilityFacts = ['Product state', 'Version', 'Audience'];
const policyFacts = ['Application state', 'Validation result', 'Available knowledge', 'Evidence certainty'];
---

<ResearchFigureFrame
  className="applicability-policy-figure"
  eyebrow="Separation of concerns"
  title="Knowing something applies does not decide what the UI should do."
  subtitle="Applicability identifies relevance. Response policy controls interface authority."
  caption="The knowledge layer identifies relevance; policy decides whether the UI should explain, highlight, suggest, or offer a user-accepted action."
>
  <div class="comparison">
    <section aria-labelledby="applicability-stage-title">
      <p class="stage-meta">01 · Applicability</p>
      <h4 id="applicability-stage-title">Does this knowledge match the current context?</h4>

      <ul class="fact-ledger">
        {applicabilityFacts.map((fact) => <li>{fact}</li>)}
      </ul>

      <div class="stage-output">
        <span>Output</span>
        <strong>Applicable authored knowledge</strong>
      </div>
    </section>

    <div class="divider" aria-hidden="true">→</div>

    <section aria-labelledby="policy-stage-title">
      <p class="stage-meta">02 · Response policy</p>
      <h4 id="policy-stage-title">How strongly should the interface intervene?</h4>

      <ul class="fact-ledger">
        {policyFacts.map((fact) => <li>{fact}</li>)}
      </ul>

      <div class="stage-output is-policy-output">
        <span>Possible UI response</span>
        <strong>Help text · highlight · suggestion · user-accepted action</strong>
      </div>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .applicability-policy-figure :global(p),
  .applicability-policy-figure :global(h4),
  .applicability-policy-figure :global(ul),
  .applicability-policy-figure :global(li) {
    margin: 0;
  }

  .applicability-policy-figure :global(ul) {
    padding: 0;
    list-style: none;
  }

  .comparison {
    display: grid;
    border-top: 1px solid var(--border-subtle);
  }

  .comparison section {
    min-width: 0;
    padding: 1rem 0.25rem;
  }

  .comparison section + section {
    border-top: 1px solid var(--border-subtle);
  }

  .stage-meta,
  .stage-output span {
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  h4 {
    margin-top: 0.4rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .fact-ledger {
    margin-top: 1rem !important;
    border-top: 1px solid var(--border-subtle);
  }

  .fact-ledger li {
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.55rem 0;
    color: var(--text-secondary);
    font-family: var(--font-mono-ui);
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  .stage-output {
    margin-top: 1rem;
    border-left: 2px solid var(--border-strong);
    padding-left: 0.75rem;
  }

  .stage-output strong {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .is-policy-output {
    border-left-color: var(--accent);
  }

  .divider {
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
  }

  @media (min-width: 800px) {
    .comparison {
      grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1fr);
    }

    .comparison section {
      padding: 1rem;
    }

    .comparison section + section {
      border-top: 0;
    }

    .divider {
      display: flex;
      border-right: 1px solid var(--border-subtle);
      border-left: 1px solid var(--border-subtle);
    }
  }
</style>
