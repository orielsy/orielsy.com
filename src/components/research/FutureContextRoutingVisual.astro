---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const flows = [
  {
    label: 'Current repository flow',
    badge: 'Explicit / human-authored',
    accent: false,
    steps: ['Agent task', 'AGENTS.md', 'Relevant constitution / specs / ADRs', 'Working context', 'Implementation'],
  },
  {
    label: 'Possible next step',
    badge: 'Proposed / not implemented',
    accent: true,
    steps: ['Agent task', 'Relevance detection', 'Select relevant specs / ADRs / repository patterns', 'Context delivery layer', 'Agent working context'],
  },
];
---

<ResearchFigureFrame
  title="From explicit lookup to task-aware context routing."
  caption="The second path is a research direction, not a claim about the current repository implementation."
>
  <div class="flows">
    {flows.map((flow) => (
      <section class:list={['flow', flow.accent && 'is-future']}>
        <div class="flow-heading">
          <strong>{flow.label}</strong>
          <span>{flow.badge}</span>
        </div>
        <ol>
          {flow.steps.map((step, index) => (
            <li>
              <span class="index">{String(index + 1).padStart(2, '0')}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</ResearchFigureFrame>

<style>
  .flows {
    display: grid;
    gap: 1px;
    border-block: 1px solid var(--border-subtle);
    background: var(--border-subtle);
  }

  .flow {
    background: var(--bg-card);
    padding: 1rem;
  }

  .flow.is-future {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .flow-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }

  .flow-heading strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .flow-heading span,
  .index {
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .flow-heading span {
    color: var(--text-muted);
  }

  .is-future .flow-heading span {
    color: var(--accent);
  }

  ol {
    display: grid;
    gap: 0.42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    min-height: 2.7rem;
    margin: 0;
    border-left: 1px solid var(--border-strong);
    background: var(--bg-secondary);
    padding: 0.55rem 0.7rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .is-future li {
    border-left-color: color-mix(in srgb, var(--accent) 58%, var(--border-strong));
  }

  .index {
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .is-future .index {
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .flows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
