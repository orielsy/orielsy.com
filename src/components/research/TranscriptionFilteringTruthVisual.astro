---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const repoScaffolding = ['VADFactory', 'PyAnnote dependencies', 'lazy get_vad() helper'];
const activePath = [
  'Buffered audio reaches process_buffer()',
  'Whisper runs without VAD first',
  'Segments return to CaptionControl.vue',
  'Client accepts nonempty text when no_speech_prob ≤ 0.6 and temperature ≤ 0.8',
];
---

<ResearchFigureFrame
  className="filtering-truth-figure"
  figureNumber="03"
  title="Repository presence is not runtime behavior"
  status="Current public source"
  caption="The distinction is source-grounded. Client filtering can reduce likely low-confidence output; it does not guarantee that all undesirable text is eliminated."
>
  <div class="truth-grid">
    <section>
      <p class="figure-label">Present in repository</p>
      <ul>
        {repoScaffolding.map((item) => <li class="figure-support">{item}</li>)}
      </ul>
      <p class="repository-note figure-support">Available scaffolding, not active silence dropping.</p>
    </section>

    <section class="active-path">
      <p class="figure-label figure-accent">Active path</p>
      <ol>
        {activePath.map((item, index) => (
          <li>
            <span class="figure-meta figure-accent">0{index + 1}</span>
            <span class="figure-support">{item}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .filtering-truth-figure :global(p) {
    margin: 0;
  }

  .filtering-truth-figure :global(ul),
  .filtering-truth-figure :global(ol) {
    padding: 0;
    list-style: none;
  }

  .truth-grid {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .truth-grid section {
    min-width: 0;
    background: var(--research-figure-surface-base, var(--bg-primary));
    padding: 1.25rem;
  }

  .truth-grid .active-path {
    background: var(--research-figure-surface-emphasis, var(--bg-card-hover));
  }

  .truth-grid ul,
  .truth-grid ol {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .truth-grid ul li {
    border-left: 1px dashed var(--border-subtle);
    padding-left: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-mono-ui);
  }

  .repository-note {
    margin-top: 1rem !important;
    color: var(--text-muted);
  }

  .active-path ol li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    border-left: 1px solid var(--accent);
    padding: 0.5rem 0 0.5rem 0.75rem;
  }

  @media (min-width: 800px) {
    .truth-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
</style>
