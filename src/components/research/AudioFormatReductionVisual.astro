---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const source = { label: 'Source example', format: '48 kHz · stereo · Float32', math: '48,000 × 2 × 4 bytes', rate: '≈ 384 KB/sec' };
const target = { label: 'Transmitted format', format: '16 kHz · mono · Int16', math: '16,000 × 1 × 2 bytes', rate: '≈ 32 KB/sec' };
---

<ResearchFigureFrame
  className="audio-format-figure"
  figureNumber="02"
  title="Reduce the audio format before transport"
  caption="These values are derived from sample-format arithmetic before WebSocket overhead; they are not measured runtime benchmarks."
>
  <div class="comparison">
    <section>
      <span class="label">{source.label}</span>
      <strong>{source.format}</strong>
      <code>{source.math}</code>
      <span class="rate">{source.rate}</span>
    </section>
    <div class="transform"><span>Downsample</span><span aria-hidden="true">→</span><span>Clamp + Int16</span></div>
    <section class="target">
      <span class="label">{target.label}</span>
      <strong>{target.format}</strong>
      <code>{target.math}</code>
      <span class="rate">{target.rate}</span>
    </section>
  </div>
  <div class="result"><span class="result-value">≈ 91.7%</span><span>less raw sample data in this format comparison</span></div>
</ResearchFigureFrame>

<style>
  :global(.research-reading .research-prose figure.audio-format-figure) { border-radius: 0 !important; }
  .comparison { display: grid; border-block: 1px solid var(--border-subtle); }
  .comparison section { display: grid; gap: 0.45rem; padding: 1rem 0; }
  .comparison section.target { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .label, .transform, .result-value { font-family: var(--font-mono-ui); text-transform: uppercase; }
  .label { color: var(--text-muted); font-size: 0.6875rem; letter-spacing: 0.08em; }
  .comparison strong { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; }
  .comparison code { border: 0; background: transparent; padding: 0; color: var(--text-secondary); font-family: var(--font-mono-ui); font-size: 0.8125rem; }
  .rate { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.8125rem; }
  .transform { display: flex; align-items: center; justify-content: center; gap: 0.55rem; border-block: 1px solid var(--border-subtle); padding: 0.75rem; color: var(--text-muted); font-size: 0.6875rem; letter-spacing: 0.07em; }
  .result { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem; padding-top: 0.95rem; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.55; }
  .result-value { color: var(--accent); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; }
  @media (min-width: 720px) {
    .comparison { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
    .comparison section { padding: 1rem; }
    .comparison section:first-child { padding-left: 0; }
    .transform { flex-direction: column; min-width: 7.5rem; border-block: 0; border-inline: 1px solid var(--border-subtle); }
  }
</style>
