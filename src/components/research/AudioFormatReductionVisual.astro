---
import { ArrowDown, ArrowRight } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  className="audio-format-figure"
  figureNumber="01"
  title="Reduce before transport"
  status="Source arithmetic · not a benchmark"
  caption="The 91.7% reduction is arithmetic derived from the two stated sample formats before protocol overhead, not a measured bandwidth result."
>
  <div class="format-comparison">
    <section>
      <p class="figure-label">Source example</p>
      <h4 class="figure-node">48 kHz · stereo · Float32</h4>
      <code class="figure-support">48,000 × 2 × 4 bytes</code>
      <p class="rate figure-detail figure-accent">≈ 384 KB/sec</p>
    </section>

    <div class="transform" aria-label="Format transformation">
      <span class="figure-label">Downsample</span>
      <ArrowDown class="arrow-mobile" size={16} strokeWidth={1.75} aria-hidden="true" />
      <ArrowRight class="arrow-desktop" size={16} strokeWidth={1.75} aria-hidden="true" />
      <span class="figure-label">Clamp + Int16</span>
    </div>

    <section>
      <p class="figure-label">Transmitted format</p>
      <h4 class="figure-node">16 kHz · mono · Int16</h4>
      <code class="figure-support">16,000 × 1 × 2 bytes</code>
      <p class="rate figure-detail figure-accent">≈ 32 KB/sec</p>
    </section>
  </div>

  <p class="reduction figure-copy"><strong>≈ 91.7%</strong> less raw sample data in this comparison</p>
</ResearchFigureFrame>

<style>
  .audio-format-figure :global(p),
  .audio-format-figure :global(h4) {
    margin: 0;
  }

  .format-comparison {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .format-comparison section {
    min-width: 0;
    background: var(--bg-card);
    padding: 1.25rem;
  }

  .format-comparison h4 {
    margin-top: 0.75rem !important;
  }

  .format-comparison code {
    display: block;
    margin-top: 1rem;
    border: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    color: var(--text-secondary) !important;
    font-family: var(--font-mono-ui);
    white-space: normal;
  }

  .rate {
    margin-top: 0.5rem !important;
    font-family: var(--font-mono-ui);
  }

  .transform {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--bg-secondary);
    padding: 1rem;
    color: var(--text-muted);
    text-align: center;
  }

  .transform :global(svg) {
    color: var(--accent);
  }

  .arrow-desktop {
    display: none;
  }

  .reduction {
    margin-top: 1.25rem !important;
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }

  .reduction strong {
    color: var(--text-primary);
  }

  @media (min-width: 720px) {
    .format-comparison {
      grid-template-columns: minmax(0, 1fr) 7.5rem minmax(0, 1fr);
    }

    .arrow-mobile {
      display: none;
    }

    .arrow-desktop {
      display: block;
    }
  }
</style>
