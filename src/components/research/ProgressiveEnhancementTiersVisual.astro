---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  className="progressive-tiers-figure"
  eyebrow="Fig. 02 · Progressive enhancement model"
  title="The interface remains useful before intelligence is added."
  status="Capability can increase"
  caption="Application truth and action boundaries remain stable as capability changes."
>
  <div class="px-5 py-6 sm:px-6 sm:py-7">
    <div class="relative mx-auto max-w-3xl">
      <span
        class="tier-rail absolute bottom-6 left-[7px] top-6 w-px bg-[var(--border-strong)]"
        aria-hidden="true"
      ></span>

      <ol class="tier-list">
        <li class="tier-row tier-row-baseline">
          <span class="tier-node tier-node-baseline" aria-hidden="true"></span>
          <div class="tier-card tier-card-baseline">
            <div class="tier-card-header">
              <span class="tier-number">01</span>
              <span class="tier-title">Baseline</span>
            </div>
            <p>Useful interface without inference.</p>
          </div>
        </li>

        <li class="tier-row">
          <span class="tier-node" aria-hidden="true"></span>
          <div class="tier-card tier-card-optional">
            <div class="tier-card-header">
              <span class="tier-number">02</span>
              <span class="tier-title">Local enhancement</span>
            </div>
            <p>Add narrow intelligence when the environment supports it.</p>
          </div>
        </li>

        <li class="tier-row">
          <span class="tier-node" aria-hidden="true"></span>
          <div class="tier-card tier-card-optional">
            <div class="tier-card-header">
              <span class="tier-number">03</span>
              <span class="tier-title">Expanded inference</span>
            </div>
            <p>Add more capable or remote inference only when the task justifies it.</p>
          </div>
        </li>
      </ol>
    </div>

    <div class="mx-auto mt-7 max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="h-px flex-1 bg-[var(--accent)]" aria-hidden="true"></span>
        <span class="whitespace-nowrap font-editorial-mono text-[10px] uppercase tracking-[0.16em] text-[var(--accent)]">
          Authority stays bounded
        </span>
        <span class="h-px flex-1 bg-[var(--accent)]" aria-hidden="true"></span>
      </div>
      <p class="mt-3 text-center text-xs leading-5 text-[var(--text-muted)]">
        Application truth and action boundaries remain stable as capability changes.
      </p>
    </div>
  </div>
</ResearchFigureFrame>

<style>
  .progressive-tiers-figure :global(p),
  .progressive-tiers-figure :global(h3),
  .progressive-tiers-figure :global(ol),
  .progressive-tiers-figure :global(li) {
    margin: 0;
  }

  .progressive-tiers-figure :global(ol) {
    padding-left: 0;
  }

  .tier-list {
    display: grid;
    gap: 0.85rem;
  }

  .tier-row {
    position: relative;
    display: grid;
    grid-template-columns: 0.95rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
  }

  .tier-node {
    position: relative;
    z-index: 1;
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--accent);
    border-radius: 999px;
    background: var(--bg-card);
  }

  .tier-node-baseline {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg-card);
  }

  .tier-card {
    border-radius: 0.3rem;
    padding: 0.95rem 1rem;
  }

  .tier-card-baseline {
    border: 1px solid var(--accent);
    background: var(--accent-subtle);
  }

  .tier-card-optional {
    border: 1px dashed var(--border-strong);
    background: var(--bg-secondary);
  }

  .tier-card-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.65rem;
    min-width: 0;
  }

  .tier-number {
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .tier-title {
    min-width: 0;
    color: var(--text-primary);
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .tier-card :global(p) {
    margin-top: 0.45rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  @media (max-width: 380px) {
    .tier-row {
      grid-template-columns: 0.8rem minmax(0, 1fr);
      gap: 0.7rem;
    }

    .tier-node {
      width: 0.8rem;
      height: 0.8rem;
    }

    .tier-rail {
      left: 6px;
    }

    .tier-card {
      padding: 0.85rem;
    }
  }
</style>
