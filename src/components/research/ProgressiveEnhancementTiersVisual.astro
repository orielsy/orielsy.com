---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const implementations = [
  { title: 'Deterministic baseline', condition: 'Useful without inference', example: 'Indexed filtering + synonyms' },
  { title: 'Local inference', condition: 'Optional when viable', example: 'Local embeddings' },
  { title: 'Remote inference', condition: 'Optional when justified', example: 'Remote reranker' },
];
---

<ResearchFigureFrame
  className="optional-implementation-figure"
  figureNumber="03"
  title="Optional capability, stable boundaries"
  caption="These are possible search implementations, not a mandatory ladder, a runtime router, or a claim of equivalent results. Graceful degradation requires a fallback that has actually been designed and implemented."
>
  <p class="surface"><span>User interaction</span>Search</p>
  <div class="implementation-options" role="group" aria-label="Illustrative implementation options for search">
    {implementations.map((item) => (
      <div>
        <p class="condition">{item.condition}</p>
        <h4>{item.title}</h4>
        <p class="example">{item.example}</p>
      </div>
    ))}
  </div>
  <div class="invariant">
    <span>Application-owned boundaries</span>
    <p>State · Validation · Permitted actions</p>
  </div>
</ResearchFigureFrame>

<style>
  .optional-implementation-figure :global(p), .optional-implementation-figure :global(h4) { margin: 0; }
  .surface { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 0.9rem; }
  .surface span, .invariant span, .condition { color: var(--text-muted); font-family: var(--font-mono-ui); font-size: 0.6875rem; line-height: 1.5; text-transform: uppercase; }
  .surface { color: var(--text-primary); font-family: var(--font-display); font-size: 1rem; font-weight: 600; }
  .implementation-options { display: grid; border-block: 1px solid var(--border-subtle); }
  .implementation-options > div { min-width: 0; padding: 1rem 0; }
  .implementation-options > div + div { border-top: 1px solid var(--border-subtle); }
  .condition { color: var(--accent); }
  h4 { margin-top: 0.45rem !important; color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.45; }
  .example { margin-top: 0.45rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .invariant { display: grid; gap: 0.35rem 1rem; padding-top: 1rem; }
  .invariant span { color: var(--accent); }
  .invariant p { color: var(--text-primary); font-size: 0.875rem; line-height: 1.6; }
  @media (min-width: 640px) {
    .implementation-options { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .implementation-options > div { padding: 1.15rem 1.15rem 1.15rem 0; }
    .implementation-options > div + div { border-top: 0; border-left: 1px solid var(--border-subtle); padding-left: 1.15rem; }
    .invariant { grid-template-columns: 12rem minmax(0, 1fr); }
  }
</style>

<style>
  :global(.research-reading .research-prose figure.optional-implementation-figure) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.optional-implementation-figure) .surface { font-size: 1rem !important; line-height: 1.5 !important; }
  :global(.research-reading .research-prose figure.optional-implementation-figure) .example,
  :global(.research-reading .research-prose figure.optional-implementation-figure) .invariant p { font-size: 0.875rem !important; line-height: 1.6 !important; }
</style>
