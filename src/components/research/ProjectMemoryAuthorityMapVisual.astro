---
import { ArrowRight } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const rows = [
  ['Constitution', 'What must remain true?', 'Project-wide', 'Stated invariant'],
  ['Feature specification', 'What is required here?', 'Feature', 'Intended behavior'],
  ['Plan', 'How is it intended to be built?', 'Implementation approach', 'Strategy'],
  ['Tasks', 'What remains or is complete?', 'Current execution', 'Recorded state'],
  ['ADR', 'Why was this choice made?', 'Decision', 'Rationale'],
  ['Code + tests', 'What exists; what was checked?', 'Behavior / checks', 'Implementation / verification'],
];
---

<ResearchFigureFrame
  className="is-open"
  figureNumber="03"
  eyebrow="Interpretive model grounded in repository roles"
  title="Authority depends on the question"
  caption="This is an editorial model of the repository's artifact roles, not a claim that the repository contains an automatic precedence engine."
>
  <div class="authority-table" role="table" aria-label="Project memory authority by concern">
    <div class="authority-head" role="row">
      <span role="columnheader">Artifact</span>
      <span role="columnheader">Question answered</span>
      <span role="columnheader">Scope</span>
      <span role="columnheader">Evidence type</span>
    </div>

    {rows.map((row, index) => (
      <div class="authority-row" role="row">
        <span class="index">0{index + 1}</span>
        <strong role="cell">{row[0]}</strong>
        <span role="cell" data-label="Question">{row[1]}</span>
        <span role="cell" data-label="Scope">{row[2]}</span>
        <span class="evidence" role="cell" data-label="Evidence">{row[3]}</span>
      </div>
    ))}
  </div>

  <div class="authority-rule">
    <p>No single artifact answers every concern.</p>
    <ArrowRight class="rule-arrow" size={16} stroke-width={1.75} aria-hidden="true" />
    <p>When artifacts diverge, expose the conflict rather than flatten it.</p>
  </div>
</ResearchFigureFrame>

<style>
  .authority-head { display: none; }

  .authority-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.4rem 0.7rem;
    padding: 0.8rem 0;
  }

  .authority-row + .authority-row { border-top: 1px solid var(--border-subtle); }

  .index,
  .authority-head,
  .evidence,
  [data-label]::before { font-family: var(--font-mono-ui); }

  .index { color: var(--accent); font-size: 0.6875rem; }

  .authority-row strong {
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .authority-row > span:not(.index) {
    grid-column: 2;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  [data-label]::before {
    margin-right: 0.4rem;
    color: var(--text-muted);
    content: attr(data-label) ':';
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .authority-rule {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-secondary));
    padding: 1rem;
  }

  .authority-rule p {
    margin: 0 !important;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .authority-rule :global(.rule-arrow) {
    display: none;
    align-self: center;
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .authority-head,
    .authority-row {
      grid-template-columns: 2rem 1.05fr 1.5fr 1.05fr 1fr;
      gap: 0.8rem;
      align-items: center;
    }

    .authority-head {
      display: grid;
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 0 0.65rem;
      color: var(--text-muted);
      font-size: 0.6875rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .authority-head span:first-child { grid-column: 2; }
    .authority-row > span:not(.index),
    .authority-row strong { grid-column: auto; }
    [data-label]::before { display: none; }

    .authority-rule {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
    }

    .authority-rule :global(.rule-arrow) { display: block; }
    .authority-rule p:last-child { text-align: right; }
  }
</style>
