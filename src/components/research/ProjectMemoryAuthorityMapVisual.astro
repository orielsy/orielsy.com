---
import { ArrowRight } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const rows = [
  ['Constitution', 'What must remain true?', 'Project-wide', 'Stated invariant'],
  ['Feature specification', 'What is required here?', 'Feature', 'Intended behavior'],
  ['Plan', 'How is it intended to be built?', 'Implementation approach', 'Strategy'],
  ['Tasks', 'What remains or is complete?', 'Current execution', 'Recorded state'],
  ['ADR', 'Why was this choice made?', 'Decision', 'Rationale'],
  ['Code + tests', 'What exists; what was checked?', 'Behavior / checks', 'Implementation / verification'],
];
---

<ResearchFigureFrame
  className="project-memory-authority"
  figureNumber="03"
  title="Authority depends on the question"
  status="Interpretive model grounded in repository roles"
  caption="This is an editorial interpretation of the repository’s artifact roles, not a claim that the repository contains an automatic precedence engine."
>
  <div class="authority-head" aria-hidden="true"><span>Artifact</span><span>Question answered</span><span>Scope</span><span>Evidence type</span></div>
  <div class="authority-table" role="table" aria-label="Project memory authority by concern">
    {rows.map((row, index) => (
      <div class="authority-row" role="row">
        <span class="index">0{index + 1}</span>
        <strong role="cell">{row[0]}</strong>
        <span role="cell" data-label="Question">{row[1]}</span>
        <span role="cell" data-label="Scope">{row[2]}</span>
        <span class="evidence" role="cell" data-label="Evidence">{row[3]}</span>
      </div>
    ))}
  </div>

  <div class="authority-rule">
    <p>No single artifact answers every concern.</p>
    <ArrowRight class="rule-arrow" size={16} strokeWidth={1.6} aria-hidden="true" />
    <p>When artifacts diverge, expose the conflict rather than flatten it.</p>
  </div>
</ResearchFigureFrame>

<style>
  .project-memory-authority :global(p) { margin: 0; }
  .authority-head { display: none; }
  .authority-row { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.45rem 0.75rem; padding: 0.9rem 0; }
  .authority-row + .authority-row { border-top: 1px solid var(--border-subtle); }
  .index, .authority-head, [data-label]::before, .evidence { font-family: var(--font-mono-ui); }
  .index { color: var(--accent); font-size: var(--research-diagram-label, 0.625rem); line-height: 1.5; }
  .authority-row strong { color: var(--text-primary); font-size: var(--research-diagram-node, 0.875rem); font-weight: 600; line-height: 1.45; }
  .authority-row > span:not(.index) { grid-column: 2; color: var(--text-secondary); font-size: var(--research-diagram-copy, 0.875rem); line-height: 1.5; }
  .authority-row .evidence { font-size: var(--research-diagram-label, 0.625rem) !important; }
  [data-label]::before { margin-right: 0.4rem; color: var(--text-muted); content: attr(data-label) ' · '; font-size: var(--research-diagram-label, 0.625rem); text-transform: uppercase; }
  .authority-rule { display: grid; gap: 0.75rem; margin-top: 1rem; border-top: 1px dashed var(--border-subtle); padding-top: 0.9rem; }
  .authority-rule p { color: var(--text-secondary); font-size: var(--research-diagram-copy, 0.875rem); line-height: 1.6; }
  .rule-arrow { display: none; color: var(--accent); }

  @media (min-width: 760px) {
    .authority-head, .authority-row { grid-template-columns: 1.05fr 1.5fr 1.05fr 1fr; gap: 0.8rem; align-items: center; }
    .authority-head { display: grid; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.65rem; color: var(--text-muted); font-size: var(--research-diagram-label, 0.625rem); letter-spacing: 0.07em; text-transform: uppercase; }
    .authority-row { position: relative; padding-left: 2rem; }
    .index { position: absolute; left: 0; top: 1.05rem; }
    .authority-row > span:not(.index), .authority-row strong { grid-column: auto; }
    [data-label]::before { display: none; }
    .authority-rule { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 1rem; }
    .authority-rule p:last-child { text-align: right; }
    .rule-arrow { display: block; }
  }
</style>
