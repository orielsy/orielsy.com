---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const exclusions = [
  {
    title: 'Inference and retrieval',
    description: 'Document ingestion, semantic search, embeddings, natural-language intent resolution, and generated guidance.',
  },
  {
    title: 'Production infrastructure',
    description: 'Backend services, persistence, and authentication.',
  },
  {
    title: 'Learning and personalization',
    description: 'Telemetry, behavioral learning, and inferred user profiles.',
  },
  {
    title: 'Runtime integrations',
    description: 'WebLLM, MCP, and remote AI APIs.',
  },
] as const;
---

<ResearchFigureFrame
  className="phase-one-limitations"
  eyebrow="Phase 1 scope boundary"
  title="Intentionally not included."
  subtitle="The reference experiment keeps these capabilities outside Phase 1 so the deterministic architecture can be evaluated on its own terms."
>
  <dl class="limitations-ledger">
    {exclusions.map((item) => (
      <div class="limitation-row">
        <dt>
          <strong>{item.title}</strong>
          <span>Not included</span>
        </dt>
        <dd>{item.description}</dd>
      </div>
    ))}
  </dl>
</ResearchFigureFrame>

<style>
  .phase-one-limitations :global(dl),
  .phase-one-limitations :global(dt),
  .phase-one-limitations :global(dd) {
    margin: 0;
  }

  .limitations-ledger {
    border-top: 1px solid var(--border-subtle);
  }

  .limitation-row {
    display: grid;
    gap: 0.35rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.8rem 0.25rem;
  }

  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  dt strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  dt span {
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  dd {
    max-width: 46rem;
    color: var(--text-secondary);
    font-size: 0.71875rem;
    line-height: 1.55;
  }

  @media (min-width: 720px) {
    .limitation-row {
      grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.25fr);
      gap: 1.5rem;
      align-items: start;
      padding: 0.9rem 1rem;
    }

    dt {
      display: grid;
      gap: 0.25rem;
    }
  }
</style>
