---
const exclusions = [
  ['Inference and retrieval', 'Document ingestion, semantic search, embeddings, natural-language intent resolution, generated guidance'],
  ['Production infrastructure', 'Backend services, persistence, authentication'],
  ['Learning and personalization', 'Telemetry, behavioral learning, inferred user profiles'],
  ['Runtime integrations', 'WebLLM, MCP, remote AI APIs'],
];
---
<dl class="adaptive-limitations not-prose" aria-label="Capabilities outside Phase 1">
  {exclusions.map(([title, detail]) => <div><dt>{title}</dt><dd>{detail}</dd></div>)}
</dl>
<style>
  .adaptive-limitations { margin: 1.5rem 0 2rem; border-block: 1px solid var(--border-subtle); }
  .adaptive-limitations :global(dt), .adaptive-limitations :global(dd) { margin: 0; }
  .adaptive-limitations > div { display: grid; gap: .25rem; padding: .75rem 0; }
  .adaptive-limitations > div + div { border-top: 1px solid var(--border-subtle); }
  dt { color: var(--text-primary); font-family: var(--font-display); font-size: .875rem; font-weight: 600; }
  dd { color: var(--text-secondary); font-size: .875rem; line-height: 1.6; }
  @media (min-width: 640px) { .adaptive-limitations > div { grid-template-columns: 13rem minmax(0,1fr); gap: 1rem; } }
</style>
