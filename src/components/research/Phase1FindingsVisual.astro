---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

export interface Props {
  figureNumber?: string;
}

const { figureNumber } = Astro.props;

const findings = [
  {
    title: 'Product knowledge can participate in UI behavior without owning business logic',
    detail: 'Validation remains separate. Knowledge explains and enriches the experience around that validation.',
  },
  {
    title: 'Adaptation can be useful before inference',
    detail: 'User familiarity, product version, validation state, and option cardinality are enough to produce meaningfully different interface responses.',
  },
  {
    title: 'Certainty is a useful control on interface authority',
    detail: 'The difference between one compatible option and several compatible options is not cosmetic. It changes what the interface can responsibly do.',
  },
  {
    title: 'Progressive help can be modeled as policy rather than scattered component conditionals',
    detail: 'The renderer consumes structured responses. It does not need to rediscover why a message applies or whether an action is safe.',
  },
];
---

<ResearchFigureFrame
  className="phase-one-findings"
  {figureNumber}
  title="What the experiment supports."
  subtitle="The deterministic prototype clarifies what adaptation can already do and narrows the future role of inference."
  status="Deterministic prototype"
  caption="Four findings from the deterministic baseline. Inference stays bounded by ambiguity rather than owning application truth."
>
  <div class="findings-layout">
    <section class="supported-findings" aria-labelledby="supported-findings-title">
      <h4 id="supported-findings-title">Supported by Phase 1</h4>
      <ol>
        {findings.map((finding, index) => (
          <li>
            <span class="finding-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{finding.title}</strong>
              <p>{finding.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <aside class="implication-panel" aria-labelledby="architectural-implication-title">
      <p class="implication-label">Architectural implication</p>
      <h4 id="architectural-implication-title">A future AI layer has a narrower job than “control the UI.”</h4>
      <p>Inference is most useful where the application is genuinely ambiguous: interpreting freeform intent, ranking semantically relevant product knowledge, adapting explanations, or bridging combinations that were not explicitly authored.</p>
      <div class="implication-rule">
        <span>Narrower responsibility</span>
        <p>That is a much smaller and safer responsibility than asking a model to infer application truth.</p>
      </div>
    </aside>
  </div>
</ResearchFigureFrame>

<style>
  .phase-one-findings :global(p),
  .phase-one-findings :global(h4),
  .phase-one-findings :global(ol),
  .phase-one-findings :global(li) {
    margin: 0;
  }

  .phase-one-findings :global(ol) {
    padding: 0;
    list-style: none;
  }

  .findings-layout {
    display: grid;
    border-top: 1px solid var(--border-subtle);
  }

  .supported-findings {
    min-width: 0;
  }

  .supported-findings > h4,
  .implication-label,
  .implication-rule > span {
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .supported-findings > h4 {
    padding: 0.8rem 0.25rem;
    color: var(--text-primary);
  }

  .supported-findings ol {
    border-top: 1px solid var(--border-subtle);
  }

  .supported-findings li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.8rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.85rem 0.25rem;
  }

  .finding-number {
    padding-top: 0.1rem;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .supported-findings strong {
    display: block;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .supported-findings li p,
  .implication-panel > p,
  .implication-rule p {
    color: var(--text-secondary);
    font-size: 0.71875rem;
    line-height: 1.6;
  }

  .supported-findings li p {
    margin-top: 0.35rem !important;
  }

  .implication-panel {
    min-width: 0;
    border-top: 1px solid var(--border-subtle);
    padding: 1rem 0.25rem 0;
  }

  .implication-panel h4 {
    margin-top: 0.55rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .implication-panel > p:not(.implication-label) {
    margin-top: 0.7rem !important;
  }

  .implication-rule {
    margin-top: 1rem;
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
  }

  .implication-rule > span {
    color: var(--accent);
  }

  .implication-rule p {
    margin-top: 0.3rem !important;
  }

  @media (min-width: 820px) {
    .findings-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .supported-findings {
      border-right: 1px solid var(--border-subtle);
    }

    .supported-findings > h4,
    .supported-findings li {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .implication-panel {
      border-top: 0;
      padding: 1rem;
    }
  }
</style>
