---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const states = [
  { name: 'Healthy', description: 'History still supports the next action.' },
  { name: 'Watch', description: 'Contradictions or buried constraints are appearing.' },
  { name: 'Handoff', description: 'Faithful compact state would probably be easier to continue from.' },
];
---

<ResearchFigureFrame className="zen-health" figureNumber="03" title="Context health is a judgment, not a score" status="Qualitative · provisional" caption="No numeric threshold or validated scoring model exists here. No single signal forces handoff; the fresh-agent counterfactual remains an unvalidated heuristic.">
  <div class="states" role="group" aria-label="Three qualitative context-health states">
    {states.map((state) => <div><h4>{state.name}</h4><p>{state.description}</p></div>)}
  </div>
  <div class="signals">
    <div><h4>Hard signals can inform</h4><p>Context load · turn count · artifact count · tool-result volume</p></div>
    <div><h4>Semantic signals matter more</h4><p>Superseded state · colliding instructions · rediscovery · buried constraints · drift</p></div>
  </div>
</ResearchFigureFrame>

<style>
  .zen-health :global(p), .zen-health :global(h4) { margin: 0; }
  .states { display: grid; border-block: 1px solid var(--border-subtle); }
  .states > div { padding: 0.9rem 0; }
  .states > div + div { border-top: 1px solid var(--border-subtle); }
  h4 { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.5; }
  .states p, .signals p { margin-top: 0.35rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .signals { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .signals h4 { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; text-transform: uppercase; }
  @media (min-width: 640px) {
    .states { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .states > div { padding: 1rem 1rem 1rem 0; }
    .states > div + div { border-top: 0; border-left: 1px solid var(--border-subtle); padding-left: 1rem; }
    .signals { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
    .signals > div:first-child { padding-right: 1rem; }
    .signals > div + div { border-left: 1px solid var(--border-subtle); padding-left: 1rem; }
  }
</style>

<style>
  :global(.research-reading .research-prose figure.zen-health) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.zen-health) .states p, :global(.research-reading .research-prose figure.zen-health) .signals p { font-size: 0.875rem !important; line-height: 1.6 !important; }
</style>
