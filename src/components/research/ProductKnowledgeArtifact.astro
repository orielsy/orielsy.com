---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const relevantInformation = ['Customer identity', 'Restriction reason', 'Recent activity', 'Verification state'];
const availableActions = ['Request identity verification', 'Remove the restriction after verification succeeds', 'Escalate to risk review'];
---

<ResearchFigureFrame
  className="product-knowledge-artifact-figure"
  figureNumber="02"
  title="Product knowledge describes the task, not the mechanics"
  caption="Illustrative product knowledge artifact. It expresses intent, relevant information, available actions, and explanatory guidance without retrieving data, granting permission, or executing behavior."
>
  <section class="product-knowledge-artifact" aria-label="Illustrative product knowledge document: Account Review">
    <header class="artifact-header">
      <div>
        <p class="artifact-kicker">Illustrative product knowledge document</p>
        <h4 class="artifact-title">Account Review</h4>
      </div>
      <p class="artifact-boundary">Describes the task / implements nothing</p>
    </header>
    <div class="artifact-body">
      <section class="artifact-purpose">
        <h5>Purpose</h5>
        <p>Investigate a restricted customer account.</p>
      </section>
      <div class="artifact-columns">
        <section>
          <h5>Relevant information</h5>
          <ul>{relevantInformation.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section>
          <h5>Available actions</h5>
          <ul>{availableActions.map((item) => <li>{item}</li>)}</ul>
        </section>
      </div>
      <section class="artifact-guidance">
        <h5>Guidance</h5>
        <p>Explain unavailable actions through their unmet prerequisites.</p>
      </section>
    </div>
  </section>
</ResearchFigureFrame>

<style>
  .product-knowledge-artifact { min-width: 0; margin: 0; border: 1px solid var(--border-subtle); border-radius: 0.2rem; background: var(--bg-secondary); color: var(--text-primary); }
  .product-knowledge-artifact :global(p), .product-knowledge-artifact :global(h4), .product-knowledge-artifact :global(h5), .product-knowledge-artifact :global(ul) { margin: 0; }
  .artifact-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 0.75rem 1.5rem; padding: 1.25rem 1.5rem; }
  .artifact-kicker, h5 { color: var(--text-muted); font-family: var(--font-mono-ui); font-size: 0.625rem; font-weight: 500; line-height: 1.5; letter-spacing: 0.1em; text-transform: uppercase; }
  .artifact-boundary { max-width: 12rem; color: var(--accent); font-size: 0.75rem; line-height: 1.65; }
  .artifact-title { margin-top: 0.4rem !important; color: var(--text-primary); font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; line-height: 1.35; }
  .artifact-body { padding: 0 1.5rem 1.5rem; }
  .artifact-purpose, .artifact-columns, .artifact-guidance { border-top: 1px solid var(--border-subtle); padding-top: 0.9rem; }
  .artifact-purpose p { margin-top: 0.45rem !important; color: var(--text-primary); font-size: 0.875rem; line-height: 1.65; }
  .artifact-columns { display: grid; gap: 0.75rem 2rem; margin-top: 1.1rem; }
  .artifact-columns ul { display: grid; gap: 0.35rem; padding: 0; margin-top: 0.65rem !important; list-style: none; }
  .artifact-columns li { color: var(--text-primary); font-size: 0.8125rem; line-height: 1.55; }
  .artifact-guidance { margin-top: 1.1rem; }
  .artifact-guidance p { margin-top: 0.45rem !important; color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.6; }
  @media (min-width: 640px) { .artifact-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); } .artifact-boundary { text-align: right; } }
  @media (max-width: 390px) { .artifact-header, .artifact-body { padding-inline: 1rem; } }
</style>
