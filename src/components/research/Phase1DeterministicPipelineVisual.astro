---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
export interface Props { figureNumber?: string; }
const { figureNumber } = Astro.props;
const stages = [
  ['Application state', 'What the user selected'],
  ['Validation', 'Known requirements'],
  ['Runtime / user context', 'Version, familiarity, compatible options'],
  ['Applicable authored knowledge', 'Fragments matching explicit facts'],
  ['Response policy', 'Evidence bounds intervention'],
  ['Structured UI response', 'Render permitted guidance or offer'],
];
---

<ResearchFigureFrame
  className="adaptive-pipeline"
  {figureNumber}
  title="Six decision stages; seven distinct concerns"
  status="Phase 1 · deterministic"
  caption="Domain state, runtime context, validation, product knowledge, knowledge applicability, response policy, and rendering remain distinct. The lab uses authored fixtures, not a document-ingestion pipeline. No inference is required."
>
  <ol aria-label="Deterministic Phase 1 decision path">
    {stages.map(([title, detail], index) => (
      <li>
        <span class="figure-meta figure-accent">0{index + 1}</span>
        <div>
          <h4 class="figure-node">{title}</h4>
          <p class="figure-support">{detail}</p>
        </div>
      </li>
    ))}
  </ol>
  <p class="boundary figure-copy">Application state and validation remain authoritative.</p>
</ResearchFigureFrame>

<style>
  .adaptive-pipeline :global(ol),
  .adaptive-pipeline :global(li),
  .adaptive-pipeline :global(h4),
  .adaptive-pipeline :global(p) {
    margin: 0;
  }

  .adaptive-pipeline :global(ol) {
    padding: 0;
    list-style: none;
  }

  ol {
    display: grid;
    border-block: 1px solid var(--border-subtle);
  }

  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.65rem;
    padding: 0.85rem 0;
  }

  li + li {
    border-top: 1px solid var(--border-subtle);
  }

  li .figure-meta {
    line-height: 1.8 !important;
  }

  li .figure-support {
    margin-top: 0.25rem !important;
  }

  .boundary {
    margin-top: 1rem !important;
    color: var(--text-primary) !important;
  }

  @media (min-width: 640px) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    li {
      display: block;
      padding: 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    li + li {
      border-top: 0;
    }

    li:nth-child(3n + 2),
    li:nth-child(3n + 3) {
      border-left: 1px solid var(--border-subtle);
    }

    li:nth-child(3n + 1) {
      padding-left: 0;
    }

    li:nth-child(n + 4) {
      border-bottom: 0;
    }

    li .figure-node {
      margin-top: 0.45rem !important;
    }
  }
</style>
