---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const stages = [
  { title: 'Application state', detail: 'What the user has selected' },
  { title: 'Deterministic validation', detail: 'Known application requirements' },
  { title: 'Product / runtime context', detail: 'Version, familiarity, compatible options' },
  { title: 'Applicable authored knowledge', detail: 'Only fragments supported by current facts', emphasis: 'knowledge' },
  { title: 'Response policy', detail: 'Choose explanation, guidance, or safe offer', emphasis: 'policy' },
  { title: 'Structured UI response', detail: 'Render the authorized intervention', emphasis: 'output' },
] as const;
---

<ResearchFigureFrame
  className="phase-one-pipeline"
  eyebrow="Phase 1 decision path"
  title="A deterministic path from state to interface response."
  subtitle="Explicit application facts narrow applicable product knowledge before response policy decides how strongly the interface may act."
  status="Deterministic · no inference"
  caption="Known facts remain in code and configuration. Application truth stays authoritative."
>
  <ol class="pipeline-grid" aria-label="Phase 1 deterministic pipeline">
    {stages.map((stage, index) => (
      <li class:list={[stage.emphasis && `is-${stage.emphasis}`]}>
        <span class="node-number">{String(index + 1).padStart(2, '0')}</span>
        <strong>{stage.title}</strong>
        <small>{stage.detail}</small>
      </li>
    ))}
  </ol>
</ResearchFigureFrame>

<style>
  .phase-one-pipeline :global(ol),
  .phase-one-pipeline :global(li) {
    margin: 0;
  }

  .phase-one-pipeline :global(ol) {
    padding: 0;
    list-style: none;
  }

  .pipeline-grid {
    display: grid;
    border-top: 1px solid var(--border-subtle);
    border-left: 1px solid var(--border-subtle);
  }

  .pipeline-grid li {
    position: relative;
    min-width: 0;
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
    padding: 0.9rem;
  }

  .node-number {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }

  .pipeline-grid strong,
  .pipeline-grid small {
    display: block;
  }

  .pipeline-grid strong {
    margin-top: 0.9rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .pipeline-grid small {
    margin-top: 0.3rem;
    color: var(--text-secondary);
    font-size: 0.71875rem;
    line-height: 1.5;
  }

  .is-knowledge,
  .is-policy {
    box-shadow: inset 2px 0 0 color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .is-output {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-card)) !important;
    box-shadow: inset 2px 0 0 var(--accent);
  }

  @media (min-width: 640px) {
    .pipeline-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pipeline-grid li {
      min-height: 8rem;
    }
  }
</style>
