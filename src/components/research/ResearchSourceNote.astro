---
interface Props {
  label?: string;
}

const { label = 'Source grounding' } = Astro.props;
---

<aside class="research-source-note not-prose" role="note">
  <p class="source-label">{label}</p>
  <div class="source-body">
    <slot />
  </div>
</aside>

<style>
  .research-source-note {
    display: grid;
    gap: 0.65rem;
    margin: 2rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.9rem 0;
  }

  .source-label {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .source-body {
    max-width: 46rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .source-body :global(p) {
    margin: 0;
    line-height: inherit;
  }

  .source-body :global(code) {
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--text-secondary);
    font-family: var(--font-mono-ui);
    font-size: inherit;
  }

  .source-body :global(a) {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.16em;
  }

  .source-body :global(a:hover) {
    color: var(--text-primary);
    text-decoration-color: var(--accent);
  }

  @media (min-width: 640px) {
    .research-source-note {
      grid-template-columns: 8.75rem minmax(0, 1fr);
      align-items: start;
      gap: 1.25rem;
    }
  }
</style>
