---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const flows = [
  {
    label: 'Drift pattern',
    accent: false,
    steps: ['Requirement changes', 'Patch implementation', 'Leave old specification behind'],
    outcome: 'Repository intent and behavior diverge',
  },
  {
    label: 'Preferred workflow',
    accent: true,
    steps: ['Requirement changes', 'Update spec / rule / decision', 'Update implementation'],
    outcome: 'Repository memory and behavior stay aligned',
  },
];
---

<ResearchFigureFrame
  title="Update durable intent before letting the implementation become the only record."
  caption="Requirement changes should update durable project intent and implementation together so later work does not inherit a stale source of truth."
>
  <div class="flows">
    {flows.map((flow) => (
      <section class:list={['flow', flow.accent && 'is-preferred']}>
        <div class="flow-label">{flow.label}</div>
        <div class="step-row">
          {flow.steps.map((step, index) => (
            <>
              <div class="step">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{step}</strong>
              </div>
              {index < flow.steps.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
            </>
          ))}
        </div>
        <div class="outcome">{flow.outcome}</div>
      </section>
    ))}
  </div>
</ResearchFigureFrame>

<style>
  .flows {
    display: grid;
    gap: 1px;
    border-block: 1px solid var(--border-subtle);
    background: var(--border-subtle);
  }

  .flow {
    background: var(--bg-card);
    padding: 1rem;
  }

  .flow.is-preferred {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .flow-label,
  .step span {
    font-family: var(--font-mono-ui);
    text-transform: uppercase;
  }

  .flow-label {
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .is-preferred .flow-label {
    color: var(--accent);
  }

  .step-row {
    display: grid;
    gap: 0.45rem;
  }

  .step {
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding: 0.7rem 0.75rem;
  }

  .step span {
    display: block;
    color: var(--text-muted);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }

  .step strong {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .arrow {
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
  }

  .outcome {
    margin-top: 0.7rem;
    border-left: 2px solid var(--border-strong);
    padding: 0.55rem 0.7rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .is-preferred .outcome {
    border-left-color: var(--accent);
    color: var(--text-primary);
  }

  @media (min-width: 760px) {
    .step-row {
      grid-template-columns: minmax(0, 1fr) 1.5rem minmax(0, 1fr) 1.5rem minmax(0, 1fr);
      align-items: stretch;
    }

    .arrow {
      display: flex;
    }
  }
</style>
