---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const lanes = [
  {
    label: 'Transient working context',
    tone: 'quiet',
    steps: ['Current task', 'Conversation', 'Temporary reasoning', 'Implementation attempt'],
  },
  {
    label: 'Durable project memory',
    tone: 'accent',
    steps: ['Project rule / requirement / decision', 'Version-controlled artifact', 'Discoverable in later sessions', 'Available before the next implementation change'],
  },
];
---

<ResearchFigureFrame
  title="Conversation context is not project memory."
  subtitle="One helps with the task in front of the agent. The other gives later work something durable to recover."
  caption="The left lane expires with the conversation; the right lane persists as version-controlled project state."
>
  <div class="lanes">
    {lanes.map((lane) => (
      <section class:list={['lane', lane.tone === 'accent' && 'is-durable']}>
        <div class="lane-label">{lane.label}</div>
        <ol>
          {lane.steps.map((step, index) => (
            <li>
              <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</ResearchFigureFrame>

<style>
  .lanes {
    display: grid;
    gap: 1px;
    border-block: 1px solid var(--border-subtle);
    background: var(--border-subtle);
  }

  .lane {
    background: var(--bg-card);
    padding: 1rem;
  }

  .lane.is-durable {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .lane-label,
  .step-number {
    font-family: var(--font-mono-ui);
    text-transform: uppercase;
  }

  .lane-label {
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.625rem;
    letter-spacing: 0.11em;
  }

  .is-durable .lane-label {
    color: var(--accent);
  }

  ol {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.7rem;
    min-height: 2.85rem;
    margin: 0;
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding: 0.6rem 0.7rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .is-durable li {
    border-color: color-mix(in srgb, var(--accent) 18%, var(--border-subtle));
  }

  .step-number {
    color: var(--text-muted);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }

  .is-durable .step-number {
    color: var(--accent);
  }

  @media (min-width: 720px) {
    .lanes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
