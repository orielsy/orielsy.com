---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const sessions = [
  {
    label: 'Session 1',
    detail: 'Current task, conversation, and local reasoning',
  },
  {
    label: 'Session 2',
    detail: 'A new working context starts from what it can recover',
  },
  {
    label: 'Session 3',
    detail: 'Later work can recover durable repository state again',
  },
];

const artifacts = ['AGENTS.md', 'Constitution', 'Feature specs', 'ADRs'];
---

<ResearchFigureFrame
  title="Conversation context can end. Project memory persists."
  subtitle="Each session gets its own working context. Version-controlled repository knowledge remains available across sessions."
  caption="Conversation history is not guaranteed to carry forward. Durable project state remains in the repository for later sessions to recover."
>
  <div class="memory-timeline">
    <div class="time-axis" aria-hidden="true">
      <span>Earlier</span>
      <span>Session sequence →</span>
      <span>Later</span>
    </div>

    <ol class="session-track" aria-label="Successive coding-agent sessions">
      {sessions.map((session) => (
        <li class="session">
          <div class="session-heading">
            <span>{session.label}</span>
            <strong>Working context</strong>
          </div>
          <p>{session.detail}</p>
          <div class="session-boundary">Not guaranteed to carry forward</div>
          <div class="mobile-read">Reads the same durable repository memory</div>
        </li>
      ))}
    </ol>

    <div class="read-connectors" aria-hidden="true">
      {sessions.map(() => (
        <div class="read-connector"><span>reads</span></div>
      ))}
    </div>

    <section class="repository" aria-label="Durable project memory">
      <div class="repository-heading">
        <span>Persistent layer</span>
        <strong>Version-controlled project memory</strong>
      </div>
      <div class="artifacts" aria-label="Examples of durable project memory">
        {artifacts.map((artifact) => <code>{artifact}</code>)}
      </div>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .memory-timeline {
    min-width: 0;
    border-block: 1px solid var(--border-subtle);
  }

  .time-axis {
    display: none;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0 0 0.65rem;
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .time-axis span:last-child {
    text-align: right;
  }

  .session-track {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .session {
    min-width: 0;
    margin: 0;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.9rem 0.8rem;
    background: var(--bg-card);
  }

  .session-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
  }

  .session-heading span,
  .session-boundary,
  .mobile-read,
  .repository-heading span,
  .read-connector span {
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .session-heading span {
    color: var(--text-muted);
  }

  .session-heading strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .session p {
    margin: 0.45rem 0 0 !important;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .session-boundary {
    margin-top: 0.75rem;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.5rem;
    color: var(--text-muted);
  }

  .mobile-read {
    margin-top: 0.55rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .read-connectors {
    display: none;
  }

  .repository {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
    padding: 1rem 0.8rem;
  }

  .repository-heading {
    display: grid;
    gap: 0.25rem;
  }

  .repository-heading span {
    color: var(--accent);
  }

  .repository-heading strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .artifacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-top: 0.75rem;
  }

  .artifacts code {
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--text-secondary);
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (min-width: 720px) {
    .memory-timeline {
      padding-top: 0.1rem;
    }

    .time-axis {
      display: grid;
    }

    .session-track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--border-subtle);
    }

    .session {
      min-height: 9.5rem;
      border-right: 1px solid var(--border-subtle);
      border-bottom: 0;
      padding: 0.95rem 1rem;
    }

    .session:last-child {
      border-right: 0;
    }

    .mobile-read {
      display: none;
    }

    .read-connectors {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      height: 3.3rem;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-card);
    }

    .read-connector {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
    }

    .read-connector::before {
      position: absolute;
      inset-block: 0;
      left: 50%;
      width: 1px;
      background: color-mix(in srgb, var(--accent) 55%, var(--border-subtle));
      content: '';
    }

    .read-connector span {
      position: relative;
      z-index: 1;
      background: var(--bg-card);
      padding: 0.15rem 0.4rem;
      color: var(--accent);
    }

    .repository {
      display: grid;
      grid-template-columns: minmax(13rem, 0.9fr) minmax(0, 1.7fr);
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.1rem;
    }

    .artifacts {
      justify-content: flex-end;
      margin-top: 0;
    }
  }
</style>
