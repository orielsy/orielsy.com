---
import { ArrowRight, AudioLines, Captions, Check, Server } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const stages = [
  { icon: AudioLines, name: 'Capture', detail: 'Microphone audio', owner: 'Electron client' },
  { icon: ArrowRight, name: 'Transport', detail: 'PCM: client → local service', owner: 'Process boundary' },
  { icon: Server, name: 'Inference', detail: 'Segments + metadata: service → client policy', owner: 'Local FastAPI service' },
  { icon: Check, name: 'Acceptance', detail: 'Returned segment evaluated before queue entry', owner: 'Client policy', accent: true },
  { icon: Captions, name: 'Presentation', detail: 'Accepted state → overlay → OBS composition', owner: 'Electron overlay / OBS' },
];
---

<ResearchFigureFrame
  className="speech-boundary-figure"
  figureNumber="01"
  title="The system boundary"
  status="Shared bridge · project-level topology"
  caption="The project keeps enough topology to explain ownership and the bidirectional hand-off. Exact formats, thresholds, chunk duration, and render scheduling are delegated to the companion research paper."
>
  <ol class="boundary-path" aria-label="speechBubbles system responsibility boundary">
    {stages.map((stage, index) => {
      const Icon = stage.icon;
      return (
        <li class:list={[stage.accent && 'is-accent']}>
          <span class="path-node" aria-hidden="true"></span>
          <div class="stage-heading">
            <Icon size={16} strokeWidth={1.75} aria-hidden="true" />
            <span class:list={['figure-meta', stage.accent && 'figure-accent']}>0{index + 1}</span>
          </div>
          <h4 class="figure-node">{stage.name}</h4>
          <p class="figure-support">{stage.detail}</p>
          <p class="figure-label owner">{stage.owner}</p>
        </li>
      );
    })}
  </ol>
</ResearchFigureFrame>

<style>
  .speech-boundary-figure :global(p),
  .speech-boundary-figure :global(h4),
  .speech-boundary-figure :global(ol),
  .speech-boundary-figure :global(li) {
    margin: 0;
  }

  .speech-boundary-figure :global(ol) {
    padding: 0;
    list-style: none;
  }

  .boundary-path {
    display: grid;
  }

  .boundary-path li {
    position: relative;
    min-width: 0;
    border-left: 1px solid var(--border-subtle);
    padding: 1rem 0 1rem 1.25rem;
  }

  .boundary-path li.is-accent {
    border-left: 2px solid var(--accent);
    background: var(--bg-secondary);
  }

  .path-node {
    position: absolute;
    top: 1.5rem;
    left: -0.25rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--border-strong);
  }

  .is-accent .path-node {
    background: var(--accent);
  }

  .stage-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .is-accent .stage-heading {
    color: var(--accent);
  }

  .figure-node {
    margin-top: 0.5rem !important;
  }

  .figure-support {
    margin-top: 0.5rem !important;
    color: var(--text-secondary);
  }

  .owner {
    margin-top: 1rem !important;
  }

  @media (min-width: 760px) {
    .boundary-path {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .boundary-path li {
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
      padding: 1.5rem 0.75rem 1rem;
    }

    .boundary-path li.is-accent {
      border-left: 0;
      border-top: 2px solid var(--accent);
    }

    .path-node {
      top: -0.25rem;
      left: 1rem;
    }
  }
</style>
