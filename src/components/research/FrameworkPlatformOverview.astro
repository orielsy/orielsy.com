    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.65rem 1rem;
  }

  .overview-heading h3,
  .overview-section h3 {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .overview-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .overview-grid section {
