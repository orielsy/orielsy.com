  }

  .overview-intro h2 {
    margin-top: 0.65rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

