---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const retained = ['Current objective', 'Decisions still in force', 'Relevant constraints', 'Rejected paths likely to recur', 'Active artifacts', 'Unresolved questions', 'Immediate next step'];
---

<ResearchFigureFrame className="zen-distillation" figureNumber="01" title="History records events; a handoff reconstructs state" caption="Selecting what still governs continuation is the proposal, not evidence that reduced context performs better. The transcript sequence is illustrative.">
  <div class="comparison">
    <section aria-labelledby="zen-history">
      <h4 id="zen-history">Accumulated transcript <span>Chronology</span></h4>
      <ol>
        <li>Initial objective</li><li>Exploration</li><li>Rejected direction</li><li>Correction</li><li>Superseded decision</li><li>Current implementation</li><li>Unresolved question</li>
      </ol>
    </section>
    <section aria-labelledby="zen-state">
      <h4 id="zen-state">Authoritative working state <span>Continuation</span></h4>
      <ul>{retained.map((item) => <li>{item}</li>)}</ul>
    </section>
  </div>
  <div class="selection-note"><span>May compress</span><p>Chronology · abandoned exploration · obsolete assumptions · repeated explanations · agent self-commentary</p></div>
</ResearchFigureFrame>

<style>
  .zen-distillation :global(p), .zen-distillation :global(h4), .zen-distillation :global(ol), .zen-distillation :global(ul), .zen-distillation :global(li) { margin: 0; }
  .zen-distillation :global(ol), .zen-distillation :global(ul) { padding: 0; list-style: none; }
  .comparison { display: grid; gap: 1.5rem; }
  .comparison section { min-width: 0; }
  .comparison section + section { border-top: 1px solid var(--border-subtle); padding-top: 1.25rem; }
  h4 { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.5; }
  h4 span { display: block; color: var(--text-muted); font-family: var(--font-mono-ui); font-size: 0.6875rem; font-weight: 400; text-transform: uppercase; }
  .comparison ol, .comparison ul { margin-top: 0.8rem !important; }
  .comparison li { border-bottom: 1px solid var(--border-subtle); padding: 0.38rem 0; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; }
  .comparison li:last-child { border-bottom: 0; }
  .comparison section:last-child li { color: var(--text-primary); }
  .selection-note { display: grid; gap: 0.35rem 1rem; margin-top: 1.25rem; border-top: 1px solid var(--border-strong); padding-top: 1rem; }
  .selection-note span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; text-transform: uppercase; }
  .selection-note p { color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  @media (min-width: 640px) {
    .comparison { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
    .comparison section:first-child { padding-right: 1.5rem; }
    .comparison section + section { border-top: 0; border-left: 1px solid var(--border-subtle); padding: 0 0 0 1.5rem; }
    .selection-note { grid-template-columns: 8rem minmax(0, 1fr); }
  }
</style>

<style>
  :global(.research-reading .research-prose figure.zen-distillation) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.zen-distillation) .selection-note p { font-size: 0.875rem !important; line-height: 1.6 !important; }
</style>
