---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const steps = [
  {
    label: 'Framework-owned capability',
    detail: 'Multiple frameworks independently maintain reactive graphs and dependency tracking.',
  },
  {
    label: 'Shared ecosystem behavior',
    detail: 'Enough implementations converge that the common semantics become easier to describe.',
  },
  {
    label: 'Standardizable primitive',
    detail: 'TC39 can explore a lower-level signal graph that multiple frameworks could build upon.',
  },
  {
    label: 'Framework layer moves up',
    detail: 'Scheduling, effects, rendering policy, ownership, and composition remain framework concerns.',
  },
];
---

<ResearchFigureFrame
  eyebrow="Platformization pattern"
  title="The primitive can move downward without the framework disappearing."
  status="Signals as a lower-level substrate"
  caption="Standardizing a lower-level mechanism changes the implementation boundary; it does not standardize the framework policy above it."
>
  <ol class="signal-path">
    {steps.map((step, index) => (
      <li>
        <div class="step-head">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{step.label}</strong>
        </div>
        <p>{step.detail}</p>
        {index < steps.length - 1 && <span class="connector" aria-hidden="true">→</span>}
      </li>
    ))}
  </ol>
</ResearchFigureFrame>

<style>
  .signal-path {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--border-subtle);
    list-style: none;
  }

  li {
    position: relative;
    background: var(--bg-card);
    padding: 1rem 1.05rem 1.05rem;
  }

  .step-head {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
  }

  .step-head span {
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .step-head strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.77rem;
    font-weight: 600;
    line-height: 1.4;
  }

  li p {
    margin: 0.45rem 0 0 !important;
    padding-left: 2.55rem;
    color: var(--text-muted);
    font-size: 0.64rem;
    line-height: 1.55;
  }

  .connector {
    display: none;
  }

  @media (min-width: 760px) {
    .signal-path {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    li {
      min-height: 9rem;
      padding: 1rem 1.05rem;
    }

    .step-head {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    li p {
      padding-left: 0;
    }

    .connector {
      position: absolute;
      top: 50%;
      right: -0.72rem;
      z-index: 2;
      display: flex;
      width: 1.45rem;
      height: 1.45rem;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      background: var(--bg-card);
      color: var(--accent);
      font-family: var(--font-mono-ui);
      font-size: 0.68rem;
      transform: translateY(-50%);
    }
  }
</style>
