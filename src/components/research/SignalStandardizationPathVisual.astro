---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const steps = [
  {
    label: 'Framework-owned capability',
    detail: 'Multiple frameworks independently maintain reactive graphs and dependency tracking.',
  },
  {
    label: 'Shared ecosystem behavior',
    detail: 'Enough implementations converge that the common semantics become easier to describe.',
  },
  {
    label: 'Standardizable primitive',
    detail: 'TC39 can explore a lower-level signal graph that multiple frameworks could build upon.',
  },
  {
    label: 'Framework policy remains',
    detail: 'Scheduling, effects, rendering coordination, ownership, disposal, and composition stay above the primitive.',
  },
];
---

<ResearchFigureFrame
  className="signal-standardization-figure"
  figureNumber="02"
  title="A primitive can move downward without the framework disappearing"
  caption="Signals illustrates the distinction between standardizing a common low-level mechanism and standardizing the framework policy built above it."
>
  <ol class="signal-path">
    {steps.map((step, index) => (
      <li>
        <div class="step-head">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{step.label}</strong>
        </div>
        <p>{step.detail}</p>
      </li>
    ))}
  </ol>
</ResearchFigureFrame>

<style>
  :global(.research-reading .research-prose figure.signal-standardization-figure) { border-radius: 0 !important; }
  .signal-path { display: grid; margin: 0; padding: 0; border-block: 1px solid var(--border-subtle); list-style: none; }
  li { margin: 0; padding: 1rem 0; }
  li + li { border-top: 1px solid var(--border-subtle); }
  .step-head { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.55rem; align-items: baseline; }
  .step-head span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .step-head strong { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.4; }
  li p { margin: 0.45rem 0 0 !important; padding-left: 2.55rem; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  @media (min-width: 760px) {
    .signal-path { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    li { min-width: 0; padding: 1rem; }
    li:first-child { padding-left: 0; }
    li + li { border-top: 0; border-left: 1px solid var(--border-subtle); }
    .step-head { grid-template-columns: 1fr; gap: 0.35rem; }
    li p { padding-left: 0; }
  }
</style>
