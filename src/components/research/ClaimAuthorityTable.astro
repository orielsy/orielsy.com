---
const rows = [
  { claim: 'Current facts', owner: 'Application state' },
  { claim: 'Implemented behavior', owner: 'Code' },
  { claim: 'Intended behavior', owner: 'Governing specification or policy' },
  { claim: 'Meaning and explanation', owner: 'Product knowledge' },
];
---

<figure class="claim-authority not-prose" aria-labelledby="claim-authority-title">
  <header class="claim-authority-header">
    <div class="claim-authority-identity">
      <svg
        class="claim-authority-icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3v18" />
        <path d="M5 7h14" />
        <path d="m7 7-3 5h6L7 7Z" />
        <path d="m17 7-3 5h6l-3-5Z" />
        <path d="M8 21h8" />
      </svg>

      <div>
        <p class="claim-authority-kicker">Authority map</p>
        <h3 id="claim-authority-title">Claim authority</h3>
      </div>
    </div>

    <p class="claim-authority-boundary">Neither code nor docs always wins</p>
  </header>

  <div class="claim-authority-body">
    <div class="claim-authority-rows">
      {rows.map((row) => (
        <div class="claim-authority-row">
          <p class="claim-authority-claim">{row.claim}</p>
          <svg
            class="claim-authority-arrow"
            aria-hidden="true"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 8h9" />
            <path d="m9 5 3 3-3 3" />
          </svg>
          <p class="claim-authority-owner">{row.owner}</p>
        </div>
      ))}
    </div>

    <div class="claim-authority-disagreement">
      <p class="claim-authority-claim">Any disagreement between them</p>
      <svg
        class="claim-authority-arrow"
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 8h9" />
        <path d="m9 5 3 3-3 3" />
      </svg>
      <p class="claim-authority-outcome">A defect to expose, not a conflict to override</p>
    </div>
  </div>
</figure>

<style>
  .claim-authority {
    overflow: hidden;
    margin: 2rem 0 2.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .claim-authority :global(p),
  .claim-authority :global(h3) {
    margin: 0;
  }

  .claim-authority-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
  }

  .claim-authority-identity {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.85rem;
  }

  .claim-authority-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
    color: var(--accent);
  }

  .claim-authority-kicker,
  .claim-authority-boundary {
    font-family: var(--font-mono-ui);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .claim-authority-kicker {
    color: var(--text-muted);
  }

  .claim-authority-boundary {
    color: var(--text-muted);
  }

  h3 {
    margin-top: 0.28rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .claim-authority-body {
    padding: 0 1.5rem 1.25rem;
  }

  .claim-authority-rows {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .claim-authority-row,
  .claim-authority-disagreement {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    padding: 0.85rem 0;
  }

  .claim-authority-row + .claim-authority-row {
    border-top: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent);
  }

  .claim-authority-claim,
  .claim-authority-owner,
  .claim-authority-outcome {
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .claim-authority-claim {
    color: var(--text-primary);
    font-weight: 600;
  }

  .claim-authority-owner {
    padding-left: 1rem;
    color: var(--text-secondary);
  }

  .claim-authority-outcome {
    padding-left: 1rem;
    color: var(--accent);
    font-weight: 600;
  }

  .claim-authority-arrow {
    display: none;
    width: 0.9rem;
    height: 0.9rem;
    color: var(--accent);
  }

  .claim-authority-disagreement {
    padding-top: 1rem;
    padding-bottom: 0;
  }

  @media (min-width: 640px) {
    .claim-authority-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.5rem 2rem;
    }

    .claim-authority-boundary {
      flex: 0 0 auto;
      text-align: right;
    }

    h3 {
      font-size: 1.125rem;
    }

    .claim-authority-body {
      padding: 1rem 2rem 1.4rem;
    }

    .claim-authority-row,
    .claim-authority-disagreement {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.1fr);
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 0;
    }

    .claim-authority-arrow {
      display: block;
    }

    .claim-authority-owner,
    .claim-authority-outcome {
      padding-left: 0;
      text-align: right;
    }

    .claim-authority-disagreement {
      padding-top: 1rem;
      padding-bottom: 0;
    }
  }
</style>
