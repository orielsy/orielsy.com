---
import { GitBranch } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';
---

<ResearchFigureFrame
  className="project-memory-drift"
  figureNumber="07"
  title="Persistence without reconciliation"
  status="Observed repository inconsistency"
  caption="Version control makes drift visible; it does not perform maintenance. This figure does not assert that either artifact automatically outranks the other."
>
  <div class="drift-comparison">
    <section>
      <div class="section-meta"><p class="label">Earlier accepted record</p><span>ADR 003 · 2026-08-26</span></div>
      <h4 class="figure-node-feature">Manual publishing model</h4>
      <p>Centers production publishing on <code>npm run live</code> from <code>main</code> and says a repository-authored Actions workflow is not required.</p>
    </section>

    <div class="divergence" aria-label="Documents disagree"><span>Divergence</span></div>

    <section>
      <div class="section-meta"><p class="label">Current guidance + implementation</p><GitBranch class="branch-icon" size={16} strokeWidth={1.6} aria-hidden="true" /></div>
      <h4 class="figure-node-feature">Three supported paths</h4>
      <ol>
        <li><span>01</span>Local <code>npm run live</code></li>
        <li><span>02</span>GitHub Actions manual dispatch</li>
        <li><span>03</span>Remote trigger branch</li>
      </ol>
      <p class="source-note figure-meta">Confirmed in AGENTS.md, README.md, and .github/workflows/deploy-production.yml</p>
    </section>
  </div>

  <div class="drift-outcomes">
    <div><span>Preserved</span><p>Both accounts remain inspectable.</p></div>
    <div><span>Not resolved</span><p>The repository does not automatically choose a winner.</p></div>
    <div><span>Human action</span><p>Amend, supersede, or reconcile the record.</p></div>
  </div>
</ResearchFigureFrame>

<style>
  .project-memory-drift :global(p), .project-memory-drift :global(h4), .project-memory-drift :global(ol), .project-memory-drift :global(li) { margin: 0; }
  .project-memory-drift :global(ol) { padding: 0; list-style: none; }
  .drift-comparison { display: grid; gap: 1rem; }
  section { min-width: 0; }
  .section-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .label, .section-meta > span, .divergence span, .source-note, .drift-outcomes span, li span, code { font-family: var(--font-mono-ui); }
  .label, .drift-outcomes span, .divergence span, .section-meta > span { font-size: var(--research-diagram-label, 0.625rem); letter-spacing: 0.07em; text-transform: uppercase; }
  .label, .section-meta > span, .source-note { color: var(--text-muted); }
  .branch-icon { color: var(--accent); }
  h4 { margin-top: 0.75rem !important; }
  section > p:not(.label):not(.source-note) { margin-top: 0.6rem !important; color: var(--text-secondary); font-size: var(--research-diagram-copy, 0.875rem); line-height: 1.6; }
  code { border: 0 !important; background: transparent !important; padding: 0 !important; color: var(--text-primary) !important; font-size: 0.6875rem !important; }
  .divergence { display: flex; align-items: center; justify-content: center; }
  .divergence::before, .divergence::after { display: none; content: ''; flex: 1; border-left: 1px dashed var(--border-subtle); }
  .divergence span { border: 1px solid var(--accent); padding: 0.35rem 0.55rem; color: var(--accent); }
  ol { display: grid; gap: 0.5rem; margin-top: 0.7rem !important; }
  li { color: var(--text-secondary); font-size: var(--research-diagram-copy, 0.875rem); line-height: 1.5; }
  li span { display: inline-block; min-width: 1.8rem; color: var(--accent); font-size: var(--research-diagram-label, 0.625rem); }
  .drift-outcomes { display: grid; gap: 1px; margin-top: 1.25rem; border: 1px solid var(--border-subtle); background: var(--border-subtle); }
  .drift-outcomes > div { background: var(--bg-card); padding: 0.85rem; }
  .drift-outcomes span { color: var(--accent); }
  .drift-outcomes p { margin-top: 0.35rem !important; color: var(--text-secondary); font-size: var(--research-diagram-caption, 0.75rem); line-height: 1.5; }

  @media (min-width: 760px) {
    .drift-comparison { grid-template-columns: minmax(0, 1fr) 6rem minmax(0, 1fr); align-items: stretch; gap: 1rem; }
    .divergence { flex-direction: column; gap: 0.7rem; }
    .divergence::before, .divergence::after { display: block; }
    .drift-outcomes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
