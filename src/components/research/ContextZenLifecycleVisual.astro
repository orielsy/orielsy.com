---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const operations = [
  { name: 'Observe', detail: 'Assess context health during ordinary turns.' },
  { name: 'Distill', detail: 'Reconstruct the state that still governs the work.' },
  { name: 'Handoff', detail: 'Package that state for a fresh context.' },
];
---

<ResearchFigureFrame className="zen-lifecycle" figureNumber="02" title="Observe, distill, hand off" caption="Observe is not background execution without host support. A complete handoff can be copied if clipboard access exists; otherwise one self-contained artifact is returned for the user to copy. No automatic chat creation or navigation is assumed.">
  <ol aria-label="Three specified Context Zen operations">
    {operations.map((operation, index) => <li><span class="step">0{index + 1}</span><div><h4>{operation.name}</h4><p>{operation.detail}</p></div></li>)}
  </ol>
  <p class="output"><span>Output</span>A continuation artifact, not a new conversation.</p>
</ResearchFigureFrame>

<style>
  .zen-lifecycle :global(p), .zen-lifecycle :global(h4), .zen-lifecycle :global(ol), .zen-lifecycle :global(li) { margin: 0; }
  .zen-lifecycle :global(ol) { padding: 0; list-style: none; }
  ol { display: grid; }
  li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.75rem; padding: 0.75rem 0; }
  li + li { border-top: 1px solid var(--border-subtle); }
  .step { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; line-height: 2; }
  h4 { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.45; }
  li p { margin-top: 0.35rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .output { display: grid; gap: 0.35rem 1rem; margin-top: 1rem !important; border-top: 1px solid var(--border-strong); padding-top: 0.85rem; color: var(--text-primary); font-size: 0.875rem; line-height: 1.6; }
  .output span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; text-transform: uppercase; }
  @media (min-width: 640px) {
    ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    li { display: block; padding: 0 1rem; }
    li:first-child { padding-left: 0; }
    li + li { border-top: 0; border-left: 1px solid var(--border-subtle); }
    h4 { margin-top: 0.55rem !important; }
    .output { grid-template-columns: 7rem minmax(0, 1fr); }
  }
</style>

<style>
  :global(.research-reading .research-prose figure.zen-lifecycle) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.zen-lifecycle) li p, :global(.research-reading .research-prose figure.zen-lifecycle) .output { font-size: 0.875rem !important; line-height: 1.6 !important; }
</style>
