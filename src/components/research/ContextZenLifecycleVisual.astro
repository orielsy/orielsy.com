---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const stages = [
  { label: 'Observe', detail: 'Context health' },
  { label: 'Distill', detail: 'Current state' },
  { label: 'Handoff', detail: 'Fresh context' },
];
---

<ResearchFigureFrame title="Observe → Distill → Handoff">
  <ol class="lifecycle-flow" aria-label="Context Zen observe, distill, handoff lifecycle">
    {stages.map((stage, index) => (
      <li class:list={['stage', index === stages.length - 1 && 'is-output']}>
        <strong>{stage.label}</strong>
        <span>{stage.detail}</span>
        {index < stages.length - 1 && (
          <>
            <span class="arrow arrow-mobile" aria-hidden="true">↓</span>
            <span class="arrow arrow-desktop" aria-hidden="true">→</span>
          </>
        )}
      </li>
    ))}
  </ol>
</ResearchFigureFrame>

<style>
  .lifecycle-flow {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 1px;
    background: var(--border-subtle);
  }

  .lifecycle-flow > .stage {
    margin: 0;
  }

  .stage {
    position: relative;
    min-width: 0;
    background: var(--bg-card);
    padding: 1rem;
  }

  .stage.is-output {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-card));
  }

  .stage strong,
  .stage span:not(.arrow) {
    display: block;
    margin: 0;
  }

  .stage strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .stage span:not(.arrow) {
    margin-top: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .arrow {
    position: absolute;
    z-index: 2;
    background: var(--bg-card);
    padding: 0.1rem;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
  }

  .arrow-mobile {
    left: 50%;
    bottom: -0.55rem;
    transform: translateX(-50%);
  }

  .arrow-desktop {
    display: none;
    right: -0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (min-width: 720px) {
    .lifecycle-flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .arrow-mobile {
      display: none;
    }

    .arrow-desktop {
      display: block;
    }
  }
</style>
