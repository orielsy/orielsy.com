---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const profiles = [
  { name: 'General-purpose', details: 'Canonical handoff when no target is supplied.' },
  { name: 'Coding', details: 'Repository state · branch · files · architecture decisions · tests · failures · next implementation step' },
  { name: 'Research', details: 'Question · findings · sources · assumptions · unresolved questions · next investigation' },
];
---

<ResearchFigureFrame className="zen-targets" figureNumber="04" title="One state, three target representations" caption="The user chooses the target; no destination discovery is required. Changing organization, emphasis, or compression must not materially change continuation state. Preservation is a requirement, not a demonstrated guarantee; “context recompilation” is architectural framing.">
  <div class="canonical"><span>Canonical handoff</span><p>Objective · decisions · constraints · rejected paths · active artifacts · open questions · next step</p></div>
  <div class="profiles" role="group" aria-label="User-selected handoff target profiles">
    {profiles.map((profile) => <div><h4>{profile.name}</h4><p>{profile.details}</p></div>)}
  </div>
  <p class="boundary">Same authoritative state; different emphasis for the receiving environment.</p>
</ResearchFigureFrame>

<style>
  .zen-targets :global(p), .zen-targets :global(h4) { margin: 0; }
  .canonical { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .canonical span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; text-transform: uppercase; }
  .canonical p { margin-top: 0.35rem !important; color: var(--text-primary); font-size: 0.875rem; line-height: 1.65; }
  .profiles { display: grid; margin-top: 1.25rem; border-top: 1px solid var(--border-subtle); }
  .profiles > div { padding: 0.9rem 0; }
  .profiles > div + div { border-top: 1px solid var(--border-subtle); }
  h4 { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.5; }
  .profiles p { margin-top: 0.35rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .boundary { border-top: 1px solid var(--border-strong); padding-top: 0.9rem; color: var(--text-primary); font-size: 0.875rem; line-height: 1.6; }
  @media (min-width: 640px) {
    .profiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .profiles > div { padding: 1rem 1rem 1rem 0; }
    .profiles > div + div { border-top: 0; border-left: 1px solid var(--border-subtle); padding-left: 1rem; }
  }
</style>

<style>
  :global(.research-reading .research-prose figure.zen-targets) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.zen-targets) .canonical p, :global(.research-reading .research-prose figure.zen-targets) .profiles p, :global(.research-reading .research-prose figure.zen-targets) .boundary { font-size: 0.875rem !important; line-height: 1.6 !important; }
</style>
