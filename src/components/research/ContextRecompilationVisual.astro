---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const stages = [
  'Conversation',
  'Authoritative working state',
  'Target profile',
  'Continuation package',
];
---

<ResearchFigureFrame
  title="Context recompilation"
  caption="Preserve the truth, then represent it for the environment that will consume it next."
>
  <ol class="recompile-flow" aria-label="Context Zen target-aware handoff pipeline">
    {stages.map((stage, index) => (
      <li class:list={['node', index === 1 && 'is-state', index === 3 && 'is-output']}>
        <strong>{stage}</strong>
        {index < stages.length - 1 && (
          <>
            <span class="arrow arrow-mobile" aria-hidden="true">↓</span>
            <span class="arrow arrow-desktop" aria-hidden="true">→</span>
          </>
        )}
      </li>
    ))}
  </ol>
</ResearchFigureFrame>

<style>
  .recompile-flow {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 1px;
    background: var(--border-subtle);
  }

  .node {
    position: relative;
    min-width: 0;
    background: var(--bg-card);
    padding: 1rem;
  }

  .node.is-state {
    box-shadow: inset 2px 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .node.is-output {
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-card));
  }

  .node strong {
    display: block;
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .arrow {
    position: absolute;
    z-index: 2;
    background: var(--bg-card);
    padding: 0.1rem;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
  }

  .arrow-mobile {
    left: 50%;
    bottom: -0.55rem;
    transform: translateX(-50%);
  }

  .arrow-desktop {
    display: none;
    right: -0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (min-width: 760px) {
    .recompile-flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .arrow-mobile {
      display: none;
    }

    .arrow-desktop {
      display: block;
    }
  }
</style>
