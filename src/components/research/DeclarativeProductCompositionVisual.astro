---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const inputs = [
  { label: 'Current state', detail: 'Restricted account · identity verification missing · no active risk review' },
  { label: 'Trusted capabilities', detail: 'Customer profile / account status · transactions · identity verification · restriction action · risk escalation' },
  { label: 'Authored product knowledge', detail: 'Purpose · relevance · prerequisites · explanation / composition guidance' },
  { label: 'Deterministic policy', detail: 'Removal requires verified identity · risk escalation remains permitted while restricted' },
];
const facts = [
  { label: 'Customer profile', value: 'Jordan Rivera' },
  { label: 'Recent transactions', value: '3 entries, 1 blocked transfer' },
  { label: 'Restriction reason', value: 'Identity verification required' },
];
const actions = [
  { label: 'Request verification', value: 'Prerequisite for removal' },
  { label: 'Remove restriction', value: 'Blocked: identity not verified' },
  { label: 'Escalate to risk', value: 'Permitted while restricted', permitted: true },
];
---

<ResearchFigureFrame
  className="composition-figure"
  figureNumber="02"
  title="A surface assembled within boundaries"
  caption="Illustrative composition, not an implemented generator. The application owns current state, authorization, validation, and mutation or side effects; composition cannot invent missing behavior."
>
  <div class="composition-layout">
    <section class="composition-inputs" aria-label="Inputs to a possible composition">
      <p class="composition-label">Inputs to a possible composition</p>
      <dl class="composition-input-list">
        {inputs.map(({ label, detail }) => <div><dt>{label}</dt><dd>{detail}</dd></div>)}
      </dl>
    </section>
    <div class="composition-result">
      <section class="composition-layer" aria-label="Proposed composition and context layer">
        <p class="composition-label">Proposed composition / context layer</p>
        <p>Select relevant capabilities, order the task, apply guidance, respect state and policy.</p>
      </section>
      <section class="derived-surface" aria-labelledby="derived-surface-title">
        <header>
          <div><p class="composition-label">Illustrative derived surface</p><h4 id="derived-surface-title">Account Review</h4></div>
          <span class="surface-status">Restricted</span>
        </header>
        <dl class="surface-facts">
          {facts.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
        <div class="surface-actions">
          <p class="composition-label">Next steps under current policy</p>
          <dl>{actions.map(({ label, value, permitted }) => <div><dt>{label}</dt><dd class:list={{ permitted }}>{value}</dd></div>)}</dl>
        </div>
      </section>
    </div>
  </div>
</ResearchFigureFrame>

<style is:global>
  [data-research-entry="product-knowledge-as-architecture"] figure.composition-figure { border-inline: 0; border-radius: 0 !important; background: transparent; padding: 1.25rem 0; }
  .composition-figure .composition-layout { display: grid; gap: 1.5rem; }
  .composition-figure .composition-layout > * { min-width: 0; }
  .composition-figure .composition-label { margin: 0 !important; font-family: var(--font-mono-ui); font-size: 0.625rem !important; font-weight: 500; line-height: 1.5; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .composition-figure .composition-input-list { margin: 0.7rem 0 0; border-top: 1px solid var(--border-subtle); }
  .composition-figure .composition-input-list > div { padding: 0.7rem 0; border-bottom: 1px solid var(--border-subtle); }
  .composition-figure .composition-input-list dt { color: var(--text-primary); font-size: 0.78rem; font-weight: 600; }
  .composition-figure .composition-input-list dd { margin: 0.2rem 0 0; color: var(--text-secondary); font-size: 0.74rem; line-height: 1.55; }
  .composition-figure .composition-layer { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .composition-figure .composition-layer .composition-label { color: var(--accent); }
  .composition-figure .composition-layer > p:last-child { margin: 0.5rem 0 0 !important; color: var(--text-primary); font-size: 0.8rem !important; line-height: 1.65 !important; }
  .composition-figure .derived-surface { min-width: 0; margin-top: 1.25rem; border: 1px solid var(--border-subtle); border-radius: 0.2rem; background: var(--bg-card); padding: 1rem; }
  .composition-figure .derived-surface header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.4rem 1rem; margin: 0 0 0.85rem; padding: 0 !important; }
  .composition-figure .derived-surface h4 { margin: 0.2rem 0 0; font-family: var(--font-display); font-size: 1rem !important; color: var(--text-primary); font-weight: 600; }
  .composition-figure .surface-status { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.7rem; }
  .composition-figure .surface-facts, .composition-figure .surface-actions dl { margin: 0; border-top: 1px solid var(--border-subtle); }
  .composition-figure .surface-facts > div, .composition-figure .surface-actions dl > div { display: grid; gap: 0.15rem 0.65rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border-subtle); font-size: 0.72rem; line-height: 1.55; }
  .composition-figure .surface-facts dt, .composition-figure .surface-actions dt { color: var(--text-secondary); }
  .composition-figure .surface-facts dd, .composition-figure .surface-actions dd { min-width: 0; margin: 0; color: var(--text-primary); font-weight: 600; }
  .composition-figure .surface-actions { margin-top: 0.7rem; }
  .composition-figure .surface-actions dl { margin-top: 0.5rem; }
  .composition-figure .surface-actions dl > div:last-child { border-bottom: 0; }
  .composition-figure .surface-actions dd.permitted { color: var(--accent); }
  @media (min-width: 640px) {
    .composition-figure .composition-layout { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 1.75rem; }
    .composition-figure .surface-facts > div, .composition-figure .surface-actions dl > div { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); }
  }
</style>
