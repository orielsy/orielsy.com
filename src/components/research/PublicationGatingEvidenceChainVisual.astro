---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const steps = [
  {
    label: 'Requirement',
    file: 'specs/003-content-publication-gating/spec.md',
    text: 'New entries fail closed until deliberately published.',
  },
  {
    label: 'Schema default',
    file: 'src/content.config.ts',
    text: 'published: z.boolean().default(false)',
  },
  {
    label: 'Route behavior',
    file: 'src/pages/research/[...slug].astro',
    text: 'Published entries render; local preview requires DEV + content-preview mode.',
  },
  {
    label: 'Feed behavior',
    file: 'src/pages/rss.xml.ts',
    text: 'RSS filters the collection to published entries.',
  },
];
---

<ResearchFigureFrame
  eyebrow="Figure 04"
  status="Direct repository evidence"
  title="One concern, four forms of evidence"
  caption="The chain does not treat the specification as proof of implementation. Each surface contributes a different kind of evidence."
>
  <ol class="evidence-chain">
    {steps.map((step, index) => (
      <li>
        <span class="node" aria-hidden="true">0{index + 1}</span>
        <div class="evidence-copy">
          <span class="label">{step.label}</span>
          <code>{step.file}</code>
          <p>{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</ResearchFigureFrame>

<style>
  .evidence-chain {
    position: relative;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-chain::before {
    position: absolute;
    top: 0.8rem;
    bottom: 0.8rem;
    left: 0.8rem;
    width: 1px;
    background: var(--border-subtle);
    content: '';
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.8rem;
    margin: 0;
  }

  .node {
    position: relative;
    z-index: 1;
    display: flex;
    width: 1.6rem;
    height: 1.6rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--bg-card);
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
  }

  .label {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  code {
    display: block;
    margin-top: 0.3rem;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--text-primary);
    font-family: var(--font-mono-ui);
    font-size: 0.7rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
    text-transform: none;
  }

  p {
    margin: 0.4rem 0 0 !important;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  @media (min-width: 760px) {
    .evidence-chain {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.15rem;
      padding-top: 0.15rem;
    }

    .evidence-chain::before {
      top: 0.8rem;
      right: calc(12.5% - 0.8rem);
      bottom: auto;
      left: calc(12.5% - 0.8rem);
      width: auto;
      height: 1px;
    }

    li {
      grid-template-columns: 1fr;
      gap: 0.7rem;
      align-content: start;
      min-width: 0;
    }

    .node {
      justify-self: start;
    }

    .evidence-copy {
      min-width: 0;
    }
  }
</style>
