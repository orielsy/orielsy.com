---
import { Braces, CircleCheck, FileCode2, FileText } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const steps = [
  ['Requirement', 'specs/003-content-publication-gating/spec.md', 'New entries fail closed until deliberately published.', FileText],
  ['Default', 'src/content.config.ts', 'published: z.boolean().default(false)', Braces],
  ['Route behavior', 'src/pages/research/[...slug].astro', 'Detail behavior distinguishes publication state; unpublished body preview requires DEV + content-preview mode.', FileCode2],
  ['Feed behavior', 'src/pages/rss.xml.ts', 'The collection query returns only data.published entries.', CircleCheck],
];
---

<ResearchFigureFrame
  className="publication-evidence"
  figureNumber="05"
  title="One concern, four forms of evidence"
  status="Direct repository evidence"
  caption="The spec defines intended behavior, while the schema, route, and feed show separate implementation surfaces. This is not an exhaustive proof that every gating requirement is met."
>
  <div class="chain-wrap">
    <span class="chain-line" aria-hidden="true"></span>
    <ol class="evidence-chain">
      {steps.map(([label, file, text, Icon], index) => (
        <li>
          <div class:list={['step-copy', index % 2 === 0 && 'is-left']}>
            <span class="label">{label}</span>
            <code>{file}</code>
            <p>{text}</p>
          </div>
          <span class="icon-node" aria-hidden="true"><Icon size={13} strokeWidth={1.6} /></span>
        </li>
      ))}
    </ol>
  </div>

  <div class="rationale">
    <div><span class="label accent">Adjacent rationale</span><code>Publication-gating ADR</code></div>
    <div><p>Preserves why publication state remains separate from lifecycle status.</p><span class="rationale-note">Related decision evidence · not an interchangeable fifth implementation checkpoint</span></div>
  </div>
</ResearchFigureFrame>

<style>
  .publication-evidence :global(p), .publication-evidence :global(ol), .publication-evidence :global(li) { margin: 0; }
  .publication-evidence :global(ol) { padding: 0; list-style: none; }
  .chain-wrap { position: relative; }
  .chain-line { position: absolute; top: 0.5rem; bottom: 0.5rem; left: 0.75rem; width: 1px; background: var(--border-subtle); }
  .evidence-chain { position: relative; display: grid; gap: 1.5rem; }
  li { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: 0.8rem; align-items: start; }
  .icon-node { position: relative; z-index: 1; grid-column: 1; grid-row: 1; display: flex; width: 1.5rem; height: 1.5rem; align-items: center; justify-content: center; border: 1px solid var(--accent); border-radius: 999px; color: var(--accent); background: var(--bg-card); }
  .step-copy { grid-column: 2; min-width: 0; }
  .label { display: block; color: var(--accent); font-family: var(--font-mono-ui); font-size: var(--research-diagram-label, 0.625rem); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  code { display: block; margin-top: 0.4rem; border: 0 !important; background: transparent !important; padding: 0 !important; color: var(--text-primary) !important; font-family: var(--font-mono-ui); font-size: 0.6875rem !important; line-height: 1.5; white-space: normal !important; overflow-wrap: anywhere; }
  .step-copy p, .rationale p { margin-top: 0.45rem !important; color: var(--text-secondary); font-size: var(--research-diagram-copy, 0.875rem); line-height: 1.6; }
  .rationale { display: grid; gap: 0.8rem; margin-top: 1.35rem; border-top: 1px solid var(--border-subtle); padding-top: 0.9rem; }
  .rationale .accent { color: var(--accent); }
  .rationale-note { display: block; margin-top: 0.45rem; color: var(--text-muted); font-family: var(--font-mono-ui); font-size: var(--research-diagram-label, 0.625rem); line-height: 1.55; }

  @media (min-width: 760px) {
    .chain-line {
      left: 50%;
      width: 1px;
      transform: translateX(-50%);
    }
    .evidence-chain { gap: 1.8rem; }
    li {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 4rem;
      align-items: center;
    }
    .icon-node {
      position: absolute;
      top: 50%;
      left: 50%;
      grid-column: auto;
      grid-row: auto;
      transform: translate(-50%, -50%);
    }
    .step-copy { grid-column: 2; }
    .step-copy.is-left { grid-column: 1; text-align: right; }
    .rationale { grid-template-columns: 9rem minmax(0, 1fr); gap: 1rem; align-items: start; }
  }
</style>
