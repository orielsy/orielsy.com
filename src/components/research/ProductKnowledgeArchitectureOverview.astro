---
import ClaimAuthorityTable from './ClaimAuthorityTable.astro';
import CompositionFormula from './CompositionFormula.astro';
import ContextAsArchitectureVisual from './ContextAsArchitectureVisual.astro';
import DeclarativeProductCompositionVisual from './DeclarativeProductCompositionVisual.astro';
import ProductKnowledgeArtifact from './ProductKnowledgeArtifact.astro';
import ResearchBreakout from './ResearchBreakout.astro';
---

<section class="pk-overview not-prose" aria-labelledby="product-knowledge-overview-title">
  <div class="pk-overview__intro">
    <h2 id="product-knowledge-overview-title">
      Software has clear homes for behavior and state. Product meaning usually has no equivalent home.
    </h2>
    <p class="pk-overview__lead">
      Code owns implemented behavior. Application state owns current facts. Schemas define valid structure.
    </p>
    <p>
      But why a workflow exists, when a capability is relevant, what should be explained, and how capabilities fit together is often scattered across documentation, UI copy, tickets, and institutional memory.
    </p>
    <p>
      The proposition is that <strong>product knowledge can become an explicit architectural input</strong> without replacing deterministic state, policy, authorization, or execution.
    </p>
  </div>

  <div class="pk-overview__section">
    <h3 id="product-meaning-home">Give product meaning an architectural home</h3>
    <p>
      The goal is not a new universal source of truth. It is explicit ownership for the meaning around a product so that intent, relevance, prerequisites, explanation, and composition guidance are represented deliberately.
    </p>
  </div>

  <ResearchBreakout mode="wide">
    <ContextAsArchitectureVisual />
  </ResearchBreakout>

  <div class="pk-overview__section">
    <h3 id="account-review-example">A concrete example: account review</h3>
    <p>
      Engineering already provides trusted capabilities such as customer identity, transaction history, verification, restriction management, and risk escalation. Product knowledge can describe why the task exists, what information matters, which prerequisites apply, and what should be explained.
    </p>
  </div>

  <ProductKnowledgeArtifact />

  <p class="pk-overview__plain-boundary">
    The document describes the task. It does not retrieve transactions, verify identity, grant permission, remove restrictions, or execute escalation.
  </p>

  <div class="pk-overview__section">
    <h3 id="keep-boundaries-clear">Keep the boundaries clear</h3>
    <p>
      Application state owns current facts. Code owns implemented behavior. Governing policy or specification owns intended constraints. Product knowledge owns meaning and explanation. When those artifacts disagree, the conflict should be exposed rather than silently resolved by AI.
    </p>
  </div>

  <ClaimAuthorityTable />

  <div class="pk-overview__section">
    <h3 id="interface-composition">What might the interface become?</h3>
    <p>
      If state, policy, available capabilities, and product knowledge are explicit, parts of an interface can potentially be composed from trusted capabilities that already exist instead of being authored as one fixed page every time.
    </p>
  </div>

  <ResearchBreakout mode="wide">
    <DeclarativeProductCompositionVisual />
  </ResearchBreakout>

  <CompositionFormula />

  <p class="pk-overview__model-note">
    This is a thinking model, not an executable formula, not a proposal to generate every screen, and not permission for AI to invent behavior the product does not actually provide.
  </p>

  <div class="pk-overview__section pk-overview__closing">
    <h3 id="what-remains-open">What remains open</h3>
    <p>
      The hard problem is making this knowledge trustworthy: establishing who owns it, keeping it aligned with code and policy, and proving that a proposed composition is allowed. This remains an architectural hypothesis, not proof that the model is reliable.
    </p>

    <button class="pk-overview__continue" type="button" data-reading-depth-open="full">
      Read full research <span aria-hidden="true">→</span>
    </button>
  </div>
</section>

<script>
  const article = document.querySelector<HTMLElement>('[data-research-entry="product-knowledge-as-architecture"]');
  const overview = article?.querySelector<HTMLElement>('[data-reading-depth-overview] .pk-overview');
  const tocAside = article?.querySelector<HTMLElement>('aside[aria-label="Research navigation"]');
  const tocShell = tocAside?.querySelector<HTMLElement>('[data-research-toc-shell]');
  const fullToc = tocShell?.querySelector<HTMLElement>('.research-toc');

  if (article && overview && tocAside && tocShell && fullToc) {
    const headings = Array.from(overview.querySelectorAll<HTMLHeadingElement>('h3[id]'));

    if (headings.length > 2 && !tocShell.querySelector('[data-reading-depth-toc="overview"]')) {
      fullToc.dataset.readingDepthToc = 'full';

      const overviewToc = fullToc.cloneNode(true) as HTMLElement;
      overviewToc.dataset.readingDepthToc = 'overview';
      overviewToc.setAttribute('aria-label', 'Overview contents');
      overviewToc.classList.add('hidden', 'lg:block');

      const list = overviewToc.querySelector<HTMLOListElement>('ol');
      list?.replaceChildren();

      headings.forEach((heading, index) => {
        if (!list) return;

        const item = document.createElement('li');
        item.className = 'm-0 p-0 leading-5';

        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.className = 'group -ml-px grid grid-cols-[26px_minmax(0,1fr)] gap-2 border-l border-transparent py-2.5 pl-4 no-underline transition-colors hover:border-[var(--accent)]';

        const number = document.createElement('span');
        number.className = 'font-editorial-mono text-[9px] text-[var(--accent)]';
        number.textContent = String(index + 1).padStart(2, '0');

        const label = document.createElement('span');
        label.className = 'text-[12px] leading-5 text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]';
        label.textContent = heading.textContent?.trim() ?? '';

        link.append(number, label);
        item.append(link);
        list.append(item);
      });

      tocShell.append(overviewToc);

      const syncToc = () => {
        const depth = article.dataset.readingDepth === 'full' ? 'full' : 'overview';
        tocAside.hidden = false;
        overviewToc.hidden = depth !== 'overview';
        fullToc.hidden = depth !== 'full';
      };

      const observer = new MutationObserver(syncToc);
      observer.observe(article, {
        attributes: true,
        attributeFilter: ['data-reading-depth'],
      });

      queueMicrotask(syncToc);
    }
  }
</script>

<style>
  .pk-overview {
    color: var(--text-secondary);
  }

  .pk-overview__intro,
  .pk-overview__section,
  .pk-overview__plain-boundary,
  .pk-overview__model-note {
    max-width: 46rem;
  }

  .pk-overview__intro h2 {
    max-width: 46rem;
    margin: 0 0 1.25rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .pk-overview p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.8;
  }

  .pk-overview p + p {
    margin-top: 0.9rem;
  }

  .pk-overview strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .pk-overview__lead {
    color: var(--text-primary);
    font-size: 1.06rem !important;
    line-height: 1.7 !important;
  }

  .pk-overview h3 {
    margin: 0 0 0.75rem;
    scroll-margin-top: 6rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .pk-overview__section {
    margin-top: 3.25rem;
  }

  .pk-overview__plain-boundary {
    margin-top: 1.25rem !important;
    color: var(--text-primary);
  }

  .pk-overview__model-note {
    margin-top: -0.35rem !important;
    color: var(--text-muted);
    font-size: 0.925rem !important;
    line-height: 1.7 !important;
  }

  .pk-overview__closing {
    margin-top: 3.75rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 2rem;
  }

  .pk-overview__continue {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.4rem;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.01em;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .pk-overview__continue:hover {
    color: var(--accent-hover);
    text-decoration-color: currentColor;
  }

  .pk-overview__continue:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pk-overview__continue {
      transition: none;
    }
  }
</style>
