---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const arms = [
  { letter: 'A', name: 'Full transcript', detail: 'Chronology retained' },
  { letter: 'B', name: 'Conventional summary', detail: 'Compression baseline' },
  { letter: 'C', name: 'Context Zen handoff', detail: 'Authoritative state reconstructed' },
];
---

<ResearchFigureFrame className="zen-experiment" figureNumber="05" title="The experiment needs a summary baseline" status="Proposed · no results" caption="These conditions and measures are proposals, not findings. The summary arm separates possible compression benefit from authoritative-state reconstruction; different work may need different amounts of raw history.">
  <ol aria-label="Three proposed continuation conditions">
    {arms.map((arm) => <li><span>{arm.letter}</span><div><h4>{arm.name}</h4><p>{arm.detail}</p></div></li>)}
  </ol>
  <div class="measures"><span>Candidate measures</span><p>Missed active constraints · revived rejected decisions · repeated questions · user corrections · task completion quality · token use · latency · target-specific success</p></div>
  <div class="metaphor"><span>Working metaphor, not a metric</span><p>“State entropy” describes the share of retained context that is superseded, conflicting, or no longer actionable.</p></div>
</ResearchFigureFrame>

<style>
  .zen-experiment :global(p), .zen-experiment :global(h4), .zen-experiment :global(ol), .zen-experiment :global(li) { margin: 0; }
  .zen-experiment :global(ol) { padding: 0; list-style: none; }
  ol { display: grid; border-block: 1px solid var(--border-subtle); }
  li { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: 0.8rem; padding: 1rem 0; }
  li + li { border-top: 1px solid var(--border-subtle); }
  li > span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; line-height: 2; }
  h4 { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.45; }
  li p, .measures p, .metaphor p { margin-top: 0.35rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .measures, .metaphor { display: grid; gap: 0.35rem 1rem; margin-top: 1.1rem; }
  .metaphor { border-top: 1px solid var(--border-subtle); padding-top: 1rem; }
  .measures span, .metaphor span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; line-height: 1.5; text-transform: uppercase; }
  @media (min-width: 640px) {
    ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    li { display: block; padding: 1rem 1rem 1rem 0; }
    li + li { border-top: 0; border-left: 1px solid var(--border-subtle); padding-left: 1rem; }
    h4 { margin-top: 0.6rem !important; }
    .measures, .metaphor { grid-template-columns: 12rem minmax(0, 1fr); }
    .measures p, .metaphor p { margin-top: 0 !important; }
  }
</style>

<style>
  :global(.research-reading .research-prose figure.zen-experiment) { border-radius: 0 !important; }
  :global(.research-reading .research-prose figure.zen-experiment) li p, :global(.research-reading .research-prose figure.zen-experiment) .measures p, :global(.research-reading .research-prose figure.zen-experiment) .metaphor p { font-size: 0.875rem !important; line-height: 1.6 !important; }
</style>
