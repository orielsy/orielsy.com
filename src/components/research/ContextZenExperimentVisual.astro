---
import ResearchFigureFrame from './ResearchFigureFrame.astro';
const arms = [
  { letter: 'A', name: 'Full transcript', detail: 'Chronology retained' },
  { letter: 'B', name: 'Conventional summary', detail: 'Compression baseline' },
  { letter: 'C', name: 'Context Zen handoff', detail: 'Authoritative state reconstructed' },
];
---

<ResearchFigureFrame className="zen-experiment" figureNumber="06" title="The experiment needs a summary baseline" status="Proposed experiment · no results" caption="No result is shown. The conventional-summary arm separates possible compression effects from authoritative-state reconstruction. Measures are candidates, and different kinds of work may require different amounts of raw history.">
  <div class="condition-label"><span aria-hidden="true">△</span><span>Three continuation conditions</span></div>
  <ol aria-label="Three proposed continuation conditions">
    {arms.map((arm) => <li><span>{arm.letter}</span><h4>{arm.name}</h4><p>{arm.detail}</p></li>)}
  </ol>
  <div class="experiment-notes">
    <div><span>Candidate measures</span><p>Missed constraints · revived decisions · repeated questions · user corrections · task quality · token use · latency · target-specific success</p></div>
    <div class="metaphor"><span>Speculative bridge</span><p><strong>State entropy</strong> asks what share of retained context is superseded, conflicting, or no longer actionable. It is a working metaphor—not a metric.</p></div>
  </div>
</ResearchFigureFrame>

<style>
  .zen-experiment :global(p), .zen-experiment :global(h4), .zen-experiment :global(ol), .zen-experiment :global(li) { margin: 0; }
  .zen-experiment :global(ol) { padding: 0; list-style: none; }
  .condition-label { display: flex; align-items: center; gap: 0.5rem; color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; }
  ol { display: grid; margin-top: 1rem !important; border: 1px solid var(--border-subtle); }
  li { padding: 1rem; background: var(--bg-secondary); }
  li + li { border-top: 1px solid var(--border-subtle); }
  li > span { color: var(--accent); font-family: var(--font-mono-ui); font-size: 0.6875rem; }
  h4 { margin-top: 0.45rem !important; color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.45; }
  li p, .experiment-notes p { margin-top: 0.25rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .experiment-notes { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .experiment-notes > div > span { color: var(--text-muted); font-family: var(--font-mono-ui); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .experiment-notes .metaphor { border-left: 2px dashed var(--accent); padding-left: 0.9rem; }
  .experiment-notes .metaphor > span { color: var(--accent); }
  .experiment-notes strong { color: var(--text-primary); font-weight: 500; }
  @media (min-width: 760px) {
    ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    li + li { border-top: 0; border-left: 1px solid var(--border-subtle); }
    .experiment-notes { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 1.5rem; }
  }
</style>