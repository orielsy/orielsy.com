---
import { MessageSquare, Table2 } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const chat = [
  'Describe the desired state in prose',
  'Conversational interpretation',
  'Action or result',
  'If the reply is only text, the user carries it back',
];

const embedded = [
  'Act inside the table',
  'Capability receives a narrow job',
  'Table updates in place',
];
---

<ResearchFigureFrame
  className="interaction-path-figure"
  figureNumber="01"
  title="Same intent, different interface path"
  status="Conceptual comparison · source + historical figure"
  caption="Conversation can also trigger an action directly. The conditional handoff applies when chat returns a result outside the table; embedded capability makes the table itself the result surface. Neither path is inherently faster, more capable, or more accurate."
>
  <div class="paths">
    <section aria-labelledby="conversation-path-title">
      <div class="path-heading muted">
        <MessageSquare size={16} strokeWidth={1.75} aria-hidden="true" />
        <p id="conversation-path-title" class="figure-label">Chat surface</p>
      </div>
      <ol>
        {chat.map((step, index) => (
          <li class:list={[index === chat.length - 1 && 'is-final']}>
            <span class="step figure-meta">0{index + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
      <p class="path-note figure-label">Handoff depends on the integration</p>
    </section>

    <div class="path-divider" aria-hidden="true"></div>

    <section aria-labelledby="embedded-path-title">
      <div class="path-heading accent">
        <Table2 size={16} strokeWidth={1.75} aria-hidden="true" />
        <p id="embedded-path-title" class="figure-label figure-accent">Embedded capability</p>
      </div>
      <ol>
        {embedded.map((step, index) => (
          <li class:list={[index === embedded.length - 1 && 'is-final']}>
            <span class="step figure-meta figure-accent">0{index + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
      <p class="path-note figure-label figure-accent is-accent">Result lives in the interface</p>
    </section>
  </div>

  <div class="shared-result">
    <span class="figure-label">Shared end state</span>
    <p class="figure-copy">The table reflects the requested state, if either path is integrated to reach it.</p>
  </div>
</ResearchFigureFrame>

<style>
  .interaction-path-figure :global(p),
  .interaction-path-figure :global(ol),
  .interaction-path-figure :global(li) {
    margin: 0;
  }

  .interaction-path-figure :global(ol) {
    padding: 0;
    list-style: none;
  }

  .paths {
    display: grid;
    gap: 2rem;
  }

  .paths section {
    min-width: 0;
  }

  .path-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .path-heading.muted {
    color: var(--text-muted);
  }

  .path-heading.accent {
    color: var(--accent);
  }

  .paths ol {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.85rem !important;
  }

  .paths li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: var(--research-figure-copy, 0.875rem);
    line-height: 1.55;
  }

  .paths li.is-final {
    color: var(--text-primary);
  }

  .step {
    line-height: 1.55 !important;
  }

  .path-note {
    margin-top: 0.85rem !important;
    border-left: 2px solid var(--border-strong);
    padding-left: 0.75rem;
  }

  .path-note.is-accent {
    border-left-color: var(--accent);
  }

  .path-divider {
    display: none;
  }

  .shared-result {
    margin-top: 1.5rem;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-card));
    padding: 0.75rem 1rem;
  }

  .shared-result p {
    margin-top: 0.375rem !important;
    color: var(--text-primary);
  }

  @media (min-width: 760px) {
    .paths {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: stretch;
      gap: 1.5rem;
    }

    .path-divider {
      display: block;
      border-left: 1px dashed var(--border-subtle);
    }
  }
</style>

<style>
  :global(.research-reading .research-prose figure.interaction-path-figure) { border-radius: 0 !important; }
</style>
