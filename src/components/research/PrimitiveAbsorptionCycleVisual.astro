---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const beforeMechanisms = [
  'Reactivity',
  'Navigation',
  'Transitions',
  'DOM machinery',
];

const platformPrimitives = [
  'Reactive graph primitives',
  'Navigation mechanics',
  'View transitions',
  'DOM update primitives',
  'Common controls',
];

const frameworkResponsibilities = [
  'Scheduling & batching',
  'Rendering composition',
  'Routing & data',
  'Server integration',
  'Compilation & DX',
];
---

<ResearchFigureFrame
  title="The framework's center of gravity moves upward."
  caption="Standardization can move durable mechanisms into the platform while frameworks concentrate on coordination, policy, composition, server integration, and developer experience."
>
  <div class="recomposition-map">
    <section class="state before-state">
      <div class="state-heading">
        <span>Before</span>
        <strong>Framework owns mechanism and coordination</strong>
      </div>

      <div class="architecture-layer framework-layer is-full">
        <div class="layer-heading">
          <span>Framework</span>
          <strong>Private substrate + application policy</strong>
        </div>
        <div class="capabilities">
          {beforeMechanisms.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </section>

    <div class="shift" aria-hidden="true">
      <span>standardization</span>
      <strong class="shift-horizontal">→</strong>
      <strong class="shift-vertical">↓</strong>
    </div>

    <section class="state after-state">
      <div class="state-heading">
        <span>After</span>
        <strong>Mechanism moves down; framework policy stays above it</strong>
      </div>

      <div class="architecture-stack">
        <div class="architecture-layer framework-layer">
          <div class="layer-heading">
            <span>Framework</span>
            <strong>Coordination + policy</strong>
          </div>
          <div class="capabilities">
            {frameworkResponsibilities.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <div class="architecture-layer platform-layer">
          <div class="layer-heading">
            <span>Platform</span>
            <strong>Durable primitives</strong>
          </div>
          <div class="capabilities">
            {platformPrimitives.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </div>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .recomposition-map {
    display: grid;
    gap: 1rem;
    align-items: start;
  }

  .state {
    min-width: 0;
  }

  .state-heading {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.65rem;
  }

  .state-heading span,
  .layer-heading span,
  .shift span {
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .state-heading span {
    color: var(--accent);
  }

  .state-heading strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .architecture-stack {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
  }

  .architecture-layer {
    min-width: 0;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    padding: 0.9rem;
  }

  .architecture-stack .architecture-layer {
    border: 0;
  }

  .framework-layer {
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .framework-layer.is-full {
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .platform-layer {
    background: var(--bg-secondary);
  }

  .layer-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
  }

  .layer-heading span {
    color: var(--text-muted);
  }

  .framework-layer .layer-heading span {
    color: var(--accent);
  }

  .layer-heading strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .capabilities span {
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    padding: 0.35rem 0.5rem;
    color: var(--text-secondary);
    font-family: var(--font-mono-ui);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .shift {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    color: var(--text-muted);
  }

  .shift span {
    color: var(--text-muted);
  }

  .shift strong {
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 1rem;
    font-weight: 500;
  }

  .shift-horizontal {
    display: none;
  }

  @media (min-width: 780px) {
    .recomposition-map {
      grid-template-columns: minmax(0, 0.9fr) 5rem minmax(0, 1.2fr);
      gap: 0.75rem;
    }

    .shift {
      align-self: center;
      flex-direction: column;
    }

    .shift span {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    .shift-horizontal {
      display: block;
    }

    .shift-vertical {
      display: none;
    }
  }
</style>
