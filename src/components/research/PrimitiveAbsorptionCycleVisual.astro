---
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const beforeMechanisms = ['Reactivity', 'Navigation', 'Transitions', 'DOM machinery'];
const platformPrimitives = ['Reactive graph primitives', 'Navigation mechanics', 'View transitions', 'DOM update primitives', 'Common controls'];
const frameworkResponsibilities = ['Scheduling & batching', 'Rendering composition', 'Routing & data', 'Server integration', 'Compilation & DX'];
---

<ResearchFigureFrame
  className="primitive-absorption-figure"
  figureNumber="03"
  title="The framework's center of gravity can move upward"
  caption="This is the working recomposition model: durable mechanisms move into the platform while frameworks concentrate on coordination, policy, composition, server integration, compilation, and developer experience."
>
  <div class="recomposition-map">
    <section class="state before-state">
      <div class="state-heading"><span>Before</span><strong>Framework owns mechanism and coordination</strong></div>
      <div class="architecture-layer framework-layer is-full">
        <div class="layer-heading"><span>Framework</span><strong>Private substrate + application policy</strong></div>
        <ul class="capabilities">{beforeMechanisms.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    <div class="shift">
      <span>Standardization</span>
      <strong aria-hidden="true">→</strong>
    </div>

    <section class="state after-state">
      <div class="state-heading"><span>After</span><strong>Mechanism moves down; framework policy stays above it</strong></div>
      <div class="architecture-stack">
        <div class="architecture-layer framework-layer">
          <div class="layer-heading"><span>Framework</span><strong>Coordination + policy</strong></div>
          <ul class="capabilities">{frameworkResponsibilities.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="architecture-layer platform-layer">
          <div class="layer-heading"><span>Platform</span><strong>Durable primitives</strong></div>
          <ul class="capabilities">{platformPrimitives.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  :global(.research-reading .research-prose figure.primitive-absorption-figure) { border-radius: 0 !important; }
  .recomposition-map { display: grid; gap: 1rem; align-items: start; }
  .state { min-width: 0; }
  .state-heading { display: grid; gap: 0.35rem; margin-bottom: 0.7rem; }
  .state-heading span,
  .layer-heading span,
  .shift span { font-family: var(--font-mono-ui); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; line-height: 1.45; text-transform: uppercase; }
  .state-heading span { color: var(--accent); }
  .state-heading strong { color: var(--text-primary); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.45; }
  .architecture-stack { display: grid; border-block: 1px solid var(--border-subtle); }
  .architecture-layer { min-width: 0; border-block: 1px solid var(--border-subtle); padding: 0.95rem 0; }
  .architecture-stack .architecture-layer { border-top: 0; }
  .architecture-stack .architecture-layer + .architecture-layer { border-top: 1px solid var(--border-subtle); }
  .framework-layer { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .platform-layer { padding-left: 1rem; }
  .layer-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.35rem 0.75rem; }
  .layer-heading span { color: var(--text-muted); }
  .framework-layer .layer-heading span { color: var(--accent); }
  .layer-heading strong { color: var(--text-primary); font-family: var(--font-display); font-size: 0.875rem; font-weight: 600; line-height: 1.4; }
  .capabilities { display: grid; gap: 0; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .capabilities li { border-top: 1px solid var(--border-subtle); padding: 0.4rem 0; color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.5; }
  .shift { display: flex; align-items: center; justify-content: center; gap: 0.55rem; color: var(--text-muted); }
  .shift span { color: var(--text-muted); }
  .shift strong { color: var(--accent); font-family: var(--font-mono-ui); font-size: 1rem; font-weight: 500; transform: rotate(90deg); }
  @media (min-width: 780px) {
    .recomposition-map { grid-template-columns: minmax(0, 0.9fr) 5rem minmax(0, 1.2fr); gap: 0.75rem; }
    .shift { align-self: center; flex-direction: column; }
    .shift strong { transform: none; }
    .capabilities { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1rem; }
  }
</style>
