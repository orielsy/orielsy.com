---
import { Cpu, Globe, ListChecks } from '@lucide/astro';
import ResearchFigureFrame from './ResearchFigureFrame.astro';

const tiers = [
  {
    key: 'deterministic',
    name: 'Deterministic',
    when: 'Baseline',
    implementation: 'Indexed filtering + synonyms',
    Icon: ListChecks,
  },
  {
    key: 'local',
    name: 'Local inference',
    when: 'When available',
    implementation: 'Local embeddings',
    Icon: Cpu,
  },
  {
    key: 'remote',
    name: 'Remote inference',
    when: 'When the task justifies it',
    implementation: 'Remote reranker',
    Icon: Globe,
  },
];
---

<ResearchFigureFrame
  figureNumber="03"
  eyebrow="Source model · semantic search"
  title="Variable capability. Fixed truth and authority."
  caption="These are implementation options for a capability, not a required ladder. The source does not prescribe how a product selects among them at runtime."
>
  <div class="desktop-model" aria-label="Three implementation tiers over a shared invariant floor">
    <div class="tier-grid tier-headings">
      <div></div>
      {tiers.map(({ name, when, Icon }, index) => (
        <div class:list={['tier-heading', index > 0 && 'tier-divider']}>
          <Icon size={16} strokeWidth={1.7} aria-hidden="true" />
          <strong>{name}</strong>
          <span>{when}</span>
        </div>
      ))}
    </div>

    <div class="tier-grid data-row">
      <span class="row-label">Implementation</span>
      {tiers.map(({ implementation }, index) => (
        <div class:list={['data-cell', index > 0 && 'tier-divider']}>{implementation}</div>
      ))}
    </div>

    <div class="tier-grid data-row">
      <span class="row-label">User experiences</span>
      <div class="shared-experience">Search</div>
    </div>
  </div>

  <div class="mobile-model" aria-label="Three implementation tiers feeding one shared search interaction">
    <div class="mobile-tier-stack">
      {tiers.map(({ name, when, implementation, Icon }) => (
        <section>
          <div class="mobile-tier-heading">
            <Icon size={16} strokeWidth={1.7} aria-hidden="true" />
            <div>
              <strong>{name}</strong>
              <span>{when}</span>
            </div>
          </div>
          <div class="mobile-implementation">
            <span>Implementation</span>
            <p>{implementation}</p>
          </div>
        </section>
      ))}
    </div>
    <div class="mobile-shared-experience">
      <span>User experiences</span>
      <strong>Search</strong>
    </div>
  </div>

  <div class="invariant-floor">
    <div class="floor-heading">
      <span>Invariant floor</span>
      <span>Constant across every tier</span>
    </div>
    <p>Application truth · action boundaries</p>
  </div>

  <p class="closing-line"><strong>Capability can degrade gracefully.</strong> Authority should remain bounded by what the application can justify.</p>
</ResearchFigureFrame>

<style>
  :global(.research-figure-frame) :global(p) {
    margin: 0;
  }

  .desktop-model {
    display: none;
  }

  .mobile-model {
    display: grid;
    gap: 0;
  }

  .mobile-tier-stack {
    position: relative;
    border-left: 1px solid var(--border-subtle);
    padding-left: 1rem;
  }

  .mobile-tier-stack section {
    position: relative;
    padding: 0 0 1rem;
  }

  .mobile-tier-stack section + section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .mobile-tier-stack section::before {
    content: '';
    position: absolute;
    top: 0.35rem;
    left: -1.24rem;
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--bg-card);
  }

  .mobile-tier-stack section + section::before {
    top: 1.35rem;
  }

  .mobile-tier-heading {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    color: var(--accent);
  }

  .mobile-tier-heading strong {
    display: block;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .mobile-tier-heading span,
  .mobile-implementation > span,
  .mobile-shared-experience > span,
  .row-label {
    color: var(--text-muted);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.07em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .mobile-tier-heading span {
    display: block;
    margin-top: 0.15rem;
  }

  .mobile-implementation {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
    margin-top: 0.65rem;
  }

  .mobile-implementation p {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .mobile-shared-experience {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
    margin-top: 0.15rem;
    border-top: 1px solid var(--border-subtle);
    padding: 0.85rem 0 0.1rem;
  }

  .mobile-shared-experience strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .invariant-floor {
    margin-top: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 48%, var(--border-subtle));
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
    padding: 0.85rem 1rem;
  }

  .floor-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .floor-heading span:first-child {
    color: var(--accent);
  }

  .floor-heading span:last-child {
    color: var(--text-muted);
  }

  .invariant-floor p {
    margin-top: 0.35rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .closing-line {
    margin-top: 1.1rem !important;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .closing-line strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  @media (min-width: 720px) {
    .mobile-model {
      display: none;
    }

    .desktop-model {
      display: block;
    }

    .tier-grid {
      display: grid;
      grid-template-columns: 7.5rem repeat(3, minmax(0, 1fr));
    }

    .tier-heading {
      min-width: 0;
      padding: 0 1rem 1rem;
      color: var(--accent);
    }

    .tier-divider {
      border-left: 1px solid var(--border-subtle);
    }

    .tier-heading strong {
      display: block;
      margin-top: 0.5rem;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.4;
    }

    .tier-heading span {
      display: block;
      margin-top: 0.18rem;
      color: var(--text-muted);
      font-family: var(--font-mono-ui);
      font-size: 0.625rem;
      letter-spacing: 0.06em;
      line-height: 1.5;
      text-transform: uppercase;
    }

    .data-row {
      border-top: 1px solid var(--border-subtle);
    }

    .row-label {
      display: flex;
      align-items: center;
      padding: 0.75rem 0;
    }

    .data-cell {
      padding: 0.75rem 1rem;
      color: var(--text-secondary);
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .shared-experience {
      grid-column: 2 / -1;
      padding: 0.75rem 1rem;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.5;
      text-align: center;
    }
  }
</style>
