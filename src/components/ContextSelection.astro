---
const rows = [
  {
    task: 'Publishing change',
    selected: [
      ['Publication Gating Spec', 'spec'],
      ['Manual Publishing ADR', 'decision'],
      ['SEO / URL ADR', 'decision, if relevant'],
    ],
  },
  {
    task: 'About-page rewrite',
    selected: [
      ['Constitution', 'project-wide rules'],
      ['About Page Spec', 'spec'],
    ],
  },
  { task: 'Typography change', selected: [['Site Foundation Spec', 'spec']] },
  {
    task: 'Coding-agent architecture work',
    selected: [
      ['Constitution', 'project-wide rules'],
      ['Relevant feature spec / ADR', 'spec, decision'],
    ],
  },
];
---

<figure class="context-selection not-prose" aria-labelledby="context-selection-title" data-research-diagram>
  <header>
    <p class="figure-number">Figure 01</p>
    <h3 id="context-selection-title">Context Selection, Not Context Accumulation</h3>
    <p class="dek">The goal is to surface the right project memory for the task — not load everything.</p>
  </header>

  <div class="routing-evidence">
    <p class="label">Current repository · human-authored routing</p>
    <p><code>AGENTS.md</code> points to documents written and maintained by people. It is not an automated relevance engine.</p>
  </div>

  <div class="column-headings" aria-hidden="true"><span>Task</span><span>Selected project memory</span></div>
  <dl class="route-ledger" aria-label="Examples of human-authored task-specific context routing">
    {rows.map((row) => (
      <div class="route-row">
        <dt>{row.task}</dt>
        <dd>
          <ul>
            {row.selected.map(([document, kind]) => (
              <li><span>{document}</span><small>{kind}</small></li>
            ))}
          </ul>
        </dd>
      </div>
    ))}
  </dl>

  <div class="unselected">
    <p class="label">Present, not selected for this task</p>
    <p>speechBubbles implementation history · Unrelated project specs · Unrelated ADRs</p>
  </div>

  <div class="working-context">
    <p class="label">Agent working context</p>
    <p>task + selected project memory <span aria-hidden="true">→</span> implementation</p>
    <p class="caveat">A selected subset, not the entire repository memory. Reading the right document does not guarantee correct output.</p>
  </div>

  <div class="delivery">
    <p class="label">Then deliver <span>— a separate decision, after selection.</span></p>
    <ul><li>Load directly</li><li>Expose through tools</li><li>Deliver through MCP</li></ul>
    <p class="caveat">MCP may carry selected context; it does not decide relevance. Project-wide, feature, package, and component scope are selection questions.</p>
  </div>
</figure>

<style>
  .context-selection {
    box-sizing: border-box;
    min-width: 0;
    margin: 2.5rem 0;
    border-block: 1px solid var(--border-subtle);
    padding: 1.25rem 0;
    color: var(--text-primary);
  }
  .context-selection :global(p), .context-selection :global(h3),
  .context-selection :global(dl), .context-selection :global(dt),
  .context-selection :global(dd), .context-selection :global(ul),
  .context-selection :global(li) { margin: 0; padding: 0; }
  .context-selection :global(ul) { list-style: none; }
  .context-selection header { padding: 0 !important; }
  .figure-number, .label, .column-headings {
    font-family: var(--font-mono-ui);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .figure-number { color: var(--accent); }
  .context-selection h3 {
    margin-top: 0.45rem !important;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }
  .dek { margin-top: 0.55rem !important; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.7; }
  .label { color: var(--text-muted); }
  .routing-evidence, .working-context { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .routing-evidence { margin-top: 1.75rem; }
  .routing-evidence > p + p, .working-context > p + p { margin-top: 0.3rem; }
  .routing-evidence > p + p, .working-context > p:nth-child(2) { font-size: 0.875rem; line-height: 1.7; }
  .routing-evidence code {
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    font-family: var(--font-mono-ui);
    font-size: 0.8125rem;
  }
  .column-headings { display: none; color: var(--text-muted); }
  .route-ledger { margin-top: 1.75rem !important; }
  .route-row { min-width: 0; border-bottom: 1px solid var(--border-subtle); padding: 1rem 0; }
  .route-row dt { color: var(--text-primary); font-size: 0.875rem; font-weight: 600; line-height: 1.6; }
  .route-row dd { min-width: 0; margin-top: 0.5rem; }
  .route-row li { min-width: 0; margin-top: 0.5rem !important; font-size: 0.875rem; line-height: 1.5; }
  .route-row li:first-child { margin-top: 0 !important; }
  .route-row small { display: block; color: var(--text-muted); font-size: 0.75rem; line-height: 1.5; }
  .unselected { padding-top: 1rem; }
  .unselected > p + p { margin-top: 0.5rem; color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.65; }
  .working-context { margin-top: 1.75rem; }
  .caveat { color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.65; }
  .delivery { margin-top: 1.75rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem; }
  .delivery .label span { color: var(--text-secondary); font-family: var(--font-body); font-size: 0.8125rem; font-weight: 400; letter-spacing: 0; text-transform: none; }
  .delivery ul { display: grid; gap: 0.45rem; margin-top: 0.8rem !important; font-size: 0.875rem; line-height: 1.5; }
  .delivery .caveat { margin-top: 0.75rem; }
  .context-selection { border-radius: 0 !important; }
  :global(.research-reading .research-prose) .context-selection > header { padding: 0 !important; }
  :global(.research-reading .research-prose) .context-selection > header .dek { font-size: 0.875rem !important; line-height: 1.7 !important; }
  :global(.research-reading .research-prose) .context-selection .routing-evidence p:not(.label),
  :global(.research-reading .research-prose) .context-selection .working-context p:not(.label):not(.caveat) { font-size: 0.875rem !important; line-height: 1.7 !important; }
  :global(.research-reading .research-prose) .context-selection .unselected p:not(.label),
  :global(.research-reading .research-prose) .context-selection .caveat { font-size: 0.8125rem !important; line-height: 1.65 !important; }
  :global(.research-reading .research-prose) .context-selection .label { font-size: 0.6875rem !important; line-height: 1.5 !important; }
  @media (min-width: 640px) {
    .context-selection { padding-block: 1.5rem; }
    .context-selection header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.75rem; }
    .context-selection h3 { margin-top: 0 !important; }
    .dek { flex: 0 0 100%; }
    .column-headings, .route-row, .unselected { display: grid; grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr); gap: 1.5rem; }
    .column-headings { margin-top: 1.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.5rem; }
    .route-ledger { margin-top: 0 !important; }
    .route-row dd { margin-top: 0; }
    .route-row li { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-top: 0.25rem !important; }
    .route-row small { flex: 0 0 auto; text-align: right; }
    .delivery ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .delivery li + li::before { content: '/'; margin-right: 1rem; color: var(--text-muted); }
  }
</style>
