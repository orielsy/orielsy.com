---
export interface Props {
  ariaLabel?: string;
}

const { ariaLabel = 'Featured implementation preview' } = Astro.props;
const bars = [28, 62, 36, 78, 48, 88, 54, 72, 34, 66, 42, 82, 58, 46];
---

<aside
  class="implementation-preview relative overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5"
  aria-label={ariaLabel}
>
  <div class="flex items-center justify-between gap-4">
    <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
      Program output
    </p>
    <span class="font-editorial-mono inline-flex items-center gap-2 text-[8px] uppercase tracking-[0.1em] text-[var(--text-muted)]">
      <span class="preview-live-dot h-1.5 w-1.5 rounded-full bg-[#ef4444]" aria-hidden="true"></span>
      Live · Local
    </span>
  </div>

  <div class="preview-window mt-5 overflow-hidden border border-[var(--border-subtle)] bg-[#0f1015]">
    <div class="relative min-h-[220px] overflow-hidden">
      <div class="signal-grid absolute inset-0" aria-hidden="true"></div>

      <div class="absolute right-4 top-6 w-[108px]" aria-hidden="true">
        <div class="waveform flex h-8 items-end justify-end gap-[3px]">
          {bars.map((height, index) => (
            <span style={`--bar-height:${height}%; --bar-index:${index};`}></span>
          ))}
        </div>
      </div>

      <div class="caption-stage absolute inset-x-4 top-[84px] h-14" aria-hidden="true">
        <span class="caption caption-one">Local speech becomes live captions.</span>
        <span class="caption caption-two">Graphics stay ready for broadcast.</span>
        <span class="caption caption-three">The overlay composites in OBS.</span>
      </div>

      <div class="lower-third absolute inset-x-4 bottom-4 overflow-hidden border-l-2 border-[var(--accent)] bg-black/55 backdrop-blur-sm" aria-hidden="true">
        <div class="relative h-[52px]">
          <div class="lower-third-entry lower-third-entry-one absolute inset-0 px-3 py-2.5">
            <p class="font-editorial-mono text-[7px] uppercase tracking-[0.12em] text-white/45">Orielsy Diaz</p>
            <p class="mt-1 text-[11px] font-medium leading-4 text-white/90">Creator · Developer</p>
          </div>
          <div class="lower-third-entry lower-third-entry-two absolute inset-0 px-3 py-2.5">
            <p class="font-editorial-mono text-[7px] uppercase tracking-[0.12em] text-white/45">speechBubbles</p>
            <p class="mt-1 text-[11px] font-medium leading-4 text-white/90">Local AI Broadcast Overlay</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</aside>

<style>
  .implementation-preview :global(p) {
    margin: 0;
  }

  .signal-grid {
    opacity: 0.09;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.09) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.09) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .preview-live-dot {
    animation: live-pulse 1.2s ease-in-out infinite;
  }

  .caption {
    position: absolute;
    right: 0;
    max-width: 88%;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(18, 20, 28, 0.82);
    padding: 0.45rem 0.6rem;
    font-size: 0.69rem;
    line-height: 1.35;
    color: rgba(255,255,255,0.9);
    opacity: 0;
    transform: translateY(6px);
    animation: caption-cycle 9s ease-in-out infinite;
  }

  .caption-two {
    animation-delay: 3s;
  }

  .caption-three {
    animation-delay: 6s;
  }

  .waveform span {
    display: block;
    width: 4px;
    height: var(--bar-height);
    min-height: 4px;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0.82;
    transform-origin: bottom;
    animation: wave-pulse 1.15s ease-in-out infinite;
    animation-delay: calc(var(--bar-index) * 70ms);
  }

  .lower-third-entry {
    opacity: 0;
    transform: translateX(10px);
    animation-duration: 20s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .lower-third-entry-one {
    animation-name: lower-third-entry-one-cycle;
  }

  .lower-third-entry-two {
    animation-name: lower-third-entry-two-cycle;
  }

  @keyframes live-pulse {
    0%, 100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes wave-pulse {
    0%, 100% {
      transform: scaleY(0.5);
      opacity: 0.55;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @keyframes caption-cycle {
    0%, 100% {
      opacity: 0;
      transform: translateY(6px);
    }
    8%, 27% {
      opacity: 1;
      transform: translateY(0);
    }
    34% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @keyframes lower-third-entry-one-cycle {
    0% {
      opacity: 0;
      transform: translateX(10px);
    }
    4%, 43% {
      opacity: 1;
      transform: translateX(0);
    }
    48%, 100% {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  @keyframes lower-third-entry-two-cycle {
    0%, 49% {
      opacity: 0;
      transform: translateX(10px);
    }
    54%, 93% {
      opacity: 1;
      transform: translateX(0);
    }
    98%, 100% {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caption,
    .waveform span,
    .lower-third-entry,
    .preview-live-dot {
      animation: none !important;
      transform: none !important;
    }

    .caption-one {
      opacity: 1;
    }

    .caption-two,
    .caption-three {
      display: none;
    }

    .waveform span {
      opacity: 0.82;
    }

    .lower-third-entry-one {
      opacity: 1;
      transform: none;
    }

    .lower-third-entry-two {
      display: none;
    }
  }
</style>
