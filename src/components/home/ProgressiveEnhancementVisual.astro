<figure aria-label="Capability tiers diagram" class="m-0">
  <div class="mb-3 flex items-center gap-2">
    <span class="font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--accent)]">Fig. 01</span>
    <span class="font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">Capability can increase</span>
  </div>

  <div class="relative">
    <span
      aria-hidden="true"
      class="absolute bottom-5 left-[4px] top-5 w-px bg-[var(--border-subtle)]"
    ></span>

    <ol class="space-y-2">
      <li class="relative pl-6">
        <span
          aria-hidden="true"
          class="absolute left-0 top-4 h-[9px] w-[9px] rounded-full border-2 border-[var(--accent)] bg-[var(--bg-card)]"
        ></span>
        <div class="rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] p-2.5">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
            <span class="font-editorial-mono text-[8px] uppercase tracking-[0.14em] text-[var(--text-primary)]">Baseline</span>
            <span class="ml-auto font-editorial-mono text-[8px] text-[var(--text-muted)]">01</span>
          </div>
          <p class="mt-1 text-xs leading-4 text-[var(--text-secondary)]">Useful interface without inference.</p>
        </div>
      </li>

      <li class="relative pl-6">
        <span
          aria-hidden="true"
          class="absolute left-0 top-4 h-[9px] w-[9px] rounded-full border-2 border-[var(--accent)] bg-[var(--bg-card)]"
        ></span>
        <div class="rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] p-2.5">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
            <span class="font-editorial-mono text-[8px] uppercase tracking-[0.14em] text-[var(--text-primary)]">Local enhancement</span>
            <span class="rounded-sm border border-[var(--accent-border)] px-1 py-px font-editorial-mono text-[7px] uppercase tracking-[0.12em] text-[var(--accent)]">Optional AI</span>
            <span class="ml-auto font-editorial-mono text-[8px] text-[var(--text-muted)]">02</span>
          </div>
          <p class="mt-1 text-xs leading-4 text-[var(--text-secondary)]">Add narrow intelligence when the environment supports it.</p>
        </div>
      </li>

      <li class="relative pl-6">
        <span
          aria-hidden="true"
          class="absolute left-0 top-4 h-[9px] w-[9px] rounded-full border-2 border-[var(--accent)] bg-[var(--accent)]"
        ></span>
        <div class="rounded-md border border-[var(--accent-border)] bg-[var(--bg-secondary)] p-2.5">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
            <span class="font-editorial-mono text-[8px] uppercase tracking-[0.14em] text-[var(--text-primary)]">Stronger inference</span>
            <span class="rounded-sm border border-[var(--accent-border)] px-1 py-px font-editorial-mono text-[7px] uppercase tracking-[0.12em] text-[var(--accent)]">Optional AI</span>
            <span class="ml-auto font-editorial-mono text-[8px] text-[var(--text-muted)]">03</span>
          </div>
          <p class="mt-1 text-xs leading-4 text-[var(--text-secondary)]">Use remote capability only when the task justifies it.</p>
        </div>
      </li>
    </ol>
  </div>

  <div class="mt-4">
    <div class="flex items-center gap-2">
      <span aria-hidden="true" class="h-px flex-1 bg-[var(--accent)]"></span>
      <span class="font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--accent)]">Authority stays bounded</span>
    </div>
  </div>
</figure>
