<aside
  class="relative min-h-[230px] overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5"
  aria-label="Progressive enhancement for intelligent interfaces concept diagram"
>
  <div class="flex items-center justify-between gap-4">
    <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
      Capability can increase
    </p>
    <span class="font-editorial-mono text-[8px] uppercase tracking-[0.08em] text-[var(--accent)]">
      Optional AI
    </span>
  </div>

  <div class="mt-7 grid grid-cols-[16px_minmax(0,1fr)] gap-3">
    <div class="relative" aria-hidden="true">
      <span class="absolute left-1/2 top-1 h-[calc(100%-0.5rem)] w-px -translate-x-1/2 bg-[var(--border-strong)]"></span>
      <span class="absolute left-1/2 top-1 h-2 w-2 -translate-x-1/2 rounded-full border border-[var(--accent)] bg-[var(--bg-card)]"></span>
      <span class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-[var(--accent)] bg-[var(--bg-card)]"></span>
      <span class="absolute bottom-1 left-1/2 h-2 w-2 -translate-x-1/2 rounded-full bg-[var(--accent)]"></span>
    </div>

    <div class="space-y-2">
      <div class="border border-[var(--border-subtle)] px-3 py-2.5">
        <div class="flex items-center justify-between gap-3">
          <p class="font-editorial-mono text-[8px] uppercase tracking-[0.08em] text-[var(--text-muted)]">Baseline</p>
          <span class="font-editorial-mono text-[8px] text-[var(--accent)]">01</span>
        </div>
        <p class="mt-1 text-[11px] leading-5 text-[var(--text-secondary)]">Useful interface without inference.</p>
      </div>

      <div class="border border-[var(--border-subtle)] px-3 py-2.5">
        <div class="flex items-center justify-between gap-3">
          <p class="font-editorial-mono text-[8px] uppercase tracking-[0.08em] text-[var(--text-muted)]">Local enhancement</p>
          <span class="font-editorial-mono text-[8px] text-[var(--accent)]">02</span>
        </div>
        <p class="mt-1 text-[11px] leading-5 text-[var(--text-secondary)]">Add narrow intelligence when the environment supports it.</p>
      </div>

      <div class="border border-[var(--accent)] bg-[var(--accent-subtle)] px-3 py-2.5">
        <div class="flex items-center justify-between gap-3">
          <p class="font-editorial-mono text-[8px] uppercase tracking-[0.08em] text-[var(--accent)]">Stronger inference</p>
          <span class="font-editorial-mono text-[8px] text-[var(--accent)]">03</span>
        </div>
        <p class="mt-1 text-[11px] leading-5 text-[var(--text-secondary)]">Use remote capability only when the task justifies it.</p>
      </div>
    </div>
  </div>

  <div class="mt-4 border-t border-[var(--border-subtle)] pt-3">
    <div class="flex items-center gap-2">
      <span class="h-px flex-1 bg-[var(--accent)]" aria-hidden="true"></span>
      <p class="font-editorial-mono text-[8px] uppercase tracking-[0.08em] text-[var(--text-muted)]">
        Authority stays bounded
      </p>
    </div>
    <p class="mt-2 text-[10px] leading-4 text-[var(--text-muted)]">
      Application truth and action boundaries remain stable as capability changes.
    </p>
  </div>
</aside>
