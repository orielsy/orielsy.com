---
interface Props {
  label?: string;
}

const { label = 'Adaptive Interface' } = Astro.props;
---

<aside class="relative min-h-[230px] overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5" aria-label="Featured research concept preview">
  <div class="flex items-center justify-between gap-4">
    <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">{label}</p>
    <span class="h-2 w-2 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
  </div>

  <div class="mt-8 grid grid-cols-[minmax(0,0.9fr)_16px_minmax(0,1.1fr)] items-center gap-2">
    <div class="space-y-3">
      <div class="border border-[var(--border-subtle)] px-3 py-2.5">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-secondary)]">Product knowledge</p>
      </div>
      <div class="border border-[var(--border-subtle)] px-3 py-2.5">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-secondary)]">Validation</p>
      </div>
      <div class="border border-[var(--border-subtle)] px-3 py-2.5">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-secondary)]">Guidance</p>
      </div>
    </div>

    <div class="flex justify-center text-lg text-[var(--accent)]" aria-hidden="true">→</div>

    <div class="min-w-0 border border-[var(--accent)] p-3">
      <p class="font-editorial-mono text-[9px] uppercase tracking-[0.09em] text-[var(--accent)]">Current state</p>

      <div class="mt-5 space-y-2" aria-hidden="true">
        <span class="block h-2 w-2/3 bg-[var(--border-strong)]"></span>
        <span class="block h-2 w-5/6 bg-[var(--border-strong)]"></span>
      </div>

      <div class="mt-6 min-w-0 border-l-2 border-[var(--accent)] pl-2.5">
        <p class="font-editorial-mono min-w-0 text-[8px] uppercase leading-4 tracking-[0.06em] text-[var(--text-secondary)]">
          <span class="block">Contextual</span>
          <span class="block">UI response</span>
        </p>
      </div>
    </div>
  </div>
</aside>
