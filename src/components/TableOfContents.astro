---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((heading) => heading.depth === 2);
---

{filteredHeadings.length > 2 && (
  <nav class="research-toc" aria-label="Table of contents">
    <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
      Contents
    </p>
    <ol class="mt-4 list-none border-l border-[var(--border-subtle)] p-0">
      {filteredHeadings.map((heading, index) => (
        <li class="m-0 p-0 leading-5">
          <a
            href={`#${heading.slug}`}
            class="group -ml-px grid grid-cols-[26px_minmax(0,1fr)] gap-2 border-l border-transparent py-2.5 pl-4 no-underline transition-colors hover:border-[var(--accent)]"
          >
            <span class="font-editorial-mono text-[9px] text-[var(--accent)]">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="text-[12px] leading-5 text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
              {heading.text}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
