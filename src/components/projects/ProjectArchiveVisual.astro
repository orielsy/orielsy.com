---
import FeaturedProjectVisual from '../home/FeaturedProjectVisual.astro';
import AdaptiveUiLabArchiveVisual from './AdaptiveUiLabArchiveVisual.astro';

export interface Props {
  visual?: 'speech-broadcast' | 'adaptive-ui-lab';
  technologies: string[];
}

const { visual, technologies } = Astro.props;
---

{visual === 'speech-broadcast' ? (
  <FeaturedProjectVisual ariaLabel="speechBubbles project preview" />
) : visual === 'adaptive-ui-lab' ? (
  <AdaptiveUiLabArchiveVisual />
) : (
  <aside class="border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5" aria-label="Project technologies">
    <p class="font-editorial-mono m-0 text-[8px] uppercase tracking-[0.1em] text-[var(--text-muted)]">Technology</p>
    <ul class="mt-4 border-t border-[var(--border-subtle)]">
      {technologies.slice(0, 6).map((technology) => (
        <li class="border-b border-[var(--border-subtle)] py-2.5 font-editorial-mono text-[9px] uppercase tracking-[0.06em] text-[var(--text-secondary)]">
          {technology}
        </li>
      ))}
    </ul>
  </aside>
)}
