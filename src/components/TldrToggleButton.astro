---
interface Props {
  controls: string;
  class?: string;
}

const { controls, class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={[
    'tldr-toggle group inline-flex cursor-pointer items-stretch overflow-hidden rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-card)] text-left transition-colors hover:border-[var(--accent-border)] hover:bg-[var(--bg-card-hover)]',
    className,
  ]}
  aria-expanded="false"
  aria-controls={controls}
  data-tldr-toggle
>
  <span
    class="tldr-toggle__icon flex h-6 w-6 shrink-0 items-center justify-center border-r border-[var(--border-subtle)] bg-[var(--bg-secondary)] font-editorial-mono text-[14px] text-[var(--accent)] transition-colors"
    aria-hidden="true"
  >
    <span data-tldr-symbol>+</span>
  </span>
  <span class="flex items-center px-1 font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
    TL;DR
  </span>
</button>

<style>
  .tldr-toggle[aria-expanded='true'] {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .tldr-toggle[aria-expanded='true'] .tldr-toggle__icon {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg-primary);
  }
</style>
