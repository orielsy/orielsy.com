---
interface Props {
  controls: string;
  class?: string;
}

const { controls, class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={[
    'tldr-toggle inline-flex min-h-10 cursor-pointer items-center gap-2 border-0 border-b border-transparent bg-transparent px-1 py-2 text-left text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]',
    className,
  ]}
  aria-expanded="false"
  aria-controls={controls}
  data-tldr-toggle
>
  <span class="font-editorial-mono text-[10px] uppercase tracking-[0.1em]">
    TL;DR
  </span>
  <span
    class="tldr-toggle__symbol font-editorial-mono text-[14px] leading-none text-[var(--accent)]"
    aria-hidden="true"
    data-tldr-symbol
  >
    +
  </span>
</button>

<style>
  .tldr-toggle[aria-expanded='true'] {
    border-bottom-color: var(--accent-border);
    color: var(--text-primary);
  }

  .tldr-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tldr-toggle {
      transition: none;
    }
  }
</style>
