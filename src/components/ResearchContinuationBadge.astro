---
interface Props {
  href: string;
  count: number;
}

const { href, count } = Astro.props;
const label = count === 1 ? '1 piece' : `${count} pieces`;
---

<a
  href={href}
  title={`Led to ${label}`}
  class="group/continuation inline-flex items-center gap-1.5 font-editorial-mono text-[10px] tracking-[0.08em] text-[var(--text-muted)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--accent)]"
>
  <svg
    class="h-2.5 w-2.5 shrink-0 text-[var(--accent)]"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 2.5v7a3 3 0 0 0 3 3h3.5" />
    <path d="m9.5 10.5 2 2-2 2" />
    <path d="M5 5.5h4a2 2 0 0 0 2-2v-1" />
  </svg>
  <span class="uppercase text-[var(--text-muted)]">Led to</span>
  <span aria-hidden="true" class="text-[var(--text-muted)]">·</span>
  <span class="normal-case tracking-normal text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors group-hover/continuation:text-[var(--accent)] group-hover/continuation:decoration-[var(--accent)]">{label}</span>
</a>