---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  articleDate?: string;
  modifiedDate?: string;
  type?: 'website' | 'article';
  schemaType?: 'website' | 'person' | 'article' | 'webpage';
  noindex?: boolean;
}

const {
  title = 'Orielsy Diaz — Senior Frontend Engineer & UI Architect',
  description = 'Personal website, technical research, UI architecture explorations, and applied AI systems by Orielsy Diaz.',
  image,
  imageAlt,
  articleDate,
  modifiedDate,
  type = 'website',
  schemaType = 'webpage',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site || new URL('https://orielsy.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const formattedTitle = title === 'Orielsy Diaz' ? title : `${title} | Orielsy Diaz`;
const ogImageUrl = image ? new URL(image, siteUrl).toString() : undefined;
const socialImageAlt = image ? imageAlt || title : undefined;

const author = {
  '@type': 'Person',
  name: 'Orielsy Diaz',
  url: siteUrl.toString(),
};

function buildStructuredData() {
  if (schemaType === 'website') {
    return {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Orielsy Diaz',
      url: siteUrl.toString(),
      description: description,
    };
  }

  if (schemaType === 'person') {
    return {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Orielsy Diaz',
      url: siteUrl.toString(),
      description: description,
      jobTitle: 'Senior Frontend Engineer & UI Architect',
    };
  }

  if (schemaType === 'article') {
    return {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description: description,
      ...(articleDate ? { datePublished: articleDate } : {}),
      ...(modifiedDate ? { dateModified: modifiedDate } : {}),
      ...(ogImageUrl ? { image: ogImageUrl } : {}),
      author,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
      url: canonicalURL.toString(),
    };
  }

  return {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: canonicalURL.toString(),
    description: description,
    isPartOf: {
      '@type': 'WebSite',
      name: 'Orielsy Diaz',
      url: siteUrl.toString(),
    },
  };
}

const jsonLd = buildStructuredData();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Orielsy Diaz — Research & Writing" href="/rss.xml" />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<meta name="author" content="Orielsy Diaz" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
<meta property="og:site_name" content="Orielsy Diaz" />
{type === 'article' && articleDate && <meta property="article:published_time" content={articleDate} />}
{type === 'article' && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Theme Script to prevent FOUC & follow OS preference -->
<script is:inline>
  (function () {
    function applyTheme() {
      const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
    applyTheme();

    if (typeof window !== 'undefined' && window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (!localStorage.getItem('theme')) {
          applyTheme();
        }
      });
    }
  })();
</script>
