---
export interface Props {
  eyebrow: string;
  description: string;
  adaptive?: boolean;
  embedded?: boolean;
}

const {
  eyebrow,
  description,
  adaptive = false,
  embedded = false,
} = Astro.props;
---

<div class="mb-8 flex items-start justify-between gap-4 border-b border-[var(--border-subtle)] pb-5">
  <div>
    <p class:list={[
      "m-0 font-mono text-[10px] uppercase tracking-[0.15em]",
      adaptive ? "text-[var(--accent)]" : "text-[var(--text-muted)]",
    ]}>{eyebrow}</p>
    {embedded ? (
      <h4 class="mt-2 mb-0 text-lg font-semibold text-[var(--text-primary)]">Configuration</h4>
    ) : (
      <h5 class="mt-2 mb-0 text-lg font-semibold text-[var(--text-primary)]">Configuration</h5>
    )}
    <p class="mt-2 max-w-md text-xs leading-5 text-[var(--text-secondary)]">{description}</p>
  </div>
  <svg class="mt-1 size-4 shrink-0 text-[var(--text-muted)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
    <path d="M5 9l-3 3 3 3"/>
    <path d="M2 12h16"/>
    <path d="M19 5l3 3-3 3"/>
    <path d="M22 8H6"/>
  </svg>
</div>
