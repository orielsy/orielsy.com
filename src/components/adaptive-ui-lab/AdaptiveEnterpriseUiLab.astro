---
import { DEFAULT_CONFIG, DEFAULT_RUNTIME, THREE_DATA_CONNECTIONS } from './fixtures.ts';
import { KNOWLEDGE } from './knowledge.ts';
import { resolveInterface } from './resolver.ts';

const initialResult = resolveInterface({
  config: DEFAULT_CONFIG,
  runtime: DEFAULT_RUNTIME,
  ui: { expandedHelp: [], highlightedField: null, dismissedGuidance: [] },
  knowledge: KNOWLEDGE,
});
const initialResponseIds = initialResult.responses.map((response) => response.id);
---

<section class="not-prose my-10 overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] shadow-sm" data-adaptive-enterprise-ui-lab>
  <header class="border-b border-[var(--border-subtle)] px-5 py-4 sm:px-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="mb-1 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--text-tertiary)]">Adaptive Enterprise UI Lab · Phase 1</p>
        <h3 class="m-0 text-lg font-semibold text-[var(--text-primary)]">Same field. Same scenario. Different interface policy.</h3>
        <p class="mt-1 max-w-3xl text-sm text-[var(--text-secondary)]">Change the shared scenario below and compare a conventional Data Connection control with the adaptive version under exactly the same conditions.</p>
      </div>
      <span class="rounded-full border border-[var(--border-subtle)] px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">deterministic</span>
    </div>
  </header>

  <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-5 py-4 sm:px-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="m-0 font-mono text-[10px] uppercase tracking-[0.16em] text-sky-600 dark:text-sky-400">Shared scenario</p>
        <p class="mt-1 text-xs text-[var(--text-tertiary)]">These controls feed both product surfaces equally.</p>
      </div>
      <button type="button" data-reset-context class="rounded-md border border-[var(--border-subtle)] px-2.5 py-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--text-secondary)] transition hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]">Reset scenario</button>
    </div>

    <div class="grid gap-3 md:grid-cols-3">
      <fieldset class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3">
        <legend class="px-1 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">User familiarity</legend>
        <div class="mt-1 grid grid-cols-2 gap-1.5">
          <button type="button" data-familiarity="new" aria-pressed="true" class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-primary)] px-3 py-2 text-xs font-medium text-[var(--text-primary)]">New</button>
          <button type="button" data-familiarity="experienced" aria-pressed="false" class="rounded-md border border-[var(--border-subtle)] px-3 py-2 text-xs text-[var(--text-secondary)]">Experienced</button>
        </div>
      </fieldset>

      <fieldset class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3">
        <legend class="px-1 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">Product version</legend>
        <div class="mt-1 grid grid-cols-2 gap-1.5">
          <button type="button" data-version="4.1" aria-pressed="false" class="rounded-md border border-[var(--border-subtle)] px-3 py-2 text-xs text-[var(--text-secondary)]">4.1</button>
          <button type="button" data-version="4.2" aria-pressed="true" class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-primary)] px-3 py-2 text-xs font-medium text-[var(--text-primary)]">4.2</button>
        </div>
      </fieldset>

      <fieldset class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3">
        <legend class="px-1 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">Compatible Data Connections</legend>
        <div class="mt-1 grid grid-cols-2 gap-1.5">
          <button type="button" data-connection-count="1" aria-pressed="false" class="rounded-md border border-[var(--border-subtle)] px-3 py-2 text-xs text-[var(--text-secondary)]">One</button>
          <button type="button" data-connection-count="3" aria-pressed="true" class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-primary)] px-3 py-2 text-xs font-medium text-[var(--text-primary)]">Several</button>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="p-5 sm:p-6">
    <div class="mb-4">
      <p class="m-0 font-mono text-[10px] uppercase tracking-[0.16em] text-emerald-600 dark:text-emerald-400">Product comparison</p>
      <p class="mt-1 text-xs text-[var(--text-tertiary)]">Both sides represent the same Data Connection field and share one underlying selection.</p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)]">
        <div class="border-b border-[var(--border-subtle)] px-5 py-4">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="m-0 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">Baseline</p>
              <h4 class="mt-1 mb-0 text-base font-semibold text-[var(--text-primary)]">Standard UI</h4>
            </div>
            <span class="rounded-md border border-[var(--border-subtle)] px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-[var(--text-tertiary)]">conventional</span>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">Static field description plus ordinary required-state feedback.</p>
        </div>

        <div class="space-y-4 p-5">
          <label class="block">
            <span class="mb-1.5 flex items-center justify-between gap-2 text-sm font-medium text-[var(--text-primary)]">
              <span>Data Connection</span>
              <span data-standard-required class="font-mono text-[10px] uppercase tracking-wide text-amber-600 dark:text-amber-400">Required</span>
            </span>
            <select data-standard-data-connection class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2.5 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--border-strong)]">
              <option value="">None selected</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name}</option>)}
            </select>
            <p class="mt-1.5 text-xs text-[var(--text-tertiary)]">Selects the external system this workflow reads from or writes to.</p>
          </label>

          <div data-standard-guidance class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3" aria-live="polite">
            <p class="m-0 text-sm text-amber-700 dark:text-amber-300">Data Connection is required.</p>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-xl border border-sky-500/25 bg-[var(--bg-primary)] shadow-sm">
        <div class="border-b border-sky-500/20 px-5 py-4">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="m-0 font-mono text-[10px] uppercase tracking-wider text-sky-600 dark:text-sky-400">Concept</p>
              <h4 class="mt-1 mb-0 text-base font-semibold text-[var(--text-primary)]">Adaptive UI</h4>
            </div>
            <span class="rounded-md border border-sky-500/25 px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-sky-600 dark:text-sky-400">context-aware</span>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">Uses the same state plus authored product knowledge to choose an appropriate response level.</p>
        </div>

        <div class="space-y-4 p-5">
          <label class="block rounded-xl transition" data-adaptive-data-connection-shell>
            <span class="mb-1.5 flex items-center justify-between gap-2 text-sm font-medium text-[var(--text-primary)]">
              <span>Data Connection</span>
              <span data-adaptive-required class="font-mono text-[10px] uppercase tracking-wide text-amber-600 dark:text-amber-400">Required</span>
            </span>
            <select data-adaptive-data-connection class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2.5 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--border-strong)]">
              <option value="">None selected</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name}</option>)}
            </select>
            <p class="mt-1.5 text-xs text-[var(--text-tertiary)]">Selects the external system this workflow reads from or writes to.</p>
          </label>

          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-4" aria-live="polite">
            <div class="mb-3 flex items-center justify-between gap-3">
              <div>
                <h5 class="m-0 text-sm font-semibold text-[var(--text-primary)]">Adaptive guidance</h5>
                <p class="mt-0.5 text-xs text-[var(--text-tertiary)]">Resolved from current state and authored product knowledge</p>
              </div>
              <span data-response-count class="font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">{initialResponseIds.length} signals</span>
            </div>
            <div data-adaptive-guidance-list class="space-y-2"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import { ONE_DATA_CONNECTION, THREE_DATA_CONNECTIONS } from './fixtures.ts';
  import { KNOWLEDGE } from './knowledge.ts';
  import { resolveInterface } from './resolver.ts';
  import type { AutomationConfiguration, ProductVersion, RuntimeContext, UIAction, UIResponse, UserFamiliarity } from './types.ts';

  document.querySelectorAll<HTMLElement>('[data-adaptive-enterprise-ui-lab]').forEach((lab) => {
    if (lab.dataset.bound === 'true') return;
    lab.dataset.bound = 'true';

    const standardDataConnection = lab.querySelector<HTMLSelectElement>('[data-standard-data-connection]');
    const adaptiveDataConnection = lab.querySelector<HTMLSelectElement>('[data-adaptive-data-connection]');
    const standardRequired = lab.querySelector<HTMLElement>('[data-standard-required]');
    const adaptiveRequired = lab.querySelector<HTMLElement>('[data-adaptive-required]');
    const standardGuidance = lab.querySelector<HTMLElement>('[data-standard-guidance]');
    const adaptiveGuidanceList = lab.querySelector<HTMLElement>('[data-adaptive-guidance-list]');
    const adaptiveShell = lab.querySelector<HTMLElement>('[data-adaptive-data-connection-shell]');
    const responseCount = lab.querySelector<HTMLElement>('[data-response-count]');
    const resetContext = lab.querySelector<HTMLButtonElement>('[data-reset-context]');

    if (!standardDataConnection || !adaptiveDataConnection || !standardGuidance || !adaptiveGuidanceList) return;

    let familiarity: UserFamiliarity = 'new';
    let productVersion: ProductVersion = '4.2';
    let connectionCount: 1 | 3 = 3;
    let dataConnectionId: string | null = null;
    const uiState = { expandedHelp: [], highlightedField: null, dismissedGuidance: [] };

    const setPressedState = (selector: string, activeValue: string, attribute: string) => {
      lab.querySelectorAll<HTMLButtonElement>(selector).forEach((button) => {
        const active = button.dataset[attribute] === activeValue;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.classList.toggle('border-[var(--border-strong)]', active);
        button.classList.toggle('bg-[var(--bg-primary)]', active);
        button.classList.toggle('font-medium', active);
        button.classList.toggle('text-[var(--text-primary)]', active);
        button.classList.toggle('border-[var(--border-subtle)]', !active);
        button.classList.toggle('text-[var(--text-secondary)]', !active);
      });
    };

    const rebuildDataConnectionOptions = () => {
      const connections = connectionCount === 1 ? ONE_DATA_CONNECTION : THREE_DATA_CONNECTIONS;
      [standardDataConnection, adaptiveDataConnection].forEach((select) => {
        select.replaceChildren();
        select.add(new Option('None selected', ''));
        connections.forEach((connection) => select.add(new Option(connection.name, connection.id)));
      });
      dataConnectionId = connections.some((connection) => connection.id === dataConnectionId) ? dataConnectionId : null;
      standardDataConnection.value = dataConnectionId ?? '';
      adaptiveDataConnection.value = dataConnectionId ?? '';
    };

    const setDataConnection = (value: string) => {
      dataConnectionId = value || null;
      standardDataConnection.value = value;
      adaptiveDataConnection.value = value;
      render();
    };

    const createActionButton = (action: UIAction) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = action.label;
      button.className = 'mt-2 rounded-md border border-[var(--border-strong)] bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)] transition hover:opacity-80';
      button.addEventListener('click', () => {
        if (action.type === 'focus-field' && action.field === 'dataConnection') adaptiveDataConnection.focus();
        if (action.type === 'set-value' && action.field === 'dataConnection' && action.value) {
          setDataConnection(action.value);
          adaptiveDataConnection.focus();
        }
      });
      return button;
    };

    const createResponseItem = (response: UIResponse, compact = false) => {
      const item = document.createElement('div');
      if (response.type === 'preconfiguration') item.className = 'rounded-lg border border-emerald-500/30 bg-emerald-500/5 p-3';
      else if (response.type === 'suggestion') item.className = 'rounded-lg border border-sky-500/30 bg-sky-500/5 p-3';
      else if (response.type === 'explanation' || response.type === 'warning') item.className = 'rounded-lg border border-amber-500/30 bg-amber-500/5 p-3';
      else item.className = compact ? 'py-1.5' : 'rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-3';

      const message = document.createElement('p');
      message.className = compact ? 'm-0 text-xs leading-relaxed text-[var(--text-secondary)]' : 'm-0 text-sm leading-relaxed text-[var(--text-primary)]';
      message.textContent = response.message;
      item.append(message);
      response.actions?.forEach((action) => item.append(createActionButton(action)));
      return item;
    };

    const renderStandard = () => {
      standardGuidance.replaceChildren();
      const message = document.createElement('p');
      message.className = dataConnectionId ? 'm-0 text-sm text-[var(--text-secondary)]' : 'm-0 text-sm text-amber-700 dark:text-amber-300';
      message.textContent = dataConnectionId ? 'Data Connection selected.' : 'Data Connection is required.';
      standardGuidance.append(message);
      standardRequired?.classList.toggle('hidden', Boolean(dataConnectionId));
    };

    const renderAdaptive = (responses: UIResponse[]) => {
      adaptiveGuidanceList.replaceChildren();
      const visibleResponses = responses.filter((response) => response.type !== 'highlight');
      const primaryResponses = visibleResponses.filter((response) => response.type !== 'help');
      const helpResponses = visibleResponses.filter((response) => response.type === 'help');

      if (visibleResponses.length === 0) {
        const quiet = document.createElement('p');
        quiet.className = 'm-0 rounded-lg border border-emerald-500/20 bg-emerald-500/5 p-3 text-sm text-[var(--text-secondary)]';
        quiet.textContent = 'Data Connection is set. No contextual intervention is needed.';
        adaptiveGuidanceList.append(quiet);
      } else {
        primaryResponses.forEach((response) => adaptiveGuidanceList.append(createResponseItem(response)));
        if (helpResponses.length > 0) {
          const details = document.createElement('details');
          details.className = 'rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 py-2';
          const summary = document.createElement('summary');
          summary.className = 'cursor-pointer text-xs font-medium text-[var(--text-secondary)]';
          summary.textContent = `Why this guidance? · ${helpResponses.length} ${helpResponses.length === 1 ? 'detail' : 'details'}`;
          details.append(summary);
          const detailBody = document.createElement('div');
          detailBody.className = 'mt-2 divide-y divide-[var(--border-subtle)]';
          helpResponses.forEach((response) => detailBody.append(createResponseItem(response, true)));
          details.append(detailBody);
          adaptiveGuidanceList.append(details);
        }
      }

      const shouldHighlight = responses.some((response) => response.id === 'data-connection-highlight');
      adaptiveShell?.classList.toggle('ring-2', shouldHighlight);
      adaptiveShell?.classList.toggle('ring-amber-500/35', shouldHighlight);
      adaptiveShell?.classList.toggle('bg-amber-500/5', shouldHighlight);
      adaptiveShell?.classList.toggle('p-3', shouldHighlight);
      adaptiveRequired?.classList.toggle('hidden', !shouldHighlight);
      if (responseCount) responseCount.textContent = `${responses.length} ${responses.length === 1 ? 'signal' : 'signals'}`;
    };

    const render = () => {
      const availableDataConnections = connectionCount === 1 ? ONE_DATA_CONNECTION : THREE_DATA_CONNECTIONS;
      const config: AutomationConfiguration = { dataConnectionId };
      const runtime: RuntimeContext = { productVersion, userFamiliarity: familiarity, availableDataConnections };
      const result = resolveInterface({ config, runtime, ui: uiState, knowledge: KNOWLEDGE });
      renderStandard();
      renderAdaptive(result.responses);
    };

    standardDataConnection.addEventListener('change', () => setDataConnection(standardDataConnection.value));
    adaptiveDataConnection.addEventListener('change', () => setDataConnection(adaptiveDataConnection.value));

    lab.querySelectorAll<HTMLButtonElement>('[data-familiarity]').forEach((button) => button.addEventListener('click', () => {
      familiarity = button.dataset.familiarity as UserFamiliarity;
      setPressedState('[data-familiarity]', familiarity, 'familiarity');
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((button) => button.addEventListener('click', () => {
      productVersion = button.dataset.version as ProductVersion;
      setPressedState('[data-version]', productVersion, 'version');
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-connection-count]').forEach((button) => button.addEventListener('click', () => {
      connectionCount = button.dataset.connectionCount === '1' ? 1 : 3;
      setPressedState('[data-connection-count]', String(connectionCount), 'connectionCount');
      rebuildDataConnectionOptions();
      render();
    }));

    resetContext?.addEventListener('click', () => {
      familiarity = 'new';
      productVersion = '4.2';
      connectionCount = 3;
      dataConnectionId = null;
      setPressedState('[data-familiarity]', familiarity, 'familiarity');
      setPressedState('[data-version]', productVersion, 'version');
      setPressedState('[data-connection-count]', String(connectionCount), 'connectionCount');
      rebuildDataConnectionOptions();
      render();
    });

    render();
  });
</script>