---
import { THREE_DATA_CONNECTIONS } from './fixtures.ts';
import LabExperienceHeader from './LabExperienceHeader.astro';
import LabScenarioControl from './LabScenarioControl.astro';
import LabSectionHeading from './LabSectionHeading.astro';
import LabTraceCard from './LabTraceCard.astro';

export interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const presets = [
  { id: 'new-several', label: 'New user, several options', hint: 'new · 4.2 · 3 matches', pressed: true },
  { id: 'one-option', label: 'Only one valid option', hint: 'new · 4.2 · 1 match', pressed: false },
  { id: 'expert', label: 'Experienced user on 4.1', hint: 'experienced · 4.1 · 3 matches', pressed: false },
];
---

<section
  class="not-prose my-10 text-[var(--text-primary)]"
  data-adaptive-enterprise-ui-lab
  data-lab-context={embedded ? 'embedded' : 'standalone'}
  aria-labelledby={embedded ? undefined : 'adaptive-lab-title'}
  aria-label={embedded ? 'Adaptive Enterprise UI Lab' : undefined}
>
  <p data-lab-status class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <header class="border-b border-[var(--border-subtle)] pb-8">
    <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--text-muted)]">
      {!embedded && (
        <>
          <span>Interactive reference implementation</span>
          <span aria-hidden="true" class="h-px w-8 bg-[var(--border-strong)]"></span>
        </>
      )}
      <span>Phase 1 · deterministic</span>
    </div>
    {!embedded && (
      <h3 id="adaptive-lab-title" class="mt-4 mb-0 max-w-4xl text-3xl font-semibold leading-tight text-[var(--text-primary)] sm:text-4xl">
        Adaptive Enterprise UI Lab
      </h3>
    )}
    <p class:list={[
      "max-w-3xl text-sm leading-7 text-[var(--text-secondary)] sm:text-base",
      embedded ? "mt-3" : "mt-4",
    ]}>
      Pick a scenario, then try both forms. The left form is a conventional baseline. The right form adjusts its help to the same facts using fixed, authored rules. No AI, inference, or semantic retrieval is used.
    </p>
    <ol data-lab-try-this class="mt-4 mb-0 grid max-w-3xl list-none gap-2 p-0 text-xs leading-5 text-[var(--text-secondary)] sm:grid-cols-3">
      <li class="m-0 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2"><span class="font-mono text-[10px] text-[var(--accent)]">1</span> Press <strong class="font-medium text-[var(--text-primary)]">Continue</strong> on both forms without choosing anything.</li>
      <li class="m-0 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2"><span class="font-mono text-[10px] text-[var(--accent)]">2</span> Load <strong class="font-medium text-[var(--text-primary)]">Only one valid option</strong> and accept the offer.</li>
      <li class="m-0 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2"><span class="font-mono text-[10px] text-[var(--accent)]">3</span> Load <strong class="font-medium text-[var(--text-primary)]">Experienced user on 4.1</strong> and watch the help shrink.</li>
    </ol>
  </header>

  <div class="py-8">
    <div data-scenario-controller class="rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] p-4 sm:p-5">
      <div class="flex flex-col gap-3 border-b border-[var(--border-subtle)] pb-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <LabSectionHeading number="01" title="Scenario controller" {embedded} />
          <p class="mt-3 max-w-2xl text-xs leading-5 text-[var(--text-secondary)]">
            These controls set the facts both forms receive. They are not part of either form, and changing one resets both forms.
          </p>
        </div>
        <span class="w-fit rounded border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--text-muted)]">
          Test conditions
        </span>
      </div>

      <div data-scenario-presets class="mt-5">
        <p class="m-0 text-xs text-[var(--text-secondary)]">Start with an example scenario</p>
        <div class="mt-2 grid gap-1.5 sm:grid-cols-3" role="group" aria-label="Example scenarios">
          {presets.map((preset) => (
            <button
              type="button"
              data-preset={preset.id}
              aria-pressed={String(preset.pressed)}
              class:list={[
                "flex h-auto flex-col items-start rounded-sm border px-3 py-2 text-left text-xs transition",
                preset.pressed
                  ? "border-[var(--accent-border)] bg-[var(--accent-subtle)] font-medium text-[var(--accent)]"
                  : "border-[var(--border-subtle)] bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]",
              ]}
            >
              <span>{preset.label}</span>
              <span class="mt-0.5 font-mono text-[10px] font-normal opacity-75">{preset.hint}</span>
            </button>
          ))}
        </div>
        <p class="mt-4 mb-0 text-xs text-[var(--text-secondary)]">Or set each condition yourself</p>
      </div>

      <div data-scenario-grid class="mt-5 grid gap-px overflow-hidden rounded-md border border-[var(--border-subtle)] bg-[var(--border-subtle)] md:grid-cols-3">
      <LabScenarioControl label="User familiarity" value="new">
        <span slot="value" data-scenario-familiarity>new</span>
        <div class="grid grid-cols-2 gap-1.5" role="group" aria-label="User familiarity">
          <button type="button" data-familiarity="new" aria-pressed="true" class="h-9 rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 text-xs font-medium text-[var(--accent)] transition">New</button>
          <button type="button" data-familiarity="experienced" aria-pressed="false" class="h-9 rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]">Experienced</button>
        </div>
      </LabScenarioControl>

      <LabScenarioControl label="Product version" value="v4.2">
        <span slot="value" data-scenario-version>v4.2</span>
        <div class="grid grid-cols-2 gap-1.5" role="group" aria-label="Product version">
          <button type="button" data-version="4.1" aria-pressed="false" class="h-9 rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]">4.1</button>
          <button type="button" data-version="4.2" aria-pressed="true" class="h-9 rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 text-xs font-medium text-[var(--accent)] transition">4.2</button>
        </div>
      </LabScenarioControl>

      <LabScenarioControl label="Compatible connections" value="3 matches">
        <span slot="value" data-scenario-connections>3 matches</span>
        <div class="grid grid-cols-2 gap-1.5" role="group" aria-label="Compatible Data Connections">
          <button type="button" data-connection-count="1" aria-pressed="false" class="h-9 rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]">One</button>
          <button type="button" data-connection-count="3" aria-pressed="true" class="h-9 rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 text-xs font-medium text-[var(--accent)] transition">Several</button>
        </div>
      </LabScenarioControl>
      </div>

      <p data-scenario-notice class="mt-4 mb-0 flex items-start gap-2 text-xs leading-5 text-[var(--text-secondary)]">
        <span aria-hidden="true" class="font-mono text-[var(--accent)]">→</span>
        <span data-scenario-notice-text>Change any condition and watch the adaptive form and its lab note update. The conventional form stays the same.</span>
      </p>
    </div>
  </div>

  <span class="mx-auto block h-8 w-px bg-[var(--border-subtle)]" aria-hidden="true"></span>

  <div class="border-y border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-4 py-4 sm:px-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <svg class="size-4 shrink-0 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
        <div>
          <p class="m-0 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--text-muted)]">Shared application truth</p>
          <p data-truth-summary class="mt-1 text-sm text-[var(--text-primary)]">3 compatible connections · product 4.2 · new user</p>
        </div>
      </div>
      <span class="font-mono text-[11px] text-[var(--text-secondary)]">Both forms read these same facts</span>
    </div>
  </div>

  <div class="border-t border-[var(--border-subtle)] pt-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <LabSectionHeading number="02" title="Demo workbench" {embedded} />
        <p class="mt-3 max-w-2xl text-xs leading-5 text-[var(--text-secondary)]">
          Both forms get the same facts. The adaptive form only adds help the rules can justify, and holds back when they can't.
        </p>
      </div>
      <span class="w-fit rounded border border-[var(--accent-border)] bg-[var(--bg-primary)] px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--accent)]">
        Try both forms
      </span>
    </div>

    <div class="mt-4 grid gap-5 lg:grid-cols-2">
      <article class="flex min-h-[32rem] flex-col rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5 sm:p-6">
        <LabExperienceHeader
          eyebrow="Conventional experience"
          description="Shows the same field in every scenario and only reacts after you press Continue."
          {embedded}
        />

        <div class="flex flex-1 flex-col">
          <div>
            <label for="standard-data-connection" class="text-sm font-medium text-[var(--text-primary)]">Data Connection</label>
            <p id="standard-data-connection-help" class="mt-1 text-xs text-[var(--text-muted)]">Required for this configuration</p>
            <select id="standard-data-connection" data-standard-data-connection aria-describedby="standard-data-connection-help standard-data-connection-error" aria-errormessage="standard-data-connection-error" aria-invalid="false" class="mt-3 h-11 w-full rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--accent-border)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
            <p id="standard-data-connection-error" data-standard-error class="mt-3 hidden text-xs text-red-600 dark:text-red-400" role="alert">Select a Data Connection to continue.</p>
          </div>

          <div data-lab-note class="mt-5 rounded-md border border-dashed border-[var(--border-subtle)] px-3 py-2.5">
            <p class="m-0 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Lab note · baseline behavior</p>
            <ul class="mt-1.5 mb-0 list-none space-y-1 p-0 text-xs leading-5 text-[var(--text-secondary)]">
              <li class="m-0">Same field and options in every scenario.</li>
              <li class="m-0">Doesn't explain what the options are for or mention the 4.2 rule.</li>
              <li class="m-0">Only reacts after you press Continue.</li>
            </ul>
          </div>

          <div data-standard-success class="mt-5 hidden rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 py-2.5 text-xs leading-5">
            <p class="m-0 font-medium text-[var(--text-primary)]"><span aria-hidden="true">✓ </span><span data-standard-success-label>Configured</span></p>
            <p class="mt-1 mb-0 text-[var(--text-muted)]">Step complete. In a real product, Continue would open the next step.</p>
          </div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-6 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-standard-continue class="inline-flex items-center justify-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] transition hover:bg-[var(--bg-card-hover)]">Continue <span aria-hidden="true">→</span></button>
            <span data-standard-outcome class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Awaiting selection</span>
          </div>
        </div>
      </article>

      <article class="flex min-h-[32rem] flex-col rounded-md border border-[var(--accent-border)] bg-[var(--bg-card)] p-5 sm:p-6">
        <LabExperienceHeader
          eyebrow="Adaptive experience"
          description="Adds help when the facts justify it, and stays quiet when they don't."
          adaptive
          {embedded}
        />

        <div class="flex flex-1 flex-col">
          <div data-adaptive-intervention class="mb-5 rounded-md border border-[var(--accent-border)] bg-[var(--bg-primary)] p-4">
            <div class="flex gap-3">
              <svg data-adaptive-info-icon class="mt-0.5 size-4 shrink-0 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <p data-adaptive-headline class="m-0 text-sm font-medium text-[var(--text-primary)]">Choose among compatible connections</p>
                  <span data-adaptive-authority class="rounded border border-[var(--accent-border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--accent)]">guide</span>
                </div>
                <p data-adaptive-guidance class="mt-2 mb-0 text-xs leading-5 text-[var(--text-secondary)]">3 compatible connections are available. Choose the one for the system this workflow needs to access.</p>
                <p data-adaptive-beginner class="mt-2 mb-0 hidden text-xs leading-5 text-[var(--text-secondary)]"></p>
                <ul data-adaptive-options class="mt-2 mb-0 hidden list-none space-y-1 p-0 text-xs leading-5 text-[var(--text-secondary)]"></ul>
                <p data-adaptive-version class="mt-3 mb-0 hidden items-start gap-2 text-xs leading-5 text-[var(--text-secondary)]">
                  <span class="shrink-0 rounded border border-[var(--accent-border)] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em] text-[var(--accent)]">New in 4.2</span>
                  <span data-adaptive-version-text></span>
                </p>
                <p data-adaptive-source class="mt-3 mb-0 border-t border-[var(--border-subtle)] pt-3 font-mono text-[10px] leading-5 text-[var(--text-muted)]">Sources (authored fixtures) · Choosing a Data Connection</p>
              </div>
            </div>
          </div>

          <div>
            <label for="adaptive-data-connection" class="text-sm font-medium text-[var(--text-primary)]">Data Connection</label>
            <p id="adaptive-data-connection-help" class="mt-1 text-xs text-[var(--text-muted)]">Required for this configuration</p>
            <select id="adaptive-data-connection" data-adaptive-data-connection aria-describedby="adaptive-data-connection-help adaptive-data-connection-error" aria-errormessage="adaptive-data-connection-error" aria-invalid="false" class="mt-3 h-11 w-full rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--accent-border)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
            <button type="button" data-use-sole-connection class="mt-3 hidden w-fit rounded-md border border-[var(--accent-border)] bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-[var(--accent)] transition hover:bg-[var(--accent-subtle)]"></button>
            <p id="adaptive-data-connection-error" data-adaptive-error class="mt-3 hidden text-xs text-red-600 dark:text-red-400" role="alert">Select a Data Connection to continue.</p>
          </div>

          <div data-lab-note class="mt-5 rounded-md border border-dashed border-[var(--border-subtle)] px-3 py-2.5">
            <p class="m-0 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Lab note · why it looks like this</p>
            <ul data-adaptive-lab-note-list class="mt-1.5 mb-0 list-none space-y-1 p-0 text-xs leading-5 text-[var(--text-secondary)]"></ul>
          </div>

          <div data-adaptive-success class="mt-5 hidden rounded-md border border-[var(--accent-border)] bg-[var(--bg-primary)] px-3 py-2.5 text-xs leading-5">
            <p class="m-0 font-medium text-[var(--text-primary)]"><span aria-hidden="true">✓ </span><span data-adaptive-success-label>Configured</span></p>
            <p class="mt-1 mb-0 text-[var(--text-muted)]">Step complete. In a real product, Continue would open the next step.</p>
          </div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-6 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-adaptive-continue class="inline-flex items-center justify-center gap-2 rounded-md bg-[var(--accent)] px-3 py-2 text-xs font-medium text-[var(--accent-contrast)] transition hover:bg-[var(--accent-hover)]">Continue <span aria-hidden="true">→</span></button>
            <span data-adaptive-outcome class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Awaiting selection</span>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="border-t border-[var(--border-subtle)] pt-8">
    <details data-decision-trace open>
      <summary class="cursor-pointer list-none">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <LabSectionHeading number="03" title="Inspect the deterministic decision" {embedded} />
          <span data-trace-toggle-label class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card)] hover:text-[var(--text-primary)]">Hide trace <span aria-hidden="true">⌃</span></span>
        </div>
      </summary>

      <div class="mt-4 grid gap-px overflow-hidden rounded-md border border-[var(--border-subtle)] bg-[var(--border-subtle)] sm:grid-cols-2 xl:grid-cols-4">
        <LabTraceCard label="Application state">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
          <p data-trace-state class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">4.2 · new · 3 matches</p>
        </LabTraceCard>
        <LabTraceCard label="Validation">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
          <p data-trace-validation class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Data Connection is required.</p>
        </LabTraceCard>
        <LabTraceCard label="Applicable knowledge">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 3h9l3 3v15H6z"/><path d="M14 3v4h4"/></svg>
          <p data-trace-knowledge class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Authored product guidance</p>
        </LabTraceCard>
        <LabTraceCard label="Response policy">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 3v6"/><path d="M6 15v6"/><path d="M18 3v4"/><path d="M18 13v8"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="10" r="3"/></svg>
          <p data-trace-policy class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Explain the ambiguity; do not infer or preselect a value.</p>
        </LabTraceCard>
      </div>

      <div class="mt-4 flex items-start gap-3 rounded-md border border-dashed border-[var(--border-subtle)] px-4 py-3 text-xs leading-5 text-[var(--text-secondary)]">
        <svg class="mt-0.5 size-4 shrink-0 text-[var(--text-muted)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 5a2 2 0 012-2h12v17H6a2 2 0 01-2-2z"/><path d="M4 18a2 2 0 012-2h12"/></svg>
        <p class="m-0">The knowledge fragments and rules in this lab are authored fixtures. The interface evaluates explicit conditions; it does not discover documents or generate guidance.</p>
      </div>
    </details>
  </div>
</section>


<script>
  import { trackPortfolioEvent } from '../../lib/analytics';
  import { ONE_DATA_CONNECTION, THREE_DATA_CONNECTIONS } from './fixtures.ts';
  import { KNOWLEDGE } from './knowledge.ts';
  import { resolveInterface } from './resolver.ts';
  import type { AutomationConfiguration, ProductVersion, RuntimeContext, UIAction, UIResponse, UserFamiliarity } from './types.ts';

  type ConnectionCount = 1 | 3;
  type ScenarioKey = 'familiarity' | 'version' | 'connections';

  interface Scenario {
    familiarity: UserFamiliarity;
    productVersion: ProductVersion;
    connectionCount: ConnectionCount;
  }

  interface SurfaceState {
    dataConnectionId: string;
    attempted: boolean;
    completed: boolean;
  }

  const PRESETS: Record<string, { label: string; scenario: Scenario }> = {
    'new-several': { label: 'New user, several options', scenario: { familiarity: 'new', productVersion: '4.2', connectionCount: 3 } },
    'one-option': { label: 'Only one valid option', scenario: { familiarity: 'new', productVersion: '4.2', connectionCount: 1 } },
    expert: { label: 'Experienced user on 4.1', scenario: { familiarity: 'experienced', productVersion: '4.1', connectionCount: 3 } },
  };

  let labInteractionTracked = false;

  const prefersReducedMotion = () => window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  document.querySelectorAll<HTMLElement>('[data-adaptive-enterprise-ui-lab]').forEach((lab) => {
    if (lab.dataset.bound === 'true') return;
    lab.dataset.bound = 'true';

    const $ = <T extends Element = HTMLElement>(selector: string) => lab.querySelector<T>(selector);

    const standardDataConnection = $<HTMLSelectElement>('[data-standard-data-connection]');
    const adaptiveDataConnection = $<HTMLSelectElement>('[data-adaptive-data-connection]');
    const standardError = $('[data-standard-error]');
    const adaptiveError = $('[data-adaptive-error]');
    const standardContinue = $<HTMLButtonElement>('[data-standard-continue]');
    const adaptiveContinue = $<HTMLButtonElement>('[data-adaptive-continue]');
    const standardOutcome = $('[data-standard-outcome]');
    const adaptiveOutcome = $('[data-adaptive-outcome]');
    const standardSuccess = $('[data-standard-success]');
    const adaptiveSuccess = $('[data-adaptive-success]');
    const standardSuccessLabel = $('[data-standard-success-label]');
    const adaptiveSuccessLabel = $('[data-adaptive-success-label]');
    const adaptiveIntervention = $('[data-adaptive-intervention]');
    const adaptiveHeadline = $('[data-adaptive-headline]');
    const adaptiveAuthority = $('[data-adaptive-authority]');
    const adaptiveGuidance = $('[data-adaptive-guidance]');
    const adaptiveBeginner = $('[data-adaptive-beginner]');
    const adaptiveOptions = $<HTMLUListElement>('[data-adaptive-options]');
    const adaptiveVersion = $('[data-adaptive-version]');
    const adaptiveVersionText = $('[data-adaptive-version-text]');
    const adaptiveSource = $('[data-adaptive-source]');
    const adaptiveLabNoteList = $<HTMLUListElement>('[data-adaptive-lab-note-list]');
    const useSoleConnection = $<HTMLButtonElement>('[data-use-sole-connection]');
    const truthSummary = $('[data-truth-summary]');
    const scenarioFamiliarity = $('[data-scenario-familiarity]');
    const scenarioVersion = $('[data-scenario-version]');
    const scenarioConnections = $('[data-scenario-connections]');
    const scenarioNoticeText = $('[data-scenario-notice-text]');
    const traceState = $('[data-trace-state]');
    const traceValidation = $('[data-trace-validation]');
    const traceKnowledge = $('[data-trace-knowledge]');
    const tracePolicy = $('[data-trace-policy]');
    const decisionTrace = $<HTMLDetailsElement>('[data-decision-trace]');
    const traceToggleLabel = $('[data-trace-toggle-label]');
    const labStatus = $('[data-lab-status]');

    if (!standardDataConnection || !adaptiveDataConnection) return;

    const trackFirstMeaningfulInteraction = () => {
      if (labInteractionTracked) return;
      labInteractionTracked = true;
      trackPortfolioEvent('lab_interaction', { lab: 'adaptive-enterprise-ui' });
    };

    lab.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-preset], [data-familiarity], [data-version], [data-connection-count], [data-standard-continue], [data-adaptive-continue], [data-use-sole-connection]')) {
        trackFirstMeaningfulInteraction();
      }
    });

    lab.addEventListener('change', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.matches('[data-standard-data-connection], [data-adaptive-data-connection]')) {
        trackFirstMeaningfulInteraction();
      }
    });

    const scenario: Scenario = { familiarity: 'new', productVersion: '4.2', connectionCount: 3 };
    const standard: SurfaceState = { dataConnectionId: '', attempted: false, completed: false };
    const adaptive: SurfaceState = { dataConnectionId: '', attempted: false, completed: false };
    let changedKeys: ScenarioKey[] = [];
    let flashTimer: number | undefined;
    const uiState = { expandedHelp: [], highlightedField: null, dismissedGuidance: [] };

    const currentConnections = () => scenario.connectionCount === 1 ? ONE_DATA_CONNECTION : THREE_DATA_CONNECTIONS;
    const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
    const scenarioSummary = () => `${scenario.familiarity} user · ${scenario.productVersion} · ${plural(currentConnections().length, 'match', 'matches')}`;

    const announce = (message: string) => {
      if (!labStatus) return;
      labStatus.textContent = '';
      window.requestAnimationFrame(() => {
        labStatus.textContent = message;
      });
    };

    const setPressed = (button: HTMLButtonElement, active: boolean) => {
      button.setAttribute('aria-pressed', String(active));
      button.classList.toggle('border-[var(--accent-border)]', active);
      button.classList.toggle('bg-[var(--accent-subtle)]', active);
      button.classList.toggle('font-medium', active);
      button.classList.toggle('text-[var(--accent)]', active);
      button.classList.toggle('border-[var(--border-subtle)]', !active);
      button.classList.toggle('bg-[var(--bg-primary)]', !active);
      button.classList.toggle('text-[var(--text-secondary)]', !active);
    };

    const syncScenarioButtons = () => {
      lab.querySelectorAll<HTMLButtonElement>('[data-familiarity]').forEach((button) => setPressed(button, button.dataset.familiarity === scenario.familiarity));
      lab.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((button) => setPressed(button, button.dataset.version === scenario.productVersion));
      lab.querySelectorAll<HTMLButtonElement>('[data-connection-count]').forEach((button) => setPressed(button, button.dataset.connectionCount === String(scenario.connectionCount)));
      lab.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => {
        const preset = PRESETS[button.dataset.preset ?? ''];
        const active = Boolean(preset)
          && preset.scenario.familiarity === scenario.familiarity
          && preset.scenario.productVersion === scenario.productVersion
          && preset.scenario.connectionCount === scenario.connectionCount;
        setPressed(button, active);
      });
    };

    const resetSurface = (surface: SurfaceState) => {
      surface.dataConnectionId = '';
      surface.attempted = false;
      surface.completed = false;
    };

    const rebuildOptions = () => {
      const connections = currentConnections();
      [standardDataConnection, adaptiveDataConnection].forEach((select) => {
        select.replaceChildren();
        select.add(new Option('Select a Data Connection', ''));
        connections.forEach((connection) => select.add(new Option(`${connection.name} · ${connection.system}`, connection.id)));
      });
    };

    const connectionName = (id: string) => currentConnections().find((connection) => connection.id === id)?.name ?? 'the selected connection';

    const authorityLabel = (response?: UIResponse) => {
      if (!response) return 'no action';
      switch (response.type) {
        case 'preconfiguration': return 'offer';
        case 'suggestion': return 'guide';
        case 'highlight': return 'highlight';
        case 'explanation': return 'explain';
        case 'help': return 'help';
        case 'warning': return 'warn';
      }
      return 'no action';
    };

    const interventionHeadline = (response?: UIResponse) => {
      if (!response) return 'Configuration ready';
      switch (response.type) {
        case 'preconfiguration': return 'One compatible connection found';
        case 'suggestion': return 'Choose among compatible connections';
        case 'highlight': return 'Data Connection required';
        case 'explanation': return 'Why this field is required';
        case 'help': return 'Data Connection guidance';
        case 'warning': return 'Review this configuration';
      }
      return 'Configuration guidance';
    };

    const policySummary = (response?: UIResponse) => {
      if (!response) return 'No intervention required; the selected value satisfies deterministic requirements.';
      switch (response.type) {
        case 'preconfiguration': return 'Offer the sole compatible value; require user confirmation before changing the field.';
        case 'suggestion': return 'Guide the user without choosing among multiple valid values.';
        case 'highlight': return 'Highlight the required field without changing its value.';
        case 'explanation': return 'Explain the deterministic requirement without taking action.';
        case 'help': return 'Surface contextual help while leaving application state unchanged.';
        case 'warning': return 'Warn about the current state without taking action.';
      }
      return 'Keep the current interface state unchanged.';
    };

    const outcomeText = (surface: SurfaceState) => {
      if (surface.completed) return '✓ Step complete';
      if (surface.dataConnectionId) return 'Ready to continue';
      if (surface.attempted) return 'Blocked · selection required';
      return 'Awaiting selection';
    };

    const setOutcome = (element: HTMLElement | null, surface: SurfaceState) => {
      if (!element) return;
      element.textContent = outcomeText(surface);
      element.classList.toggle('text-red-600', surface.attempted && !surface.dataConnectionId);
      element.classList.toggle('dark:text-red-400', surface.attempted && !surface.dataConnectionId);
      element.classList.toggle('text-[var(--accent)]', surface.completed);
      element.classList.toggle('text-[var(--text-muted)]', !surface.completed && !(surface.attempted && !surface.dataConnectionId));
    };

    const flashIntervention = () => {
      if (!adaptiveIntervention || prefersReducedMotion()) return;
      adaptiveIntervention.removeAttribute('data-flash');
      void adaptiveIntervention.offsetWidth;
      adaptiveIntervention.setAttribute('data-flash', 'true');
      window.clearTimeout(flashTimer);
      flashTimer = window.setTimeout(() => adaptiveIntervention.removeAttribute('data-flash'), 1200);
    };

    let pendingSetValueAction: UIAction | undefined;

    const render = () => {
      const connections = currentConnections();
      const config: AutomationConfiguration = { dataConnectionId: adaptive.dataConnectionId || null };
      const runtime: RuntimeContext = { productVersion: scenario.productVersion, userFamiliarity: scenario.familiarity, availableDataConnections: connections };
      const result = resolveInterface({ config, runtime, ui: uiState, knowledge: KNOWLEDGE });
      const primaryResponse = result.responses.reduce<UIResponse | undefined>(
        (selected, response) => !selected || response.authority > selected.authority ? response : selected,
        undefined,
      );
      const byId = (id: string) => result.responses.find((response) => response.id === id);
      const beginnerResponse = byId('data-connection-beginner-help');
      const optionsResponse = byId('data-connection-option-overview');
      const versionResponse = byId('data-connection-version-guidance');
      pendingSetValueAction = primaryResponse?.actions?.find((action) => action.type === 'set-value');

      if (scenarioFamiliarity) scenarioFamiliarity.textContent = scenario.familiarity;
      if (scenarioVersion) scenarioVersion.textContent = `v${scenario.productVersion}`;
      if (scenarioConnections) scenarioConnections.textContent = plural(connections.length, 'match', 'matches');
      if (truthSummary) truthSummary.textContent = `${plural(connections.length, 'compatible connection', 'compatible connections')} · product ${scenario.productVersion} · ${scenario.familiarity} user`;

      // Surfaces: validation, outcomes, completion.
      const standardInvalid = standard.attempted && !standard.dataConnectionId;
      const adaptiveInvalid = adaptive.attempted && !adaptive.dataConnectionId;

      standardError?.classList.toggle('hidden', !standardInvalid);
      adaptiveError?.classList.toggle('hidden', !adaptiveInvalid);
      if (adaptiveError) {
        adaptiveError.textContent = pendingSetValueAction
          ? `Select a Data Connection to continue, or use the suggested ${connections[0]?.name ?? 'connection'}.`
          : `Pick one of the ${connections.length} compatible connections${optionsResponse ? ' described above' : ''} to continue.`;
      }
      standardDataConnection.setAttribute('aria-invalid', String(standardInvalid));
      adaptiveDataConnection.setAttribute('aria-invalid', String(adaptiveInvalid));
      setOutcome(standardOutcome, standard);
      setOutcome(adaptiveOutcome, adaptive);

      standardSuccess?.classList.toggle('hidden', !standard.completed);
      adaptiveSuccess?.classList.toggle('hidden', !adaptive.completed);
      if (standardSuccessLabel) standardSuccessLabel.textContent = `Configured with ${connectionName(standard.dataConnectionId)}`;
      if (adaptiveSuccessLabel) adaptiveSuccessLabel.textContent = `Configured with ${connectionName(adaptive.dataConnectionId)}`;

      // Adaptive intervention panel.
      if (adaptiveHeadline) adaptiveHeadline.textContent = interventionHeadline(primaryResponse);
      if (adaptiveAuthority) adaptiveAuthority.textContent = authorityLabel(primaryResponse);
      if (adaptiveGuidance) {
        adaptiveGuidance.textContent = primaryResponse?.message
          ?? 'The selected Data Connection satisfies the current requirement, so the guidance steps aside.';
      }

      if (adaptiveBeginner) {
        adaptiveBeginner.textContent = beginnerResponse?.message ?? '';
        adaptiveBeginner.classList.toggle('hidden', !beginnerResponse);
      }

      if (adaptiveOptions) {
        adaptiveOptions.replaceChildren();
        (optionsResponse?.items ?? []).forEach((line) => {
          const [name, ...rest] = line.split(': ');
          const item = document.createElement('li');
          item.className = 'm-0';
          const strong = document.createElement('strong');
          strong.className = 'font-medium text-[var(--text-primary)]';
          strong.textContent = name;
          item.append(strong, rest.length ? ` — ${rest.join(': ')}` : '');
          adaptiveOptions.append(item);
        });
        adaptiveOptions.classList.toggle('hidden', !optionsResponse);
      }

      if (adaptiveVersion) {
        if (adaptiveVersionText) adaptiveVersionText.textContent = versionResponse?.message ?? '';
        adaptiveVersion.classList.toggle('hidden', !versionResponse);
        adaptiveVersion.classList.toggle('flex', Boolean(versionResponse));
      }

      if (adaptiveSource) {
        const shown = [primaryResponse, beginnerResponse, optionsResponse, versionResponse].filter((response): response is UIResponse => Boolean(response));
        const knowledgeLabels = shown
          .flatMap((response) => response.knowledgeIds ?? [])
          .map((knowledgeId) => result.applicableKnowledge.find((item) => item.id === knowledgeId)?.source.label)
          .filter((label): label is string => Boolean(label));
        const labels = [...new Set(knowledgeLabels)];
        if (primaryResponse?.type === 'preconfiguration') labels.unshift('Application state');
        adaptiveSource.textContent = labels.length > 0
          ? `Sources (authored fixtures) · ${labels.join(' · ')}`
          : 'Source · Application state';
      }

      if (useSoleConnection) {
        const show = Boolean(pendingSetValueAction?.value && !adaptive.dataConnectionId);
        useSoleConnection.classList.toggle('hidden', !show);
        if (pendingSetValueAction) useSoleConnection.textContent = `✓ ${pendingSetValueAction.label}`;
      }

      // Plain-language lab note explaining the adaptive decision.
      if (adaptiveLabNoteList) {
        const notes: { key: ScenarioKey | 'selection'; text: string }[] = [];
        if (adaptive.dataConnectionId) {
          notes.push({ key: 'selection', text: 'A valid connection is selected, so the guidance steps aside.' });
        } else {
          notes.push(scenario.familiarity === 'new'
            ? { key: 'familiarity', text: optionsResponse ? 'New user: adds a plain-language explanation and what each option is for.' : 'New user: adds a plain-language explanation.' }
            : { key: 'familiarity', text: 'Experienced user: skips the beginner explanation and option descriptions.' });
          notes.push(scenario.productVersion === '4.2'
            ? { key: 'version', text: 'Version 4.2: shows the new explicit-selection rule.' }
            : { key: 'version', text: 'Version 4.1: no version notice, because the 4.2 rule does not apply.' });
          notes.push(connections.length === 1
            ? { key: 'connections', text: 'One compatible option: offers it as a button, but only you can apply it.' }
            : { key: 'connections', text: `${connections.length} valid options: guides you, but will not choose one for you.` });
        }
        adaptiveLabNoteList.replaceChildren();
        notes.forEach((note) => {
          const item = document.createElement('li');
          item.className = 'm-0';
          const changed = note.key !== 'selection' && changedKeys.includes(note.key);
          item.dataset.changed = String(changed);
          item.textContent = changed ? `Changed · ${note.text}` : note.text;
          adaptiveLabNoteList.append(item);
        });
      }

      // Decision trace.
      if (traceState) traceState.textContent = `${scenario.productVersion} · ${scenario.familiarity} · ${plural(connections.length, 'match', 'matches')}`;
      if (traceValidation) {
        traceValidation.textContent = result.validation.length > 0
          ? 'Data Connection is required.'
          : 'No blocking validation issues.';
      }
      if (traceKnowledge) {
        const labels = [...new Set(result.applicableKnowledge.map((item) => item.source.label))];
        traceKnowledge.textContent = labels.length > 0 ? labels.join(' · ') : 'No authored knowledge applies.';
      }
      if (tracePolicy) tracePolicy.textContent = policySummary(primaryResponse);
    };

    const applyScenario = (next: Scenario, notice: string) => {
      const previous = { ...scenario };
      Object.assign(scenario, next);
      changedKeys = [];
      if (previous.familiarity !== scenario.familiarity) changedKeys.push('familiarity');
      if (previous.productVersion !== scenario.productVersion) changedKeys.push('version');
      if (previous.connectionCount !== scenario.connectionCount) changedKeys.push('connections');

      resetSurface(standard);
      resetSurface(adaptive);
      syncScenarioButtons();
      rebuildOptions();
      render();
      if (changedKeys.length > 0) flashIntervention();

      const fullNotice = changedKeys.length > 0
        ? `${notice} Both forms were reset.`
        : `${notice} Nothing changed in the scenario; both forms were reset.`;
      if (scenarioNoticeText) scenarioNoticeText.textContent = fullNotice;
      announce(`${fullNotice} Scenario: ${scenarioSummary()}.`);
    };

    standardDataConnection.addEventListener('change', () => {
      standard.dataConnectionId = standardDataConnection.value;
      standard.attempted = false;
      standard.completed = false;
      render();
      announce(standard.dataConnectionId
        ? 'Conventional form: Data Connection selected. Ready to continue.'
        : 'Conventional form: Data Connection cleared.');
    });

    adaptiveDataConnection.addEventListener('change', () => {
      adaptive.dataConnectionId = adaptiveDataConnection.value;
      adaptive.attempted = false;
      adaptive.completed = false;
      render();
      announce(adaptive.dataConnectionId
        ? 'Adaptive form: Data Connection selected. Guidance removed. Ready to continue.'
        : 'Adaptive form: Data Connection cleared.');
    });

    standardContinue?.addEventListener('click', () => {
      standard.attempted = true;
      standard.completed = Boolean(standard.dataConnectionId);
      render();
      announce(standard.completed
        ? `Conventional form: step complete with ${connectionName(standard.dataConnectionId)}.`
        : 'Conventional form: blocked. Select a Data Connection to continue.');
    });

    adaptiveContinue?.addEventListener('click', () => {
      adaptive.attempted = true;
      adaptive.completed = Boolean(adaptive.dataConnectionId);
      render();
      announce(adaptive.completed
        ? `Adaptive form: step complete with ${connectionName(adaptive.dataConnectionId)}.`
        : 'Adaptive form: blocked. Select a Data Connection to continue.');
    });

    useSoleConnection?.addEventListener('click', () => {
      if (!pendingSetValueAction?.value) return;
      adaptive.dataConnectionId = pendingSetValueAction.value;
      adaptiveDataConnection.value = pendingSetValueAction.value;
      adaptive.attempted = false;
      adaptive.completed = false;
      const selectedLabel = adaptiveDataConnection.selectedOptions[0]?.textContent?.trim();
      render();
      adaptiveContinue?.focus();
      announce(`Adaptive form: ${selectedLabel || 'compatible Data Connection'} selected. Ready to continue.`);
    });

    decisionTrace?.addEventListener('toggle', () => {
      if (!traceToggleLabel) return;
      traceToggleLabel.innerHTML = decisionTrace.open ? 'Hide trace <span aria-hidden="true">⌃</span>' : 'Show trace <span aria-hidden="true">⌄</span>';
    });

    lab.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.addEventListener('click', () => {
      const preset = PRESETS[button.dataset.preset ?? ''];
      if (!preset) return;
      applyScenario({ ...preset.scenario }, `Loaded “${preset.label}” (${preset.scenario.familiarity} user · ${preset.scenario.productVersion} · ${plural(preset.scenario.connectionCount, 'match', 'matches')}).`);
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-familiarity]').forEach((button) => button.addEventListener('click', () => {
      const familiarity = button.dataset.familiarity as UserFamiliarity;
      applyScenario({ ...scenario, familiarity }, `Changed user familiarity to ${familiarity === 'new' ? 'New' : 'Experienced'}.`);
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((button) => button.addEventListener('click', () => {
      const productVersion = button.dataset.version as ProductVersion;
      applyScenario({ ...scenario, productVersion }, `Changed product version to ${productVersion}.`);
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-connection-count]').forEach((button) => button.addEventListener('click', () => {
      const connectionCount: ConnectionCount = button.dataset.connectionCount === '1' ? 1 : 3;
      applyScenario({ ...scenario, connectionCount }, `Changed compatible connections to ${connectionCount === 1 ? 'One' : 'Several'}.`);
    }));

    syncScenarioButtons();
    rebuildOptions();
    render();
  });
</script>
