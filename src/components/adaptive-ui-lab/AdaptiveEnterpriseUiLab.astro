---
import { THREE_DATA_CONNECTIONS } from './fixtures.ts';
---

<section
  class="not-prose my-10 overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)]"
  data-adaptive-enterprise-ui-lab
>
  <header class="border-b border-[var(--border-subtle)] px-5 py-7 sm:px-7 sm:py-8">
    <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--text-muted)]">
      <span>Interactive reference implementation</span>
      <span aria-hidden="true" class="h-px w-8 bg-[var(--border-strong)]"></span>
      <span>Phase 1 · deterministic</span>
    </div>
    <h3 class="mt-4 mb-0 text-2xl font-semibold leading-tight text-[var(--text-primary)] sm:text-3xl">
      Adaptive Enterprise UI Lab
    </h3>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--text-secondary)] sm:text-base">
      Change the scenario, then compare how two interface policies respond to the same Data Connection truth. No AI, inference, or semantic retrieval is used.
    </p>
  </header>

  <div class="px-5 py-7 sm:px-7 sm:py-8">
    <div class="flex items-center gap-3">
      <span class="font-mono text-[10px] text-[var(--accent)]">01</span>
      <h4 class="m-0 font-mono text-xs font-medium uppercase tracking-[0.14em] text-[var(--text-secondary)]">Set the shared scenario</h4>
    </div>

    <div class="mt-4 grid overflow-hidden rounded-md border border-[var(--border-subtle)] bg-[var(--border-subtle)] md:grid-cols-3 md:gap-px">
      <fieldset class="m-0 border-0 bg-[var(--bg-card)] p-4 sm:p-5">
        <legend class="sr-only">User familiarity</legend>
        <div class="mb-4 flex items-center justify-between gap-3">
          <span class="text-xs text-[var(--text-secondary)]">User familiarity</span>
          <span data-scenario-familiarity class="font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">new</span>
        </div>
        <div class="grid grid-cols-2 gap-1.5">
          <button type="button" data-familiarity="new" aria-pressed="true" class="rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 py-2.5 text-xs font-medium text-[var(--accent)] transition">New</button>
          <button type="button" data-familiarity="experienced" aria-pressed="false" class="rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 py-2.5 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]">Experienced</button>
        </div>
      </fieldset>

      <fieldset class="m-0 border-0 bg-[var(--bg-card)] p-4 sm:p-5">
        <legend class="sr-only">Product version</legend>
        <div class="mb-4 flex items-center justify-between gap-3">
          <span class="text-xs text-[var(--text-secondary)]">Product version</span>
          <span data-scenario-version class="font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">v4.2</span>
        </div>
        <div class="grid grid-cols-2 gap-1.5">
          <button type="button" data-version="4.1" aria-pressed="false" class="rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 py-2.5 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]">4.1</button>
          <button type="button" data-version="4.2" aria-pressed="true" class="rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 py-2.5 text-xs font-medium text-[var(--accent)] transition">4.2</button>
        </div>
      </fieldset>

      <fieldset class="m-0 border-0 bg-[var(--bg-card)] p-4 sm:p-5">
        <legend class="sr-only">Compatible connections</legend>
        <div class="mb-4 flex items-center justify-between gap-3">
          <span class="text-xs text-[var(--text-secondary)]">Compatible connections</span>
          <span data-scenario-connections class="font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">3 matches</span>
        </div>
        <div class="grid grid-cols-2 gap-1.5">
          <button type="button" data-connection-count="1" aria-pressed="false" class="rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 py-2.5 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]">One</button>
          <button type="button" data-connection-count="3" aria-pressed="true" class="rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 py-2.5 text-xs font-medium text-[var(--accent)] transition">Several</button>
        </div>
      </fieldset>
    </div>

    <div class="mt-4 flex justify-end">
      <button type="button" data-reset-context class="font-mono text-[10px] uppercase tracking-wider text-[var(--text-muted)] transition hover:text-[var(--text-primary)]">Reset scenario</button>
    </div>
  </div>

  <div class="border-y border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-5 py-4 sm:px-7">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-1 inline-block size-2 rounded-full bg-[var(--accent)]"></span>
        <div>
          <p class="m-0 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--text-muted)]">Shared application truth</p>
          <p data-truth-summary class="mt-1 text-sm text-[var(--text-primary)]">3 compatible connections · product 4.2 · new user</p>
        </div>
      </div>
      <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--accent)]">Same state → different policy</span>
    </div>
  </div>

  <div class="px-5 py-7 sm:px-7 sm:py-8">
    <div class="flex items-center gap-3">
      <span class="font-mono text-[10px] text-[var(--accent)]">02</span>
      <h4 class="m-0 font-mono text-xs font-medium uppercase tracking-[0.14em] text-[var(--text-secondary)]">Compare the interface policy</h4>
    </div>

    <div class="mt-4 grid gap-5 lg:grid-cols-2">
      <article class="flex min-h-[32rem] flex-col rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5 sm:p-6">
        <div class="mb-8 flex items-start justify-between gap-4 border-b border-[var(--border-subtle)] pb-5">
          <div>
            <p class="m-0 font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--text-muted)]">Conventional experience</p>
            <h5 class="mt-2 mb-0 text-lg font-semibold text-[var(--text-primary)]">Configuration</h5>
            <p class="mt-2 max-w-md text-xs leading-5 text-[var(--text-secondary)]">The form exposes the available values and leaves interpretation to the user.</p>
          </div>
          <span class="font-mono text-[9px] uppercase tracking-wider text-[var(--text-muted)]">baseline</span>
        </div>

        <div class="flex flex-1 flex-col">
          <div>
            <label for="standard-data-connection" class="text-sm font-medium text-[var(--text-primary)]">Data Connection</label>
            <p class="mt-1 text-xs text-[var(--text-muted)]">Required for this configuration</p>
            <select id="standard-data-connection" data-standard-data-connection class="mt-3 h-11 w-full rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--accent-border)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
            <p data-standard-error class="mt-3 hidden text-xs font-medium text-[var(--accent)]" role="alert">Select a Data Connection to continue.</p>
          </div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-6 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-standard-continue class="inline-flex items-center justify-center gap-2 rounded-md border border-[var(--border-strong)] bg-[var(--bg-card)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] transition hover:bg-[var(--bg-secondary)]">Continue <span aria-hidden="true">→</span></button>
            <span data-standard-outcome class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Awaiting selection</span>
          </div>
        </div>
      </article>

      <article class="flex min-h-[32rem] flex-col rounded-md border border-[var(--accent-border)] bg-[var(--bg-card)] p-5 sm:p-6">
        <div class="mb-8 flex items-start justify-between gap-4 border-b border-[var(--border-subtle)] pb-5">
          <div>
            <p class="m-0 font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--accent)]">Adaptive experience</p>
            <h5 class="mt-2 mb-0 text-lg font-semibold text-[var(--text-primary)]">Configuration</h5>
            <p class="mt-2 max-w-md text-xs leading-5 text-[var(--text-secondary)]">The form adds only the intervention supported by the current evidence.</p>
          </div>
          <span class="font-mono text-[9px] uppercase tracking-wider text-[var(--accent)]">adaptive</span>
        </div>

        <div class="flex flex-1 flex-col">
          <div class="mb-5 rounded-md border border-[var(--accent-border)] bg-[var(--accent-subtle)] p-4" aria-live="polite">
            <div class="flex gap-3">
              <span aria-hidden="true" class="mt-1 inline-block size-2 shrink-0 rounded-full bg-[var(--accent)]"></span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <p data-adaptive-headline class="m-0 text-sm font-medium text-[var(--text-primary)]">Context-aware guidance</p>
                  <span data-adaptive-authority class="rounded border border-[var(--accent-border)] px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--accent)]">authority 5</span>
                </div>
                <div data-adaptive-guidance-list class="mt-3 space-y-2"></div>
                <p data-version-source class="mt-3 border-t border-[var(--accent-border)] pt-3 font-mono text-[10px] leading-5 text-[var(--text-muted)]">Demo knowledge · applies to product 4.2</p>
              </div>
            </div>
          </div>

          <div data-adaptive-data-connection-shell class="rounded-md transition">
            <div class="flex items-center justify-between gap-3">
              <label for="adaptive-data-connection" class="text-sm font-medium text-[var(--text-primary)]">Data Connection</label>
              <span data-adaptive-required class="hidden font-mono text-[9px] uppercase tracking-wider text-[var(--accent)]">Required</span>
            </div>
            <p class="mt-1 text-xs text-[var(--text-muted)]">Required for this configuration</p>
            <select id="adaptive-data-connection" data-adaptive-data-connection class="mt-3 h-11 w-full rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--accent-border)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
            <p data-adaptive-error class="mt-3 hidden text-xs font-medium text-[var(--accent)]" role="alert">Select a Data Connection to continue.</p>
          </div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-6 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-adaptive-continue class="inline-flex items-center justify-center gap-2 rounded-md bg-[var(--accent)] px-3 py-2 text-xs font-medium text-white transition hover:bg-[var(--accent-hover)]">Continue <span aria-hidden="true">→</span></button>
            <span data-adaptive-outcome class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Awaiting selection</span>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="border-t border-[var(--border-subtle)] px-5 py-7 sm:px-7 sm:py-8">
    <details data-decision-trace open>
      <summary class="cursor-pointer list-none">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-[var(--accent)]">03</span>
            <div>
              <h4 class="m-0 font-mono text-xs font-medium uppercase tracking-[0.14em] text-[var(--text-secondary)]">Inspect the deterministic decision</h4>
              <p class="mt-1 text-xs text-[var(--text-muted)]">The adaptive side exposes exactly what the resolver evaluated.</p>
            </div>
          </div>
          <span data-trace-toggle-label class="font-mono text-[10px] uppercase tracking-wider text-[var(--text-muted)]">Hide trace</span>
        </div>
      </summary>

      <div class="mt-4 grid overflow-hidden rounded-md border border-[var(--border-subtle)] bg-[var(--border-subtle)] sm:grid-cols-2 sm:gap-px xl:grid-cols-4">
        <div class="min-h-36 bg-[var(--bg-card)] p-4 sm:p-5">
          <span aria-hidden="true" class="inline-block size-2 rounded-full bg-[var(--accent)]"></span>
          <p class="mt-4 mb-0 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--text-muted)]">Application state</p>
          <p data-trace-state class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">4.2 · new · 3 matches</p>
        </div>
        <div class="min-h-36 bg-[var(--bg-card)] p-4 sm:p-5">
          <span aria-hidden="true" class="inline-block size-2 rounded-full bg-[var(--accent)]"></span>
          <p class="mt-4 mb-0 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--text-muted)]">Validation</p>
          <p data-trace-validation class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Data Connection is required.</p>
        </div>
        <div class="min-h-36 bg-[var(--bg-card)] p-4 sm:p-5">
          <span aria-hidden="true" class="inline-block size-2 rounded-full bg-[var(--accent)]"></span>
          <p class="mt-4 mb-0 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--text-muted)]">Applicable knowledge</p>
          <p data-trace-knowledge class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Authored product guidance</p>
        </div>
        <div class="min-h-36 bg-[var(--bg-card)] p-4 sm:p-5">
          <span aria-hidden="true" class="inline-block size-2 rounded-full bg-[var(--accent)]"></span>
          <p class="mt-4 mb-0 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--text-muted)]">Response policy</p>
          <p data-trace-policy class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Authority 5 · suggestion</p>
        </div>
      </div>

      <div class="mt-4 flex items-start gap-3 rounded-md border border-dashed border-[var(--border-subtle)] px-4 py-3">
        <span aria-hidden="true" class="mt-1 inline-block size-2 shrink-0 rounded-full bg-[var(--text-muted)]"></span>
        <p class="m-0 text-xs leading-5 text-[var(--text-secondary)]">The knowledge fragments and rules in this lab are authored fixtures. The interface evaluates explicit conditions; it does not discover documents or generate guidance.</p>
      </div>
    </details>
  </div>
</section>

<script>
  import { ONE_DATA_CONNECTION, THREE_DATA_CONNECTIONS } from './fixtures.ts';
  import { KNOWLEDGE } from './knowledge.ts';
  import { resolveInterface } from './resolver.ts';
  import type { AutomationConfiguration, ProductVersion, RuntimeContext, UIAction, UIResponse, UserFamiliarity } from './types.ts';

  document.querySelectorAll<HTMLElement>('[data-adaptive-enterprise-ui-lab]').forEach((lab) => {
    if (lab.dataset.bound === 'true') return;
    lab.dataset.bound = 'true';

    const standardDataConnection = lab.querySelector<HTMLSelectElement>('[data-standard-data-connection]');
    const adaptiveDataConnection = lab.querySelector<HTMLSelectElement>('[data-adaptive-data-connection]');
    const standardError = lab.querySelector<HTMLElement>('[data-standard-error]');
    const adaptiveError = lab.querySelector<HTMLElement>('[data-adaptive-error]');
    const standardContinue = lab.querySelector<HTMLButtonElement>('[data-standard-continue]');
    const adaptiveContinue = lab.querySelector<HTMLButtonElement>('[data-adaptive-continue]');
    const standardOutcome = lab.querySelector<HTMLElement>('[data-standard-outcome]');
    const adaptiveOutcome = lab.querySelector<HTMLElement>('[data-adaptive-outcome]');
    const adaptiveRequired = lab.querySelector<HTMLElement>('[data-adaptive-required]');
    const adaptiveGuidanceList = lab.querySelector<HTMLElement>('[data-adaptive-guidance-list]');
    const adaptiveShell = lab.querySelector<HTMLElement>('[data-adaptive-data-connection-shell]');
    const adaptiveHeadline = lab.querySelector<HTMLElement>('[data-adaptive-headline]');
    const adaptiveAuthority = lab.querySelector<HTMLElement>('[data-adaptive-authority]');
    const versionSource = lab.querySelector<HTMLElement>('[data-version-source]');
    const truthSummary = lab.querySelector<HTMLElement>('[data-truth-summary]');
    const scenarioFamiliarity = lab.querySelector<HTMLElement>('[data-scenario-familiarity]');
    const scenarioVersion = lab.querySelector<HTMLElement>('[data-scenario-version]');
    const scenarioConnections = lab.querySelector<HTMLElement>('[data-scenario-connections]');
    const traceState = lab.querySelector<HTMLElement>('[data-trace-state]');
    const traceValidation = lab.querySelector<HTMLElement>('[data-trace-validation]');
    const traceKnowledge = lab.querySelector<HTMLElement>('[data-trace-knowledge]');
    const tracePolicy = lab.querySelector<HTMLElement>('[data-trace-policy]');
    const decisionTrace = lab.querySelector<HTMLDetailsElement>('[data-decision-trace]');
    const traceToggleLabel = lab.querySelector<HTMLElement>('[data-trace-toggle-label]');
    const resetContext = lab.querySelector<HTMLButtonElement>('[data-reset-context]');

    if (!standardDataConnection || !adaptiveDataConnection || !adaptiveGuidanceList) return;

    let familiarity: UserFamiliarity = 'new';
    let productVersion: ProductVersion = '4.2';
    let connectionCount: 1 | 3 = 3;
    let standardDataConnectionId: string | null = null;
    let adaptiveDataConnectionId: string | null = null;
    let standardAttempted = false;
    let adaptiveAttempted = false;
    const uiState = { expandedHelp: [], highlightedField: null, dismissedGuidance: [] };

    const setPressedState = (selector: string, activeValue: string, attribute: string) => {
      lab.querySelectorAll<HTMLButtonElement>(selector).forEach((button) => {
        const active = button.dataset[attribute] === activeValue;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.classList.toggle('border-[var(--accent-border)]', active);
        button.classList.toggle('bg-[var(--accent-subtle)]', active);
        button.classList.toggle('font-medium', active);
        button.classList.toggle('text-[var(--accent)]', active);
        button.classList.toggle('border-[var(--border-subtle)]', !active);
        button.classList.toggle('bg-[var(--bg-primary)]', !active);
        button.classList.toggle('text-[var(--text-secondary)]', !active);
      });
    };

    const currentConnections = () => connectionCount === 1 ? ONE_DATA_CONNECTION : THREE_DATA_CONNECTIONS;

    const resetSurfaceState = () => {
      standardDataConnectionId = null;
      adaptiveDataConnectionId = null;
      standardAttempted = false;
      adaptiveAttempted = false;
    };

    const rebuildDataConnectionOptions = () => {
      const connections = currentConnections();
      [standardDataConnection, adaptiveDataConnection].forEach((select) => {
        select.replaceChildren();
        select.add(new Option('Select a Data Connection', ''));
        connections.forEach((connection) => select.add(new Option(`${connection.name} · ${connection.system}`, connection.id)));
      });
      standardDataConnection.value = standardDataConnectionId ?? '';
      adaptiveDataConnection.value = adaptiveDataConnectionId ?? '';
    };

    const createActionButton = (action: UIAction) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = action.label;
      button.className = 'mt-3 rounded-md border border-[var(--accent-border)] bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-[var(--accent)] transition hover:bg-[var(--accent-subtle)]';
      button.addEventListener('click', () => {
        if (action.type === 'focus-field' && action.field === 'dataConnection') adaptiveDataConnection.focus();
        if (action.type === 'set-value' && action.field === 'dataConnection' && action.value) {
          adaptiveDataConnectionId = action.value;
          adaptiveDataConnection.value = action.value;
          adaptiveAttempted = false;
          render();
          adaptiveDataConnection.focus();
        }
      });
      return button;
    };

    const createResponseItem = (response: UIResponse, compact = false) => {
      const item = document.createElement('div');
      item.className = compact ? 'py-1.5' : 'rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-3';
      const message = document.createElement('p');
      message.className = compact ? 'm-0 text-xs leading-5 text-[var(--text-secondary)]' : 'm-0 text-xs leading-5 text-[var(--text-secondary)]';
      message.textContent = response.message;
      item.append(message);
      response.actions?.forEach((action) => item.append(createActionButton(action)));
      return item;
    };

    const renderStandard = () => {
      standardError?.classList.toggle('hidden', !(standardAttempted && !standardDataConnectionId));
      if (standardOutcome) standardOutcome.textContent = standardDataConnectionId ? 'Ready to continue' : 'Awaiting selection';
    };

    const renderAdaptive = (responses: UIResponse[]) => {
      adaptiveGuidanceList.replaceChildren();
      const visibleResponses = responses.filter((response) => response.type !== 'highlight');
      const primaryResponses = visibleResponses.filter((response) => response.type !== 'help');
      const helpResponses = visibleResponses.filter((response) => response.type === 'help');

      if (visibleResponses.length === 0) {
        const quiet = document.createElement('p');
        quiet.className = 'm-0 text-xs leading-5 text-[var(--text-secondary)]';
        quiet.textContent = 'Data Connection is set. No contextual intervention is needed.';
        adaptiveGuidanceList.append(quiet);
      } else {
        primaryResponses.forEach((response) => adaptiveGuidanceList.append(createResponseItem(response)));
        if (helpResponses.length > 0) {
          const details = document.createElement('details');
          details.className = 'rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 py-2';
          const summary = document.createElement('summary');
          summary.className = 'cursor-pointer text-xs font-medium text-[var(--text-secondary)]';
          summary.textContent = `Why this guidance? · ${helpResponses.length} ${helpResponses.length === 1 ? 'detail' : 'details'}`;
          details.append(summary);
          const detailBody = document.createElement('div');
          detailBody.className = 'mt-2 divide-y divide-[var(--border-subtle)]';
          helpResponses.forEach((response) => detailBody.append(createResponseItem(response, true)));
          details.append(detailBody);
          adaptiveGuidanceList.append(details);
        }
      }

      const shouldHighlight = responses.some((response) => response.id === 'data-connection-highlight');
      adaptiveShell?.classList.toggle('ring-1', shouldHighlight);
      adaptiveShell?.classList.toggle('ring-[var(--accent-border)]', shouldHighlight);
      adaptiveShell?.classList.toggle('bg-[var(--accent-subtle)]', shouldHighlight);
      adaptiveShell?.classList.toggle('p-3', shouldHighlight);
      adaptiveRequired?.classList.toggle('hidden', !shouldHighlight);
      adaptiveError?.classList.toggle('hidden', !(adaptiveAttempted && !adaptiveDataConnectionId));
      if (adaptiveOutcome) adaptiveOutcome.textContent = adaptiveDataConnectionId ? 'Ready to continue' : 'Awaiting selection';

      const highest = responses.reduce<UIResponse | null>((current, response) => !current || response.authority > current.authority ? response : current, null);
      if (adaptiveHeadline) adaptiveHeadline.textContent = highest ? (highest.type === 'preconfiguration' ? 'A safe value can be offered' : 'Context-aware guidance') : 'No intervention needed';
      if (adaptiveAuthority) adaptiveAuthority.textContent = highest ? `authority ${highest.authority}` : 'authority 0';
      if (versionSource) versionSource.classList.toggle('hidden', productVersion !== '4.2');
    };

    const render = () => {
      const availableDataConnections = currentConnections();
      const config: AutomationConfiguration = { dataConnectionId: adaptiveDataConnectionId };
      const runtime: RuntimeContext = { productVersion, userFamiliarity: familiarity, availableDataConnections };
      const result = resolveInterface({ config, runtime, ui: uiState, knowledge: KNOWLEDGE });

      renderStandard();
      renderAdaptive(result.responses);

      if (scenarioFamiliarity) scenarioFamiliarity.textContent = familiarity;
      if (scenarioVersion) scenarioVersion.textContent = `v${productVersion}`;
      if (scenarioConnections) scenarioConnections.textContent = `${availableDataConnections.length} ${availableDataConnections.length === 1 ? 'match' : 'matches'}`;
      if (truthSummary) truthSummary.textContent = `${availableDataConnections.length} compatible ${availableDataConnections.length === 1 ? 'connection' : 'connections'} · product ${productVersion} · ${familiarity} user`;
      if (traceState) traceState.textContent = `${productVersion} · ${familiarity} · ${availableDataConnections.length} ${availableDataConnections.length === 1 ? 'match' : 'matches'}`;
      if (traceValidation) traceValidation.textContent = result.validation.length > 0 ? 'Data Connection is required.' : 'Configuration is valid.';
      if (traceKnowledge) {
        const labels = [...new Set(result.applicableKnowledge.map((item) => item.source.label))];
        traceKnowledge.textContent = labels.length > 0 ? labels.join(' · ') : 'No authored knowledge applies.';
      }
      if (tracePolicy) {
        const highest = result.responses.reduce<UIResponse | null>((current, response) => !current || response.authority > current.authority ? response : current, null);
        tracePolicy.textContent = highest ? `Authority ${highest.authority} · ${highest.type}` : 'Authority 0 · no intervention';
      }
    };

    standardDataConnection.addEventListener('change', () => {
      standardDataConnectionId = standardDataConnection.value || null;
      standardAttempted = false;
      renderStandard();
    });

    adaptiveDataConnection.addEventListener('change', () => {
      adaptiveDataConnectionId = adaptiveDataConnection.value || null;
      adaptiveAttempted = false;
      render();
    });

    standardContinue?.addEventListener('click', () => {
      standardAttempted = true;
      renderStandard();
    });

    adaptiveContinue?.addEventListener('click', () => {
      adaptiveAttempted = true;
      render();
    });

    decisionTrace?.addEventListener('toggle', () => {
      if (traceToggleLabel) traceToggleLabel.textContent = decisionTrace.open ? 'Hide trace' : 'Show trace';
    });

    lab.querySelectorAll<HTMLButtonElement>('[data-familiarity]').forEach((button) => button.addEventListener('click', () => {
      familiarity = button.dataset.familiarity as UserFamiliarity;
      setPressedState('[data-familiarity]', familiarity, 'familiarity');
      resetSurfaceState();
      rebuildDataConnectionOptions();
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((button) => button.addEventListener('click', () => {
      productVersion = button.dataset.version as ProductVersion;
      setPressedState('[data-version]', productVersion, 'version');
      resetSurfaceState();
      rebuildDataConnectionOptions();
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-connection-count]').forEach((button) => button.addEventListener('click', () => {
      connectionCount = button.dataset.connectionCount === '1' ? 1 : 3;
      setPressedState('[data-connection-count]', String(connectionCount), 'connectionCount');
      resetSurfaceState();
      rebuildDataConnectionOptions();
      render();
    }));

    resetContext?.addEventListener('click', () => {
      familiarity = 'new';
      productVersion = '4.2';
      connectionCount = 3;
      resetSurfaceState();
      setPressedState('[data-familiarity]', familiarity, 'familiarity');
      setPressedState('[data-version]', productVersion, 'version');
      setPressedState('[data-connection-count]', String(connectionCount), 'connectionCount');
      rebuildDataConnectionOptions();
      render();
    });

    rebuildDataConnectionOptions();
    render();
  });
</script>