---
import { DEFAULT_CONFIG, DEFAULT_RUNTIME, THREE_DATA_CONNECTIONS } from './fixtures.ts';
import { KNOWLEDGE } from './knowledge.ts';
import { resolveInterface } from './resolver.ts';

const initialResult = resolveInterface({
  config: DEFAULT_CONFIG,
  runtime: DEFAULT_RUNTIME,
  ui: { expandedHelp: [], highlightedField: null, dismissedGuidance: [] },
  knowledge: KNOWLEDGE,
});
const initialResponseIds = initialResult.responses.map((response) => response.id);
---

<section class="not-prose my-10 overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] shadow-sm" data-adaptive-enterprise-ui-lab>
  <header class="border-b border-[var(--border-subtle)] px-5 py-5 sm:px-6">
    <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--text-tertiary)]">
      <span>Interactive reference implementation</span>
      <span aria-hidden="true" class="h-px w-7 bg-[var(--border-strong)]"></span>
      <span>Phase 1 · deterministic</span>
    </div>
    <h3 class="mt-3 mb-0 text-xl font-semibold text-[var(--text-primary)]">Adaptive Enterprise UI Lab</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[var(--text-secondary)]">
      Change the shared scenario, then compare how a conventional interface and an adaptive interface respond to the same Data Connection truth.
    </p>
  </header>

  <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-5 py-5 sm:px-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="m-0 font-mono text-[10px] uppercase tracking-[0.16em] text-sky-600 dark:text-sky-400">01 · Set the shared scenario</p>
        <p class="mt-1 text-xs text-[var(--text-tertiary)]">These conditions apply equally to both experiences.</p>
      </div>
      <button type="button" data-reset-context class="rounded-md border border-[var(--border-subtle)] px-2.5 py-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--text-secondary)] transition hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]">Reset scenario</button>
    </div>

    <div class="grid gap-3 md:grid-cols-3">
      <fieldset class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3">
        <legend class="px-1 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">User familiarity</legend>
        <div class="mt-1 grid grid-cols-2 gap-1.5">
          <button type="button" data-familiarity="new" aria-pressed="true" class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-primary)] px-3 py-2 text-xs font-medium text-[var(--text-primary)]">New</button>
          <button type="button" data-familiarity="experienced" aria-pressed="false" class="rounded-md border border-[var(--border-subtle)] px-3 py-2 text-xs text-[var(--text-secondary)]">Experienced</button>
        </div>
      </fieldset>

      <fieldset class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3">
        <legend class="px-1 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">Product version</legend>
        <div class="mt-1 grid grid-cols-2 gap-1.5">
          <button type="button" data-version="4.1" aria-pressed="false" class="rounded-md border border-[var(--border-subtle)] px-3 py-2 text-xs text-[var(--text-secondary)]">4.1</button>
          <button type="button" data-version="4.2" aria-pressed="true" class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-primary)] px-3 py-2 text-xs font-medium text-[var(--text-primary)]">4.2</button>
        </div>
      </fieldset>

      <fieldset class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] p-3">
        <legend class="px-1 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">Compatible Data Connections</legend>
        <div class="mt-1 grid grid-cols-2 gap-1.5">
          <button type="button" data-connection-count="1" aria-pressed="false" class="rounded-md border border-[var(--border-subtle)] px-3 py-2 text-xs text-[var(--text-secondary)]">One</button>
          <button type="button" data-connection-count="3" aria-pressed="true" class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-primary)] px-3 py-2 text-xs font-medium text-[var(--text-primary)]">Several</button>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="border-b border-[var(--border-subtle)] px-5 py-3 sm:px-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="m-0 font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--text-tertiary)]">Shared application truth</p>
        <p data-truth-summary class="mt-1 text-xs text-[var(--text-secondary)]">3 compatible connections · product 4.2 · new user</p>
      </div>
      <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-sky-600 dark:text-sky-400">Same scenario → different policy</span>
    </div>
  </div>

  <div class="p-5 sm:p-6">
    <div class="mb-4">
      <p class="m-0 font-mono text-[10px] uppercase tracking-[0.16em] text-emerald-600 dark:text-emerald-400">02 · Compare the interface policy</p>
      <p class="mt-1 text-xs text-[var(--text-tertiary)]">The two experiences start from the same scenario, but each can be used independently.</p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="flex min-h-[28rem] flex-col overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)]">
        <div class="border-b border-[var(--border-subtle)] px-5 py-4">
          <p class="m-0 font-mono text-[10px] uppercase tracking-wider text-[var(--text-tertiary)]">Conventional experience</p>
          <h4 class="mt-1 mb-0 text-base font-semibold text-[var(--text-primary)]">Configuration</h4>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">The form exposes the available values and leaves interpretation to the user.</p>
        </div>

        <div class="flex flex-1 flex-col p-5">
          <label class="block">
            <span class="text-sm font-medium text-[var(--text-primary)]">Data Connection</span>
            <p class="mt-1 text-xs text-[var(--text-tertiary)]">Required for this configuration</p>
            <select data-standard-data-connection class="mt-3 w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2.5 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--border-strong)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
          </label>

          <div data-standard-error class="mt-3 hidden text-xs text-red-600 dark:text-red-400" role="alert">Select a Data Connection to continue.</div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-5 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-standard-continue class="rounded-md border border-[var(--border-strong)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] transition hover:bg-[var(--bg-secondary)]">Continue →</button>
            <span data-standard-outcome class="font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-tertiary)]">Awaiting selection</span>
          </div>
        </div>
      </section>

      <section class="flex min-h-[28rem] flex-col overflow-hidden rounded-xl border border-sky-500/30 bg-[var(--bg-primary)] shadow-sm">
        <div class="border-b border-sky-500/20 px-5 py-4">
          <p class="m-0 font-mono text-[10px] uppercase tracking-wider text-sky-600 dark:text-sky-400">Adaptive experience</p>
          <h4 class="mt-1 mb-0 text-base font-semibold text-[var(--text-primary)]">Configuration</h4>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">The form adds only the intervention supported by the current evidence.</p>
        </div>

        <div class="flex flex-1 flex-col p-5">
          <div class="mb-4 rounded-lg border border-sky-500/25 bg-sky-500/5 p-3" aria-live="polite">
            <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
              <p data-adaptive-headline class="m-0 text-sm font-medium text-[var(--text-primary)]">Context-aware guidance</p>
              <span data-adaptive-authority class="rounded border border-sky-500/25 px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider text-sky-600 dark:text-sky-400">policy</span>
            </div>
            <div data-adaptive-guidance-list class="space-y-2"></div>
          </div>

          <label class="block rounded-xl transition" data-adaptive-data-connection-shell>
            <span class="mb-1.5 flex items-center justify-between gap-2 text-sm font-medium text-[var(--text-primary)]">
              <span>Data Connection</span>
              <span data-adaptive-required class="hidden font-mono text-[10px] uppercase tracking-wide text-amber-600 dark:text-amber-400">Required</span>
            </span>
            <select data-adaptive-data-connection class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2.5 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--border-strong)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
            <p class="mt-1.5 text-xs text-[var(--text-tertiary)]">Selects the external system this workflow reads from or writes to.</p>
          </label>

          <div data-adaptive-error class="mt-3 hidden text-xs text-red-600 dark:text-red-400" role="alert">Select a Data Connection to continue.</div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-5 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-adaptive-continue class="rounded-md bg-[var(--text-primary)] px-3 py-2 text-xs font-medium text-[var(--bg-primary)] transition hover:opacity-90">Continue →</button>
            <span data-adaptive-outcome class="font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-tertiary)]">Awaiting selection</span>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="border-t border-[var(--border-subtle)] px-5 py-5 sm:px-6">
    <details data-decision-trace>
      <summary class="cursor-pointer list-none">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="m-0 font-mono text-[10px] uppercase tracking-[0.16em] text-violet-600 dark:text-violet-400">03 · Inspect the deterministic decision</p>
            <p class="mt-1 text-xs text-[var(--text-tertiary)]">See what the adaptive side evaluated before choosing its response.</p>
          </div>
          <span class="font-mono text-[9px] uppercase tracking-wider text-[var(--text-tertiary)]">Show trace</span>
        </div>
      </summary>

      <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-[var(--border-subtle)] sm:grid-cols-2 xl:grid-cols-4">
        <div class="bg-[var(--bg-card)] p-4">
          <p class="m-0 font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--text-tertiary)]">Application state</p>
          <p data-trace-state class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">4.2 · new · 3 matches</p>
        </div>
        <div class="bg-[var(--bg-card)] p-4">
          <p class="m-0 font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--text-tertiary)]">Validation</p>
          <p data-trace-validation class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">Data Connection required</p>
        </div>
        <div class="bg-[var(--bg-card)] p-4">
          <p class="m-0 font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--text-tertiary)]">Applicable knowledge</p>
          <p data-trace-knowledge class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">Authored product guidance</p>
        </div>
        <div class="bg-[var(--bg-card)] p-4">
          <p class="m-0 font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--text-tertiary)]">Response policy</p>
          <p data-trace-policy class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">Contextual suggestion</p>
        </div>
      </div>

      <p class="mt-3 rounded-lg border border-dashed border-[var(--border-subtle)] px-4 py-3 text-xs leading-relaxed text-[var(--text-tertiary)]">
        The knowledge fragments and rules in this lab are authored fixtures. Phase 1 evaluates explicit conditions; it does not discover documents or generate guidance.
      </p>
    </details>
  </div>
</section>

<script>
  import { ONE_DATA_CONNECTION, THREE_DATA_CONNECTIONS } from './fixtures.ts';
  import { KNOWLEDGE } from './knowledge.ts';
  import { resolveInterface } from './resolver.ts';
  import type { AutomationConfiguration, ProductVersion, RuntimeContext, UIAction, UIResponse, UserFamiliarity } from './types.ts';

  document.querySelectorAll<HTMLElement>('[data-adaptive-enterprise-ui-lab]').forEach((lab) => {
    if (lab.dataset.bound === 'true') return;
    lab.dataset.bound = 'true';

    const standardDataConnection = lab.querySelector<HTMLSelectElement>('[data-standard-data-connection]');
    const adaptiveDataConnection = lab.querySelector<HTMLSelectElement>('[data-adaptive-data-connection]');
    const standardError = lab.querySelector<HTMLElement>('[data-standard-error]');
    const adaptiveError = lab.querySelector<HTMLElement>('[data-adaptive-error]');
    const standardContinue = lab.querySelector<HTMLButtonElement>('[data-standard-continue]');
    const adaptiveContinue = lab.querySelector<HTMLButtonElement>('[data-adaptive-continue]');
    const standardOutcome = lab.querySelector<HTMLElement>('[data-standard-outcome]');
    const adaptiveOutcome = lab.querySelector<HTMLElement>('[data-adaptive-outcome]');
    const adaptiveRequired = lab.querySelector<HTMLElement>('[data-adaptive-required]');
    const adaptiveGuidanceList = lab.querySelector<HTMLElement>('[data-adaptive-guidance-list]');
    const adaptiveShell = lab.querySelector<HTMLElement>('[data-adaptive-data-connection-shell]');
    const adaptiveHeadline = lab.querySelector<HTMLElement>('[data-adaptive-headline]');
    const adaptiveAuthority = lab.querySelector<HTMLElement>('[data-adaptive-authority]');
    const truthSummary = lab.querySelector<HTMLElement>('[data-truth-summary]');
    const traceState = lab.querySelector<HTMLElement>('[data-trace-state]');
    const traceValidation = lab.querySelector<HTMLElement>('[data-trace-validation]');
    const traceKnowledge = lab.querySelector<HTMLElement>('[data-trace-knowledge]');
    const tracePolicy = lab.querySelector<HTMLElement>('[data-trace-policy]');
    const resetContext = lab.querySelector<HTMLButtonElement>('[data-reset-context]');

    if (!standardDataConnection || !adaptiveDataConnection || !adaptiveGuidanceList) return;

    let familiarity: UserFamiliarity = 'new';
    let productVersion: ProductVersion = '4.2';
    let connectionCount: 1 | 3 = 3;
    let standardDataConnectionId: string | null = null;
    let adaptiveDataConnectionId: string | null = null;
    let standardAttempted = false;
    let adaptiveAttempted = false;
    const uiState = { expandedHelp: [], highlightedField: null, dismissedGuidance: [] };

    const setPressedState = (selector: string, activeValue: string, attribute: string) => {
      lab.querySelectorAll<HTMLButtonElement>(selector).forEach((button) => {
        const active = button.dataset[attribute] === activeValue;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.classList.toggle('border-[var(--border-strong)]', active);
        button.classList.toggle('bg-[var(--bg-primary)]', active);
        button.classList.toggle('font-medium', active);
        button.classList.toggle('text-[var(--text-primary)]', active);
        button.classList.toggle('border-[var(--border-subtle)]', !active);
        button.classList.toggle('text-[var(--text-secondary)]', !active);
      });
    };

    const currentConnections = () => connectionCount === 1 ? ONE_DATA_CONNECTION : THREE_DATA_CONNECTIONS;

    const resetSurfaceState = () => {
      standardDataConnectionId = null;
      adaptiveDataConnectionId = null;
      standardAttempted = false;
      adaptiveAttempted = false;
    };

    const rebuildDataConnectionOptions = () => {
      const connections = currentConnections();
      [standardDataConnection, adaptiveDataConnection].forEach((select) => {
        select.replaceChildren();
        select.add(new Option('Select a Data Connection', ''));
        connections.forEach((connection) => select.add(new Option(`${connection.name} · ${connection.system}`, connection.id)));
      });
      standardDataConnection.value = standardDataConnectionId ?? '';
      adaptiveDataConnection.value = adaptiveDataConnectionId ?? '';
    };

    const createActionButton = (action: UIAction) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = action.label;
      button.className = 'mt-2 rounded-md border border-sky-500/35 bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-sky-700 transition hover:opacity-80 dark:text-sky-300';
      button.addEventListener('click', () => {
        if (action.type === 'focus-field' && action.field === 'dataConnection') adaptiveDataConnection.focus();
        if (action.type === 'set-value' && action.field === 'dataConnection' && action.value) {
          adaptiveDataConnectionId = action.value;
          adaptiveDataConnection.value = action.value;
          adaptiveAttempted = false;
          render();
          adaptiveDataConnection.focus();
        }
      });
      return button;
    };

    const createResponseItem = (response: UIResponse, compact = false) => {
      const item = document.createElement('div');
      if (response.type === 'preconfiguration') item.className = 'rounded-lg border border-emerald-500/30 bg-emerald-500/5 p-3';
      else if (response.type === 'suggestion') item.className = 'rounded-lg border border-sky-500/30 bg-[var(--bg-primary)] p-3';
      else if (response.type === 'explanation' || response.type === 'warning') item.className = 'rounded-lg border border-amber-500/30 bg-amber-500/5 p-3';
      else item.className = compact ? 'py-1.5' : 'rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-3';

      const message = document.createElement('p');
      message.className = compact ? 'm-0 text-xs leading-relaxed text-[var(--text-secondary)]' : 'm-0 text-sm leading-relaxed text-[var(--text-primary)]';
      message.textContent = response.message;
      item.append(message);
      response.actions?.forEach((action) => item.append(createActionButton(action)));
      return item;
    };

    const renderStandard = () => {
      standardError?.classList.toggle('hidden', !(standardAttempted && !standardDataConnectionId));
      if (standardOutcome) standardOutcome.textContent = standardDataConnectionId ? 'Ready to continue' : 'Awaiting selection';
    };

    const renderAdaptive = (responses: UIResponse[]) => {
      adaptiveGuidanceList.replaceChildren();
      const visibleResponses = responses.filter((response) => response.type !== 'highlight');
      const primaryResponses = visibleResponses.filter((response) => response.type !== 'help');
      const helpResponses = visibleResponses.filter((response) => response.type === 'help');

      if (visibleResponses.length === 0) {
        const quiet = document.createElement('p');
        quiet.className = 'm-0 text-sm text-[var(--text-secondary)]';
        quiet.textContent = 'Data Connection is set. No contextual intervention is needed.';
        adaptiveGuidanceList.append(quiet);
      } else {
        primaryResponses.forEach((response) => adaptiveGuidanceList.append(createResponseItem(response)));
        if (helpResponses.length > 0) {
          const details = document.createElement('details');
          details.className = 'rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 py-2';
          const summary = document.createElement('summary');
          summary.className = 'cursor-pointer text-xs font-medium text-[var(--text-secondary)]';
          summary.textContent = `Why this guidance? · ${helpResponses.length} ${helpResponses.length === 1 ? 'detail' : 'details'}`;
          details.append(summary);
          const detailBody = document.createElement('div');
          detailBody.className = 'mt-2 divide-y divide-[var(--border-subtle)]';
          helpResponses.forEach((response) => detailBody.append(createResponseItem(response, true)));
          details.append(detailBody);
          adaptiveGuidanceList.append(details);
        }
      }

      const shouldHighlight = responses.some((response) => response.id === 'data-connection-highlight');
      adaptiveShell?.classList.toggle('ring-2', shouldHighlight);
      adaptiveShell?.classList.toggle('ring-amber-500/35', shouldHighlight);
      adaptiveShell?.classList.toggle('bg-amber-500/5', shouldHighlight);
      adaptiveShell?.classList.toggle('p-3', shouldHighlight);
      adaptiveRequired?.classList.toggle('hidden', !shouldHighlight);
      adaptiveError?.classList.toggle('hidden', !(adaptiveAttempted && !adaptiveDataConnectionId));
      if (adaptiveOutcome) adaptiveOutcome.textContent = adaptiveDataConnectionId ? 'Ready to continue' : 'Awaiting selection';

      const highest = responses.reduce<UIResponse | null>((current, response) => !current || response.authority > current.authority ? response : current, null);
      if (adaptiveHeadline) adaptiveHeadline.textContent = highest ? 'Context-aware guidance' : 'No intervention needed';
      if (adaptiveAuthority) adaptiveAuthority.textContent = highest ? `authority ${highest.authority}` : 'authority 0';
    };

    const render = () => {
      const availableDataConnections = currentConnections();
      const config: AutomationConfiguration = { dataConnectionId: adaptiveDataConnectionId };
      const runtime: RuntimeContext = { productVersion, userFamiliarity: familiarity, availableDataConnections };
      const result = resolveInterface({ config, runtime, ui: uiState, knowledge: KNOWLEDGE });

      renderStandard();
      renderAdaptive(result.responses);

      if (truthSummary) truthSummary.textContent = `${availableDataConnections.length} compatible ${availableDataConnections.length === 1 ? 'connection' : 'connections'} · product ${productVersion} · ${familiarity} user`;
      if (traceState) traceState.textContent = `${productVersion} · ${familiarity} · ${availableDataConnections.length} ${availableDataConnections.length === 1 ? 'match' : 'matches'}`;
      if (traceValidation) traceValidation.textContent = result.validation.length > 0 ? 'Data Connection is required.' : 'Configuration is valid.';
      if (traceKnowledge) {
        const labels = [...new Set(result.applicableKnowledge.map((item) => item.source.label))];
        traceKnowledge.textContent = labels.length > 0 ? labels.join(' · ') : 'No authored knowledge applies.';
      }
      if (tracePolicy) {
        const highest = result.responses.reduce<UIResponse | null>((current, response) => !current || response.authority > current.authority ? response : current, null);
        tracePolicy.textContent = highest ? `Authority ${highest.authority} · ${highest.type}` : 'Authority 0 · no intervention';
      }
    };

    standardDataConnection.addEventListener('change', () => {
      standardDataConnectionId = standardDataConnection.value || null;
      standardAttempted = false;
      renderStandard();
    });

    adaptiveDataConnection.addEventListener('change', () => {
      adaptiveDataConnectionId = adaptiveDataConnection.value || null;
      adaptiveAttempted = false;
      render();
    });

    standardContinue?.addEventListener('click', () => {
      standardAttempted = true;
      renderStandard();
    });

    adaptiveContinue?.addEventListener('click', () => {
      adaptiveAttempted = true;
      render();
    });

    lab.querySelectorAll<HTMLButtonElement>('[data-familiarity]').forEach((button) => button.addEventListener('click', () => {
      familiarity = button.dataset.familiarity as UserFamiliarity;
      setPressedState('[data-familiarity]', familiarity, 'familiarity');
      resetSurfaceState();
      rebuildDataConnectionOptions();
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((button) => button.addEventListener('click', () => {
      productVersion = button.dataset.version as ProductVersion;
      setPressedState('[data-version]', productVersion, 'version');
      resetSurfaceState();
      rebuildDataConnectionOptions();
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-connection-count]').forEach((button) => button.addEventListener('click', () => {
      connectionCount = button.dataset.connectionCount === '1' ? 1 : 3;
      setPressedState('[data-connection-count]', String(connectionCount), 'connectionCount');
      resetSurfaceState();
      rebuildDataConnectionOptions();
      render();
    }));

    resetContext?.addEventListener('click', () => {
      familiarity = 'new';
      productVersion = '4.2';
      connectionCount = 3;
      resetSurfaceState();
      setPressedState('[data-familiarity]', familiarity, 'familiarity');
      setPressedState('[data-version]', productVersion, 'version');
      setPressedState('[data-connection-count]', String(connectionCount), 'connectionCount');
      rebuildDataConnectionOptions();
      render();
    });

    rebuildDataConnectionOptions();
    render();
  });
</script>