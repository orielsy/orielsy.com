---
import { THREE_DATA_CONNECTIONS } from './fixtures.ts';
import LabExperienceHeader from './LabExperienceHeader.astro';
import LabScenarioControl from './LabScenarioControl.astro';
import LabSectionHeading from './LabSectionHeading.astro';
import LabTraceCard from './LabTraceCard.astro';

export interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<section
  class="not-prose my-10 text-[var(--text-primary)]"
  data-adaptive-enterprise-ui-lab
  data-lab-context={embedded ? 'embedded' : 'standalone'}
  aria-labelledby={embedded ? undefined : 'adaptive-lab-title'}
  aria-label={embedded ? 'Adaptive Enterprise UI Lab' : undefined}
>
  <header class="border-b border-[var(--border-subtle)] pb-8">
    <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--text-muted)]">
      <span>{embedded ? 'Working Phase 1 instrument' : 'Interactive reference implementation'}</span>
      <span aria-hidden="true" class="h-px w-8 bg-[var(--border-strong)]"></span>
      <span>Phase 1 · deterministic</span>
    </div>
    {!embedded && (
      <h3 id="adaptive-lab-title" class="mt-4 mb-0 max-w-4xl text-3xl font-semibold leading-tight text-[var(--text-primary)] sm:text-4xl">
        Adaptive Enterprise UI Lab
      </h3>
    )}
    <p class:list={[
      "max-w-3xl text-sm leading-7 text-[var(--text-secondary)] sm:text-base",
      embedded ? "mt-3" : "mt-4",
    ]}>
      Set the scenario outside the demo, then compare how two Data Connection forms respond to that same application truth. No AI, inference, or semantic retrieval is used.
    </p>
  </header>

  <div class="py-8">
    <div data-scenario-controller class="rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] p-4 sm:p-5">
      <div class="flex flex-col gap-3 border-b border-[var(--border-subtle)] pb-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <LabSectionHeading number="01" title="Scenario controller" {embedded} />
          <p class="mt-3 max-w-2xl text-xs leading-5 text-[var(--text-secondary)]">
            These controls set the test conditions. They are not part of either Data Connection form.
          </p>
        </div>
        <span class="w-fit rounded border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--text-muted)]">
          Controls demo state
        </span>
      </div>

      <div data-scenario-grid class="mt-5 grid gap-px overflow-hidden rounded-md border border-[var(--border-subtle)] bg-[var(--border-subtle)] md:grid-cols-3">
      <LabScenarioControl label="User familiarity" value="new">
        <span slot="value" data-scenario-familiarity>new</span>
        <div class="grid grid-cols-2 gap-1.5" role="group" aria-label="User familiarity">
          <button type="button" data-familiarity="new" aria-pressed="true" class="h-9 rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 text-xs font-medium text-[var(--accent)] transition">New</button>
          <button type="button" data-familiarity="experienced" aria-pressed="false" class="h-9 rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]">Experienced</button>
        </div>
      </LabScenarioControl>

      <LabScenarioControl label="Product version" value="v4.2">
        <span slot="value" data-scenario-version>v4.2</span>
        <div class="grid grid-cols-2 gap-1.5" role="group" aria-label="Product version">
          <button type="button" data-version="4.1" aria-pressed="false" class="h-9 rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]">4.1</button>
          <button type="button" data-version="4.2" aria-pressed="true" class="h-9 rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 text-xs font-medium text-[var(--accent)] transition">4.2</button>
        </div>
      </LabScenarioControl>

      <LabScenarioControl label="Compatible connections" value="3 matches">
        <span slot="value" data-scenario-connections>3 matches</span>
        <div class="grid grid-cols-2 gap-1.5" role="group" aria-label="Compatible Data Connections">
          <button type="button" data-connection-count="1" aria-pressed="false" class="h-9 rounded-sm border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]">One</button>
          <button type="button" data-connection-count="3" aria-pressed="true" class="h-9 rounded-sm border border-[var(--accent-border)] bg-[var(--accent-subtle)] px-3 text-xs font-medium text-[var(--accent)] transition">Several</button>
        </div>
      </LabScenarioControl>
      </div>
    </div>
  </div>

  <span class="mx-auto block h-8 w-px bg-[var(--border-subtle)]" aria-hidden="true"></span>

  <div class="border-y border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-4 py-4 sm:px-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <svg class="size-4 shrink-0 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
        <div>
          <p class="m-0 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--text-muted)]">Shared application truth</p>
          <p data-truth-summary class="mt-1 text-sm text-[var(--text-primary)]">3 compatible connections · product 4.2 · new user</p>
        </div>
      </div>
      <span class="font-mono text-[11px] text-[var(--text-secondary)]">ONE STATE → TWO DEMO FORMS</span>
    </div>
  </div>

  <div class="border-t border-[var(--border-subtle)] pt-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <LabSectionHeading number="02" title="Demo workbench" {embedded} />
        <p class="mt-3 max-w-2xl text-xs leading-5 text-[var(--text-secondary)]">
          Both forms receive the same application truth. The adaptive form adds only the intervention authorized by the resolver's evidence and response policy.
        </p>
      </div>
      <span class="w-fit rounded border border-[var(--accent-border)] bg-[var(--bg-primary)] px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--accent)]">
        Actual user task
      </span>
    </div>

    <div class="mt-4 grid gap-5 lg:grid-cols-2">
      <article class="flex min-h-[32rem] flex-col rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5 sm:p-6">
        <LabExperienceHeader
          eyebrow="Conventional experience"
          description="The form exposes the available values and leaves interpretation to the user."
          {embedded}
        />

        <div class="flex flex-1 flex-col">
          <div>
            <label for="standard-data-connection" class="text-sm font-medium text-[var(--text-primary)]">Data Connection</label>
            <p class="mt-1 text-xs text-[var(--text-muted)]">Required for this configuration</p>
            <select id="standard-data-connection" data-standard-data-connection class="mt-3 h-11 w-full rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--accent-border)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
            <p data-standard-error class="mt-3 hidden text-xs text-red-600 dark:text-red-400" role="alert">Select a Data Connection to continue.</p>
          </div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-6 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-standard-continue class="inline-flex items-center justify-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] transition hover:bg-[var(--bg-card-hover)]">Continue <span aria-hidden="true">→</span></button>
            <span data-standard-outcome class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Awaiting selection</span>
          </div>
        </div>
      </article>

      <article class="flex min-h-[32rem] flex-col rounded-md border border-[var(--accent-border)] bg-[var(--bg-card)] p-5 sm:p-6">
        <LabExperienceHeader
          eyebrow="Adaptive experience"
          description="The form adds only the intervention supported by the current evidence."
          adaptive
          {embedded}
        />

        <div class="flex flex-1 flex-col">
          <div data-adaptive-intervention class="mb-5 rounded-md border border-[var(--accent-border)] bg-[var(--bg-primary)] p-4" aria-live="polite">
            <div class="flex gap-3">
              <svg data-adaptive-info-icon class="mt-0.5 size-4 shrink-0 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <p data-adaptive-headline class="m-0 text-sm font-medium text-[var(--text-primary)]">Choose among compatible connections</p>
                  <span data-adaptive-authority class="rounded border border-[var(--accent-border)] px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--accent)]">EXPLAIN</span>
                </div>
                <p data-adaptive-guidance class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Choose the connection for the system this workflow needs to access.</p>
                <p data-adaptive-source class="mt-3 border-t border-[var(--border-subtle)] pt-3 font-mono text-[10px] leading-5 text-[var(--text-muted)]">DOCUMENTATION · Choosing a Data Connection</p>
                <details data-guidance-details class="mt-3 border-t border-[var(--border-subtle)] pt-3">
                  <summary class="cursor-pointer text-xs font-medium text-[var(--text-secondary)] transition hover:text-[var(--text-primary)]">Why this guidance?</summary>
                  <ul data-guidance-details-list class="mt-2 space-y-1.5 text-xs leading-5 text-[var(--text-muted)]"></ul>
                </details>
              </div>
            </div>
          </div>

          <div>
            <label for="adaptive-data-connection" class="text-sm font-medium text-[var(--text-primary)]">Data Connection</label>
            <p class="mt-1 text-xs text-[var(--text-muted)]">Required for this configuration</p>
            <select id="adaptive-data-connection" data-adaptive-data-connection class="mt-3 h-11 w-full rounded-md border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-3 text-sm text-[var(--text-primary)] outline-none transition focus:border-[var(--accent-border)]">
              <option value="">Select a Data Connection</option>
              {THREE_DATA_CONNECTIONS.map((connection) => <option value={connection.id}>{connection.name} · {connection.system}</option>)}
            </select>
            <button type="button" data-use-sole-connection class="mt-3 hidden w-fit rounded-md border border-[var(--accent-border)] bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-[var(--accent)] transition hover:bg-[var(--accent-subtle)]"></button>
            <p data-adaptive-error class="mt-3 hidden text-xs text-red-600 dark:text-red-400" role="alert">Select a Data Connection to continue.</p>
          </div>

          <div class="mt-auto flex flex-col-reverse gap-3 border-t border-[var(--border-subtle)] pt-6 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" data-adaptive-continue class="inline-flex items-center justify-center gap-2 rounded-md bg-[var(--accent)] px-3 py-2 text-xs font-medium text-white transition hover:bg-[var(--accent-hover)]">Continue <span aria-hidden="true">→</span></button>
            <span data-adaptive-outcome class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">Awaiting selection</span>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="border-t border-[var(--border-subtle)] pt-8">
    <details data-decision-trace open>
      <summary class="cursor-pointer list-none">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <LabSectionHeading number="03" title="Inspect the deterministic decision" {embedded} />
          <span data-trace-toggle-label class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-xs text-[var(--text-secondary)] transition hover:bg-[var(--bg-card)] hover:text-[var(--text-primary)]">Hide trace <span aria-hidden="true">⌃</span></span>
        </div>
      </summary>

      <div class="mt-4 grid gap-px overflow-hidden rounded-md border border-[var(--border-subtle)] bg-[var(--border-subtle)] sm:grid-cols-2 xl:grid-cols-4">
        <LabTraceCard label="Application state">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
          <p data-trace-state class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">4.2 · new · 3 matches</p>
        </LabTraceCard>
        <LabTraceCard label="Validation">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
          <p data-trace-validation class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Data Connection is required.</p>
        </LabTraceCard>
        <LabTraceCard label="Applicable knowledge">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 3h9l3 3v15H6z"/><path d="M14 3v4h4"/></svg>
          <p data-trace-knowledge class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Authored product guidance</p>
        </LabTraceCard>
        <LabTraceCard label="Response policy">
          <svg slot="icon" class="size-4 text-[var(--accent)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 3v6"/><path d="M6 15v6"/><path d="M18 3v4"/><path d="M18 13v8"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="10" r="3"/></svg>
          <p data-trace-policy class="mt-2 text-xs leading-5 text-[var(--text-secondary)]">Explain the ambiguity; do not infer or preselect a value.</p>
        </LabTraceCard>
      </div>

      <div class="mt-4 flex items-start gap-3 rounded-md border border-dashed border-[var(--border-subtle)] px-4 py-3 text-xs leading-5 text-[var(--text-secondary)]">
        <svg class="mt-0.5 size-4 shrink-0 text-[var(--text-muted)]" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 5a2 2 0 012-2h12v17H6a2 2 0 01-2-2z"/><path d="M4 18a2 2 0 012-2h12"/></svg>
        <p class="m-0">The knowledge fragments and rules in this lab are authored fixtures. The interface evaluates explicit conditions; it does not discover documents or generate guidance.</p>
      </div>
    </details>
  </div>
</section>

<script>
  import { trackPortfolioEvent } from '../../lib/analytics';
  import { ONE_DATA_CONNECTION, THREE_DATA_CONNECTIONS } from './fixtures.ts';
  import { KNOWLEDGE } from './knowledge.ts';
  import { resolveInterface } from './resolver.ts';
  import type { AutomationConfiguration, ProductVersion, RuntimeContext, UIAction, UIResponse, UserFamiliarity } from './types.ts';

  let labInteractionTracked = false;

  document.querySelectorAll<HTMLElement>('[data-adaptive-enterprise-ui-lab]').forEach((lab) => {
    if (lab.dataset.bound === 'true') return;
    lab.dataset.bound = 'true';

    const standardDataConnection = lab.querySelector<HTMLSelectElement>('[data-standard-data-connection]');
    const adaptiveDataConnection = lab.querySelector<HTMLSelectElement>('[data-adaptive-data-connection]');
    const standardError = lab.querySelector<HTMLElement>('[data-standard-error]');
    const adaptiveError = lab.querySelector<HTMLElement>('[data-adaptive-error]');
    const standardContinue = lab.querySelector<HTMLButtonElement>('[data-standard-continue]');
    const adaptiveContinue = lab.querySelector<HTMLButtonElement>('[data-adaptive-continue]');
    const standardOutcome = lab.querySelector<HTMLElement>('[data-standard-outcome]');
    const adaptiveOutcome = lab.querySelector<HTMLElement>('[data-adaptive-outcome]');
    const adaptiveHeadline = lab.querySelector<HTMLElement>('[data-adaptive-headline]');
    const adaptiveAuthority = lab.querySelector<HTMLElement>('[data-adaptive-authority]');
    const adaptiveGuidance = lab.querySelector<HTMLElement>('[data-adaptive-guidance]');
    const adaptiveSource = lab.querySelector<HTMLElement>('[data-adaptive-source]');
    const guidanceDetails = lab.querySelector<HTMLDetailsElement>('[data-guidance-details]');
    const guidanceDetailsList = lab.querySelector<HTMLUListElement>('[data-guidance-details-list]');
    const useSoleConnection = lab.querySelector<HTMLButtonElement>('[data-use-sole-connection]');
    const truthSummary = lab.querySelector<HTMLElement>('[data-truth-summary]');
    const scenarioFamiliarity = lab.querySelector<HTMLElement>('[data-scenario-familiarity]');
    const scenarioVersion = lab.querySelector<HTMLElement>('[data-scenario-version]');
    const scenarioConnections = lab.querySelector<HTMLElement>('[data-scenario-connections]');
    const traceState = lab.querySelector<HTMLElement>('[data-trace-state]');
    const traceValidation = lab.querySelector<HTMLElement>('[data-trace-validation]');
    const traceKnowledge = lab.querySelector<HTMLElement>('[data-trace-knowledge]');
    const tracePolicy = lab.querySelector<HTMLElement>('[data-trace-policy]');
    const decisionTrace = lab.querySelector<HTMLDetailsElement>('[data-decision-trace]');
    const traceToggleLabel = lab.querySelector<HTMLElement>('[data-trace-toggle-label]');

    if (!standardDataConnection || !adaptiveDataConnection) return;

    const trackFirstMeaningfulInteraction = () => {
      if (labInteractionTracked) return;
      labInteractionTracked = true;
      trackPortfolioEvent('lab_interaction', { lab: 'adaptive-enterprise-ui' });
    };

    lab.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-familiarity], [data-version], [data-connection-count], [data-standard-continue], [data-adaptive-continue], [data-use-sole-connection]')) {
        trackFirstMeaningfulInteraction();
      }
    });

    lab.addEventListener('change', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.matches('[data-standard-data-connection], [data-adaptive-data-connection]')) {
        trackFirstMeaningfulInteraction();
      }
    });

    let familiarity: UserFamiliarity = 'new';
    let productVersion: ProductVersion = '4.2';
    let connectionCount: 1 | 3 = 3;
    let standardDataConnectionId = '';
    let adaptiveDataConnectionId = '';
    let standardAttempted = false;
    let adaptiveAttempted = false;
    const uiState = { expandedHelp: [], highlightedField: null, dismissedGuidance: [] };

    const currentConnections = () => connectionCount === 1 ? ONE_DATA_CONNECTION : THREE_DATA_CONNECTIONS;

    const setPressedState = (selector: string, activeValue: string, attribute: string) => {
      lab.querySelectorAll<HTMLButtonElement>(selector).forEach((button) => {
        const active = button.dataset[attribute] === activeValue;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('border-[var(--accent-border)]', active);
        button.classList.toggle('bg-[var(--accent-subtle)]', active);
        button.classList.toggle('font-medium', active);
        button.classList.toggle('text-[var(--accent)]', active);
        button.classList.toggle('border-[var(--border-subtle)]', !active);
        button.classList.toggle('bg-[var(--bg-primary)]', !active);
        button.classList.toggle('text-[var(--text-secondary)]', !active);
      });
    };

    const resetSurfaceState = () => {
      standardDataConnectionId = '';
      adaptiveDataConnectionId = '';
      standardAttempted = false;
      adaptiveAttempted = false;
    };

    const rebuildOptions = () => {
      const connections = currentConnections();
      [standardDataConnection, adaptiveDataConnection].forEach((select) => {
        select.replaceChildren();
        select.add(new Option('Select a Data Connection', ''));
        connections.forEach((connection) => select.add(new Option(`${connection.name} · ${connection.system}`, connection.id)));
      });
    };

    const authorityLabel = (response?: UIResponse) => {
      if (!response) return 'none';
      switch (response.type) {
        case 'preconfiguration': return 'offer';
        case 'suggestion': return 'guide';
        case 'highlight': return 'highlight';
        case 'explanation': return 'explain';
        case 'help': return 'help';
        case 'warning': return 'warn';
      }
      return 'none';
    };

    const interventionHeadline = (response?: UIResponse) => {
      if (!response) return 'Configuration ready';
      switch (response.type) {
        case 'preconfiguration': return 'One compatible connection found';
        case 'suggestion': return 'Choose among compatible connections';
        case 'highlight': return 'Data Connection required';
        case 'explanation': return 'Why this field is required';
        case 'help': return 'Data Connection guidance';
        case 'warning': return 'Review this configuration';
      }
      return 'Configuration guidance';
    };

    const policySummary = (response?: UIResponse) => {
      if (!response) return 'No intervention required; the selected value satisfies deterministic requirements.';
      switch (response.type) {
        case 'preconfiguration': return 'Offer the sole compatible value; require user confirmation before changing the field.';
        case 'suggestion': return 'Guide the user without choosing among multiple valid values.';
        case 'highlight': return 'Highlight the required field without changing its value.';
        case 'explanation': return 'Explain the deterministic requirement without taking action.';
        case 'help': return 'Surface contextual help while leaving application state unchanged.';
        case 'warning': return 'Warn about the current state without taking action.';
      }
      return 'Keep the current interface state unchanged.';
    };

    let pendingSetValueAction: UIAction | undefined;

    const render = () => {
      const connections = currentConnections();
      const config: AutomationConfiguration = { dataConnectionId: adaptiveDataConnectionId || null };
      const runtime: RuntimeContext = { productVersion, userFamiliarity: familiarity, availableDataConnections: connections };
      const result = resolveInterface({ config, runtime, ui: uiState, knowledge: KNOWLEDGE });
      const primaryResponse = result.responses.reduce<UIResponse | undefined>(
        (selected, response) => !selected || response.authority > selected.authority ? response : selected,
        undefined,
      );
      const supportingResponses = result.responses.filter(
        (response) => response !== primaryResponse && (response.type === 'help' || response.type === 'explanation'),
      );
      pendingSetValueAction = primaryResponse?.actions?.find((action) => action.type === 'set-value');

      if (scenarioFamiliarity) scenarioFamiliarity.textContent = familiarity;
      if (scenarioVersion) scenarioVersion.textContent = `v${productVersion}`;
      if (scenarioConnections) scenarioConnections.textContent = `${connections.length} ${connections.length === 1 ? 'match' : 'matches'}`;
      if (truthSummary) truthSummary.textContent = `${connections.length} compatible ${connections.length === 1 ? 'connection' : 'connections'} · product ${productVersion} · ${familiarity} user`;

      if (standardError) standardError.classList.toggle('hidden', !(standardAttempted && !standardDataConnectionId));
      if (adaptiveError) adaptiveError.classList.toggle('hidden', !(adaptiveAttempted && !adaptiveDataConnectionId));
      if (standardOutcome) standardOutcome.textContent = standardDataConnectionId ? 'Ready to continue' : 'Awaiting selection';
      if (adaptiveOutcome) adaptiveOutcome.textContent = adaptiveDataConnectionId ? 'Ready to continue' : 'Awaiting selection';

      if (adaptiveHeadline) adaptiveHeadline.textContent = interventionHeadline(primaryResponse);
      if (adaptiveAuthority) adaptiveAuthority.textContent = authorityLabel(primaryResponse);
      if (adaptiveGuidance) {
        adaptiveGuidance.textContent = primaryResponse?.message
          ?? 'The selected Data Connection satisfies the current requirement.';
      }

      if (adaptiveSource) {
        const knowledgeSources = (primaryResponse?.knowledgeIds ?? [])
          .map((knowledgeId) => result.applicableKnowledge.find((item) => item.id === knowledgeId)?.source.label)
          .filter((label): label is string => Boolean(label));
        const sourceLabels = [...new Set(knowledgeSources)];
        if ((primaryResponse?.validationIds?.length ?? 0) > 0) sourceLabels.unshift('Application validation');
        if (primaryResponse?.type === 'preconfiguration') sourceLabels.unshift('Application state');
        adaptiveSource.textContent = sourceLabels.length > 0
          ? sourceLabels.join(' · ')
          : 'Application state';
      }

      if (guidanceDetails && guidanceDetailsList) {
        guidanceDetailsList.replaceChildren();
        supportingResponses.forEach((response) => {
          const item = document.createElement('li');
          item.textContent = response.message;
          guidanceDetailsList.append(item);
        });
        const showDetails = supportingResponses.length > 0;
        guidanceDetails.classList.toggle('hidden', !showDetails);
        if (!showDetails) guidanceDetails.open = false;
      }

      if (useSoleConnection) {
        const show = Boolean(pendingSetValueAction?.value && !adaptiveDataConnectionId);
        useSoleConnection.classList.toggle('hidden', !show);
        if (pendingSetValueAction) useSoleConnection.textContent = `✓ ${pendingSetValueAction.label}`;
      }

      if (traceState) traceState.textContent = `${productVersion} · ${familiarity} · ${connections.length} ${connections.length === 1 ? 'match' : 'matches'}`;
      if (traceValidation) {
        traceValidation.textContent = result.validation.length > 0
          ? 'Data Connection is required.'
          : 'No blocking validation issues.';
      }
      if (traceKnowledge) {
        const labels = [...new Set(result.applicableKnowledge.map((item) => item.source.label))];
        traceKnowledge.textContent = labels.length > 0 ? labels.join(' · ') : 'No authored knowledge applies.';
      }
      if (tracePolicy) tracePolicy.textContent = policySummary(primaryResponse);
    };

    standardDataConnection.addEventListener('change', () => {
      standardDataConnectionId = standardDataConnection.value;
      standardAttempted = false;
      render();
    });

    adaptiveDataConnection.addEventListener('change', () => {
      adaptiveDataConnectionId = adaptiveDataConnection.value;
      adaptiveAttempted = false;
      render();
    });

    standardContinue?.addEventListener('click', () => {
      standardAttempted = true;
      render();
    });

    adaptiveContinue?.addEventListener('click', () => {
      adaptiveAttempted = true;
      render();
    });

    useSoleConnection?.addEventListener('click', () => {
      if (!pendingSetValueAction?.value) return;
      adaptiveDataConnectionId = pendingSetValueAction.value;
      adaptiveDataConnection.value = pendingSetValueAction.value;
      adaptiveAttempted = false;
      render();
    });

    decisionTrace?.addEventListener('toggle', () => {
      if (!traceToggleLabel) return;
      traceToggleLabel.innerHTML = decisionTrace.open ? 'Hide trace <span aria-hidden="true">⌃</span>' : 'Show trace <span aria-hidden="true">⌄</span>';
    });

    lab.querySelectorAll<HTMLButtonElement>('[data-familiarity]').forEach((button) => button.addEventListener('click', () => {
      familiarity = button.dataset.familiarity as UserFamiliarity;
      setPressedState('[data-familiarity]', familiarity, 'familiarity');
      resetSurfaceState();
      rebuildOptions();
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((button) => button.addEventListener('click', () => {
      productVersion = button.dataset.version as ProductVersion;
      setPressedState('[data-version]', productVersion, 'version');
      resetSurfaceState();
      rebuildOptions();
      render();
    }));

    lab.querySelectorAll<HTMLButtonElement>('[data-connection-count]').forEach((button) => button.addEventListener('click', () => {
      connectionCount = button.dataset.connectionCount === '1' ? 1 : 3;
      setPressedState('[data-connection-count]', String(connectionCount), 'connectionCount');
      resetSurfaceState();
      rebuildOptions();
      render();
    }));

    rebuildOptions();
    render();
  });
</script>
