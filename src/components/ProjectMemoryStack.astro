---
import ResearchFigureFrame from './research/ResearchFigureFrame.astro';

const bands = [
  {
    scope: 'Entry point',
    hint: 'Routing layer, not a mega-prompt',
    accent: true,
    layers: [{ file: 'AGENTS.md', question: 'How should the agent work?', indent: 0 }],
  },
  {
    scope: 'Project-wide',
    hint: 'Applies to every change',
    layers: [{ file: 'Constitution', question: 'What must remain true across the project?', indent: 0 }],
  },
  {
    scope: 'Feature-specific',
    hint: 'Scope narrows as work gets concrete',
    layers: [
      { file: 'Feature Spec', question: 'What are we trying to accomplish?', indent: 0 },
      { file: 'Plan', question: 'How will this repository implement it?', indent: 1 },
      { file: 'Tasks', question: 'What needs to happen now?', indent: 2 },
    ],
  },
  {
    scope: 'Durable history',
    hint: 'Written once, consulted later',
    layers: [
      {
        file: 'ADR / Decision Record',
        question: 'Why was a durable product or architectural decision made?',
        indent: 0,
        note: 'Can influence implementation at any point — not only after tasks.',
      },
    ],
  },
  {
    scope: 'Output',
    hint: 'A result of intent, not the source of it',
    layers: [{ file: 'Implementation', question: 'The resulting code and content', indent: 0 }],
  },
];
---

<ResearchFigureFrame
  title="The Project Memory Stack"
  subtitle="Different artifacts preserve different kinds of intent."
  caption="These are durable knowledge layers with different scopes, not a fixed execution pipeline. A change may read only one or two of them."
>
  <ol class="memory-bands" aria-label="Project memory layers">
    {bands.map((band, bandIndex) => (
      <li class:list={['memory-band', band.accent && 'is-entry']}>
        <div class="scope-column">
          <span class="band-number">{String(bandIndex + 1).padStart(2, '0')}</span>
          <strong>{band.scope}</strong>
          <span>{band.hint}</span>
        </div>

        <div class="layers-column">
          {band.layers.map((layer) => (
            <div class:list={['memory-layer', layer.indent === 1 && 'indent-1', layer.indent === 2 && 'indent-2']}>
              <div class="layer-line">
                <code>{layer.file}</code>
                <span>{layer.question}</span>
              </div>
              {layer.note && <p class="layer-note">{layer.note}</p>}
            </div>
          ))}
        </div>
      </li>
    ))}
  </ol>
</ResearchFigureFrame>

<style>
  .memory-bands {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--border-subtle);
  }

  .memory-band {
    display: grid;
    gap: 1rem;
    margin: 0;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1rem;
  }

  .memory-band:last-child {
    border-bottom: 0;
  }

  .memory-band.is-entry {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .scope-column {
    min-width: 0;
  }

  .band-number {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .scope-column strong {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .scope-column > span:last-child {
    display: block;
    margin-top: 0.3rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .layers-column {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .memory-layer {
    border-left: 1px solid var(--border-strong);
    padding: 0.65rem 0.75rem;
    background: var(--bg-secondary);
  }

  .is-entry .memory-layer {
    border-left-color: var(--accent);
  }

  .layer-line {
    display: grid;
    gap: 0.35rem;
  }

  .layer-line code {
    width: fit-content;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--text-primary);
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .is-entry .layer-line code {
    color: var(--accent);
  }

  .layer-line span,
  .layer-note {
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .layer-note {
    margin: 0.5rem 0 0 !important;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.5rem;
    color: var(--text-muted);
  }

  @media (min-width: 700px) {
    .memory-band {
      grid-template-columns: minmax(9rem, 0.8fr) minmax(0, 2fr);
      gap: 1.4rem;
      padding: 1rem 1.1rem;
    }

    .layer-line {
      grid-template-columns: minmax(8.5rem, 0.8fr) minmax(0, 1.7fr);
      align-items: baseline;
      gap: 1rem;
    }

    .memory-layer.indent-1 {
      margin-left: 1.25rem;
    }

    .memory-layer.indent-2 {
      margin-left: 2.5rem;
    }
  }
</style>
