---
import ResearchFigureFrame from './research/ResearchFigureFrame.astro';

const featureLayers = [
  { file: 'Feature Spec', question: 'What are we trying to accomplish?' },
  { file: 'Plan', question: 'How will this repository implement it?' },
  { file: 'Tasks', question: 'What needs to happen now?' },
];
---

<ResearchFigureFrame
  title="The Project Memory Stack"
  subtitle="AGENTS.md is the entry point. Durable knowledge remains separated by scope and responsibility."
  caption="This is a routing and scope model, not a mandatory execution pipeline. A change may need one memory layer, several layers, or an ADR at any point."
>
  <div class="memory-map">
    <section class="router" aria-label="Agent entry point">
      <span>Entry / router</span>
      <code>AGENTS.md</code>
      <p>Points the agent toward the project memory relevant to the work.</p>
    </section>

    <div class="map-link map-link-in" aria-hidden="true">
      <span>Select relevant memory</span>
    </div>

    <section class="memory-scopes" aria-label="Durable project memory by scope">
      <div class="scope-row">
        <div class="scope-label">
          <span>Project-wide</span>
          <small>Applies across the repository</small>
        </div>
        <div class="scope-content">
          <code>Constitution</code>
          <p>What must remain true across the project?</p>
        </div>
      </div>

      <div class="scope-row">
        <div class="scope-label">
          <span>Feature-specific</span>
          <small>Scope narrows with the work</small>
        </div>
        <div class="scope-content feature-scope">
          {featureLayers.map((layer) => (
            <div class="feature-layer">
              <code>{layer.file}</code>
              <p>{layer.question}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="scope-row">
        <div class="scope-label">
          <span>Durable history</span>
          <small>Reasons that should survive implementation</small>
        </div>
        <div class="scope-content">
          <code>ADR / Decision Record</code>
          <p>Why was a durable product or architectural decision made?</p>
          <p class="scope-note">Can influence implementation at any point.</p>
        </div>
      </div>
    </section>

    <div class="map-link map-link-out" aria-hidden="true">
      <span>Informs</span>
    </div>

    <section class="output" aria-label="Implementation output">
      <span>Result</span>
      <strong>Implementation</strong>
      <p>Code and content produced from the intent relevant to the change.</p>
    </section>
  </div>
</ResearchFigureFrame>

<style>
  .memory-map {
    display: grid;
    gap: 0;
    min-width: 0;
    border-block: 1px solid var(--border-subtle);
  }

  .router,
  .output {
    min-width: 0;
    padding: 0.95rem 0.8rem;
  }

  .router {
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
  }

  .output {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .router > span,
  .output > span,
  .scope-label > span,
  .map-link span {
    font-family: var(--font-mono-ui);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .router > span,
  .output > span {
    color: var(--accent);
  }

  .router code {
    display: block;
    width: fit-content;
    margin-top: 0.3rem;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--text-primary);
    font-family: var(--font-mono-ui);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .output strong {
    display: block;
    margin-top: 0.3rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .router p,
  .output p,
  .scope-content p {
    margin: 0.45rem 0 0 !important;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .map-link {
    display: flex;
    align-items: center;
    min-height: 2.7rem;
    border-top: 1px solid var(--border-subtle);
    padding: 0.55rem 0.8rem;
    color: var(--text-muted);
    background: var(--bg-card);
  }

  .map-link::before {
    margin-right: 0.5rem;
    color: var(--accent);
    content: '↓';
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
  }

  .memory-scopes {
    min-width: 0;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .scope-row {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.9rem 0.8rem;
  }

  .scope-row + .scope-row {
    border-top: 1px solid var(--border-subtle);
  }

  .scope-label > span {
    display: block;
    color: var(--text-muted);
  }

  .scope-label small {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .scope-content {
    min-width: 0;
  }

  .scope-content > code,
  .feature-layer code {
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--text-primary);
    font-family: var(--font-mono-ui);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .feature-scope {
    display: grid;
    gap: 0;
  }

  .feature-layer {
    min-width: 0;
    padding: 0.55rem 0;
  }

  .feature-layer:first-child {
    padding-top: 0;
  }

  .feature-layer:last-child {
    padding-bottom: 0;
  }

  .feature-layer + .feature-layer {
    border-top: 1px dashed var(--border-subtle);
  }

  .feature-layer p {
    margin-top: 0.2rem !important;
  }

  .scope-content .scope-note {
    margin-top: 0.55rem !important;
    border-left: 1px solid var(--accent);
    padding-left: 0.6rem;
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  @media (min-width: 820px) {
    .memory-map {
      grid-template-columns: minmax(10rem, 0.72fr) 3.6rem minmax(0, 2.15fr) 3.6rem minmax(10rem, 0.72fr);
      align-items: stretch;
    }

    .router,
    .output {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1rem;
    }

    .output {
      border-top: 0;
      border-left: 1px solid var(--border-subtle);
    }

    .map-link {
      position: relative;
      justify-content: center;
      min-height: 0;
      border-top: 0;
      padding: 0;
      text-align: center;
    }

    .map-link::before {
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 1px;
      margin: 0;
      background: color-mix(in srgb, var(--accent) 45%, var(--border-subtle));
      content: '';
    }

    .map-link::after {
      position: absolute;
      top: calc(50% - 0.55rem);
      right: 0.2rem;
      color: var(--accent);
      content: '→';
      font-family: var(--font-mono-ui);
      font-size: 0.75rem;
    }

    .map-link span {
      position: relative;
      z-index: 1;
      width: min-content;
      background: var(--bg-card);
      padding: 0.3rem 0.2rem;
      color: var(--text-muted);
      line-height: 1.35;
    }

    .memory-scopes {
      border-top: 0;
      border-inline: 1px solid var(--border-subtle);
    }

    .scope-row {
      grid-template-columns: minmax(8rem, 0.8fr) minmax(0, 1.8fr);
      gap: 1rem;
      padding: 0.95rem 1rem;
    }

    .feature-layer {
      display: grid;
      grid-template-columns: minmax(7rem, 0.72fr) minmax(0, 1.6fr);
      gap: 0.8rem;
      align-items: baseline;
    }

    .feature-layer p {
      margin-top: 0 !important;
    }
  }
</style>
