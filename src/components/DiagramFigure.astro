---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  breakout?: boolean;
}

const { src, alt, caption, breakout = true } = Astro.props;
---

<figure class:list={['my-8 rounded-lg overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-card)] group', breakout && 'media-breakout']}>
  <!-- Image container with zoom overlay trigger -->
  <div class="relative cursor-zoom-in overflow-hidden bg-[var(--bg-secondary)]/40 diagram-zoom-trigger" data-img-src={src} data-img-alt={caption || alt}>
    <img 
      src={src} 
      alt={alt}
      class="w-full h-auto object-contain transition-transform duration-200 group-hover:scale-[1.005]"
      loading="lazy"
    />
    <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity px-2.5 py-1 rounded bg-[var(--bg-card)]/90 backdrop-blur-sm border border-[var(--border-subtle)] text-[11px] font-mono text-[var(--text-secondary)] flex items-center gap-1.5 shadow-sm">
      <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
      </svg>
      <span>Click to Expand</span>
    </div>
  </div>

  <!-- Caption & Action Bar -->
  <figcaption class="p-3 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[var(--text-muted)] border-t border-[var(--border-subtle)] bg-[var(--bg-card)]">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
      <span>{caption || alt}</span>
    </div>
    <div class="flex items-center gap-3">
      <a 
        href={src} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors flex items-center gap-1 hover:underline"
        title="Open full resolution in new tab"
      >
        <span>Full Resolution (PNG)</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </figcaption>
</figure>

<!-- Shared Modal Lightbox for Full-Screen View -->
<dialog id="diagram-lightbox" class="p-0 bg-transparent backdrop:bg-black/85 backdrop:backdrop-blur-sm max-w-[95vw] max-h-[95vh] rounded-lg border border-[var(--border-strong)] outline-none m-auto overflow-hidden shadow-2xl">
  <div class="relative flex flex-col bg-[var(--bg-card)] max-w-full max-h-[92vh]">
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-[var(--border-subtle)] bg-[var(--bg-secondary)] text-xs font-mono">
      <span id="lightbox-caption" class="text-[var(--text-primary)] font-medium truncate pr-4"></span>
      <div class="flex items-center gap-3">
        <a id="lightbox-raw-link" href="#" target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--accent)] flex items-center gap-1">
          <span>Open Raw</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <button id="lightbox-close" class="p-1 rounded hover:bg-[var(--bg-card-hover)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer" aria-label="Close modal">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
    <div class="p-3 overflow-auto flex items-center justify-center bg-[var(--bg-primary)]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[82vh] object-contain select-none" />
    </div>
  </div>
</dialog>

<script>
  function setupDiagramLightbox() {
    const triggers = document.querySelectorAll('.diagram-zoom-trigger');
    const dialog = document.getElementById('diagram-lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxRawLink = document.getElementById('lightbox-raw-link') as HTMLAnchorElement | null;
    const closeBtn = document.getElementById('lightbox-close');

    if (!dialog || !lightboxImg) return;

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-img-src') || '';
        const alt = trigger.getAttribute('data-img-alt') || '';
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        if (lightboxCaption) lightboxCaption.textContent = alt;
        if (lightboxRawLink) lightboxRawLink.href = src;
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  setupDiagramLightbox();
  document.addEventListener('astro:page-load', setupDiagramLightbox);
</script>
