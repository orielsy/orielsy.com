---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  breakout?: boolean;
}

const { src, alt, caption, breakout = true } = Astro.props;
const accessibleName = caption || alt;
---

<figure
  data-diagram-figure
  class:list={['my-8 overflow-hidden rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)] group', breakout && 'media-breakout']}
>
  <button
    type="button"
    class="relative block w-full cursor-zoom-in overflow-hidden bg-[var(--bg-secondary)]/40 text-left diagram-zoom-trigger focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--accent)]"
    data-img-src={src}
    data-img-alt={accessibleName}
    aria-label={`Expand diagram: ${accessibleName}`}
    aria-haspopup="dialog"
  >
    <img
      src={src}
      alt={alt}
      class="h-auto w-full object-contain transition-transform duration-200 group-hover:scale-[1.005]"
      loading="lazy"
    />
    <span
      class="pointer-events-none absolute right-3 bottom-3 flex items-center gap-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-card)]/90 px-2 py-1 font-editorial-mono text-[9px] text-[var(--text-secondary)] opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
      aria-hidden="true"
    >
      <svg class="h-3.5 w-3.5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
      </svg>
      <span>Expand</span>
    </span>
  </button>

  <dialog
    data-diagram-lightbox
    aria-label={`Expanded diagram: ${accessibleName}`}
    class="m-auto max-h-[95vh] max-w-[95vw] overflow-hidden rounded-md border border-[var(--border-strong)] bg-transparent p-0 outline-none shadow-2xl backdrop:bg-black/85 backdrop:backdrop-blur-sm"
  >
    <div class="relative flex max-h-[92vh] max-w-full flex-col bg-[var(--bg-card)]">
      <div class="flex items-center justify-between border-b border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-4 py-2.5 font-editorial-mono text-[10px]">
        <span data-lightbox-caption class="truncate pr-4 font-medium text-[var(--text-primary)]"></span>
        <div class="flex items-center gap-3">
          <a
            data-lightbox-raw-link
            href={src}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--accent)]"
          >
            <span>Open Raw</span>
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <button
            type="button"
            data-lightbox-close
            class="cursor-pointer rounded p-1 text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)]"
            aria-label="Close expanded diagram"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      <div class="flex items-center justify-center overflow-auto bg-[var(--bg-primary)] p-3">
        <img data-lightbox-img src="" alt="" class="max-h-[82vh] max-w-full select-none object-contain" />
      </div>
    </div>
  </dialog>

  <figcaption class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border-subtle)] bg-[var(--bg-card)] px-4 py-3 text-[11px] leading-5 text-[var(--text-muted)] sm:text-xs">
    <span>{accessibleName}</span>
    <a
      href={src}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1 font-editorial-mono text-[9px] text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)] hover:underline"
      title="Open full resolution in new tab"
    >
      <span>Full Resolution (PNG)</span>
      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </figcaption>
</figure>

<script>
  function setupDiagramLightboxes() {
    document.querySelectorAll<HTMLElement>('[data-diagram-figure]').forEach((figure) => {
      if (figure.dataset.lightboxBound === 'true') return;

      const trigger = figure.querySelector<HTMLButtonElement>('.diagram-zoom-trigger');
      const dialog = figure.querySelector<HTMLDialogElement>('[data-diagram-lightbox]');
      const lightboxImg = figure.querySelector<HTMLImageElement>('[data-lightbox-img]');
      const lightboxCaption = figure.querySelector<HTMLElement>('[data-lightbox-caption]');
      const lightboxRawLink = figure.querySelector<HTMLAnchorElement>('[data-lightbox-raw-link]');
      const closeBtn = figure.querySelector<HTMLButtonElement>('[data-lightbox-close]');

      if (!trigger || !dialog || !lightboxImg) return;

      const openDialog = () => {
        const imageSrc = trigger.dataset.imgSrc || '';
        const imageAlt = trigger.dataset.imgAlt || '';

        lightboxImg.src = imageSrc;
        lightboxImg.alt = imageAlt;
        if (lightboxCaption) lightboxCaption.textContent = imageAlt;
        if (lightboxRawLink) lightboxRawLink.href = imageSrc;

        dialog.showModal();
        closeBtn?.focus();
      };

      trigger.addEventListener('click', openDialog);
      closeBtn?.addEventListener('click', () => dialog.close());

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener('close', () => {
        trigger.focus();
      });

      figure.dataset.lightboxBound = 'true';
    });
  }

  setupDiagramLightboxes();
  document.addEventListener('astro:page-load', setupDiagramLightboxes);
</script>
