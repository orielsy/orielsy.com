---
export interface Props {
  kind: 'research' | 'project';
}

const { kind } = Astro.props;
const headingId = `concept-draft-${kind}-heading`;
---

<section
  class="my-8 overflow-hidden rounded-md border border-[var(--border-subtle)] border-l-2 border-l-amber-600 bg-[var(--bg-card)] dark:border-l-amber-400"
  aria-labelledby={headingId}
>
  <div class="flex items-center gap-3 px-4 py-3 sm:px-5">
    <div
      class="flex size-7 shrink-0 items-center justify-center rounded-full border border-amber-200 bg-amber-50/60 text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/20 dark:text-amber-300"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3.5">
        <path d="M10 2v6.5L5.4 17a2.6 2.6 0 0 0 2.3 3.8h8.6a2.6 2.6 0 0 0 2.3-3.8L14 8.5V2" />
        <path d="M8.5 2h7" />
        <path d="M7.2 16h9.6" />
      </svg>
    </div>

    <h2 id={headingId} class="min-w-0 text-sm leading-6 text-[var(--text-secondary)]">
      <span class="font-editorial-mono font-semibold uppercase tracking-[0.09em] text-amber-700 dark:text-amber-300">
        Concept Draft
      </span>
      <span class="mx-2 text-[var(--text-muted)]" aria-hidden="true">·</span>
      <span>Published while still evolving</span>
    </h2>
  </div>
</section>
