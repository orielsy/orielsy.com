---
export interface Props {
  kind: 'research' | 'project';
}

const { kind } = Astro.props;
const statusLabel = kind === 'research' ? 'Research status' : 'Project status';
const description = kind === 'research'
  ? 'Published in public while the framing, examples, and conclusions continue to evolve.'
  : 'Published in public while the implementation, framing, and case study continue to evolve.';
const headingId = `concept-draft-${kind}-heading`;
---

<section
  class="my-8 overflow-hidden rounded-lg border border-[var(--border-subtle)] border-l-2 border-l-[var(--accent)] bg-[var(--bg-card)]"
  aria-labelledby={headingId}
>
  <div class="flex gap-4 px-5 py-5 sm:px-6">
    <div
      class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--accent)_24%,var(--border-subtle))] bg-[color-mix(in_srgb,var(--accent)_6%,var(--bg-card))] text-[var(--accent)]"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4">
        <path d="M6 3.75h8.5L18 7.25V20.25H6z" />
        <path d="M14 3.75v4h4" />
        <path d="M9 13.5h6" />
        <path d="M9 16.5h4" />
      </svg>
    </div>

    <div class="min-w-0">
      <p class="font-editorial-mono text-[9px] font-medium uppercase tracking-[0.12em] text-[var(--accent)]">
        {statusLabel}
      </p>
      <h2 id={headingId} class="font-display mt-1.5 text-base font-semibold tracking-[-0.02em] text-[var(--text-primary)] sm:text-lg">
        Concept Draft
      </h2>
      <p class="mt-1.5 max-w-2xl text-sm leading-6 text-[var(--text-secondary)]">
        {description}
      </p>
    </div>
  </div>
</section>
