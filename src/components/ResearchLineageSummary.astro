---
interface ResearchReference {
  href: string;
  title: string;
  published: boolean;
}

interface RelatedWorkReference {
  href: string;
  label: string;
}

interface Props {
  origin?: ResearchReference;
  descendants?: ResearchReference[];
  related?: ResearchReference[];
  relatedWork?: RelatedWorkReference;
}

const {
  origin,
  descendants = [],
  related = [],
  relatedWork,
} = Astro.props;

const hasLineage = Boolean(origin || descendants.length > 0 || related.length > 0 || relatedWork);
---

{hasLineage && (
  <section
    id="research-lineage"
    class="scroll-mt-24 border-t border-[var(--border-subtle)] py-12 sm:py-16"
    aria-labelledby="research-lineage-title"
  >
    <div class="site-shell grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <div class="flex items-center gap-2">
          <svg
            class="h-3 w-3 shrink-0 text-[var(--accent)]"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 2.5v7a3 3 0 0 0 3 3h3.5" />
            <path d="m9.5 10.5 2 2-2 2" />
            <path d="M5 5.5h4a2 2 0 0 0 2-2v-1" />
          </svg>
          <h2
            id="research-lineage-title"
            class="font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]"
          >
            Story lineage
          </h2>
        </div>
        <p class="mt-3 max-w-xs text-xs leading-6 text-[var(--text-muted)]">
          Where this argument came from and where it continues.
        </p>
      </div>

      <div class="max-w-3xl border-t border-[var(--accent)] pt-5 lg:col-span-8 lg:col-start-5">
        <dl class="space-y-2.5 border-l border-[var(--border-subtle)] pl-3">
          {origin && (
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <dt class="shrink-0 font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">
                Grew out of
              </dt>
              <dd>
                {origin.published ? (
                  <a
                    href={origin.href}
                    class="inline-flex items-center gap-1 text-xs leading-5 text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                  >
                    {origin.title} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="inline-flex flex-wrap items-center gap-1.5 text-xs leading-5 text-[var(--text-muted)]">
                    <span aria-hidden="true">▢</span>
                    {origin.title}
                    <span class="font-editorial-mono text-[8px] uppercase tracking-[0.14em]">not published</span>
                  </span>
                )}
              </dd>
            </div>
          )}

          {descendants.length > 0 && (
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <dt class="shrink-0 font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">
                Led to
              </dt>
              <dd class="flex flex-wrap gap-x-4 gap-y-1">
                {descendants.map((item) => (
                  item.published ? (
                    <a
                      href={item.href}
                      class="inline-flex items-center gap-1 text-xs leading-5 text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                    >
                      {item.title} <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <span class="inline-flex flex-wrap items-center gap-1.5 text-xs leading-5 text-[var(--text-muted)]">
                      <span aria-hidden="true">▢</span>
                      {item.title}
                      <span class="font-editorial-mono text-[8px] uppercase tracking-[0.14em]">not published</span>
                    </span>
                  )
                ))}
              </dd>
            </div>
          )}

          {related.length > 0 && (
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <dt class="shrink-0 font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">
                Runs alongside
              </dt>
              <dd class="flex flex-wrap gap-x-4 gap-y-1">
                {related.map((item) => (
                  item.published ? (
                    <a
                      href={item.href}
                      class="inline-flex items-center gap-1 text-xs leading-5 text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                    >
                      {item.title} <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <span class="inline-flex flex-wrap items-center gap-1.5 text-xs leading-5 text-[var(--text-muted)]">
                      <span aria-hidden="true">▢</span>
                      {item.title}
                      <span class="font-editorial-mono text-[8px] uppercase tracking-[0.14em]">not published</span>
                    </span>
                  )
                ))}
              </dd>
            </div>
          )}

          {relatedWork && (
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <dt class="shrink-0 font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">
                Built as
              </dt>
              <dd>
                <a
                  href={relatedWork.href}
                  class="inline-flex items-center gap-1 text-xs leading-5 text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                >
                  {relatedWork.label} <span aria-hidden="true">→</span>
                </a>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </section>
)}
