---
interface ResearchReference {
  href: string;
  title: string;
  published: boolean;
}

interface Props {
  origin?: ResearchReference;
  descendants?: ResearchReference[];
}

const { origin, descendants = [] } = Astro.props;
---

{(origin || descendants.length > 0) && (
  <div id="research-lineage" class="mt-6 max-w-3xl scroll-mt-24 border-l border-[var(--border-subtle)] pl-3">
    <div class="flex items-center gap-1.5">
      <svg
        class="h-3 w-3 shrink-0 text-[var(--accent)]"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 2.5v7a3 3 0 0 0 3 3h3.5" />
        <path d="m9.5 10.5 2 2-2 2" />
        <path d="M5 5.5h4a2 2 0 0 0 2-2v-1" />
      </svg>
      <span class="font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">Lineage</span>
    </div>

    <dl class="mt-2 space-y-1.5">
      {origin && (
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <dt class="font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">Grew out of</dt>
          <dd>
            <a href={origin.href} class="text-xs leading-5 text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]">
              {origin.title} <span aria-hidden="true">→</span>
            </a>
          </dd>
        </div>
      )}

      {descendants.length > 0 && (
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <dt class="font-editorial-mono text-[8px] uppercase tracking-[0.16em] text-[var(--text-muted)]">Led to</dt>
          <dd class="flex flex-wrap gap-x-4 gap-y-1">
            {descendants.map((item) => (
              item.published ? (
                <a href={item.href} class="text-xs leading-5 text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]">
                  {item.title} <span aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 text-xs leading-5 text-[var(--text-muted)]">
                  {item.title}
                  <span class="font-editorial-mono text-[8px] uppercase tracking-[0.12em]">not published</span>
                </span>
              )
            ))}
          </dd>
        </div>
      )}
    </dl>
  </div>
)}
