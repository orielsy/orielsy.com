---
interface ResearchReference {
  href: string;
  title: string;
  published: boolean;
}

interface RelatedWorkReference {
  href: string;
  label: string;
}

interface Props {
  origin?: ResearchReference;
  descendants?: ResearchReference[];
  related?: ResearchReference[];
  relatedWorks?: RelatedWorkReference[];
}

const {
  origin,
  descendants = [],
  related = [],
  relatedWorks = [],
} = Astro.props;

const hasLineage = Boolean(origin || descendants.length > 0 || related.length > 0 || relatedWorks.length > 0);
---

{hasLineage && (
  <section
    id="research-lineage"
    class="scroll-mt-24 border-t border-[var(--border-subtle)] py-12 sm:py-16"
    aria-labelledby="research-lineage-title"
  >
    <div class="site-shell grid gap-8 lg:grid-cols-12 lg:gap-10">
      <header class="lg:col-span-3">
        <h2
          id="research-lineage-title"
          class="font-editorial-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]"
        >
          Research lineage
        </h2>
        <p class="mt-4 max-w-xs text-sm leading-7 text-[var(--text-secondary)]">
          Where this argument came from and where it continues.
        </p>
      </header>

      <div class="lg:col-span-8 lg:col-start-5">
        <dl class="border-t border-[var(--accent)]">
          {origin && (
            <div class="grid gap-3 border-b border-[var(--border-subtle)] py-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-editorial-mono text-[10px] uppercase tracking-[0.1em] text-[var(--text-muted)]">
                Grew out of
              </dt>
              <dd class="min-w-0">
                {origin.published ? (
                  <a
                    href={origin.href}
                    class="text-[15px] leading-6 text-[var(--text-primary)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                  >
                    {origin.title}
                  </a>
                ) : (
                  <div>
                    <span class="block text-[15px] leading-6 text-[var(--text-secondary)]">{origin.title}</span>
                    <span class="font-editorial-mono mt-1 block text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
                      Unpublished
                    </span>
                  </div>
                )}
              </dd>
            </div>
          )}

          {descendants.length > 0 && (
            <div class="grid gap-3 border-b border-[var(--border-subtle)] py-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-editorial-mono text-[10px] uppercase tracking-[0.1em] text-[var(--text-muted)]">
                Led to
              </dt>
              <dd class="grid min-w-0 gap-3">
                {descendants.map((item) => (
                  item.published ? (
                    <a
                      href={item.href}
                      class="block text-[15px] leading-6 text-[var(--text-primary)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                    >
                      {item.title}
                    </a>
                  ) : (
                    <div>
                      <span class="block text-[15px] leading-6 text-[var(--text-secondary)]">{item.title}</span>
                      <span class="font-editorial-mono mt-1 block text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
                        Unpublished
                      </span>
                    </div>
                  )
                ))}
              </dd>
            </div>
          )}

          {related.length > 0 && (
            <div class="grid gap-3 border-b border-[var(--border-subtle)] py-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-editorial-mono text-[10px] uppercase tracking-[0.1em] text-[var(--text-muted)]">
                Runs alongside
              </dt>
              <dd class="grid min-w-0 gap-3">
                {related.map((item) => (
                  item.published ? (
                    <a
                      href={item.href}
                      class="block text-[15px] leading-6 text-[var(--text-primary)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                    >
                      {item.title}
                    </a>
                  ) : (
                    <div>
                      <span class="block text-[15px] leading-6 text-[var(--text-secondary)]">{item.title}</span>
                      <span class="font-editorial-mono mt-1 block text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
                        Unpublished
                      </span>
                    </div>
                  )
                ))}
              </dd>
            </div>
          )}

          {relatedWorks.length > 0 && (
            <div class="grid gap-3 border-b border-[var(--border-subtle)] py-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-editorial-mono text-[10px] uppercase tracking-[0.1em] text-[var(--text-muted)]">
                Built as
              </dt>
              <dd class="grid min-w-0 gap-3">
                {relatedWorks.map((item) => (
                  <a
                    href={item.href}
                    class="block text-[15px] leading-6 text-[var(--text-primary)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                  >
                    {item.label}
                  </a>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </section>
)}
