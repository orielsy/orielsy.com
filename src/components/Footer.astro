---
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 w-full border-t border-[var(--border-subtle)] bg-[var(--bg-secondary)]/35 py-10 text-[var(--text-muted)]">
  <div class="site-shell flex flex-col gap-8">
    <div class="flex flex-col gap-5 border-b border-[var(--border-subtle)] pb-7 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="font-editorial-mono text-[9px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
          Orielsy.com
        </p>
        <p class="mt-2 text-xs leading-6 text-[var(--text-secondary)]">
          Research, implementations, and ongoing technical experimentation.
        </p>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2 font-editorial-mono text-[9px] uppercase tracking-[0.08em]">
        <a href="https://github.com/orielsy" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">GitHub</a>
        <a href="https://www.linkedin.com/in/orielsy" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">LinkedIn</a>
        <a href="/rss.xml" class="hover:text-[var(--text-primary)]">RSS</a>
      </div>
    </div>

    <div class="flex flex-col gap-2 text-[11px] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} Orielsy Diaz. Built with Astro, TypeScript, and Tailwind.</p>
      <p class="font-editorial-mono text-[9px] uppercase tracking-[0.08em] text-[var(--text-muted)]">
        No trackers · minimal client JavaScript · static-first
      </p>
    </div>
  </div>
</footer>
