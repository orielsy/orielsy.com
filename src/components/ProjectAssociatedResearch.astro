---
interface ResearchReference {
  href: string;
  title: string;
  type?: string;
  published: boolean;
}

interface Props {
  items: ResearchReference[];
  projectId: string;
}

const { items, projectId } = Astro.props;
---

{items.length > 0 && (
  <section
    id="associated-research"
    class="scroll-mt-24 border-t border-[var(--border-subtle)] py-12 sm:py-16"
    aria-labelledby="research-basis-title"
  >
    <div class="site-shell grid gap-8 lg:grid-cols-12 lg:gap-10">
      <header class="lg:col-span-3">
        <h2
          id="research-basis-title"
          class="font-editorial-mono text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]"
        >
          Research basis
        </h2>
        <p class="mt-4 max-w-xs text-sm leading-7 text-[var(--text-secondary)]">
          Research that frames the implementation and records the reasoning behind it.
        </p>
      </header>

      <div class="lg:col-span-8 lg:col-start-5">
        <ul class="border-t border-[var(--accent)]" aria-label="Research basis publications">
          {items.map((item) => (
            <li class="grid gap-3 border-b border-[var(--border-subtle)] py-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
              <span class="font-editorial-mono text-[10px] uppercase tracking-[0.1em] text-[var(--text-muted)]">
                {item.type ?? 'Research'}
              </span>

              <div class="min-w-0">
                <a
                  href={item.href}
                  data-analytics-event="project_to_research"
                  data-analytics-project={projectId}
                  data-analytics-research={item.href.split('/').filter(Boolean).at(-1)}
                  class="text-[15px] leading-6 text-[var(--text-primary)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
                >
                  {item.title}
                </a>
                {!item.published && (
                  <span class="font-editorial-mono mt-1 block text-[10px] uppercase tracking-[0.12em] text-[var(--text-muted)]">
                    Local preview
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}
