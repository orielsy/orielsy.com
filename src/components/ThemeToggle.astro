---
---

<div
  data-theme-toggle
  class="relative inline-flex items-stretch rounded-full border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-1"
  role="group"
  aria-label="Theme"
>
  <span
    data-theme-indicator
    class="pointer-events-none absolute inset-y-1 left-1 w-[calc(50%-4px)] rounded-full border border-[var(--border-subtle)] bg-[var(--bg-primary)] shadow-sm transition-transform duration-300 ease-out dark:translate-x-full"
    aria-hidden="true"
  ></span>

  <button
    data-theme-option="light"
    type="button"
    class="relative z-10 inline-flex min-h-7 flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.08em] text-[var(--accent)] transition-colors dark:text-[var(--text-muted)] dark:hover:text-[var(--text-secondary)]"
    aria-label="Use light theme"
    aria-pressed="true"
  >
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <span class="hidden sm:inline">Day</span>
  </button>

  <button
    data-theme-option="dark"
    type="button"
    class="relative z-10 inline-flex min-h-7 flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.08em] text-[var(--text-muted)] transition-colors hover:text-[var(--text-secondary)] dark:text-[var(--accent)]"
    aria-label="Use dark theme"
    aria-pressed="false"
  >
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
    </svg>
    <span class="hidden sm:inline">Night</span>
  </button>
</div>
