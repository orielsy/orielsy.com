---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'research'>;
  showTags?: boolean;
  previewUnpublished?: boolean;
}

const { entry, showTags = true, previewUnpublished = false } = Astro.props;
const { data, id } = entry;
const isPublished = data.published;
const isConceptDraft = isPublished && data.draft;
const canOpen = isPublished || previewUnpublished;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(data.pubDate);
---

<article
  data-article-type={data.type}
  data-article-published={isPublished ? 'true' : 'false'}
  data-article-draft={isConceptDraft ? 'true' : 'false'}
  class:list={[
    'article-item group relative border-t border-[var(--border-subtle)] py-5 transition-colors first:border-t-0 sm:py-6',
    canOpen && 'hover:bg-[var(--bg-secondary)]/30',
    !canOpen && 'cursor-pointer opacity-80 hover:bg-[var(--bg-secondary)]/30',
  ]}
>
  {!canOpen && (
    <button
      type="button"
      data-status-trigger
      aria-controls={`research-status-${id}`}
      aria-expanded="false"
      aria-label={`Show publication status for ${data.title}`}
      class="absolute inset-0 z-10 cursor-pointer border-0 bg-transparent p-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--accent)]"
    ></button>
  )}

  <div class="grid gap-4 sm:grid-cols-[132px_minmax(0,1fr)] sm:gap-8">
    <div class="font-editorial-mono text-[10px] uppercase leading-5 tracking-[0.08em] text-[var(--text-muted)]">
      <time datetime={data.pubDate.toISOString()}>{formattedDate}</time>
      <p class="mt-1 text-[var(--accent)]">
        {!isPublished ? (previewUnpublished ? 'Local preview' : 'In progress') : isConceptDraft ? 'Concept draft' : data.type}
      </p>
    </div>

    <div class="min-w-0">
      <div class="font-editorial-mono flex flex-wrap gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.07em] text-[var(--text-muted)]">
        <span>{data.type}</span>
        {isPublished && data.readingTime && <span>{data.readingTime}</span>}
      </div>

      <h3 class="font-display mt-2 text-lg font-semibold leading-snug tracking-[-0.025em] text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)] sm:text-xl">
        {canOpen ? (
          <a href={`/research/${id}`} class="focus:outline-none">
            <span class="absolute inset-0" aria-hidden="true"></span>
            {data.title}
          </a>
        ) : (
          <span>{data.title}</span>
        )}
      </h3>

      <p class="mt-2 max-w-3xl text-sm leading-7 text-[var(--text-secondary)]">
        {data.description}
      </p>

      {!canOpen && (
        <div
          id={`research-status-${id}`}
          hidden
          role="status"
          aria-live="polite"
          class="relative z-20 mt-4 border-l border-[var(--accent)] pl-4 text-xs leading-6 text-[var(--text-secondary)]"
        >
          This research entry is still being developed and is not publicly available yet.
        </div>
      )}

      {showTags && data.tags && data.tags.length > 0 && (
        <div class="relative z-20 mt-4 flex flex-wrap gap-x-4 gap-y-2 font-editorial-mono text-[10px] uppercase tracking-[0.06em] text-[var(--text-muted)]">
          {data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      )}
    </div>
  </div>
</article>