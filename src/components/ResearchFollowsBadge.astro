---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<span class="block min-w-0 w-full max-w-[calc(100vw-2.5rem)] basis-full overflow-hidden sm:w-auto sm:max-w-full sm:basis-auto">
  <a
    href={href}
    title={`Follows ${title}`}
    class="group/follows flex min-w-0 max-w-full items-center gap-1.5 overflow-hidden font-editorial-mono text-[10px] tracking-[0.08em] text-[var(--text-muted)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--accent)] sm:inline-flex"
  >
    <svg
      class="h-2.5 w-2.5 shrink-0 text-[var(--accent)]"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12.5 13.5V8a3.5 3.5 0 0 0-3.5-3.5H4" />
      <path d="m6.5 2-2.5 2.5L6.5 7" />
    </svg>
    <span class="shrink-0 uppercase text-[var(--text-muted)]">Follows</span>
    <span aria-hidden="true" class="shrink-0 text-[var(--text-muted)]">·</span>
    <span class="min-w-0 truncate normal-case tracking-normal text-[var(--text-primary)] underline decoration-[var(--border-strong)] decoration-dotted underline-offset-4 transition-colors group-hover/follows:text-[var(--accent)] group-hover/follows:decoration-[var(--accent)]">{title}</span>
  </a>
</span>